---
/**
 * Horizontal milestone timeline: a row of year tabs along a line; the selected year shows a photo,
 * the year set large, a title, a short text and a link to the story. A milestone without its own
 * photo uses the cover of the article it links to. `tone="dark"` for dark green sections.
 */
import ImageSlot from '../ImageSlot.astro';
import { isFilled } from '../../lib/content';
import { link } from '../../lib/routes';
import { newsByLink } from '../../lib/news';

interface Img { src?: string; focus?: string; zoom?: string | number; alt?: string }
interface Item { when: string; title: string; text?: string; link?: string; image?: Img }
/** `autoplay` (ms): move to the next year on its own (e.g. 6000); it waits while off screen or focused. */
interface Props { items: Item[]; tone?: 'dark' | 'light'; linkLabel?: string; cms?: string; id?: string; photos?: boolean; title?: string; hint?: string; autoplay?: number }
const { tone = 'light', linkLabel = 'Đọc câu chuyện', cms, id = 'years', photos = true, title, hint, autoplay } = Astro.props;
// Optional content beside the year panels (slot "aside"), e.g. a story card.
const hasAside = Astro.slots.has('aside');
const items = await Promise.all((Astro.props.items ?? []).filter((t) => isFilled(t.title)).map(async (t) => {
  if (isFilled(t.image?.src)) return { ...t, img: t.image!, own: true };
  const n = await newsByLink(t.link);
  return { ...t, img: n?.data.cover?.src ? { ...n.data.cover, alt: n.data.cover.alt || t.title } : (t.image ?? {}), own: false };
}));
const fill = 'position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto;display:block';
---
{items.length > 0 && <div class:list={['yt-tl', `yt-tl--${tone}`, { 'yt-tl--text': !photos }]} data-picker data-pick-autoplay={autoplay || undefined}>
{(title || hint) && <div class="yt-tl__head">{title && <h3>{title}</h3>}{hint && <span>{hint}</span>}</div>}
<div class="yt-tl__railbox">
<div class="yt-tl__rail" role="tablist" aria-label="Các mốc">
{items.map((t, k) => <button type="button" role="tab" data-pick={k} aria-selected={k === 0 ? 'true' : 'false'}><span class="yt-tl__dot" aria-hidden="true"></span><span class="yt-tl__when">{t.when}</span></button>)}
</div>
{items.length > 1 && <div class="yt-tl__nav"><button type="button" data-pick-step="-1" aria-label="Mốc trước"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg></button><span class="yt-tl__count" aria-hidden="true"><b data-yt-n>1</b>/{items.length}</span><button type="button" data-pick-step="1" aria-label="Mốc sau"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></button></div>}
</div>
<div class:list={['yt-tl__stage', { 'yt-tl__stage--aside': hasAside }]}>
<div class="yt-tl__panels">
{items.map((t, k) => (
<div class="yt-tl__panel" role="tabpanel" data-pick-panel={k} hidden={k !== 0}>
{photos && <div class="yt-tl__img"><ImageSlot style={fill} id={`${id}-${k}`} shape="rounded" radius={18} placeholder={t.title} image={t.img} cms={cms ? `${cms}.${k}.image` : undefined} sizes="(max-width: 899px) 92vw, 560px" /></div>}
<div class="yt-tl__text">
<span class="yt-tl__year">{t.when}</span>
<h3>{t.title}</h3>
{isFilled(t.text) && <p class="jx-justify">{t.text}</p>}
{isFilled(t.link) && <a class="yt-tl__more" href={link(t.link!)}>{linkLabel} <span aria-hidden="true">↗</span></a>}
</div>
</div>
))}
</div>
{hasAside && <div class="yt-tl__aside"><slot name="aside" /></div>}
</div>
</div>}

<script>
  // "2/7" counter beside the arrows follows the selected year.
  document.querySelectorAll<HTMLElement>('.yt-tl').forEach((tl) => tl.addEventListener('picker:change', () => {
    const btns = [...tl.querySelectorAll('.yt-tl__rail [data-pick]')];
    const n = tl.querySelector('[data-yt-n]');
    if (n) n.textContent = String(btns.findIndex((b) => b.getAttribute('aria-selected') === 'true') + 1);
  }));
</script>

<style>
  .yt-tl { display: flex; flex-direction: column; gap: 28px; }
  /* The rail scrolls sideways on narrow screens; the padding keeps the enlarged first/last dot and its halo from being clipped. */
  .yt-tl__rail { position: relative; display: flex; justify-content: space-between; gap: 8px; overflow-x: auto; scrollbar-width: none; padding: 10px 10px 4px; margin-inline: -10px; }
  .yt-tl__rail::-webkit-scrollbar { display: none; }
  .yt-tl__rail::before { content: ''; position: absolute; left: 10px; right: 10px; top: 19px; height: 2px; background: var(--yt-line); }
  .yt-tl__dot { position: relative; z-index: 1; }
  .yt-tl__rail button { position: relative; flex: 1 0 auto; min-width: 96px; display: flex; flex-direction: column; align-items: center; gap: 10px; padding: 0 6px 4px; border: 0; background: none; cursor: pointer; color: var(--yt-muted); font: 600 15px/1.2 var(--font-display); white-space: nowrap; transition: color var(--motion-fast); }
  .yt-tl__rail button:first-child { align-items: flex-start; padding-left: 0; }
  .yt-tl__rail button:last-child { align-items: flex-end; padding-right: 0; }
  .yt-tl__dot { width: 20px; height: 20px; border-radius: 50%; border: 2px solid var(--yt-line-strong); background: var(--yt-bg); transition: background var(--motion-fast), border-color var(--motion-fast), transform var(--motion-fast); }
  .yt-tl__rail button:hover { color: var(--yt-fg); }
  .yt-tl__rail button[aria-selected='true'] { color: var(--yt-accent); font-weight: 700; }
  .yt-tl__rail button[aria-selected='true'] .yt-tl__dot { background: var(--yt-accent); border-color: var(--yt-accent); transform: scale(1.15); box-shadow: 0 0 0 5px var(--yt-halo); }
  .yt-tl__panel { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: 28px clamp(28px, 4vw, 56px); align-items: center; }
  .yt-tl__panel[hidden] { display: none; }
  .yt-tl__head { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; flex-wrap: wrap; }
  .yt-tl__head h3 { margin: 0; font: 700 clamp(20px, 1.8vw, 24px)/1.3 var(--font-display); color: var(--yt-fg); }
  .yt-tl__head span { font-size: 13px; color: var(--yt-muted); }
  .yt-tl__stage--aside { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 28px clamp(28px, 4vw, 56px); align-items: start; }
  .yt-tl--text .yt-tl__panel { grid-template-columns: minmax(0, 1fr); align-items: start; }
  .yt-tl--text .yt-tl__year { font-size: clamp(48px, 5vw, 68px); color: var(--yt-year, var(--yt-accent)); }
  .yt-tl__img { position: relative; aspect-ratio: 16 / 10; }
  .yt-tl__text { display: flex; flex-direction: column; gap: 12px; align-items: flex-start; }
  .yt-tl__year { font: 700 clamp(40px, 4.4vw, 60px)/1 var(--font-display); color: var(--yt-accent); letter-spacing: -.01em; }
  .yt-tl__text h3 { margin: 0; font: 700 clamp(22px, 2vw, 28px)/1.3 var(--font-display); color: var(--yt-fg); text-wrap: balance; }
  .yt-tl__text p { margin: 0; color: var(--yt-body); font-size: var(--fs-body); line-height: 1.65; align-self: stretch; }
  .yt-tl--text .yt-tl__more { min-height: 0; padding: 0; background: none; color: var(--yt-accent); }
  .yt-tl__more { margin-top: 6px; display: inline-flex; align-items: center; gap: 12px; min-height: 44px; padding: 0 20px; border-radius: 999px; background: var(--yt-btn-bg); color: var(--yt-btn-fg); font-weight: 700; font-size: 15px; text-decoration: none; transition: transform var(--motion-fast); }
  .yt-tl__more:hover { transform: translateY(-1px); text-decoration: none; color: var(--yt-btn-fg); }
  .yt-tl--dark { --yt-bg: var(--green-800); --yt-line: rgba(255, 255, 255, .18); --yt-line-strong: rgba(255, 255, 255, .45); --yt-muted: var(--green-200); --yt-fg: #fff; --yt-body: var(--green-50); --yt-accent: var(--brand-highlight); --yt-halo: rgba(245, 196, 78, .2); --yt-btn-bg: #fff; --yt-btn-fg: var(--green-700); }
  .yt-tl--light { --yt-bg: var(--surface-card); --yt-line: var(--border-default); --yt-line-strong: var(--green-300); --yt-muted: var(--text-tertiary); --yt-fg: var(--text-primary); --yt-body: var(--text-secondary); --yt-accent: var(--brand-bright); --yt-halo: rgba(12, 166, 78, .15); --yt-btn-bg: var(--brand-bright); --yt-btn-fg: #fff; }
  /* Beside a story card the photo sits above the text. */
  .yt-tl__stage--aside .yt-tl__panel { grid-template-columns: minmax(0, 1fr); gap: 18px; }
  .yt-tl__stage--aside .yt-tl__img { aspect-ratio: 16 / 9; }
  .yt-tl__railbox { display: flex; flex-direction: column; gap: 10px; }
  .yt-tl__nav { display: none; }
  @media (max-width: 899.98px) {
    /* Phones: more years hide off to the right — the rail fades out there, and arrows with "1/7" show there is more. */
    .yt-tl__rail.is-scrollable { -webkit-mask-image: linear-gradient(90deg, #000 calc(100% - 44px), transparent); mask-image: linear-gradient(90deg, #000 calc(100% - 44px), transparent); }
    .yt-tl__nav { display: flex; align-items: center; justify-content: flex-end; gap: 10px; color: var(--yt-fg); }
    .yt-tl__nav button { width: 36px; height: 36px; display: grid; place-items: center; padding: 0; border-radius: 50%; border: 1px solid var(--yt-line-strong); background: none; color: var(--yt-fg); cursor: pointer; }
    .yt-tl__count { font: 600 14px var(--font-display); color: var(--yt-muted); min-width: 34px; text-align: center; }
    .yt-tl__count b { color: var(--yt-accent); }
    .yt-tl__panel, .yt-tl__stage--aside { grid-template-columns: minmax(0, 1fr); }
    .yt-tl__rail { justify-content: flex-start; }
    .yt-tl__rail button, .yt-tl__rail button:first-child, .yt-tl__rail button:last-child { flex: none; align-items: center; padding: 0 10px 4px; }
    /* The connecting line is drawn by each year (not across the visible box), so it runs unbroken to the last year
       when the rail scrolls sideways. */
    .yt-tl__rail::before { display: none; }
    .yt-tl__rail button::before { content: ''; position: absolute; top: 9px; left: 0; right: -8px; height: 2px; background: var(--yt-line); }
    .yt-tl__rail button:first-child::before { left: 50%; }
    .yt-tl__rail button:last-child::before { right: 50%; }
    .yt-tl__rail button:only-child::before { display: none; }
    /* Arrows under the story, on the left, where the thumb is. */
    .yt-tl__railbox { display: contents; }
    /* Phone order: photo and story first, then the year rail, then the arrows. */
    .yt-tl__stage { order: 1; }
    .yt-tl__rail { order: 2; }
    .yt-tl__nav { order: 3; justify-content: flex-start; margin-top: -12px; }
    .yt-tl__nav button { width: 44px; height: 44px; }
  }
</style>
