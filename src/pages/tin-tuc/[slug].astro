---
import raw from '../../content/pages/tin-tuc.json';
import { isFilled, withDefaults } from '../../lib/content';
import siteRaw from '../../content/site.json';
import Layout from '../../layouts/Layout.astro';
import ImageSlot from '../../components/ImageSlot.astro';
import { render } from 'astro:content';
import { url, link } from '../../lib/routes';
import { CATEGORIES, formatDate, getNews, isArticle, isPress, newsUrl, readingTime, type NewsEntry } from '../../lib/news';
const site = withDefaults(siteRaw, 'src/content/site.json');

const c = withDefaults(raw, 'src/content/pages/tin-tuc.json');

export async function getStaticPaths() {
  // Press items that link to the newspaper's own page need no article page here.
  const all = (await getNews()).filter(isArticle);
  return all.map((entry) => ({ params: { slug: entry.id }, props: { entry, all } }));
}
interface Props { entry: NewsEntry; all: NewsEntry[] }
const { entry, all } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const t = c.article;
const cat = CATEGORIES[d.category];
const others = all.filter((e) => e.id !== entry.id && !isPress(e));
const related = [...others.filter((e) => e.data.category === d.category), ...others.filter((e) => e.data.category !== d.category)].slice(0, 3);
const pageUrl = new URL(newsUrl(entry), Astro.site ?? 'https://example.com').href;
---
<Layout title={d.title} description={isFilled(d.summary) ? d.summary : undefined} active="Tin tức" background="var(--surface-card)">
<article>
<header style="max-width:820px;margin:0 auto;padding:32px clamp(20px,4vw,40px) 32px;display:flex;flex-direction:column;gap:18px">
<span style="font-size:13px;color:var(--text-tertiary)"><a href={url('trang-chu')} style="color:var(--text-tertiary)">{t.breadcrumb_home}</a> / <a href={url('tin-tuc')} style="color:var(--text-tertiary)">{t.breadcrumb_news}</a> / {cat}</span>
<span style="font:var(--type-eyebrow);letter-spacing:.08em;color:var(--green-600)">{cat.toUpperCase()}</span>
<h1 style="margin:0;font:var(--type-h1);letter-spacing:-.01em;text-wrap:balance">{d.title}</h1>
<div style="display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;padding:14px 0;border-top:1px solid var(--border-default);border-bottom:1px solid var(--border-default);font-size:14px;color:var(--text-secondary)">
<span>{d.author}{d.date && ` · ${formatDate(d.date)}`} · {readingTime(entry)} {t.minutes_read}</span>
<div style="display:flex;gap:16px;font-weight:600"><a href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(pageUrl)}`} target="_blank" rel="noopener">{t.share_facebook}</a><a href={link(site.social.zalo)} target="_blank" rel="noopener">{t.share_zalo}</a><button type="button" id="copy-link" data-copied={t.copied} style="background:none;border:0;padding:0;font:600 14px var(--font-body);color:var(--text-link);cursor:pointer">{t.copy_link}</button></div>
</div>
</header>
<div style="max-width:1120px;margin:0 auto;padding:0 clamp(20px,4vw,40px)"><figure style="margin:0;display:flex;flex-direction:column;gap:10px"><div style="position:relative;height:clamp(260px,44vw,560px)"><ImageSlot style="position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto;display:block" id={`news-${entry.id}`} shape="rounded" radius="16" placeholder={d.cover.alt || 'Ảnh đại diện bài viết'} image={d.cover} cms={`${entry.filePath}#cover`} /></div>{d.cover_caption && <figcaption style="font-size:14px;color:var(--text-tertiary);text-align:center">{d.cover_caption}</figcaption>}</figure></div>
<div class="article-body" style="max-width:720px;margin:0 auto;padding:40px clamp(20px,4vw,40px) 64px;display:flex;flex-direction:column;gap:22px;font-size:var(--fs-lead);line-height:1.75">
{isFilled(d.summary) && <p style="margin:0;font-weight:600;font-size:20px;line-height:1.6">{d.summary}</p>}
<Content />
{d.album.length > 0 && <div style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px">{d.album.map((img, i) => <div style="position:relative;height:150px"><ImageSlot style="position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto;display:block" id={`news-${entry.id}-album-${i}`} shape="rounded" radius="10" placeholder={img.alt || 'Album'} image={img} cms={`${entry.filePath}#album.${i}`} /></div>)}</div>}
{d.album_link && <a href={link(d.album_link)} style="font-size:15px;font-weight:600">{t.album_more}</a>}
{d.tags.length > 0 && <div style="display:flex;gap:8px;flex-wrap:wrap;padding-top:20px;border-top:1px solid var(--border-default);font-size:14px"><span style="color:var(--text-tertiary)">{t.tags_label}</span>{d.tags.map((tag) => <a href={url('tin-tuc')} style="padding:4px 12px;border-radius:var(--radius-full);background:var(--surface-sunken);color:var(--text-primary)">{tag}</a>)}</div>}
</div>
</article>

{related.length > 0 && <section style="background:var(--surface-page);border-top:1px solid var(--border-default)">
<div style="max-width:1280px;margin:0 auto;padding:clamp(48px,6vw,80px) clamp(20px,4vw,56px);display:flex;flex-direction:column;gap:28px">
<div style="display:flex;justify-content:space-between;align-items:flex-end;gap:16px;flex-wrap:wrap"><h2 style="margin:0;font:var(--type-h3)">{t.related_title}</h2><a href={url('tin-tuc')} style="font-weight:600">{t.related_all}</a></div>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(clamp(calc((100% - 48px)/3),calc((888px - 100%)*999),100%),1fr));gap:24px">
{related.map((r) => <a href={newsUrl(r)} style="display:flex;flex-direction:column;gap:12px;color:var(--text-primary)"><div style="position:relative;height:190px"><ImageSlot style="position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto;display:block" id={`news-${r.id}`} shape="rounded" radius="12" placeholder="Ảnh" image={r.data.cover} cms={`${r.filePath}#cover`} /></div><span style="font-size:13px;color:var(--green-600);font-weight:600">{CATEGORIES[r.data.category]}</span><strong style="line-height:1.4">{r.data.title}</strong></a>)}
</div></div></section>}
</Layout>

<style>
  .article-body :global(p) { margin: 0; }
  .article-body :global(h2) { margin: 16px 0 0; font: 700 26px/1.3 var(--font-display); }
  .article-body :global(h3) { margin: 8px 0 0; font: 700 21px/1.35 var(--font-display); }
  .article-body :global(ul), .article-body :global(ol) { margin: 0; padding-left: 22px; }
  .article-body :global(img) { display: block; width: 100%; height: auto; border-radius: 12px; margin: 8px 0; background: var(--surface-sunken); }
  /* Photo caption: an italic line right under a photo (articles imported from the old site). */
  .article-body :global(p:has(> img) + p:has(> em:only-child)) { margin-top: -12px; font-size: 14px; line-height: 1.5; color: var(--text-tertiary); text-align: center; text-align-last: center; }
  .article-body :global(.video-embed) { position: relative; aspect-ratio: 16 / 9; border-radius: 12px; overflow: hidden; background: #000; }
  .article-body :global(.video-embed iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .article-body :global(table) { width: 100%; border-collapse: collapse; font-size: 15px; line-height: 1.5; display: block; overflow-x: auto; }
  .article-body :global(th), .article-body :global(td) { padding: 8px 10px; border: 1px solid var(--border-default); text-align: left; vertical-align: top; }
  .article-body :global(th) { background: var(--surface-sunken); }
  .article-body :global(blockquote) { margin: 8px 0; padding: 8px 0 8px 24px; border-left: 4px solid var(--green-500); font: 600 22px/1.5 var(--font-display); color: var(--green-800); }
  .article-body :global(blockquote p) { text-align: left; }
  .article-body :global(blockquote p + p) { margin-top: 8px; font: 500 15px var(--font-body); color: var(--text-secondary); }
</style>
<script>
  const btn = document.getElementById('copy-link')!;
  const label = btn.textContent;
  btn.addEventListener('click', () => {
    navigator.clipboard?.writeText(location.href).catch(() => { /* clipboard unavailable */ });
    btn.textContent = btn.dataset.copied!;
    setTimeout(() => { btn.textContent = label; }, 1800);
  });
</script>
