---
import raw from '../content/pages/giai-phap.json';
import { withDefaults } from '../lib/content';
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import ImageSlot from '../components/ImageSlot.astro';
import Input from '../components/Input.astro';
import { url } from '../lib/routes';

const c = withDefaults(raw, 'src/content/pages/giai-phap.json');
const v = c.s03_theo_van_de;

// The finder opens on the last issue, as in the design.
const defaultIssue = c.finder_issues.length - 1;
---
<Layout title={c.seo.title || undefined} description={c.seo.description || undefined} active="Giải pháp">
<section style="position:relative;min-height:min(70vh,600px);background:var(--green-900);display:flex">
<div style="position:absolute;inset:0"><ImageSlot style="position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto;display:block" id="sol-hero" shape="rect" placeholder="Cận cảnh bông lúa chín trên cánh đồng" image={c.s01_hero.img_sol_hero_1} cms="src/content/pages/giai-phap.json#s01_hero.img_sol_hero_1" /></div>
<div style="position:absolute;inset:0;pointer-events:none;background:linear-gradient(90deg,rgba(2,53,26,.8) 0%,rgba(2,53,26,.45) 50%,rgba(2,53,26,0) 80%)"></div>
<div style="position:relative;max-width:1280px;width:100%;margin:0 auto;padding:28px clamp(20px,4vw,56px) clamp(56px,7vw,96px);display:flex;flex-direction:column;justify-content:space-between;gap:48px;pointer-events:none;color:#fff">
<span style="font-size:13px;color:var(--green-100)">{c.s01_hero.t1}</span>
<div style="max-width:760px;display:flex;flex-direction:column;gap:20px">
<span style="font:var(--type-eyebrow);letter-spacing:.08em;color:var(--green-100)">{c.s01_hero.t2}</span>
<h1 style="margin:0;font:var(--type-h1);letter-spacing:-.015em;text-wrap:balance">{c.s01_hero.t3}</h1>
<p style="margin:0;font-size:var(--fs-lead);line-height:1.55;color:var(--green-50);text-wrap:pretty">{c.s01_hero.t4}</p>
<div style="display:flex;gap:12px;flex-wrap:wrap;pointer-events:auto"><a href="#tim-giai-phap" style="background:var(--green-500);color:#fff;font-weight:700;padding:13px 22px;border-radius:var(--radius-md)">{c.s01_hero.t5}</a><a href={url('giai-phap-du-an')} style="background:#fff;color:var(--green-700);font-weight:700;padding:13px 22px;border-radius:var(--radius-md)">{c.s01_hero.t6}</a></div>
</div></div></section>

<section style="background:var(--surface-card)">
<div style="max-width:1280px;margin:0 auto;padding:clamp(64px,8vw,112px) clamp(20px,4vw,56px);display:flex;flex-direction:column;gap:40px">
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:24px 64px;align-items:end">
<div style="display:flex;flex-direction:column;gap:14px"><span style="font:var(--type-eyebrow);letter-spacing:.08em;color:var(--green-600)">{c.s02_cay_trong.t1}</span><h2 style="margin:0;font:var(--type-h2);letter-spacing:-.01em;text-wrap:balance">{c.s02_cay_trong.t2}</h2></div>
<p style="margin:0;color:var(--text-secondary);font-size:var(--fs-body);text-wrap:pretty">{c.s02_cay_trong.t3}</p>
</div>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,340px),1fr));gap:20px">
<a href="#tim-giai-phap" style="position:relative;height:300px;border-radius:var(--radius-lg);overflow:hidden;display:block;color:#fff"><ImageSlot style="position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto;display:block" id="cg-1" shape="rect" placeholder="Lúa, ngô" image={c.s02_cay_trong.img_cg_1_1} cms="src/content/pages/giai-phap.json#s02_cay_trong.img_cg_1_1" /><div style="position:absolute;inset:auto 0 0 0;padding:22px;background:linear-gradient(0deg,rgba(2,53,26,.85),rgba(2,53,26,0));pointer-events:none;display:flex;flex-direction:column;gap:4px"><strong style="font-size:21px">{c.s02_cay_trong.t4}</strong><span style="font-size:14px;color:var(--green-50)">{c.s02_cay_trong.t5}</span></div></a>
<a href="#tim-giai-phap" style="position:relative;height:300px;border-radius:var(--radius-lg);overflow:hidden;display:block;color:#fff"><ImageSlot style="position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto;display:block" id="cg-2" shape="rect" placeholder="Rau màu" image={c.s02_cay_trong.img_cg_2_1} cms="src/content/pages/giai-phap.json#s02_cay_trong.img_cg_2_1" /><div style="position:absolute;inset:auto 0 0 0;padding:22px;background:linear-gradient(0deg,rgba(2,53,26,.85),rgba(2,53,26,0));pointer-events:none;display:flex;flex-direction:column;gap:4px"><strong style="font-size:21px">{c.s02_cay_trong.t6}</strong><span style="font-size:14px;color:var(--green-50)">{c.s02_cay_trong.t7}</span></div></a>
<a href="#tim-giai-phap" style="position:relative;height:300px;border-radius:var(--radius-lg);overflow:hidden;display:block;color:#fff"><ImageSlot style="position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto;display:block" id="cg-3" shape="rect" placeholder="Cây ăn quả" image={c.s02_cay_trong.img_cg_3_1} cms="src/content/pages/giai-phap.json#s02_cay_trong.img_cg_3_1" /><div style="position:absolute;inset:auto 0 0 0;padding:22px;background:linear-gradient(0deg,rgba(2,53,26,.85),rgba(2,53,26,0));pointer-events:none;display:flex;flex-direction:column;gap:4px"><strong style="font-size:21px">{c.s02_cay_trong.t8}</strong><span style="font-size:14px;color:var(--green-50)">{c.s02_cay_trong.t9}</span></div></a>
<a href="#tim-giai-phap" style="position:relative;height:300px;border-radius:var(--radius-lg);overflow:hidden;display:block;color:#fff"><ImageSlot style="position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto;display:block" id="cg-4" shape="rect" placeholder="Cà phê, chè" image={c.s02_cay_trong.img_cg_4_1} cms="src/content/pages/giai-phap.json#s02_cay_trong.img_cg_4_1" /><div style="position:absolute;inset:auto 0 0 0;padding:22px;background:linear-gradient(0deg,rgba(2,53,26,.85),rgba(2,53,26,0));pointer-events:none;display:flex;flex-direction:column;gap:4px"><strong style="font-size:21px">{c.s02_cay_trong.t10}</strong><span style="font-size:14px;color:var(--green-50)">{c.s02_cay_trong.t11}</span></div></a>
<a href="#tim-giai-phap" style="position:relative;height:300px;border-radius:var(--radius-lg);overflow:hidden;display:block;color:#fff"><ImageSlot style="position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto;display:block" id="cg-5" shape="rect" placeholder="Hoa, cây cảnh" image={c.s02_cay_trong.img_cg_5_1} cms="src/content/pages/giai-phap.json#s02_cay_trong.img_cg_5_1" /><div style="position:absolute;inset:auto 0 0 0;padding:22px;background:linear-gradient(0deg,rgba(2,53,26,.85),rgba(2,53,26,0));pointer-events:none;display:flex;flex-direction:column;gap:4px"><strong style="font-size:21px">{c.s02_cay_trong.t12}</strong><span style="font-size:14px;color:var(--green-50)">{c.s02_cay_trong.t13}</span></div></a>
<a href="#tim-giai-phap" style="position:relative;height:300px;border-radius:var(--radius-lg);overflow:hidden;display:block;color:#fff"><ImageSlot style="position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto;display:block" id="cg-6" shape="rect" placeholder="Cây dược liệu" image={c.s02_cay_trong.img_cg_6_1} cms="src/content/pages/giai-phap.json#s02_cay_trong.img_cg_6_1" /><div style="position:absolute;inset:auto 0 0 0;padding:22px;background:linear-gradient(0deg,rgba(2,53,26,.85),rgba(2,53,26,0));pointer-events:none;display:flex;flex-direction:column;gap:4px"><strong style="font-size:21px">{c.s02_cay_trong.t14}</strong><span style="font-size:14px;color:var(--green-50)">{c.s02_cay_trong.t15}</span></div></a>
</div></div></section>

<section id="theo-van-de" style="background:var(--surface-page);scroll-margin-top:120px">
<div style="max-width:1280px;margin:0 auto;padding:clamp(64px,8vw,112px) clamp(20px,4vw,56px);display:flex;flex-direction:column;gap:32px">
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:24px 64px;align-items:end">
<div style="display:flex;flex-direction:column;gap:14px"><span style="font:var(--type-eyebrow);letter-spacing:.08em;color:var(--green-600)">{v.t1}</span><h2 style="margin:0;font:var(--type-h2);letter-spacing:-.01em;text-wrap:balance">{v.t2}</h2></div>
<p style="margin:0;color:var(--text-secondary);font-size:var(--fs-body);text-wrap:pretty">{v.t3}</p>
</div>
<div role="tablist" aria-label={v.t2} style="display:flex;gap:8px;flex-wrap:wrap">
{c.issues.map((it, k) => <button type="button" role="tab" class="chip" id={`issue-tab-${k}`} aria-controls={`issue-${k}`} aria-selected={k === 0 ? 'true' : 'false'} aria-pressed={k === 0 ? 'true' : 'false'} data-issue-tab={k} style="padding:10px 18px;border-radius:var(--radius-full);border:1px solid var(--border-strong);background:var(--surface-card);color:var(--text-primary);font:600 15px var(--font-body);cursor:pointer">{it.title}</button>)}
</div>
{c.issues.map((it, k) => (
<div role="tabpanel" id={`issue-${k}`} aria-labelledby={`issue-tab-${k}`} data-issue={k} hidden={k !== 0} class="issue-flow">
<article class="issue-step">
<div style="position:relative;height:220px"><ImageSlot style="position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto;display:block" id={`issue-${k}-problem`} shape="rect" placeholder={it.image.alt} image={it.image} cms={`src/content/pages/giai-phap.json#issues.${k}.image`} /></div>
<div style="padding:22px;display:flex;flex-direction:column;gap:10px"><span class="issue-step__label"><b>1</b>{v.label_problem}</span><h3 style="margin:0;font:var(--type-num)">{it.title}</h3><p style="margin:0;color:var(--text-secondary)">{it.symptoms}</p></div>
</article>
<span class="issue-arrow" aria-hidden="true">→</span>
<article class="issue-step" style="background:var(--green-50);border-color:var(--green-100)">
<div style="padding:22px;display:flex;flex-direction:column;gap:12px"><span class="issue-step__label"><b>2</b>{v.label_why}</span>
<ul style="margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:12px">{it.why.split('\n').filter((l) => l.trim()).map((l) => <li style="display:grid;grid-template-columns:14px minmax(0,1fr);gap:8px"><span aria-hidden="true" style="width:8px;height:8px;margin-top:9px;border-radius:50%;background:var(--green-500)"></span><span>{l}</span></li>)}</ul>
</div>
</article>
<span class="issue-arrow" aria-hidden="true">→</span>
<article class="issue-step" style="border:2px solid var(--green-500)">
<div style="display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:2px;background:var(--border-default)">
<figure style="margin:0;position:relative;height:170px;background:var(--surface-sunken)"><ImageSlot style="position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto;display:block" id={`issue-${k}-pack`} shape="rect" fit="contain" placeholder={it.pack_image.alt} image={it.pack_image} cms={`src/content/pages/giai-phap.json#issues.${k}.pack_image`} /><figcaption class="issue-cap">{v.label_pack}</figcaption></figure>
<figure style="margin:0;position:relative;height:170px"><ImageSlot style="position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto;display:block" id={`issue-${k}-result`} shape="rect" placeholder={it.result_image.alt} image={it.result_image} cms={`src/content/pages/giai-phap.json#issues.${k}.result_image`} /><figcaption class="issue-cap">{v.label_result}{it.result_caption ? ` · ${it.result_caption}` : ''}</figcaption></figure>
</div>
<div style="padding:22px;display:flex;flex-direction:column;gap:10px"><span class="issue-step__label" style="color:var(--green-700)"><b>3</b>{v.label_solution}</span><h3 style="margin:0;font:var(--type-num);color:var(--green-800)">{it.solution_name}</h3><p style="margin:0;color:var(--text-secondary)">{it.solution_text}</p>
{it.products.length > 0 && <div style="display:flex;gap:6px;flex-wrap:wrap;align-items:center"><span style="font-size:14px;font-weight:600">{v.label_products}</span>{it.products.map((name) => <a href={url('san-pham')} style="font-size:13px;font-weight:600;padding:4px 10px;border-radius:var(--radius-full);background:var(--green-50);color:var(--green-800);text-decoration:none">{name}</a>)}</div>}
</div>
</article>
</div>
))}

<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:40px 72px;align-items:start;margin-top:clamp(24px,4vw,48px);padding-top:clamp(40px,5vw,64px);border-top:1px solid var(--border-default)">
<div style="display:flex;flex-direction:column;gap:16px;position:sticky;top:140px">
<span style="font:var(--type-eyebrow);letter-spacing:.08em;color:var(--green-600)">{v.faq_eyebrow}</span>
<h2 style="margin:0;font:var(--type-h2);letter-spacing:-.01em;text-wrap:balance">{v.faq_title}</h2>
<p style="margin:0;color:var(--text-secondary);font-size:var(--fs-body);text-wrap:pretty">{v.faq_intro}</p>
</div>
<div data-accordion style="display:flex;flex-direction:column;border-top:1px solid var(--border-default)">
{c.problems.map((p, k) => (
<div style="border-bottom:1px solid var(--border-default)">
<button type="button" data-acc aria-expanded={k === 0 ? 'true' : 'false'} aria-controls={`pb-${k}`} style="width:100%;display:flex;gap:16px;align-items:baseline;text-align:left;padding:22px 0;border:0;background:none;cursor:pointer;font:700 19px/1.35 var(--font-body);color:var(--text-primary)"><span style="font:600 14px var(--font-mono);color:var(--green-600)">{String(k + 1).padStart(2, '0')}</span><span style="flex:1">{p.title}</span><span data-acc-sign style="font:400 22px var(--font-body);color:var(--green-600)">{k === 0 ? '−' : '+'}</span></button>
<div id={`pb-${k}`} hidden={k !== 0} style="padding:0 0 24px 38px;display:flex;flex-direction:column;gap:12px"><div style="color:var(--text-secondary);white-space:pre-line"><strong style="color:var(--text-primary);display:block;margin-bottom:4px">{c.problems_cause_label}</strong>{p.cause}</div><div style="background:var(--green-50);border-radius:var(--radius-md);padding:14px 16px"><strong style="color:var(--green-800)">{c.problems_fix_label} </strong>{p.fix}</div></div>
</div>
))}
</div></div>
</div></section>

<section style="background:var(--green-800);color:#fff">
<div style="max-width:1280px;margin:0 auto;padding:clamp(64px,8vw,112px) clamp(20px,4vw,56px);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:48px 72px;align-items:center">
<div style="position:relative;height:480px"><ImageSlot style="position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto;display:block" id="soil" shape="rounded" radius="20" placeholder="Bàn tay cầm nắm đất có cây con" image={c.s04_suc_khoe_dat.img_soil_1} cms="src/content/pages/giai-phap.json#s04_suc_khoe_dat.img_soil_1" /></div>
<div style="display:flex;flex-direction:column;gap:24px">
<span style="font:var(--type-eyebrow);letter-spacing:.08em;color:var(--green-200)">{c.s04_suc_khoe_dat.t1}</span>
<h2 style="margin:0;font:var(--type-h2);letter-spacing:-.01em;text-wrap:balance">{c.s04_suc_khoe_dat.t2}</h2>
<div style="display:flex;flex-direction:column;gap:0;border-top:1px solid var(--green-600)">
<div style="display:grid;grid-template-columns:48px minmax(0,1fr);gap:12px;padding:16px 0;border-bottom:1px solid var(--green-700)"><span style="font:var(--type-num);color:var(--amber-400)">{c.s04_suc_khoe_dat.t3}</span><div><strong>{c.s04_suc_khoe_dat.t4}</strong><div style="color:var(--green-100);font-size:15px">{c.s04_suc_khoe_dat.t5}</div></div></div>
<div style="display:grid;grid-template-columns:48px minmax(0,1fr);gap:12px;padding:16px 0;border-bottom:1px solid var(--green-700)"><span style="font:var(--type-num);color:var(--amber-400)">{c.s04_suc_khoe_dat.t6}</span><div><strong>{c.s04_suc_khoe_dat.t7}</strong><div style="color:var(--green-100);font-size:15px">{c.s04_suc_khoe_dat.t8}</div></div></div>
<div style="display:grid;grid-template-columns:48px minmax(0,1fr);gap:12px;padding:16px 0;border-bottom:1px solid var(--green-700)"><span style="font:var(--type-num);color:var(--amber-400)">{c.s04_suc_khoe_dat.t9}</span><div><strong>{c.s04_suc_khoe_dat.t10}</strong><div style="color:var(--green-100);font-size:15px">{c.s04_suc_khoe_dat.t11}</div></div></div>
<div style="display:grid;grid-template-columns:48px minmax(0,1fr);gap:12px;padding:16px 0;border-bottom:1px solid var(--green-700)"><span style="font:var(--type-num);color:var(--amber-400)">{c.s04_suc_khoe_dat.t12}</span><div><strong>{c.s04_suc_khoe_dat.t13}</strong><div style="color:var(--green-100);font-size:15px">{c.s04_suc_khoe_dat.t14}</div></div></div>
</div></div></div></section>

<section id="tim-giai-phap" style="background:var(--surface-card);scroll-margin-top:120px">
<div style="max-width:1280px;margin:0 auto;padding:clamp(64px,8vw,112px) clamp(20px,4vw,56px);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:40px 64px;align-items:start">
<div style="display:flex;flex-direction:column;gap:24px">
<div style="display:flex;flex-direction:column;gap:14px"><span style="font:var(--type-eyebrow);letter-spacing:.08em;color:var(--green-600)">{c.s05_tim_giai_phap.t1}</span><h2 style="margin:0;font:var(--type-h2);letter-spacing:-.01em;text-wrap:balance">{c.s05_tim_giai_phap.t2}</h2></div>
<div style="display:flex;flex-direction:column;gap:10px"><span style="font-weight:600">{c.s05_tim_giai_phap.t3}</span><div style="display:flex;gap:8px;flex-wrap:wrap">{c.finder_crops.map((crop, k) => <button type="button" class="chip" data-chip="crop" data-k={k} aria-pressed={k === 0 ? 'true' : 'false'} style="padding:8px 16px;border-radius:var(--radius-full);border:1px solid var(--border-strong);background:var(--surface-card);color:var(--text-primary);font:600 15px var(--font-body);cursor:pointer">{crop}</button>)}</div></div>
<div style="display:flex;flex-direction:column;gap:10px"><span style="font-weight:600">{c.s05_tim_giai_phap.t4}</span><div style="display:flex;gap:8px;flex-wrap:wrap">{c.finder_issues.map((issue, k) => <button type="button" class="chip" data-chip="issue" data-k={k} aria-pressed={k === defaultIssue ? 'true' : 'false'} style="padding:8px 16px;border-radius:var(--radius-full);border:1px solid var(--border-strong);background:var(--surface-card);color:var(--text-primary);font:600 15px var(--font-body);cursor:pointer">{issue.label}</button>)}</div></div>
</div>
<div style="background:var(--surface-page);border:1px solid var(--border-default);border-radius:var(--radius-xl);padding:clamp(24px,3vw,36px);display:flex;flex-direction:column;gap:18px">
<span style="font:var(--type-eyebrow);letter-spacing:.08em;color:var(--text-tertiary)">{c.s05_tim_giai_phap.t5}</span>
<h3 id="rec-title" style="margin:0;font:var(--type-num)">{c.finder_crops[0] + ' · ' + c.finder_issues[defaultIssue].label.toLowerCase()}</h3>
{c.finder_issues.map(({ steps }, i) => <div data-rec={i} hidden={i !== defaultIssue} style="display:flex;flex-direction:column;gap:10px">{steps.map((t, k) => <div style="display:grid;grid-template-columns:28px minmax(0,1fr);gap:10px;align-items:baseline"><span style="font:700 14px var(--font-mono);color:var(--green-600)">{String(k + 1).padStart(2, '0')}</span><span>{t}</span></div>)}</div>)}
<span style="font-size:14px;color:var(--text-tertiary)">{c.s05_tim_giai_phap.t6}</span>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:12px;padding-top:16px;border-top:1px solid var(--border-default)">
<Input label={c.s05_tim_giai_phap.f1} placeholder={c.s05_tim_giai_phap.f2} />
<Input label={c.s05_tim_giai_phap.f3} placeholder={c.s05_tim_giai_phap.f4} />
</div>
<a href={url('lien-he', 'lien-he-form')} style="text-decoration:none;display:inline-flex"><Button as="span" size="lg">{c.s05_tim_giai_phap.t7}</Button></a>
</div></div></section>

<section style="background:var(--surface-page)">
<div style="max-width:1280px;margin:0 auto;padding:clamp(64px,8vw,112px) clamp(20px,4vw,56px);display:flex;flex-direction:column;gap:36px">
<div style="display:flex;justify-content:space-between;align-items:flex-end;gap:20px;flex-wrap:wrap"><div style="display:flex;flex-direction:column;gap:14px;max-width:640px"><span style="font:var(--type-eyebrow);letter-spacing:.08em;color:var(--green-600)">{c.s06_mo_hinh_thuc_te.t1}</span><h2 style="margin:0;font:var(--type-h2);letter-spacing:-.01em;text-wrap:balance">{c.s06_mo_hinh_thuc_te.t2}</h2></div><a href={url('tin-tuc', 'nd')} style="font-weight:600">{c.s06_mo_hinh_thuc_te.t3}</a></div>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(clamp(calc((100% - 48px)/3),calc((1068px - 100%)*999),100%),1fr));gap:24px">
