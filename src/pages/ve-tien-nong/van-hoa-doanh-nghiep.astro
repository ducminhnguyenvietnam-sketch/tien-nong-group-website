---
/**
 * Văn hóa doanh nghiệp. Flow: hero → key figures → the slogan → origin + the five "tốt cho" questions
 * → five tâm niệm → five core values (photo + caption from a real news story) → traditions → training
 * (news cards) → the Tiến Nông song → poems → gallery → invitation to join.
 */
import raw from '../../content/pages/van-hoa-doanh-nghiep.json';
import { isFilled, stripPlaceholders, withDefaults } from '../../lib/content';
import Layout from '../../layouts/Layout.astro';
import ImageSlot from '../../components/ImageSlot.astro';
import PageHero from '../../components/PageHero.astro';
import FigureCard from '../../components/FigureCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import Head from '../../components/story/Head.astro';
import siteRaw from '../../content/site.json';
import { link, url, youtubeId } from '../../lib/routes';
import { newsByLink } from '../../lib/news';
import { localeOf } from '../../lib/i18n';
/** Language of this page (vi / en / zh): content is read in that language. */
const L = localeOf(Astro.url);

const c = withDefaults(raw, 'src/content/pages/van-hoa-doanh-nghiep.json', L);
const site = withDefaults(siteRaw, 'src/content/site.json', L);
const F = 'src/content/pages/van-hoa-doanh-nghiep.json';
const fill = 'position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto;display:block';

const principles = c.principles.items.filter((p) => isFilled(p.title));
const poems = c.poems.items.filter((p) => isFilled(p.text));
const measures = (c.origin.measures as string[]).filter(isFilled);
const hasGallery = c.gallery.photos.some((ph) => isFilled(ph.src));


/** Photo for a card: its own CMS photo, otherwise the cover of the news story it links to. */
const photoFor = async (img: any, href: string) => {
  if (isFilled(img?.src)) return { image: img, own: true };
  const n = await newsByLink(href);
  return { image: n?.data.cover, own: false };
};
// Đảng bộ: horizontal timeline; each stop shows its photo (or the cover of its news story) or a "document" card.
const party = await Promise.all(c.party.milestones.map(async (m, k) => ({ ...m, k, ...(await photoFor(m.image, m.link)) })));
const shownParty = party.filter((m) => isFilled(m.year) && isFilled(m.title));
const values = await Promise.all(c.values.items.map(async (v, k) => ({ ...v, k, ...(await photoFor(v.image, v.link)) })));
const shownValues = values.filter((v) => isFilled(v.title));
const traditions = c.traditions.items.map((t, k) => ({ ...t, k })).filter((t) => isFilled(t.title));
const learning = await Promise.all(c.learning.items.map(async (l, k) => ({ ...l, k, ...(await photoFor(l.image, l.link)) })));
const shownLearning = learning.filter((l) => isFilled(l.title));

const videos = c.media.videos.filter((v) => isFilled(v.youtube) || isFilled(v.file));
const [mainVideo, ...moreVideos] = videos;
/** What the song player needs to know about a clip (the big box plays whichever clip was picked). */
const clip = (v: (typeof videos)[number]) => ({ yt: youtubeId(v.youtube) || '', file: isFilled(v.file) ? link(v.file) : '', title: v.title || '', label: v.label || '', dur: v.duration || '' });
const titleParts = (() => {
  const t = String(c.media.title || ''), h = String(c.media.highlight || '').trim();
  const i = h ? t.indexOf(h) : -1;
  return i < 0 ? [t, '', ''] : [t.slice(0, i), h, t.slice(i + h.length)];
})();
const two = (n: number) => String(n + 1).padStart(2, '0');
const tnVideo = youtubeId(c.principles.youtube);
const stories = c.family.stories.map((st, k) => ({ ...st, k }) as typeof st & { k: number }).filter((st) => isFilled(st.names));
---
<Layout align={c.can_le} title={c.seo.title || undefined} description={c.seo.description || undefined} active="Về Tiến Nông">
<PageHero id="vh-hero" image={c.hero.background} cms={`${F}#hero.background`} placeholder={c.hero.background?.alt || 'Tập thể cán bộ, nhân viên Tiến Nông'}
  crumbs={[{ label: c.hero.breadcrumb_home, href: url('trang-chu') }, { label: c.hero.breadcrumb_parent, href: url('ve-tien-nong') }, { label: c.hero.breadcrumb_self }]}
  eyebrow={c.hero.eyebrow} title={c.hero.title} lead={c.hero.intro} leadWidth={775}>
{principles.length > 0 && <a href="#tam-niem" class="page-hero__btn page-hero__btn--solid">{c.hero.button_principles}</a>}{mainVideo && <a href="#bai-hat" class="page-hero__btn">{c.hero.button_media}</a>}
</PageHero>

<FigureCard overlap items={c.stats} />

{shownParty.length > 0 && <section id="dang-bo" class="st-sec dg">
<div class="st-wrap" data-picker data-pick-autoplay="6000">
<div class="dg__head">
<div class="st-head"><span class="st-eyebrow">{c.party.eyebrow}</span><h2 class="st-h2">{c.party.title}</h2></div>
<div class="dg__arrows"><button type="button" data-pick-step="-1" aria-label="Mốc trước"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"/></svg></button><button type="button" data-pick-step="1" aria-label="Mốc sau"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></button></div>
</div>
<div class="dg__stage">
{shownParty.map((m, i) => { const doc = !isFilled(m.image?.src) && isFilled(m.doc_date); return (
<div role="tabpanel" class="dg__panel" data-pick-panel={i} hidden={i !== 0} aria-label={m.year}>
<div class="dg__media">
{doc
  ? <div class="dg__doc"><div class="dg__paper">
      {isFilled(m.doc_label) && <span class="dg__paper-label">{m.doc_label}</span>}
      <span class="dg__paper-date">{m.doc_date}</span>
      <span class="dg__paper-rule" aria-hidden="true"></span>
      {isFilled(m.doc_text) && <span class="dg__paper-text">{m.doc_text}</span>}
      {isFilled(m.doc_badge) && <span class="dg__paper-badge">{m.doc_badge}</span>}
    </div></div>
  : <><ImageSlot style={fill} id={`vh-party-${m.k}`} shape="rect" placeholder={m.image?.alt || m.title} image={m.image} cms={m.own ? `${F}#party.milestones.${m.k}.image` : undefined} sizes="(max-width: 899px) 92vw, 640px" />
    {isFilled(m.fig) && <span class="dg__badge"><strong>{m.fig}</strong><span>{m.fig_label}</span></span>}</>}
</div>
<div class="dg__text">
<span class="dg__year" aria-hidden="true">{m.year}</span>
<h3>{m.title}</h3>
<p class="jx-justify">{m.body}</p>
{isFilled(m.link) && <a href={link(m.link)} class="vh-link">Đọc bài →</a>}
</div>
</div>); })}
</div>
<div class="dg__rail" role="tablist" aria-label="Các dấu mốc của Đảng bộ Tiến Nông">
{shownParty.map((m, i) => <button type="button" role="tab" class:list={['dg__stop', { 'dg__stop--key': m.key }]} data-pick={i} aria-selected={i === 0 ? 'true' : 'false'}><span class="dg__dot" aria-hidden="true"></span><span class="dg__label">{m.year}</span>{isFilled(m.tag) && <span class="dg__tag">{m.tag}</span>}</button>)}
</div>
</div></section>}

<section id="khoi-nguon" class="st-sec">
<div class="st-wrap">
<div class="vh-origin">
<Head eyebrow={c.origin.eyebrow} title={c.origin.title} intro={c.origin.text} />
<div class="vh-origin__photo st-hide-empty"><ImageSlot style={fill} id="vh-origin" shape="rounded" radius="20" placeholder={c.origin.image.alt || 'Ảnh khởi nguồn'} image={c.origin.image} cms={`${F}#origin.image`} sizes="(max-width: 899px) 92vw, 520px" /></div>
</div>
{measures.length > 0 && <div class="vh-measure">
<div class="vh-measure__head"><strong>{c.origin.measure_title}</strong><span>{c.origin.measure_intro}</span></div>
<ul class="vh-measure__list" style={`--n:${measures.length}`}>{measures.map((m) => <li>{m}</li>)}</ul>
</div>}
</div></section>

{principles.length > 0 && <section id="tam-niem" class="st-sec st-sec--dark">
<div class="st-wrap">
<Head eyebrow={c.principles.eyebrow} title={c.principles.title} intro={c.principles.intro} split />
<div class="vh-tn">
{tnVideo
  ? <button type="button" class="yt vh-tn__media" data-yt={tnVideo} aria-label={`Phát video ${c.principles.title}`}>
      <img src={`https://i.ytimg.com/vi/${tnVideo}/hqdefault.jpg`} alt="" loading="lazy" width="480" height="360" />
      <span class="yt__play" aria-hidden="true"></span>
    </button>
  : <div class="vh-tn__media st-hide-empty"><ImageSlot style={fill} id="vh-tam-niem" shape="rounded" radius="20" placeholder="Bức Tâm niệm" image={c.principles.image} cms={`${F}#principles.image`} sizes="(max-width: 899px) 92vw, 560px" /></div>}
<ol class="vh-tn__list" data-seq>
{principles.map((p, i) => <li><span class="vh-tn__num">{i + 1}</span><strong>{p.title}</strong></li>)}
</ol>
</div>
</div></section>}

{shownValues.length > 0 && <section id="gia-tri" class="st-sec scrolly" data-scrolly>
<div class="scrolly__pin"><div class="st-wrap">
<Head eyebrow={c.values.eyebrow} title={c.values.title} intro={c.values.intro} split />
<div class="vh-values" data-picker>
<div class="vh-values__list" role="tablist" aria-label={c.values.title}>
{shownValues.map((v, i) => <button type="button" role="tab" data-pick={i} aria-selected={i === 0 ? 'true' : 'false'}>
<span class="vh-values__num">{two(i)}</span>
<span class="vh-values__txt"><strong>{v.title}</strong><span>{v.body}</span></span>
</button>)}
</div>
<div class="vh-values__stage">
{shownValues.map((v, i) => <figure role="tabpanel" data-pick-panel={i} hidden={i !== 0} class="vh-values__panel">
<div class="vh-values__img"><ImageSlot style={fill} id={`vh-value-${v.k}`} shape="rect" placeholder={v.title} image={v.image} cms={v.own ? `${F}#values.items.${v.k}.image` : undefined} sizes="(max-width: 899px) 92vw, 640px" /></div>
{isFilled(v.proof) && <figcaption><span>{v.proof}</span>{isFilled(v.link) && <a href={link(v.link)}>Đọc bài →</a>}</figcaption>}
</figure>)}
</div>
</div>
</div></div></section>}

{traditions.length > 0 && <section id="nghi-thuc" class="st-sec st-sec--dark scrolly" data-scrolly>
<div class="scrolly__pin"><div class="st-wrap">
<Head eyebrow={c.traditions.eyebrow} title={c.traditions.title} intro={c.traditions.intro} split />
<div class="vh-trad" data-picker>
<div class="vh-trad__list">
{traditions.map((t, i) => <div class="vh-trad__item">
<button type="button" data-pick={i} aria-selected={i === 0 ? 'true' : 'false'} aria-controls={`vh-trad-${i}`}><span>{t.title}</span><span class="vh-trad__sign" aria-hidden="true"></span></button>
<div id={`vh-trad-${i}`} class="vh-trad__body" data-pick-panel={i} hidden={i !== 0}><p>{stripPlaceholders(t.body)}</p>
{isFilled(t.image?.src) && <div class="vh-trad__thumb"><ImageSlot style={fill} id={`vh-tradition-m-${t.k}`} shape="rounded" radius="14" placeholder={t.image.alt || t.title} image={t.image} sizes="92vw" /></div>}</div>
</div>)}
</div>
<div class="vh-trad__stage">
{traditions.map((t, i) => <div class="vh-trad__img" data-pick-panel={i} hidden={i !== 0}><ImageSlot style={fill} id={`vh-tradition-${t.k}`} shape="rounded" radius="20" placeholder={t.image.alt || t.title} image={t.image} cms={`${F}#traditions.items.${t.k}.image`} sizes="(max-width: 899px) 92vw, 600px" /></div>)}
</div>
</div>
</div></div></section>}

{stories.length > 0 && <section id="gia-dinh" class="st-sec st-sec--card">
<div class="st-wrap">
<div class="vh-fam__head">
<Head eyebrow={c.family.eyebrow} title={c.family.title} intro={c.family.intro} split />
</div>
<div class="vh-fam" data-count={Math.min(stories.length, 3)}>
{stories.map((st) => <article class="vh-fam__card">
<div class="vh-fam__img"><ImageSlot style={fill} id={`vh-family-${st.k}`} shape="rect" placeholder={st.names} image={st.image} cms={`${F}#family.stories.${st.k}.image`} sizes="(max-width: 899px) 92vw, 600px" /></div>
<div class="vh-fam__body">
{isFilled(st.tag) && <span class="vh-fam__tag">{st.tag}</span>}
<h3>{st.names}</h3>
<p class="jx-justify">{st.text}</p>
{isFilled(st.link) && <a href={link(st.link)} class="vh-link vh-fam__read">{st.link_label || 'Đọc câu chuyện'} →</a>}
</div>
</article>)}
</div>
{isFilled(c.family.link) && <a href={link(c.family.link)} class="vh-link vh-fam__more">{c.family.link_label || 'Đọc câu chuyện'} →</a>}
</div></section>}

{shownLearning.length > 0 && <section id="hoc-tap" class="st-sec">
<div class="st-wrap">
<div class="st-split">
<div class="vh-learn__copy">
<Head eyebrow={c.learning.eyebrow} title={c.learning.title} intro={c.learning.intro} />
{isFilled(c.learning.motto) && <blockquote class="vh-learn__motto"><p>{c.learning.motto}</p></blockquote>}
</div>
<div class="st-split__media st-hide-empty vh-learn__photo" style="--ratio:3/2"><ImageSlot style={fill} id="vh-learning" shape="rounded" radius="20" placeholder={c.learning.image.alt || 'Ảnh đào tạo'} image={c.learning.image} cms={`${F}#learning.image`} sizes="(max-width: 899px) 92vw, 600px" /></div>
</div>
<div class="vh-learn__grid">
{shownLearning.map((l) => <a href={link(l.link)} class="vh-learn__card">
<span class="vh-learn__img"><ImageSlot style={fill} id={`vh-learn-${l.k}`} shape="rect" placeholder={l.title} image={l.image} cms={l.own ? `${F}#learning.items.${l.k}.image` : undefined} sizes="(max-width: 767px) 92vw, 400px" /></span>
<span class="vh-learn__body">
{isFilled(l.label) && <span class="vh-learn__label">{l.label}</span>}
<strong>{l.title}</strong>
<span class="vh-learn__text">{l.text}</span>
</span>
</a>)}
</div>
</div></section>}

{mainVideo && <section id="bai-hat" class="st-sec st-sec--dark">
<div class="st-wrap">
<div class="vh-song__head">
<div class="st-head"><span class="vh-song__eyebrow">{c.media.eyebrow}</span><h2 class="st-h2 vh-song__title">{titleParts[0]}{titleParts[1] && <span class="vh-gold">{titleParts[1]}</span>}{titleParts[2]}</h2>{isFilled(c.media.intro) && <p class="st-lead">{c.media.intro}</p>}</div>
{isFilled(site.social.youtube) && <a href={link(site.social.youtube)} target="_blank" rel="noopener" class="vh-song__channel-link">Xem kênh YouTube <span aria-hidden="true">↗</span></a>}
</div>
<div class:list={['vh-song', { 'vh-song--solo': moreVideos.length === 0 }]} data-song>
{(() => { const m = clip(mainVideo); return (
<div class="vh-song__main" data-song-main data-clip={JSON.stringify(m)}>
  <button type="button" class="vh-song__poster" data-song-play aria-label={`Phát video ${m.title}`}>
    {m.yt && <img src={`https://i.ytimg.com/vi/${m.yt}/maxresdefault.jpg`} alt="" loading="lazy" width="1280" height="720" />}
    <span class="vh-song__shade" aria-hidden="true"></span>
    {isFilled(m.dur) && <span class="vh-song__dur">{m.dur}</span>}
    <span class="yt__play yt__play--big" aria-hidden="true"></span>
    <span class="vh-song__cap">{isFilled(m.label) && <span>{m.label}</span>}{isFilled(m.title) && <strong>{m.title}</strong>}</span>
  </button>
</div>); })()}
{moreVideos.length > 0 && <ul class="vh-song__list">
{moreVideos.slice(0, 3).map((v) => { const m = clip(v); return (
  <li><button type="button" class="vh-song__item" data-song-pick data-clip={JSON.stringify(m)} aria-label={`Phát video ${m.title}`}>
    <span class="vh-song__thumb">{m.yt && <img src={`https://i.ytimg.com/vi/${m.yt}/mqdefault.jpg`} alt="" loading="lazy" width="320" height="180" />}<span class="yt__play" aria-hidden="true"></span>{isFilled(m.dur) && <span class="vh-song__dur vh-song__dur--sm">{m.dur}</span>}</span>
    <span class="vh-song__meta">{isFilled(m.label) && <span>{m.label}</span>}<strong>{m.title}</strong></span>
  </button></li>); })}
{moreVideos.length < 3 && isFilled(site.social.youtube) && <li><a href={link(site.social.youtube)} target="_blank" rel="noopener" class="vh-song__item vh-song__item--channel">
  <span class="vh-song__thumb vh-song__thumb--channel"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="1" y="4.5" width="22" height="15" rx="4.5" fill="#FF0000"/><path fill="#fff" d="m10 8.8 5.6 3.2-5.6 3.2z"/></svg></span>
  <span class="vh-song__meta"><span>KÊNH YOUTUBE</span><strong>Xem thêm video của Tiến Nông</strong></span>
</a></li>}
</ul>}
</div>
</div></section>}

{poems.length > 0 && <section id="tho" class="st-sec st-sec--card">
<div class="st-wrap">
<Head eyebrow={c.poems.eyebrow} title={c.poems.title} intro={c.poems.intro} split />
<div class="st-grid" style="--min:340px">
{poems.map((p) => <figure style="margin:0;display:flex;flex-direction:column;gap:16px;padding:clamp(24px,3vw,36px);background:var(--surface-page);border-left:4px solid var(--amber-400);border-radius:var(--radius-lg)"><strong style="font:var(--type-num)">{p.title}</strong><blockquote style="margin:0;white-space:pre-line;font:500 17px/1.8 var(--font-display);color:var(--text-primary)">{p.text}</blockquote><figcaption style="display:flex;flex-direction:column;padding-top:12px;border-top:1px solid var(--border-default)"><strong>{p.author}</strong><span style="font-size:14px;color:var(--text-secondary)">{p.place}</span></figcaption></figure>)}
</div></div></section>}

<section id="khoanh-khac" class="st-sec" data-needs-photos={hasGallery ? undefined : ''}>
<div class="st-wrap">
<Head eyebrow={c.gallery.eyebrow} title={c.gallery.title} />
<div class="vh-gallery">
{c.gallery.photos.map((ph, k) => <figure class="vh-gallery__item"><ImageSlot style={fill} id={`vh-gallery-${k}`} shape="rounded" radius="16" placeholder={ph.alt} image={ph} cms={`${F}#gallery.photos.${k}`} />{isFilled(ph.alt) && <figcaption>{ph.alt}</figcaption>}</figure>)}
</div></div></section>

<CtaBand title={c.cta.title} text={c.cta.text} primary={{ label: c.cta.button_jobs, href: url('tuyen-dung', 'vi-tri') }} secondary={{ label: c.cta.button_about, href: url('ve-tien-nong') }} />
</Layout>

<script>
  /* Song player: the big box plays the picked clip; the clip it was showing takes the picked one's place on the right. */
  type Clip = { yt: string; file: string; title: string; label: string; dur: string };
  document.querySelectorAll<HTMLElement>('[data-song]').forEach((root) => {
    const main = root.querySelector<HTMLElement>('[data-song-main]');
    if (!main) return;
    let cur: Clip = JSON.parse(main.dataset.clip || '{}');
    const esc = (t: string) => t.replace(/[&<>"]/g, (ch) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[ch]!);
    const play = (v: Clip) => {
      main.innerHTML = v.yt
        ? `<iframe src="https://www.youtube-nocookie.com/embed/${v.yt}?autoplay=1&rel=0" title="${esc(v.title)}" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>`
        : `<video src="${esc(v.file)}" controls autoplay playsinline></video>`;
      main.dataset.clip = JSON.stringify(v);
      main.querySelector<HTMLElement>('iframe,video')?.focus();
    };
    const paint = (btn: HTMLElement, v: Clip) => {
      btn.dataset.clip = JSON.stringify(v);
      btn.setAttribute('aria-label', `${({ en: 'Play video:', zh: '播放视频：' } as Record<string, string>)[document.documentElement.lang.slice(0, 2)] ?? 'Phát video'} ${v.title}`);
      const thumb = btn.querySelector('.vh-song__thumb');
      if (thumb) thumb.innerHTML = (v.yt ? `<img src="https://i.ytimg.com/vi/${v.yt}/mqdefault.jpg" alt="" width="320" height="180">` : '')
        + '<span class="yt__play" aria-hidden="true"></span>' + (v.dur ? `<span class="vh-song__dur vh-song__dur--sm">${esc(v.dur)}</span>` : '');
      const meta = btn.querySelector('.vh-song__meta');
      if (meta) meta.innerHTML = (v.label ? `<span>${esc(v.label)}</span>` : '') + `<strong>${esc(v.title)}</strong>`;
      // innerHTML loses the page's scoped-style attribute: copy it from the button onto the new children.
      const cid = [...btn.attributes].find((a) => a.name.startsWith('data-astro-cid'));
      if (cid) btn.querySelectorAll('*').forEach((el) => el.setAttribute(cid.name, ''));
    };
    main.querySelector('[data-song-play]')?.addEventListener('click', () => play(cur));
    root.querySelectorAll<HTMLElement>('[data-song-pick]').forEach((btn) => btn.addEventListener('click', () => {
      const next: Clip = JSON.parse(btn.dataset.clip || '{}');
      paint(btn, cur);
      cur = next;
      play(next);
      if (matchMedia('(max-width: 1023.98px)').matches) main.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }));
  });
</script>

<style>
  /* Đảng bộ (Claude Design "Đảng bộ Tiến Nông — section Văn hoá doanh nghiệp"): photo + story, year rail below. */
  .dg .st-wrap { gap: clamp(24px, 3vw, 40px); }
  .dg__head { display: flex; justify-content: space-between; align-items: flex-end; gap: 20px 48px; flex-wrap: wrap; }
  .dg__arrows { display: flex; gap: 8px; }
  .dg__arrows button { width: 44px; height: 44px; border-radius: 999px; border: 1px solid var(--border-strong); background: var(--surface-card); color: var(--text-primary); display: inline-flex; align-items: center; justify-content: center; padding: 0; cursor: pointer; }
  .dg__arrows button:hover { background: var(--green-50); border-color: var(--green-300); }
  .dg__stage { position: relative; min-height: 420px; }
  .dg__panel { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); gap: 28px clamp(32px, 5vw, 64px); align-items: center; }
  .dg__panel:not([hidden]) { animation: vh-in 420ms var(--ease-out) both; }
  .dg__media { order: 2; position: relative; aspect-ratio: 16 / 10; border-radius: var(--radius-xl); overflow: hidden; background: var(--surface-sunken); }
  .dg__badge { position: absolute; left: 20px; bottom: 20px; z-index: 1; display: flex; align-items: baseline; gap: 10px; max-width: calc(100% - 40px); padding: 12px 18px; border-radius: 16px; background: rgba(2, 53, 26, .88); color: #fff; }
  .dg__badge strong { font: 800 30px/1 var(--font-display); color: var(--brand-highlight); }
  .dg__badge span { font-size: 14px; line-height: 1.35; color: var(--green-50); text-align: start; }
  .dg__doc { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; background: radial-gradient(120% 140% at 50% 0%, var(--green-700) 0%, var(--green-800) 55%, var(--green-900) 100%); }
  .dg__paper { width: min(78%, 420px); padding: clamp(22px, 3vw, 32px) clamp(20px, 3vw, 30px); border-radius: 6px; background: #fffdf6; color: var(--text-primary); box-shadow: 0 18px 40px rgba(0, 0, 0, .28); transform: rotate(-2.5deg); display: flex; flex-direction: column; gap: 12px; text-align: center; }
  .dg__paper-label { font: 600 12px/1.4 var(--font-body); letter-spacing: .14em; text-transform: uppercase; color: var(--text-tertiary, #727b72); }
  .dg__paper-date { font: 800 clamp(34px, 4vw, 52px)/1 var(--font-display); color: var(--green-700); letter-spacing: -.02em; }
  .dg__paper-rule { height: 1px; background: var(--border-default); }
  .dg__paper-text { white-space: pre-line; font-size: 15px; line-height: 1.5; color: var(--text-secondary); text-align: center !important; text-align-last: center !important; }
  .dg__paper-badge { align-self: center; padding: 6px 14px; border-radius: 999px; background: #fbead0; color: #6b4309; font-size: 14px; font-weight: 600; }
  .dg__text { display: flex; flex-direction: column; gap: 14px; }
  .dg__year { font: 800 clamp(56px, 8vw, 112px)/1 var(--font-display); letter-spacing: -.02em; color: var(--green-600); }
  .dg__text h3 { margin: 0; font: 700 clamp(21px, 2vw, 28px)/1.3 var(--font-display); text-wrap: balance; }
  .dg__text p { margin: 0; font-size: var(--fs-body, 16px); line-height: 1.75; color: var(--text-secondary); }
  .dg__text .vh-link { align-self: flex-start; }
  .dg__rail { display: flex; overflow-x: auto; scrollbar-width: none; padding: 8px 0 4px; scroll-snap-type: x proximity; }
  .dg__rail::-webkit-scrollbar { display: none; }
  .dg__rail.is-scrollable { -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 24px, #000 calc(100% - 48px), transparent 100%); mask-image: linear-gradient(90deg, transparent 0, #000 24px, #000 calc(100% - 48px), transparent 100%); }
  .dg__stop { position: relative; flex: 1 0 112px; display: flex; flex-direction: column; align-items: center; gap: 10px; padding: 0 4px; background: none; border: 0; cursor: pointer; font: inherit; color: inherit; scroll-snap-align: center; }
  .dg__stop::before { content: ''; position: absolute; top: 11px; left: 50%; width: 100%; border-top: 2px dotted var(--gray-400); }
  .dg__stop.is-past::before { border-top: 2px solid var(--green-500); }
  .dg__stop:last-child::before { width: 0; }
  .dg__dot { position: relative; z-index: 1; width: 10px; height: 10px; margin: 7px 0; border-radius: 50%; background: var(--gray-700); transition: all var(--motion-base) var(--ease-out); }
  .dg__stop.is-past .dg__dot { background: var(--green-500); }
  .dg__stop[aria-selected='true'] .dg__dot { width: 24px; height: 24px; margin: 0; background: var(--green-500); box-shadow: 0 0 0 6px var(--green-100); }
  .dg__stop--key .dg__dot, .dg__stop--key[aria-selected='true'] .dg__dot { background: var(--brand-highlight); }
  .dg__stop--key[aria-selected='true'] .dg__dot { box-shadow: 0 0 0 6px #fbead0; }
  .dg__label { font: 700 clamp(17px, 1.6vw, 22px)/1.2 var(--font-display); color: var(--text-primary); }
  .dg__stop[aria-selected='true'] .dg__label { color: var(--green-600); }
  .dg__tag { font-size: 13px; line-height: 1.3; color: var(--text-secondary); text-align: center; }
  @media (max-width: 899.98px) {
    .dg__panel { grid-template-columns: minmax(0, 1fr); }
    .dg__media { order: 0; }
    .dg__stage { min-height: 0; }
    .dg__stop { flex-basis: 92px; }
    .dg__year { font-size: 48px; }
    .dg__badge { left: 12px; bottom: 12px; padding: 9px 13px; } .dg__badge strong { font-size: 24px; } .dg__badge span { font-size: 13px; }
  }

  /* Slogan band: one large line, two supporting lines (different from the figures card above). */
  .vh-slogan { position: relative; overflow: hidden; background: radial-gradient(120% 140% at 50% 0%, var(--green-700) 0%, var(--green-800) 55%, var(--green-900) 100%); color: #fff; margin-top: clamp(40px, 5vw, 64px); }
  .vh-slogan__wrap { max-width: var(--wrap, 1280px); margin: 0 auto; padding: clamp(56px, 7vw, 88px) clamp(20px, 4vw, 56px); display: flex; flex-direction: column; align-items: center; text-align: center; gap: 18px; }
  .vh-slogan__label { font: 600 13px/1.4 var(--font-body); letter-spacing: .14em; text-transform: uppercase; color: var(--brand-highlight); }
  .vh-slogan__text { margin: 0; font: 600 clamp(28px, 3.6vw, 48px)/1.2 var(--font-display); letter-spacing: -.01em; text-align: center; text-align-last: center; text-wrap: balance; }
  .vh-slogan__dash { color: rgba(245, 196, 78, .75); }
  .vh-slogan__gold { color: var(--brand-highlight); }
  .vh-slogan__more { margin: 14px 0 0; display: grid; grid-template-columns: repeat(2, minmax(0, auto)); justify-content: center; gap: 16px 0; }
  .vh-slogan__more > div { display: flex; flex-direction: column; gap: 6px; padding: 4px clamp(20px, 3vw, 40px); }
  .vh-slogan__more > div + div { border-left: 1px solid rgba(245, 196, 78, .45); }
  .vh-slogan__more dt { font: 600 12px/1.4 var(--font-body); letter-spacing: .1em; text-transform: uppercase; color: var(--green-100); }
  .vh-slogan__more dd { margin: 0; font: 500 clamp(16px, 1.4vw, 19px)/1.45 var(--font-display); color: #fff; text-align: center; text-align-last: center; }

  /* Origin: text beside a shorter photo, then the five questions across the full width. */
  .vh-origin { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: 32px clamp(32px, 5vw, 64px); align-items: start; }
  .vh-origin :global(.st-head) { max-width: none; }
  .vh-origin__photo { position: relative; aspect-ratio: 4 / 3; }
  .vh-measure { display: flex; flex-direction: column; gap: 18px; padding: clamp(22px, 3vw, 32px); border-radius: var(--radius-xl); background: var(--surface-card); border: 1px solid var(--border-default); }
  .vh-measure__head { display: flex; align-items: baseline; justify-content: space-between; gap: 8px 32px; flex-wrap: wrap; }
  .vh-measure__head strong { font: 600 clamp(22px, 2vw, 26px)/1.3 var(--font-display); color: var(--text-primary); }
  .vh-measure__head span { color: var(--text-secondary); font-size: 16px; text-align: start; }
  .vh-measure__list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(var(--n), minmax(0, 1fr)); gap: 12px; }
  .vh-measure__list li { display: flex; align-items: center; justify-content: center; min-height: 68px; padding: 12px 10px; border-radius: var(--radius-lg);
    background: var(--m-bg, var(--green-800)); color: var(--m-fg, #fff); font: 600 clamp(15px, 1.3vw, 18px)/1.3 var(--font-display); text-align: center; white-space: nowrap; }

  /* The five questions get darker from left to right (lightest "tốt cho mình", darkest "tốt cho tương lai"). */
  .vh-measure__list li:nth-child(1) { --m-bg: #d6f2e1; --m-fg: var(--green-900); }
  .vh-measure__list li:nth-child(2) { --m-bg: #8fd3ab; --m-fg: var(--green-900); }
  .vh-measure__list li:nth-child(3) { --m-bg: #2eae69; }
  .vh-measure__list li:nth-child(4) { --m-bg: #00793f; }
  .vh-measure__list li:nth-child(5) { --m-bg: #02351a; }

  /* Five tâm niệm (Figma): the song video on the left, the five lines on the right with round numbers. */
  .vh-tn { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 32px clamp(40px, 6vw, 88px); align-items: center; }
  .vh-tn__media { position: relative; aspect-ratio: 16 / 9; }
  .vh-tn__list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 18px; }
  .vh-tn__list li { display: grid; grid-template-columns: 44px minmax(0, 1fr); gap: 18px; align-items: center; }
  .vh-tn__num { width: 44px; height: 44px; border-radius: 50%; display: flex; align-items: center; justify-content: center; border: 1px solid rgba(245, 196, 78, .65); color: var(--brand-highlight); font: 600 18px/1 var(--font-display); }
  .vh-tn__list strong { font: 600 clamp(19px, 1.75vw, 24px)/1.35 var(--font-display); color: #fff; text-align: start; }


  /* Family: couples' stories, photo + short text; up to three to a row. */
  .vh-fam { display: grid; grid-template-columns: repeat(var(--fam-cols, 3), minmax(0, 1fr)); gap: 24px; }
  .vh-fam[data-count='1'] { --fam-cols: 1; max-width: 760px; }
  .vh-fam[data-count='2'] { --fam-cols: 2; }
  .vh-fam__read { margin-top: auto; align-self: flex-start; }
  .vh-fam__body { flex: 1; }
  .vh-fam__card { display: flex; flex-direction: column; background: var(--surface-page); border: 1px solid var(--border-default); border-radius: var(--radius-xl); overflow: hidden; }
  .vh-fam__img { position: relative; aspect-ratio: 16 / 9; }
  .vh-fam__body { display: flex; flex-direction: column; gap: 10px; padding: clamp(20px, 2.4vw, 30px); }
  .vh-fam__tag { font: 600 12px/1.4 var(--font-body); letter-spacing: .08em; text-transform: uppercase; color: var(--brand-bright); }
  .vh-fam__body h3 { margin: 0; font: 600 clamp(18px, 1.5vw, 21px)/1.35 var(--font-display); color: var(--green-800); text-wrap: balance; }
  .vh-fam__body p { margin: 0; font-size: 15.5px; line-height: 1.65; color: var(--text-secondary); }
  .vh-fam__more { align-self: flex-start; }

  /* Core values: pick a value on the left, its photo and caption show on the right. */
  .vh-values { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr); gap: 24px clamp(28px, 4vw, 56px); align-items: start; }
  .vh-values__list { display: flex; flex-direction: column; gap: 8px; }
  .vh-values__list button { display: grid; grid-template-columns: 40px minmax(0, 1fr); gap: 14px; align-items: start; width: 100%; padding: 16px 18px; text-align: left; cursor: pointer;
    border: 1px solid var(--border-default); border-radius: var(--radius-lg); background: var(--surface-card); color: var(--text-primary); font: inherit;
    transition: background var(--motion-base), border-color var(--motion-base), box-shadow var(--motion-base); }
  .vh-values__list button:hover { border-color: var(--green-200); }
  .vh-values__list button[aria-selected='true'] { background: var(--green-800); border-color: var(--green-800); color: #fff; box-shadow: var(--shadow-md); }
  .vh-values__num { font: 600 15px/1.6 var(--font-display); color: var(--brand-bright); }
  .vh-values__list button[aria-selected='true'] .vh-values__num { color: var(--brand-highlight); }
  .vh-values__txt { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .vh-values__txt strong { font: 600 18px/1.35 var(--font-display); }
  .vh-values__txt span { font-size: 15px; line-height: 1.55; color: var(--text-secondary); text-align: start; }
  .vh-values__list button[aria-selected='true'] .vh-values__txt span { color: var(--green-100); }
  .vh-values__stage { position: sticky; top: calc(var(--hdr-h, 72px) + 24px); }
  .vh-values__panel { margin: 0; display: flex; flex-direction: column; gap: 14px; }
  .vh-values__panel:not([hidden]) { animation: vh-in 260ms var(--ease-out) both; }
  .vh-values__img { position: relative; aspect-ratio: 4 / 3; border-radius: var(--radius-xl); overflow: hidden; background: var(--surface-sunken); }
  .vh-values__panel figcaption { display: flex; justify-content: space-between; align-items: baseline; gap: 8px 20px; flex-wrap: wrap; padding: 0 4px; }
  .vh-values__panel figcaption span { flex: 1 1 320px; font: 500 16px/1.5 var(--font-display); color: var(--text-primary); text-align: start; }
  .vh-values__panel figcaption a { flex: none; font-weight: 600; color: var(--brand-bright); }
  /* Pinned (scroll-driven, src/scripts/scrolly.ts): compact so the whole block fits on one screen;
     only the selected value shows its text. */
  :global(.scrolly.is-pinned) .st-wrap { padding-block: 0; gap: clamp(16px, 2.6vh, 32px); }
  :global(.scrolly.is-pinned) .vh-values__list { gap: 6px; }
  :global(.scrolly.is-pinned) .vh-values__list button { padding: 12px 16px; }
  :global(.scrolly.is-pinned) .vh-values__list button:not([aria-selected='true']) .vh-values__txt span { display: none; }
  :global(.scrolly.is-pinned) .vh-values__stage { position: static; }
  :global(.scrolly.is-pinned) .vh-values__img { aspect-ratio: auto; height: clamp(240px, calc(100vh - var(--hdr-h, 72px) - 330px), 470px); }
  :global(.scrolly.is-pinned) .vh-trad__item button { padding: 14px 20px; }
  :global(.scrolly.is-pinned) .vh-trad__img { aspect-ratio: auto; height: clamp(240px, calc(100vh - var(--hdr-h, 72px) - 260px), 440px); }
  /* A thin progress line under the section title while pinned. */
  @keyframes vh-in { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }

  /* Traditions: accordion on the left, the photo of the open item on the right (Figma). */
  .vh-trad { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); gap: 24px clamp(28px, 4vw, 56px); align-items: start; }
  .vh-trad__list { display: flex; flex-direction: column; gap: 10px; }
  .vh-trad__item { border: 1px solid rgba(255, 255, 255, .16); border-radius: var(--radius-lg); background: rgba(255, 255, 255, .04); transition: background var(--motion-base), border-color var(--motion-base); }
  .vh-trad__item:has([aria-selected='true']) { background: rgba(255, 255, 255, .08); border-color: rgba(245, 196, 78, .5); }
  .vh-trad__item button { width: 100%; display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 18px 22px; background: none; border: 0; cursor: pointer;
    color: #fff; font: 600 clamp(17px, 1.5vw, 19px)/1.35 var(--font-display); text-align: left; }
  .vh-trad__sign { position: relative; flex: none; width: 14px; height: 14px; }
  .vh-trad__sign::before, .vh-trad__sign::after { content: ''; position: absolute; left: 0; top: 6px; width: 14px; height: 2px; background: var(--brand-highlight); transition: transform var(--motion-base) var(--ease-out); }
  .vh-trad__sign::after { transform: rotate(90deg); }
  .vh-trad__item button[aria-selected='true'] .vh-trad__sign::after { transform: rotate(0deg); }
  .vh-trad__body { padding: 0 22px 20px; }
  .vh-trad__body p { margin: 0; color: var(--green-50); font-size: 16px; line-height: 1.65; }
  .vh-trad__stage { position: relative; }
  .vh-trad__img { position: relative; aspect-ratio: 3 / 2; }
  .vh-trad__img:not([hidden]) { animation: vh-in 260ms var(--ease-out) both; }

  /* Training: short intro, then three news cards. */
  .vh-learn__copy { display: flex; flex-direction: column; gap: 20px; }
  .vh-learn__motto { margin: 0; padding: 16px 20px; border-left: 4px solid var(--brand-highlight); border-radius: 0 var(--radius-md) var(--radius-md) 0; background: var(--surface-card); }
  .vh-learn__motto p { margin: 0; font: 600 17px/1.55 var(--font-display); color: var(--text-primary); }
  .vh-learn__head { display: flex; justify-content: flex-end; margin-bottom: -20px; }
  .vh-learn__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
  .vh-learn__card { display: flex; flex-direction: column; background: var(--surface-card); border: 1px solid var(--border-default); border-radius: var(--radius-lg); overflow: hidden;
    color: var(--text-primary); text-decoration: none; transition: box-shadow var(--motion-base), border-color var(--motion-base); }
  .vh-learn__card:hover { color: var(--text-primary); text-decoration: none; border-color: var(--green-200); box-shadow: var(--shadow-md); }
  .vh-learn__img { position: relative; display: block; aspect-ratio: 16 / 9; background: var(--surface-sunken); }
  .vh-learn__body { display: flex; flex-direction: column; gap: 8px; padding: 18px 20px 20px; }
  .vh-learn__label { font: 600 11.5px/1.4 var(--font-body); letter-spacing: .06em; text-transform: uppercase; color: var(--brand-bright); }
  .vh-learn__body strong { font: 600 18px/1.35 var(--font-display); }
  .vh-learn__text { color: var(--text-secondary); font-size: 15px; line-height: 1.55; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; text-align: start; }
  .vh-link { font-weight: 600; color: var(--brand-bright); }
  .vh-link--light { color: var(--brand-highlight); }
  .vh-link--light:hover { color: #fff; }

  /* Song (Figma): big video card with caption over the photo, three clips on the right. */
  .vh-song__head { display: flex; justify-content: space-between; align-items: flex-end; gap: 16px 32px; flex-wrap: wrap; }
  .vh-song__eyebrow { font: 600 15px/1.4 var(--font-body); color: #fff; }
  .vh-song__title { font-size: clamp(32px, 3.4vw, 50px); }
  .vh-gold { color: var(--brand-highlight); }
  .vh-song__channel-link { font-weight: 600; color: var(--green-300); white-space: nowrap; }
  .vh-song__channel-link:hover { color: #fff; }
  .vh-song { display: grid; grid-template-columns: minmax(0, 2.2fr) minmax(0, 1fr); gap: 20px; align-items: stretch; }
  .vh-song__main { position: relative; aspect-ratio: 16 / 9; text-align: left; border-radius: var(--radius-xl); overflow: hidden; background: var(--green-900); }
  .vh-song__poster { position: absolute; inset: 0; width: 100%; height: 100%; padding: 0; border: 0; background: none; cursor: pointer; color: inherit; font: inherit; text-align: left; }
  .vh-song__poster img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: scale 600ms var(--ease-out); }
  .vh-song__poster:hover img { scale: 1.03; }
  .vh-song__poster:hover .yt__play { transform: scale(1.08); }
  .vh-song__main :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .vh-song--solo { grid-template-columns: minmax(0, 1fr); }
  .vh-song--solo .vh-song__main { aspect-ratio: 21 / 9; }
  .vh-song__main :global(video) { position: absolute; inset: 0; width: 100%; height: 100%; background: #000; }
  .vh-song__shade { position: absolute; inset: 0; background: linear-gradient(0deg, rgba(0, 40, 20, .78) 0%, rgba(0, 40, 20, .2) 45%, rgba(0, 40, 20, 0) 70%); }
  .vh-song__dur { position: absolute; right: 18px; top: 18px; padding: 4px 10px; border-radius: 8px; background: rgba(0, 0, 0, .65); color: #fff; font: 600 13px/1.3 var(--font-body); }
  .vh-song__dur--sm { right: 8px; top: auto; bottom: 8px; padding: 2px 7px; font-size: 11.5px; }
  .vh-song__cap { position: absolute; left: clamp(20px, 4%, 48px); right: 20px; bottom: clamp(20px, 6%, 44px); display: flex; flex-direction: column; gap: 10px; color: #fff; }
  .vh-song__cap span { font: 600 13px/1.4 var(--font-body); letter-spacing: .14em; text-transform: uppercase; }
  .vh-song__cap strong { font: 600 clamp(26px, 3vw, 44px)/1.15 var(--font-display); }
  .vh-song__list { list-style: none; margin: 0; padding: 0; display: grid; grid-auto-rows: 1fr; gap: 16px; }
  button.vh-song__item { width: 100%; font: inherit; text-align: left; cursor: pointer; }
  .vh-song__item { height: 100%; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: 16px; align-items: center; padding: 10px; border-radius: var(--radius-lg);
    border: 1px solid rgba(255, 255, 255, .14); background: rgba(255, 255, 255, .04); color: #fff; text-decoration: none; transition: background var(--motion-base), border-color var(--motion-base); }
  .vh-song__item:hover { background: rgba(255, 255, 255, .09); border-color: rgba(255, 255, 255, .26); color: #fff; text-decoration: none; }
  .vh-song__thumb { position: relative; aspect-ratio: 16 / 10; border-radius: var(--radius-md); overflow: hidden; background: var(--green-900); }
  .vh-song__thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .vh-song__thumb--channel { display: flex; align-items: center; justify-content: center; background: rgba(255, 255, 255, .06); }
  .vh-song__thumb--channel svg { width: 56px; height: 56px; }
  .vh-song__meta { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
  .vh-song__meta span { font: 600 11.5px/1.4 var(--font-body); letter-spacing: .1em; text-transform: uppercase; color: var(--green-100); }
  .vh-song__meta strong { font: 600 clamp(15px, 1.25vw, 18px)/1.4 var(--font-display); text-align: start; }

  /* Gallery mosaic: first photo large, the rest fill a 3-column grid. */
  .vh-gallery { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); grid-auto-rows: 220px; gap: 12px; }
  .vh-gallery > :first-child { grid-column: span 2; grid-row: span 2; }
  .vh-gallery__item { position: relative; min-height: 200px; margin: 0; border-radius: 16px; overflow: hidden; }
