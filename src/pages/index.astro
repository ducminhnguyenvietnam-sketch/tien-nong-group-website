  const editing = (() => {
    if (new URLSearchParams(location.search).has('sua-anh')) return true;
    try { return localStorage.getItem('tn-edit-photos') === '1'; } catch { return false; }
  })();
  if (slider && !editing) {
    // Slides without a photo stay out of the public slider (the photo editor still shows them).
    slider.querySelectorAll<HTMLElement>('[data-empty-slide]').forEach((s) => {
      slider.querySelector(`[data-slide-to="${s.dataset.slide}"]`)?.remove();
      s.remove();
    });
    if (slider.querySelectorAll('.hero-slide').length < 2) slider.querySelectorAll('.hero-arrow, .hero-dots').forEach((e) => e.remove());
  }
  if (slider) {
    const slides = [...slider.querySelectorAll<HTMLElement>('.hero-slide')];
    const dots = [...slider.querySelectorAll<HTMLElement>('[data-slide-to]')];
    let cur = 0, paused = false;
    const show = (k: number) => {
      cur = (k + slides.length) % slides.length;
      slides.forEach((s, i) => { s.classList.toggle('is-active', i === cur); s.setAttribute('aria-hidden', String(i !== cur)); });
      dots.forEach((d, i) => d.setAttribute('aria-selected', String(i === cur)));
    };
    slider.querySelectorAll<HTMLElement>('[data-slide-step]').forEach((b) => b.addEventListener('click', () => show(cur + Number(b.dataset.slideStep))));
    dots.forEach((d) => d.addEventListener('click', () => show(Number(d.dataset.slideTo))));
    slider.addEventListener('mouseenter', () => { paused = true; });
    slider.addEventListener('mouseleave', () => { paused = false; });
    slider.addEventListener('focusin', () => { paused = true; });
    slider.addEventListener('focusout', () => { paused = false; });
    let x0: number | null = null;
    slider.addEventListener('pointerdown', (e) => { if (e.pointerType !== 'mouse') x0 = e.clientX; });
    slider.addEventListener('pointerup', (e) => {
      if (x0 === null || document.documentElement.classList.contains('pe-on')) { x0 = null; return; }
      const dx = e.clientX - x0; x0 = null;
      if (Math.abs(dx) > 50) show(cur + (dx < 0 ? 1 : -1));
    });
    // No autoplay: people read the first message, then choose to see more (arrows, dots, swipe).
    void paused;
  }

  document.getElementById('product-tabs')?.addEventListener('tabs:change', (e) => {
    const v = (e as CustomEvent<string>).detail;
    document.querySelectorAll<HTMLElement>('#san-pham [data-panel]').forEach((p) => { p.hidden = p.dataset.panel !== v; });
  });
</script>
