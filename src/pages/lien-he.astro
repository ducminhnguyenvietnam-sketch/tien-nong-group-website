---
/**
 * Liên hệ. Flow: hero → six contact points, one per need → check a genuine product (QR) and report
 * a problem → find a dealer: the sales director in charge of each province (data shared with
 * Trở thành đối tác) → head office & plants → social channels → request form → company details.
 */
import raw from '../content/pages/lien-he.json';
import partnerRaw from '../content/pages/tro-thanh-doi-tac.json';
import { isFilled, withDefaults } from '../lib/content';
import siteRaw from '../content/site.json';
import Layout from '../layouts/Layout.astro';
import FormFallback from '../components/FormFallback.astro';
import Button from '../components/Button.astro';
import Checkbox from '../components/Checkbox.astro';
import ImageSlot from '../components/ImageSlot.astro';
import Input from '../components/Input.astro';
import Select from '../components/Select.astro';
import Head from '../components/story/Head.astro';
import { url, link } from '../lib/routes';

const c = withDefaults(raw, 'src/content/pages/lien-he.json');
const partner = withDefaults(partnerRaw, 'src/content/pages/tro-thanh-doi-tac.json');
const site = withDefaults(siteRaw, 'src/content/site.json');
const F = 'src/content/pages/lien-he.json';
const co = site.company as Record<string, string>;
const social = Object.entries(site.social as Record<string, string>).filter(([, v]) => isFilled(v));
const SOCIAL: Record<string, string> = { facebook: 'Facebook', youtube: 'YouTube', tiktok: 'TikTok', zalo: 'Zalo OA' };
const fill = 'position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto;display:block';
// Contact values become tap-to-call / tap-to-mail links; a placeholder hotline falls back to the company number.
const value = (v: string) => (isFilled(v) ? v : v.trim() ? co.phone : '');
const contactHref = (v: string) => (v.includes('@') ? `mailto:${v.trim()}` : v.replace(/[^\d+]/g, '').length >= 8 ? `tel:${v.replace(/[^\d+]/g, '')}` : undefined);
// In-page anchors stay as they are; site paths get the deploy base.
const href = (h: string) => (h.startsWith('#') ? h : link(h));
const tel = (phone: string) => phone.replace(/[^\d+]/g, '');
// Icons for the six contact points: leaf (engineers), cart, handshake, briefcase, megaphone, people.
const ROUTE_ICONS = [
  '<path d="M5 19c0-8 5-13 14-14-1 9-6 14-14 14z"/><path d="M5 19l7-7"/>',
  '<circle cx="9" cy="20" r="1.4"/><circle cx="17" cy="20" r="1.4"/><path d="M3 4h2l2.4 11h11L21 7H6.2"/>',
  '<path d="M3 12l4-4 4 3 3-3 7 6"/><path d="M7 16l3 3M10 14l3 3M13 13l3 3"/>',
  '<rect x="3" y="7" width="18" height="13" rx="2"/><path d="M9 7V5h6v2M3 13h18"/>',
  '<path d="M4 10v4h3l7 4V6L7 10z"/><path d="M18 9a4 4 0 0 1 0 6"/>',
  '<circle cx="9" cy="8" r="3"/><path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6"/><path d="M16 4a3 3 0 0 1 0 6M21 20c0-2.6-1.6-4.8-4-5.6"/>',
];
const prettyPhone = (phone: string) => {
  const d = tel(phone);
  return /^0\d{9}$/.test(d) ? `${d.slice(0, 4)} ${d.slice(4, 7)} ${d.slice(7)}` : phone;
};
// Each office/plant card links to Google Maps: the CMS link if set, else a search for the address.
const mapsFor = (address: string, custom?: string | null) =>
  custom?.trim() || `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(address.replace(/ /g, ' '))}`;
---
<Layout title={c.seo.title || undefined} description={c.seo.description || undefined} active="">
<section class="lh-hero">
<div class="lh-hero__wrap">
<nav class="lh-hero__crumbs" aria-label="Đường dẫn"><a href={url('trang-chu')}>{c.hero.t1}</a> <span aria-hidden="true">/</span> <span aria-current="page">{c.hero.t2.replace(/^\s*\/\s*/, '')}</span></nav>
<span class="lh-hero__eyebrow">{c.hero.eyebrow}</span>
<h1>{c.hero.title}</h1>
<p>{[c.hero.lead, c.hero.hours].filter(isFilled).join(' ')}</p>
</div>
</section>
<section class="lh-routes" id="dau-moi" aria-label={c.routes.eyebrow}>
<div class="lh-routes__grid">
{c.routes.items.map((r, k) => {
  const v = value(r.value);
  return (
    <div class="lh-route">
      <span class="lh-route__ic" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={ROUTE_ICONS[k % ROUTE_ICONS.length]} /></span>
      <span class="lh-route__label">{r.label}</span>
      {isFilled(v) && <a class="lh-route__value" href={contactHref(v)}>{v}</a>}
      <span class="lh-route__note jx-start">{r.note}</span>
      {isFilled(r.link) && <a class="lh-route__link" href={href(r.link)}>{r.link_label}</a>}
    </div>
  );
})}
</div>
</section>

<section class="st-sec" id="chinh-hang">
<div class="st-wrap">
<div class="st-split st-split--top">
<div>
<Head eyebrow={c.genuine.eyebrow} title={c.genuine.title} intro={c.genuine.intro} />
<ol class="st-steps" style="--min:140px">{c.genuine.steps.map((s) => <li><strong>{s.title}</strong><span>{s.text}</span></li>)}</ol>
</div>
<div style="background:var(--green-800);color:#fff;border-radius:var(--radius-xl);padding:clamp(24px,3vw,36px);display:flex;flex-direction:column;gap:14px">
<strong style="font:var(--type-h3)">{c.genuine.report_title}</strong>
<p style="margin:0;color:var(--green-100);line-height:1.65">{c.genuine.report_text}</p>
<div class="st-actions">{isFilled(c.genuine.report_phone) && <a href={contactHref(c.genuine.report_phone)} class="st-btn" style="background:#fff;border-color:#fff;color:var(--green-700)">☎ {c.genuine.report_phone}</a>}<a href="#lien-he-form" class="st-btn" style="border-color:rgba(255,255,255,.5);color:#fff">Gửi phản ánh</a></div>
</div>
</div>
</div></section>

<section class="st-sec st-sec--card" id="dai-ly">
<div class="st-wrap">
<Head eyebrow={c.regions.eyebrow} title={c.regions.title} intro={c.regions.intro} split />
<div class="lh-dirs">
{partner.managers.map((m, k) => (
<article class="lh-dir">
<div class="lh-dir__img"><ImageSlot style={fill} id={`dir-${k}`} shape="rect" placeholder={m.image?.alt || m.area || m.region} image={m.image} cms={`src/content/pages/tro-thanh-doi-tac.json#managers.${k}.image`} sizes="(max-width: 899px) 92vw, 400px" /><span class="lh-dir__region">{m.region}</span></div>
<div class="lh-dir__body">
{isFilled(m.area) && <span class="lh-dir__area">{m.area}</span>}
<strong class="lh-dir__name">{m.name}</strong>
<span class="lh-dir__title">{m.title}</span>
<a class="lh-dir__call" href={`tel:${tel(m.phone)}`}><span aria-hidden="true">☎</span><span>{prettyPhone(m.phone)}</span><em>{c.regions.call_label}</em></a>
{Array.isArray(m.provinces) && m.provinces.length > 0 && <div class="lh-dir__prov"><span>{c.regions.provinces_label}</span><ul>{(m.provinces as string[]).map((pv) => <li>{pv}</li>)}</ul></div>}
</div>
</article>
))}
</div>
<a href={url('tro-thanh-doi-tac', 'lien-he-khu-vuc')} class="lh-more">{c.regions.map_label}</a>
</div></section>

<section id="nha-may" class="st-sec">
<div class="st-wrap">
<Head title={c.sites.title} />
<div class="g-stack" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(clamp(calc((100% - 48px)/4),calc((1088px - 100%)*999),calc((100% - 16px)/2)),1fr));gap:16px">
{c.sites.items.map((p, k) => (
<article class="site-card">
<div class:list={['site-card__img', { 'is-empty': !isFilled(p.image?.src) }]}><svg class="site-card__icon" viewBox="0 0 48 48" aria-hidden="true"><path d="M4 42V22l10 6v-6l10 6v-6l10 6V8h8v34z" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round"/><path d="M12 36h4M22 36h4M32 36h4" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg><ImageSlot style={fill} id={`site-${k + 1}`} shape="rect" placeholder={p.image?.alt || p.name} image={p.image} cms={`${F}#sites.items.${k}.image`} sizes="(max-width: 767px) 92vw, 320px" /></div>
<div class="site-card__body"><span class="site-card__tag">{p.tag}</span><strong>{p.name}</strong>{isFilled(p.role) && <span class="site-card__role">{p.role}</span>}<span class="site-card__addr">{p.address}</span><a href={`tel:${tel(p.phone)}`} class="site-card__phone">{p.phone}</a><a href={mapsFor(p.address, p.map)} target="_blank" rel="noopener" class="site-card__map">{c.sites.map_label}</a></div>
</article>
))}
</div>
{isFilled(c.sites.visit_text) && <p class="st-note" style="margin:0">{c.sites.visit_text}</p>}
</div></section>

{social.length > 0 && <section class="st-sec st-sec--dark">
<div class="st-wrap st-wrap--s" style="flex-direction:row;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:20px">
<Head title={c.social.title} intro={c.social.intro} level="h3" />
<div class="st-actions">{social.map(([k, v]) => <a href={link(v)} target="_blank" rel="noopener" class="st-btn">{SOCIAL[k] ?? k}</a>)}</div>
</div></section>}

<section id="lien-he-form" class="st-sec st-sec--card">
<div class="st-wrap st-wrap--narrow" style="max-width:880px">
<Head title={c.form.title} intro={c.form.intro} />
<div style="background:var(--surface-page);border:1px solid var(--border-default);border-radius:var(--radius-xl);padding:clamp(24px,3vw,36px);display:flex;flex-direction:column;gap:16px">
<div id="contact-sent" hidden style="display:flex;flex-direction:column;gap:8px;padding:16px 0"><span style="font:700 13px var(--font-mono);color:var(--green-600)">{c.form.sent_label}</span><strong style="font-size:22px">{c.form.sent_title}</strong><span style="color:var(--text-secondary)">{c.form.sent_before} <span id="need-label">{(c.form.needs as string[])[0]?.toLowerCase()}</span> {c.form.sent_after}</span><button type="button" data-form-again style="align-self:flex-start;background:none;border:0;padding:0;color:var(--green-700);font:600 15px var(--font-body);cursor:pointer">{c.form.again}</button></div>
<FormFallback />
<form id="contact-form" data-lead-form="lien-he" data-sent="contact-sent" style="display:flex;flex-direction:column;gap:16px">
<Select id="contact-need" name="need" label={c.form.need_label} options={(c.form.needs as string[]).map((v) => ({ value: v, label: v }))} />
<div class="g-stack" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(clamp(calc((100% - 42px)/4),calc((922px - 100%)*999),calc((100% - 14px)/2)),1fr));gap:14px">
<Input label={c.form.name_label} name="name" autocomplete="name" required placeholder={c.form.name_ph} />
<Input label={c.form.phone_label} name="phone" type="tel" autocomplete="tel" required placeholder={c.form.phone_ph} />
<Input label={c.form.email_label} name="email" type="email" autocomplete="email" placeholder={c.form.email_ph} />
<Input label={c.form.province_label} name="province" placeholder={c.form.province_ph} />
</div>
<label style="display:flex;flex-direction:column;gap:6px"><span style="font-size:14px;font-weight:500">{c.form.message_label}</span><textarea name="message" rows="4" placeholder={c.form.message_ph} style="padding:10px 14px;border-radius:var(--radius-md);border:1px solid var(--border-default);font:16px var(--font-body);resize:vertical;outline-color:var(--green-500)"></textarea></label>
<Checkbox label={c.form.consent} name="consent" data-consent required />
<Button size="lg" type="submit">{c.form.submit}</Button>
</form>
</div>
<div style="display:flex;flex-direction:column;gap:4px;padding-top:8px;color:var(--text-secondary);font-size:15px">
<strong style="color:var(--text-primary)">{c.legal.title}</strong>
<span>{co.name}</span>
<span>{co.tax_code_label} {co.tax_code}</span>
<span>{co.address} · {co.phone} · {co.email}</span>
</div>
</div></section>
</Layout>

<style>
  /* Hero without a photo (Figma): brand green, title and lead; the six contact cards ride up onto it. */
  .lh-hero { position: relative; overflow: hidden; color: #fff; background: radial-gradient(110% 140% at 85% 0%, #1d7a42 0%, var(--green-800) 50%, var(--green-900) 100%); }
  .lh-hero::after { content: ''; position: absolute; right: -60px; top: -40px; width: 360px; height: 360px; border-radius: 50%; background: radial-gradient(circle, rgba(245, 196, 78, .16), rgba(245, 196, 78, 0) 70%); pointer-events: none; }
  .lh-hero__wrap { position: relative; max-width: 1280px; margin: 0 auto; padding: 28px clamp(20px, 4vw, 56px) 150px; display: flex; flex-direction: column; gap: 16px; }
  .lh-hero__crumbs { font-size: 13px; color: var(--green-100); display: flex; gap: 6px; margin-bottom: clamp(20px, 3vw, 36px); }
  .lh-hero__crumbs a { color: var(--green-100); }
  .lh-hero__eyebrow { display: flex; align-items: center; gap: 14px; font: var(--type-eyebrow); letter-spacing: .1em; color: var(--green-50); }
  .lh-hero__eyebrow::before { content: ''; width: 40px; height: 2px; background: var(--brand-highlight); }
  .lh-hero h1 { margin: 0; font: var(--type-h1); color: #fff; letter-spacing: -.015em; }
  .lh-hero p { margin: 0; max-width: 640px; font-size: var(--fs-lead); line-height: 1.6; color: var(--green-50); text-align: start; }
  .lh-routes { position: relative; z-index: 2; display: flow-root; background: var(--surface-page); }
  .lh-routes__grid { max-width: 1280px; margin: -110px auto 0; padding: 0 clamp(20px, 4vw, 56px); display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
  .lh-route { display: flex; flex-direction: column; gap: 8px; padding: 24px 24px 22px; background: var(--surface-card); border-radius: var(--radius-lg); border-top: 3px solid var(--brand-bright); box-shadow: 0 18px 40px rgba(0, 71, 35, .12), 0 2px 6px rgba(0, 71, 35, .06); }
  .lh-route__ic { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 12px; background: var(--green-50); color: var(--green-700); margin-bottom: 4px; }
  .lh-route__label { font: 700 12px/1.3 var(--font-display); letter-spacing: .1em; color: var(--green-600); }
  .lh-route__value { font: 700 21px/1.3 var(--font-display); color: var(--text-primary); }
  .lh-route__value:hover { color: var(--green-700); }
  .lh-route__note { color: var(--text-secondary); font-size: 15px; line-height: 1.55; }
  .lh-route__link { margin-top: auto; padding-top: 4px; font-weight: 600; font-size: 15px; color: var(--brand-bright); }
  #chinh-hang { padding-top: clamp(56px, 6vw, 88px); }
  /* Sales directors: photo, region, name, a call button and the provinces they look after. */
  .lh-dirs { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 22px; }
  .lh-dir { display: flex; flex-direction: column; background: var(--surface-page); border: 1px solid var(--border-default); border-radius: var(--radius-lg); overflow: hidden; }
  .lh-dir__img { position: relative; aspect-ratio: 16 / 10; }
  .lh-dir__region { position: absolute; left: 16px; top: 16px; padding: 6px 12px; border-radius: 8px; background: var(--brand-highlight); color: var(--green-900); font: 700 12.5px/1 var(--font-display); letter-spacing: .04em; }
  .lh-dir__body { padding: 20px 22px 22px; display: flex; flex-direction: column; gap: 6px; flex: 1; }
  .lh-dir__area { font: 700 11.5px/1.3 var(--font-display); letter-spacing: .08em; text-transform: uppercase; color: var(--green-600); }
  .lh-dir__name { font: 700 21px/1.3 var(--font-display); }
  .lh-dir__title { color: var(--text-secondary); font-size: 15px; }
  .lh-dir__call { margin: 10px 0 4px; display: flex; align-items: center; gap: 10px; padding: 10px 10px 10px 16px; border-radius: 12px; background: var(--green-800); color: #fff; text-decoration: none; font: 700 18px/1 var(--font-display); }
  .lh-dir__call em { margin-left: auto; font-style: normal; font-size: 13px; padding: 8px 12px; border-radius: 8px; background: var(--brand-bright); }
  .lh-dir__call:hover { color: #fff; text-decoration: none; background: var(--green-700); }
  .lh-dir__prov > span { font-size: 13px; font-weight: 600; color: var(--text-tertiary); }
  .lh-dir__prov ul { list-style: none; margin: 6px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .lh-dir__prov li { padding: 4px 10px; border-radius: 999px; background: var(--surface-card); border: 1px solid var(--border-default); font-size: 13px; color: var(--text-secondary); }
  .lh-more { align-self: flex-start; font-weight: 600; color: var(--brand-bright); }
  @media (max-width: 1023.98px) {
    .lh-routes__grid, .lh-dirs { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 639.98px) {
    .lh-routes__grid, .lh-dirs { grid-template-columns: minmax(0, 1fr); }
    .lh-hero__wrap { padding-bottom: 130px; }
  }
  .site-card { display: flex; flex-direction: column; background: var(--surface-card); border: 1px solid var(--border-default); border-radius: var(--radius-lg); overflow: hidden; }
  .site-card__img { position: relative; aspect-ratio: 16 / 10; background: linear-gradient(135deg, var(--green-50), var(--green-100)); }
  /* No photo yet: a soft branded panel for visitors; the photo slot itself shows in the photo editor (?sua-anh). */
  .site-card__icon { position: absolute; left: 50%; top: 50%; width: 56px; height: 56px; transform: translate(-50%, -50%); color: var(--green-500); opacity: .55; }
  .site-card__img:not(.is-empty) .site-card__icon { display: none; }
  html:not(.pe-on) .site-card__img.is-empty :global(.img-slot) { display: none !important; }
  .site-card__body { display: flex; flex-direction: column; gap: 6px; padding: 18px 20px 20px; flex: 1; }
  .site-card__tag { font: var(--type-eyebrow); letter-spacing: .06em; text-transform: uppercase; color: var(--green-600); }
  .site-card strong { font: 700 17px/1.35 var(--font-display); text-wrap: balance; }
  .site-card__role { font-size: 14px; color: var(--text-primary); }
  .site-card__addr { color: var(--text-secondary); font-size: 15px; line-height: 1.5; }
  .site-card__phone { color: var(--text-primary); font-weight: 600; }
  .site-card__map { margin-top: auto; padding-top: 6px; font-weight: 600; font-size: 15px; }
</style>

<script>
  // The "sent" panel names the department matching the chosen need.
  const need = document.getElementById('contact-need') as HTMLSelectElement;
  document.getElementById('contact-form')!.addEventListener('lead:sent', () => {
    document.getElementById('need-label')!.textContent = need.selectedOptions[0].text.toLowerCase();
  });
</script>
