---
import Button from './Button.astro';
import siteRaw from '../content/site.json';
import { withDefaults } from '../lib/content';
import { NAV, asset, link, url } from '../lib/routes';

const site = withDefaults(siteRaw, 'src/content/site.json');

interface Props { active?: string }
const { active = '' } = Astro.props;
const h = site.header;
const navLabels: Record<string, string> = h.nav;
// `active` names the nav item by its built-in label; the shown label comes from the CMS.
const items = NAV.map(([key, slug]) => ({ label: navLabels[slug.replace(/-/g, '_')] || key, href: url(slug), active: key === active }));
---
<header style="position:sticky;top:0;z-index:30;display:block">
<div style="font-family:var(--font-body);background:var(--surface-card);border-bottom:1px solid var(--border-default)">
<div style="background:var(--green-800);color:var(--green-100);font-size:13px">
<div style="max-width:1280px;margin:0 auto;padding:6px clamp(20px,4vw,56px);display:flex;justify-content:flex-end;gap:24px;flex-wrap:wrap">
<a href={url('tuyen-dung')} style="color:var(--green-100);text-decoration:none">{h.top_jobs}</a><a href={url('lien-he', 'dai-ly')} style="color:var(--green-100);text-decoration:none">{h.top_dealers}</a><a href={url('lien-he')} style="color:var(--green-100);text-decoration:none">{h.top_contact}</a><span style="display:flex;gap:6px"><strong style="color:#fff">VI</strong><span>/</span><a href={link(h.english_url)} style="color:var(--green-100);text-decoration:none">EN</a></span>
</div></div>
<div style="max-width:1280px;margin:0 auto;padding:12px clamp(20px,4vw,56px);display:flex;align-items:center;justify-content:space-between;gap:20px">
<a href={url('trang-chu')} style="flex:none;display:block"><img src={asset("assets/logo-full.png")} alt="Tiến Nông" style="height:52px;width:auto;display:block" /></a>
<div class="hdr-wide">
<nav aria-label="Chính" style="flex:1 1 auto;min-width:0;display:flex;justify-content:center;gap:clamp(14px,1.7vw,28px);white-space:nowrap;font-size:15px;font-weight:600">
{items.map((item) => item.active
  ? <a href={item.href} aria-current="page" style="color:var(--green-700);text-decoration:none;padding:8px 0;border-bottom:2px solid var(--green-500)">{item.label}</a>
  : <a href={item.href} style="color:var(--text-primary);text-decoration:none;padding:8px 0;border-bottom:2px solid transparent">{item.label}</a>)}
</nav>
<a href={url('lien-he', 'dai-ly')} style="flex:none;white-space:nowrap;text-decoration:none"><Button as="span">{h.cta}</Button></a>
</div>
<div class="hdr-narrow" style="align-items:center;gap:12px">
<a href={url('lien-he', 'dai-ly')} style="flex:none;white-space:nowrap;text-decoration:none"><Button as="span">{h.cta}</Button></a>
<button type="button" data-menu-toggle aria-expanded="false" aria-controls="hdr-panel" aria-label="Menu" data-open={h.menu_close} data-closed={h.menu_open} style="display:flex;align-items:center;gap:8px;padding:10px 16px;border-radius:var(--radius-md);border:1px solid var(--border-strong);background:var(--surface-card);font:600 15px var(--font-body);color:var(--text-primary);cursor:pointer;white-space:nowrap">{h.menu_open}</button>
</div>
</div>
<nav id="hdr-panel" class="hdr-panel" aria-label="Chính" hidden style="border-top:1px solid var(--border-default);background:var(--surface-card)">
<div style="max-width:1280px;margin:0 auto;padding:8px clamp(20px,4vw,56px) 16px;display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:0 24px">
{items.map((item) => item.active
  ? <a href={item.href} aria-current="page" style="padding:12px 0;border-bottom:1px solid var(--border-default);color:var(--green-700);font-weight:700;text-decoration:none">{item.label}</a>
  : <a href={item.href} style="padding:12px 0;border-bottom:1px solid var(--border-default);color:var(--text-primary);font-weight:600;text-decoration:none">{item.label}</a>)}
</div></nav>
</div>
</header>
<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const panel = document.getElementById('hdr-panel');
  if (toggle && panel) {
    toggle.addEventListener('click', () => {
      const open = panel.hidden;
      panel.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
      toggle.textContent = (open ? toggle.dataset.open : toggle.dataset.closed) ?? '';
    });
  }
</script>
