---
import raw from '../content/pages/nong-dan.json';
import { withDefaults } from '../lib/content';
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import Checkbox from '../components/Checkbox.astro';
import ImageSlot from '../components/ImageSlot.astro';
import Input from '../components/Input.astro';
import Select from '../components/Select.astro';
import { url, link } from '../lib/routes';
import { formatDate, getNews, newsLinkAttrs, newsUrl } from '../lib/news';

const c = withDefaults(raw, 'src/content/pages/nong-dan.json');

// Hội thảo đầu bờ: 2 newest articles in "Nông dân & Mô hình hiệu quả" tagged "hội thảo";
// if fewer are tagged, the rest are filled with the newest articles of that category.
const WORKSHOPS_SHOWN = 2;
const farmerNews = (await getNews()).filter((n) => n.data.category === 'nd');
const isWorkshop = (n: (typeof farmerNews)[number]) => n.data.tags.some((t) => t.trim().toLowerCase().normalize('NFC') === 'hội thảo'.normalize('NFC'));
const workshops = [...farmerNews.filter(isWorkshop), ...farmerNews.filter((n) => !isWorkshop(n))].slice(0, WORKSHOPS_SHOWN);

---
<Layout title={c.seo.title || undefined} description={c.seo.description || undefined} active="Nông dân Tiến Nông">
<section style="position:relative;min-height:min(70vh,600px);background:var(--green-900);display:flex">
<div style="position:absolute;inset:0"><ImageSlot style="position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto;display:block" id="farmer-hero" shape="rect" placeholder="Nông dân và kỹ sư Tiến Nông trên cánh đồng" image={c.s01_hero.img_farmer_hero_1} cms="src/content/pages/nong-dan.json#s01_hero.img_farmer_hero_1" /></div>
<div style="position:absolute;inset:0;pointer-events:none;background:linear-gradient(90deg,rgba(2,53,26,.8) 0%,rgba(2,53,26,.4) 50%,rgba(2,53,26,0) 80%)"></div>
<div style="position:relative;max-width:1280px;width:100%;margin:0 auto;padding:28px clamp(20px,4vw,56px) clamp(56px,7vw,96px);display:flex;flex-direction:column;justify-content:space-between;gap:48px;pointer-events:none;color:#fff">
<span style="font-size:13px;color:var(--green-100)">{c.s01_hero.t1}</span>
<div style="max-width:760px;display:flex;flex-direction:column;gap:20px">
<span style="font:600 13px var(--font-mono);letter-spacing:.12em;color:var(--green-100)">{c.s01_hero.t2}</span>
<h1 style="margin:0;font:800 clamp(34px,4.8vw,60px)/1.08 var(--font-display);letter-spacing:-.015em;text-wrap:balance">{c.s01_hero.t3}</h1>
<p style="margin:0;font-size:19px;line-height:1.55;color:var(--green-50);text-align:justify;text-wrap:pretty">{c.s01_hero.t4}</p>
<div style="display:flex;gap:12px;flex-wrap:wrap;pointer-events:auto"><a href="#dang-ky" style="background:var(--green-500);color:#fff;font-weight:700;padding:13px 22px;border-radius:var(--radius-md)">{c.s01_hero.t5}</a><a href={link(c.s01_hero.link1)} style="background:#fff;color:var(--green-700);font-weight:700;padding:13px 22px;border-radius:var(--radius-md)">{c.s01_hero.t6}</a></div>
</div></div></section>

<section id="dang-ky" style="background:var(--surface-card);scroll-margin-top:120px">
<div style="max-width:1280px;margin:0 auto;padding:clamp(64px,8vw,112px) clamp(20px,4vw,56px);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:40px 72px;align-items:start">
<div style="display:flex;flex-direction:column;gap:20px">
<span style="font:600 13px var(--font-mono);letter-spacing:.12em;color:var(--green-600)">{c.s02_dang_ky.t1}</span>
<h2 style="margin:0;font:800 clamp(30px,3.4vw,44px)/1.15 var(--font-display);letter-spacing:-.01em;text-wrap:balance">{c.s02_dang_ky.t2}</h2>
<p style="margin:0;color:var(--text-secondary);font-size:17px;text-align:justify;text-wrap:pretty">{c.s02_dang_ky.t3}</p>
<div style="display:flex;flex-direction:column;border-top:1px solid var(--border-default)">
<div style="display:flex;gap:14px;padding:14px 0;border-bottom:1px solid var(--border-default)"><span style="color:var(--green-600);font-weight:700">✓</span><span>{c.s02_dang_ky.t4}</span></div>
<div style="display:flex;gap:14px;padding:14px 0;border-bottom:1px solid var(--border-default)"><span style="color:var(--green-600);font-weight:700">✓</span><span>{c.s02_dang_ky.t5}</span></div>
<div style="display:flex;gap:14px;padding:14px 0;border-bottom:1px solid var(--border-default)"><span style="color:var(--green-600);font-weight:700">✓</span><span>{c.s02_dang_ky.t6}</span></div>
<div style="display:flex;gap:14px;padding:14px 0;border-bottom:1px solid var(--border-default)"><span style="color:var(--green-600);font-weight:700">✓</span><span>{c.s02_dang_ky.t7}</span></div>
</div></div>
<div style="background:var(--surface-page);border:1px solid var(--border-default);border-radius:var(--radius-xl);padding:clamp(24px,3vw,36px);display:flex;flex-direction:column;gap:16px">
<div id="reg-sent" hidden style="padding:32px 8px;display:flex;flex-direction:column;gap:10px;align-items:flex-start"><span style="font:700 13px var(--font-mono);color:var(--green-600)">{c.s02_dang_ky.t8}</span><strong style="font-size:22px">{c.s02_dang_ky.t9}</strong><span style="color:var(--text-secondary);text-align:justify">{c.s02_dang_ky.t10}</span><button type="button" data-form-again style="background:none;border:0;padding:0;color:var(--green-700);font:600 15px var(--font-body);cursor:pointer">{c.s02_dang_ky.t11}</button></div>
<form data-lead-form data-sent="reg-sent" style="display:flex;flex-direction:column;gap:14px">
<Input label={c.s02_dang_ky.f1} name="name" autocomplete="name" required placeholder={c.s02_dang_ky.f2} />
<Input label={c.s02_dang_ky.f3} name="phone" type="tel" autocomplete="tel" required placeholder={c.s02_dang_ky.f4} />
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:14px">
<Input label={c.s02_dang_ky.f5} name="province" required placeholder={c.s02_dang_ky.f6} />
<Select label={c.s02_dang_ky.f7} name="crop" options={c.form_crops.map((v) => ({ value: v, label: v }))} />
</div>
<Checkbox label={c.s02_dang_ky.f8} name="consent" data-consent required />
<Button size="lg" type="submit">{c.s02_dang_ky.t12}</Button>
<span style="font-size:14px;color:var(--text-tertiary)">{c.s02_dang_ky.t13}</span>
</form>
</div></div></section>

<section style="background:var(--surface-page)">
<div style="max-width:1280px;margin:0 auto;padding:clamp(64px,8vw,112px) clamp(20px,4vw,56px);display:flex;flex-direction:column;gap:40px">
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:24px 64px;align-items:end">
<div style="display:flex;flex-direction:column;gap:14px"><span style="font:600 13px var(--font-mono);letter-spacing:.12em;color:var(--green-600)">{c.s03_cau_chuyen_nha_nong.t1}</span><h2 style="margin:0;font:800 clamp(30px,3.4vw,44px)/1.15 var(--font-display);letter-spacing:-.01em;text-wrap:balance">{c.s03_cau_chuyen_nha_nong.t2}</h2></div>
<p style="margin:0;color:var(--text-secondary);font-size:17px;text-align:justify;text-wrap:pretty">{c.s03_cau_chuyen_nha_nong.t3}</p>
</div>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,520px),1fr));gap:24px">
<article style="display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.3fr);background:var(--surface-card);border:1px solid var(--border-default);border-radius:var(--radius-lg);overflow:hidden"><div style="position:relative;min-height:300px"><ImageSlot style="position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto;display:block" id="story-1" shape="rect" placeholder="Chân dung nông dân trên ruộng" image={c.s03_cau_chuyen_nha_nong.img_story_1_1} cms="src/content/pages/nong-dan.json#s03_cau_chuyen_nha_nong.img_story_1_1" /></div><div style="padding:24px;display:flex;flex-direction:column;gap:12px"><span style="font:600 12px var(--font-mono);color:var(--green-600)">{c.s03_cau_chuyen_nha_nong.t4}</span><p style="margin:0;font:600 19px/1.45 var(--font-display);text-align:justify">{c.s03_cau_chuyen_nha_nong.t5}</p><div style="display:flex;gap:24px;padding-top:12px;border-top:1px solid var(--border-default);margin-top:auto"><div><div style="font:800 24px var(--font-display);color:var(--amber-600)">{c.s03_cau_chuyen_nha_nong.t6}</div><span style="font:600 12px/1.4 var(--font-body);letter-spacing:.06em;text-transform:uppercase;color:var(--text-secondary)">{c.s03_cau_chuyen_nha_nong.t7}</span></div><div><div style="font:800 24px var(--font-display);color:var(--amber-600)">{c.s03_cau_chuyen_nha_nong.t8}</div><span style="font:600 12px/1.4 var(--font-body);letter-spacing:.06em;text-transform:uppercase;color:var(--text-secondary)">{c.s03_cau_chuyen_nha_nong.t9}</span></div></div><strong style="font-size:15px">{c.s03_cau_chuyen_nha_nong.t10}</strong></div></article>
<article style="display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.3fr);background:var(--surface-card);border:1px solid var(--border-default);border-radius:var(--radius-lg);overflow:hidden"><div style="position:relative;min-height:300px"><ImageSlot style="position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto;display:block" id="story-2" shape="rect" placeholder="Chân dung nông dân vườn cà phê" image={c.s03_cau_chuyen_nha_nong.img_story_2_1} cms="src/content/pages/nong-dan.json#s03_cau_chuyen_nha_nong.img_story_2_1" /></div><div style="padding:24px;display:flex;flex-direction:column;gap:12px"><span style="font:600 12px var(--font-mono);color:var(--green-600)">{c.s03_cau_chuyen_nha_nong.t11}</span><p style="margin:0;font:600 19px/1.45 var(--font-display);text-align:justify">{c.s03_cau_chuyen_nha_nong.t12}</p><div style="display:flex;gap:24px;padding-top:12px;border-top:1px solid var(--border-default);margin-top:auto"><div><div style="font:800 24px var(--font-display);color:var(--amber-600)">{c.s03_cau_chuyen_nha_nong.t13}</div><span style="font:600 12px/1.4 var(--font-body);letter-spacing:.06em;text-transform:uppercase;color:var(--text-secondary)">{c.s03_cau_chuyen_nha_nong.t14}</span></div><div><div style="font:800 24px var(--font-display);color:var(--amber-600)">{c.s03_cau_chuyen_nha_nong.t15}</div><span style="font:600 12px/1.4 var(--font-body);letter-spacing:.06em;text-transform:uppercase;color:var(--text-secondary)">{c.s03_cau_chuyen_nha_nong.t16}</span></div></div><strong style="font-size:15px">{c.s03_cau_chuyen_nha_nong.t17}</strong></div></article>
</div>
<a href={url('tin-tuc')} style="align-self:flex-start;font-weight:600">{c.s03_cau_chuyen_nha_nong.t18}</a>
</div></section>

<section id="hoi-thao" style="background:var(--surface-card)">
<div style="max-width:1280px;margin:0 auto;padding:clamp(56px,7vw,96px) clamp(20px,4vw,56px);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,380px),1fr));gap:32px 64px;align-items:start">
<div style="display:flex;flex-direction:column;gap:14px"><span style="font:600 13px var(--font-mono);letter-spacing:.12em;color:var(--green-600)">{c.s04_hoi_thao_dau_bo.t1}</span><h2 style="margin:0;font:800 clamp(28px,3vw,40px)/1.15 var(--font-display);letter-spacing:-.01em;text-wrap:balance">{c.s04_hoi_thao_dau_bo.t2}</h2><span style="color:var(--text-secondary);text-align:justify">{c.s04_hoi_thao_dau_bo.t3}</span></div>
<div style="display:flex;flex-direction:column;gap:16px">
<div style="display:flex;flex-direction:column;border-top:1px solid var(--border-default)">
{workshops.map((n) => <a href={newsUrl(n)} {...newsLinkAttrs(n)} style="display:grid;grid-template-columns:120px minmax(0,1fr);gap:16px;align-items:center;padding:16px 0;border-bottom:1px solid var(--border-default);color:var(--text-primary)"><div style="position:relative;height:84px"><ImageSlot style="position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto;display:block" id={`news-${n.id}`} shape="rounded" radius="10" placeholder="Ảnh hội thảo" image={n.data.cover} cms={`${n.filePath}#cover`} /></div><div style="display:flex;flex-direction:column;gap:4px"><span style="font-size:13px;color:var(--text-tertiary)">{formatDate(n.data.date)}</span><strong style="line-height:1.4">{n.data.title}</strong></div></a>)}
{workshops.length === 0 && <span style="padding:16px 0;color:var(--text-secondary)">{c.s04_hoi_thao_dau_bo.t5}</span>}
</div>
<a href={url('tin-tuc', 'nd')} style="font-weight:600;font-size:15px">{c.s04_hoi_thao_dau_bo.t4}</a>
</div></div></div></section>

<section style="background:var(--green-800);color:#fff">
<div style="max-width:1280px;margin:0 auto;padding:clamp(64px,8vw,112px) clamp(20px,4vw,56px);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,380px),1fr));gap:40px 72px;align-items:start">
<div style="display:flex;flex-direction:column;gap:16px"><span style="font:600 13px var(--font-mono);letter-spacing:.12em;color:var(--green-200)">{c.s05_hoi_dap.t1}</span><h2 style="margin:0;font:800 clamp(30px,3.4vw,44px)/1.15 var(--font-display);letter-spacing:-.01em;text-wrap:balance">{c.s05_hoi_dap.t2}</h2><span style="color:var(--green-100);text-align:justify">{c.s05_hoi_dap.t3}</span></div>
<div data-accordion style="display:flex;flex-direction:column;border-top:1px solid var(--green-600)">
{c.faq.map((f, k) => (
<div style="border-bottom:1px solid var(--green-700)">
<button type="button" data-acc aria-expanded={k === 0 ? 'true' : 'false'} aria-controls={`faq-${k}`} style="width:100%;display:flex;gap:16px;align-items:baseline;text-align:left;padding:20px 0;border:0;background:none;cursor:pointer;font:600 18px/1.4 var(--font-body);color:#fff"><span style="flex:1">{f.q}</span><span data-acc-sign style="font:400 22px var(--font-body);color:var(--amber-400)">{k === 0 ? '−' : '+'}</span></button>
<p id={`faq-${k}`} hidden={k !== 0} style="margin:0;padding:0 0 22px;color:var(--green-100);text-align:justify;text-wrap:pretty">{f.a}</p>
</div>
))}
</div></div></section>
</Layout>
