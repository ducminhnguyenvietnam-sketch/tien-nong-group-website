---
import c from '../content/pages/ve-tien-nong.json';
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import ImageSlot from '../components/ImageSlot.astro';
import { url } from '../lib/routes';

---
<Layout title={c.seo.title || undefined} description={c.seo.description || undefined} active="Về Tiến Nông">
<section style="background:var(--surface-card)">
<div style="max-width:1280px;margin:0 auto;padding:28px clamp(20px,4vw,56px) 0;display:flex;flex-direction:column;gap:clamp(28px,4vw,48px)">
<span style="font-size:13px;color:var(--text-tertiary)"><a href={url('trang-chu')} style="color:var(--text-tertiary)">{c.s01_hero.t1}</a> {c.s01_hero.t2}</span>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,440px),1fr));gap:24px 64px;align-items:end">
<div style="display:flex;flex-direction:column;gap:16px">
<span style="font:600 13px var(--font-mono);letter-spacing:.12em;color:var(--green-600)">{c.s01_hero.t3}</span>
<h1 style="margin: 0; font: 800 clamp(38px,5vw,64px)/1.08 var(--font-display); letter-spacing: -.015em; max-width:794px;text-wrap:balance">{c.s01_hero.t4}</h1><p style="margin: 0; font-size: 18px; color: var(--text-secondary); text-align: justify; text-wrap: pretty; width: min(739px, 100%); min-height: 90px">{c.s01_hero.t5}</p>
</div>

</div>
<div style="position:relative;height:clamp(280px,40vw,560px)"><ImageSlot style="position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto;display:block" id="about-hero" shape="rounded" radius="24" placeholder="Ảnh tập thể cán bộ, nhân viên trước trụ sở Tiến Nông" image={c.s01_hero.img_about_hero_1} /></div>
</div>
<div style="max-width:1280px;margin:0 auto;padding:40px clamp(20px,4vw,56px) 48px;display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:24px">
<div style="display:flex;flex-direction:column;gap:2px"><span style="font:800 36px/1.1 var(--font-display);color:var(--green-700)">{c.s01_hero.t6}</span><span style="font:600 13px/1.45 var(--font-body);letter-spacing:.06em;text-transform:uppercase;color:var(--text-secondary);margin-top:6px">{c.s01_hero.t7}</span></div>
<div style="display:flex;flex-direction:column;gap:2px"><span style="font:800 36px/1.1 var(--font-display);color:var(--green-700)">{c.s01_hero.t8}</span><span style="font:600 13px/1.45 var(--font-body);letter-spacing:.06em;text-transform:uppercase;color:var(--text-secondary);margin-top:6px">{c.s01_hero.t9}</span></div>
<div style="display:flex;flex-direction:column;gap:2px"><span style="font:800 36px/1.1 var(--font-display);color:var(--green-700)">{c.s01_hero.t10}</span><span style="font:600 13px/1.45 var(--font-body);letter-spacing:.06em;text-transform:uppercase;color:var(--text-secondary);margin-top:6px">{c.s01_hero.t11}</span></div>
<div style="display:flex;flex-direction:column;gap:2px"><span style="font:800 36px/1.1 var(--font-display);color:var(--green-700)">{c.s01_hero.t12}</span><span style="font:600 13px/1.45 var(--font-body);letter-spacing:.06em;text-transform:uppercase;color:var(--text-secondary);margin-top:6px">{c.s01_hero.t13}</span></div>
<div style="display:flex;flex-direction:column;gap:2px"><span style="font:800 36px/1.1 var(--font-display);color:var(--green-700)">{c.s01_hero.t14}</span><span style="font:600 13px/1.45 var(--font-body);letter-spacing:.06em;text-transform:uppercase;color:var(--text-secondary);margin-top:6px">{c.s01_hero.t15}</span></div>
<div style="display:flex;flex-direction:column;gap:2px"><span style="font:800 36px/1.1 var(--font-display);color:var(--green-700)">{c.s01_hero.t16}</span><span style="font:600 13px/1.45 var(--font-body);letter-spacing:.06em;text-transform:uppercase;color:var(--text-secondary);margin-top:6px">{c.s01_hero.t17}</span></div>
</div>
</section>

<nav style="position:sticky;top:108px;z-index:20;background:var(--surface-page);border-top:1px solid var(--border-default);border-bottom:1px solid var(--border-default)">
<div style="max-width:1280px;margin:0 auto;padding:0 clamp(20px,4vw,56px);display:flex;gap:28px;overflow-x:auto;white-space:nowrap;font-size:14px;font-weight:600">
<a href="#thu-ngo" style="color:var(--text-secondary);padding:14px 0">{c.s01_hero.t18}</a><a href="#su-menh" style="color:var(--text-secondary);padding:14px 0">{c.s01_hero.t19}</a><a href="#lich-su" style="color:var(--text-secondary);padding:14px 0">{c.s01_hero.t20}</a><a href="#lanh-dao" style="color:var(--text-secondary);padding:14px 0">{c.s01_hero.t21}</a><a href="#thanh-tuu" style="color:var(--text-secondary);padding:14px 0">{c.s01_hero.t22}</a><a href="#nang-luc" style="color:var(--text-secondary);padding:14px 0">{c.s01_hero.t23}</a><a href="#he-sinh-thai" style="color:var(--text-secondary);padding:14px 0">{c.s01_hero.t24}</a>
</div></nav>

<section id="thu-ngo" style="scroll-margin-top:160px">
<div style="max-width:1280px;margin:0 auto;padding:clamp(64px,8vw,112px) clamp(20px,4vw,56px);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,360px),1fr));gap:48px 80px;align-items:center">
<div style="display:flex;flex-direction:column;gap:16px;max-width:420px">
<div style="position:relative;aspect-ratio:4/5"><ImageSlot style="position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto;display:block" id="ceo-portrait" shape="rounded" radius="20" placeholder="Chân dung Tổng Giám đốc Nguyễn Hồng Phong" image={c.s02_thu_ngo.img_ceo_portrait_1} /></div>
</div>
<div style="display:flex;flex-direction:column;gap:24px">
<span style="font:600 13px var(--font-mono);letter-spacing:.12em;color:var(--green-600)">{c.s02_thu_ngo.t1}</span>
<p style="margin: 0; font: 600 clamp(24px,2.6vw,34px)/1.4 var(--font-display); text-wrap: pretty; text-align: justify">{c.s02_thu_ngo.t2}</p>
<p style="margin:0;color:var(--text-secondary);font-size:17px;text-align:justify;text-wrap:pretty">{c.s02_thu_ngo.t3}</p>
<div style="display:flex;flex-direction:column;padding-top:16px;border-top:1px solid var(--border-default)"><strong style="font-size:17px">{c.s02_thu_ngo.t4}</strong><span style="color:var(--text-secondary)">{c.s02_thu_ngo.t5}</span></div>
</div></div></section>

<section id="su-menh" style="scroll-margin-top:160px;background:var(--green-800);color:#fff">
<div style="max-width:1280px;margin:0 auto;padding:clamp(64px,8vw,112px) clamp(20px,4vw,56px);display:flex;flex-direction:column;gap:56px">
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(clamp(calc((100% - 64px)/3),calc((964px - 100%)*999),100%),1fr));gap:32px">
<div style="display:flex;flex-direction:column;gap:12px"><span style="font:600 13px var(--font-mono);letter-spacing:.12em;color:var(--green-200)">{c.s03_su_menh_gia_tri.t1}</span><span style="font:700 clamp(24px,2.4vw,30px)/1.3 var(--font-display);text-wrap:balance">{c.s03_su_menh_gia_tri.t2}</span></div>
<div style="display:flex;flex-direction:column;gap:12px"><span style="font:600 13px var(--font-mono);letter-spacing:.12em;color:var(--green-200)">{c.s03_su_menh_gia_tri.t3}</span><span style="font:700 clamp(24px,2.4vw,30px)/1.3 var(--font-display);text-wrap:balance">{c.s03_su_menh_gia_tri.t4}</span></div>
<div style="display:flex;flex-direction:column;gap:12px"><span style="font:600 13px var(--font-mono);letter-spacing:.12em;color:var(--green-200)">{c.s03_su_menh_gia_tri.t5}</span><span style="font:700 clamp(24px,2.4vw,30px)/1.3 var(--font-display);text-wrap:balance">{c.s03_su_menh_gia_tri.t6}</span></div>
</div>
<div style="display:flex;flex-direction:column;gap:24px;padding-top:40px;border-top:1px solid var(--green-700)">
<span style="font:600 13px var(--font-mono);letter-spacing:.12em;color:var(--green-200)">{c.s03_su_menh_gia_tri.t7}</span>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(clamp(calc((100% - 48px)/4),calc((1008px - 100%)*999),calc((100% - 16px)/2)),1fr));gap:16px">
<div style="background:var(--green-700);border-radius:var(--radius-lg);padding:24px;display:flex;flex-direction:column;gap:10px"><span style="font:700 14px var(--font-mono);color:var(--amber-400)">{c.s03_su_menh_gia_tri.t8}</span><strong style="font-size:20px">{c.s03_su_menh_gia_tri.t9}</strong><span style="color:var(--green-100);font-size:15px;text-align:justify">{c.s03_su_menh_gia_tri.t10}</span></div>
<div style="background:var(--green-700);border-radius:var(--radius-lg);padding:24px;display:flex;flex-direction:column;gap:10px"><span style="font:700 14px var(--font-mono);color:var(--amber-400)">{c.s03_su_menh_gia_tri.t11}</span><strong style="font-size:20px">{c.s03_su_menh_gia_tri.t12}</strong><span style="color:var(--green-100);font-size:15px">{c.s03_su_menh_gia_tri.t13}</span></div>
<div style="background:var(--green-700);border-radius:var(--radius-lg);padding:24px;display:flex;flex-direction:column;gap:10px"><span style="font:700 14px var(--font-mono);color:var(--amber-400)">{c.s03_su_menh_gia_tri.t14}</span><strong style="font-size:20px">{c.s03_su_menh_gia_tri.t15}</strong><span style="color:var(--green-100);font-size:15px;text-align:justify">{c.s03_su_menh_gia_tri.t16}</span></div>
<div style="background:var(--green-700);border-radius:var(--radius-lg);padding:24px;display:flex;flex-direction:column;gap:10px"><span style="font:700 14px var(--font-mono);color:var(--amber-400)">{c.s03_su_menh_gia_tri.t17}</span><strong style="font-size:20px">{c.s03_su_menh_gia_tri.t18}</strong><span style="color:var(--green-100);font-size:15px">{c.s03_su_menh_gia_tri.t19}</span></div>
</div></div></div></section>

<section id="lich-su" style="scroll-margin-top:160px;background:var(--surface-card)">
<div data-picker style="max-width:1280px;margin:0 auto;padding:clamp(64px,8vw,112px) clamp(20px,4vw,56px);display:flex;flex-direction:column;gap:40px">
<div style="display:flex;justify-content:space-between;align-items:flex-end;gap:24px;flex-wrap:wrap">
<div style="display:flex;flex-direction:column;gap:14px;max-width:640px">
<span style="font:600 13px var(--font-mono);letter-spacing:.12em;color:var(--green-600)">{c.s04_lich_su.t1}</span>
<h2 style="margin:0;font:800 clamp(30px,3.4vw,44px)/1.15 var(--font-display);letter-spacing:-.01em;text-wrap:balance">{c.s04_lich_su.t2}</h2>
</div>
<div style="display:flex;gap:8px"><button type="button" data-pick-step="-1" aria-label="Mốc trước" style="width:44px;height:44px;border-radius:var(--radius-full);border:1px solid var(--border-strong);background:var(--surface-card);font-size:18px;cursor:pointer">←</button><button type="button" data-pick-step="1" aria-label="Mốc sau" style="width:44px;height:44px;border-radius:var(--radius-full);border:1px solid var(--border-strong);background:var(--surface-card);font-size:18px;cursor:pointer">→</button></div>
</div>
<div role="tablist" aria-label="Các mốc lịch sử" style="display:flex;gap:0;overflow-x:auto;border-bottom:1px solid var(--border-default)">
{c.milestones.map((m, k) => <button type="button" role="tab" class="ms-year" data-pick={k} aria-selected={k === 0 ? 'true' : 'false'} style="flex:1 0 110px;padding:14px 8px;background:none;border:0;border-bottom:3px solid transparent;font:700 22px var(--font-display);color:var(--text-tertiary);cursor:pointer">{m.year}</button>)}
</div>
{c.milestones.map((m, k) => (
<div role="tabpanel" data-pick-panel={k} hidden={k !== 0} style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,400px),1fr));gap:32px 56px;align-items:center">
<div style="position:relative;height:360px"><ImageSlot style="position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto;display:block" id={`ms-${k}`} shape="rounded" radius="16" placeholder={m.image.alt} image={m.image} /></div>
<div style="display:flex;flex-direction:column;gap:14px">
<span style="font:800 64px/1 var(--font-display);color:var(--green-200)">{m.year}</span>
<h3 style="margin: 0; font: 700 26px/1.3 var(--font-display); text-wrap: balance; max-width:382px">{m.title}</h3>
<p style="margin:0;color:var(--text-secondary);font-size:17px;text-align:justify;text-wrap:pretty">{m.body}</p>
</div></div>
))}
</div></section>

<section id="lanh-dao" style="scroll-margin-top:160px">
<div style="max-width:1280px;margin:0 auto;padding:clamp(64px,8vw,112px) clamp(20px,4vw,56px);display:flex;flex-direction:column;gap:40px">
<div style="display:flex;flex-direction:column;gap:14px;max-width:640px">
<span style="font:600 13px var(--font-mono);letter-spacing:.12em;color:var(--green-600)">{c.s05_lanh_dao.t1}</span>
<h2 style="margin:0;font:800 clamp(30px,3.4vw,44px)/1.15 var(--font-display);letter-spacing:-.01em">{c.s05_lanh_dao.t2}</h2>
</div>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(clamp(calc((100% - 96px)/5),calc((1000px - 100%)*999),calc((100% - 48px)/3)),1fr));gap:24px">
<div style="display:flex;flex-direction:column;gap:12px"><div style="position:relative;aspect-ratio:4/5"><ImageSlot style="position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto;display:block" id="lead-1" shape="rounded" radius="16" placeholder="Chân dung (nền đồng nhất)" image={c.s05_lanh_dao.img_lead_1_1} /></div><div><strong style="display:block;font-size:17px">{c.s05_lanh_dao.t3}</strong><span style="color:var(--text-secondary);font-size:15px">{c.s05_lanh_dao.t4}</span></div></div>
<div style="display:flex;flex-direction:column;gap:12px"><div style="position:relative;aspect-ratio:4/5"><ImageSlot style="position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto;display:block" id="lead-2" shape="rounded" radius="16" placeholder="Chân dung (nền đồng nhất)" image={c.s05_lanh_dao.img_lead_2_1} /></div><div><strong style="display:block;font-size:17px">{c.s05_lanh_dao.t5}</strong><span style="color:var(--text-secondary);font-size:15px">{c.s05_lanh_dao.t6}</span></div></div>
<div style="display:flex;flex-direction:column;gap:12px"><div style="position:relative;aspect-ratio:4/5"><ImageSlot style="position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto;display:block" id="lead-3" shape="rounded" radius="16" placeholder="Chân dung (nền đồng nhất)" image={c.s05_lanh_dao.img_lead_3_1} /></div><div><strong style="display:block;font-size:17px">{c.s05_lanh_dao.t7}</strong><span style="color:var(--text-secondary);font-size:15px">{c.s05_lanh_dao.t8}</span></div></div>
<div style="display:flex;flex-direction:column;gap:12px"><div style="position:relative;aspect-ratio:4/5"><ImageSlot style="position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto;display:block" id="lead-4" shape="rounded" radius="16" placeholder="Chân dung (nền đồng nhất)" image={c.s05_lanh_dao.img_lead_4_1} /></div><div><strong style="display:block;font-size:17px">{c.s05_lanh_dao.t9}</strong><span style="color:var(--text-secondary);font-size:15px">{c.s05_lanh_dao.t10}</span></div></div>
<div style="display:flex;flex-direction:column;gap:12px"><div style="position:relative;aspect-ratio:4/5"><ImageSlot style="position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto;display:block" id="lead-5" shape="rounded" radius="16" placeholder="Chân dung (nền đồng nhất)" image={c.s05_lanh_dao.img_lead_5_1} /></div><div><strong style="display:block;font-size:17px">{c.s05_lanh_dao.t11}</strong><span style="color:var(--text-secondary);font-size:15px">{c.s05_lanh_dao.t12}</span></div></div>
</div></div></section>

<section id="thanh-tuu" style="scroll-margin-top:160px;background:var(--surface-card)">
<div style="max-width:1280px;margin:0 auto;padding:clamp(64px,8vw,112px) clamp(20px,4vw,56px);display:flex;flex-direction:column;gap:40px">
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:24px 64px;align-items:end">
<div style="display:flex;flex-direction:column;gap:14px">
<span style="font:600 13px var(--font-mono);letter-spacing:.12em;color:var(--green-600)">{c.s06_thanh_tuu.t1}</span>
<h2 style="margin:0;font:800 clamp(30px,3.4vw,44px)/1.15 var(--font-display);letter-spacing:-.01em;text-wrap:balance">{c.s06_thanh_tuu.t2}</h2>
</div>
<p style="margin:0;color:var(--text-secondary);font-size:17px;text-align:justify;text-wrap:pretty">{c.s06_thanh_tuu.t3}</p>
</div>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(clamp(calc((100% - 40px)/3),calc((960px - 100%)*999),100%),1fr));gap:20px">
<div style="grid-column:1/-1;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr));gap:20px">
<div style="background:var(--green-50);border-radius:var(--radius-lg);padding:28px;display:grid;grid-template-columns:96px minmax(0,1fr);gap:20px;align-items:center"><div style="position:relative;height:120px"><ImageSlot style="position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto;display:block" id="award-hc" shape="rounded" radius="12" fit="contain" placeholder="Ảnh Huân chương" image={c.s06_thanh_tuu.img_award_hc_1} /></div><div style="display:flex;flex-direction:column;gap:4px"><span style="font:600 12px var(--font-mono);color:var(--green-700);letter-spacing:.06em">{c.s06_thanh_tuu.t4}</span><strong style="font-size:21px;line-height:1.3">{c.s06_thanh_tuu.t5}</strong><span style="color:var(--text-secondary);font-size:14px">{c.s06_thanh_tuu.t6}</span></div></div>
<div style="background:var(--green-50);border-radius:var(--radius-lg);padding:28px;display:grid;grid-template-columns:96px minmax(0,1fr);gap:20px;align-items:center"><div style="position:relative;height:120px"><ImageSlot style="position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto;display:block" id="award-bk" shape="rounded" radius="12" fit="contain" placeholder="Ảnh Bằng khen" image={c.s06_thanh_tuu.img_award_bk_1} /></div><div style="display:flex;flex-direction:column;gap:4px"><span style="font:600 12px var(--font-mono);color:var(--green-700);letter-spacing:.06em">{c.s06_thanh_tuu.t7}</span><strong style="font-size:21px;line-height:1.3">{c.s06_thanh_tuu.t8}</strong><span style="color:var(--text-secondary);font-size:14px">{c.s06_thanh_tuu.t9}</span></div></div>
</div>
<div style="border:1px solid var(--border-default);border-radius:var(--radius-lg);padding:24px;display:flex;flex-direction:column;gap:14px"><span style="font:600 12px var(--font-mono);color:var(--green-600);letter-spacing:.06em">{c.s06_thanh_tuu.t10}</span>
<div style="display:flex;flex-direction:column;gap:2px;padding-bottom:12px;border-bottom:1px solid var(--border-default)"><strong>{c.s06_thanh_tuu.t11}</strong><span style="font-size:14px;color:var(--text-tertiary)">{c.s06_thanh_tuu.t12}</span></div>
<div style="display:flex;flex-direction:column;gap:2px"><strong>{c.s06_thanh_tuu.t13}</strong><span style="font-size:14px;color:var(--text-tertiary)">{c.s06_thanh_tuu.t14}</span></div></div>
<div style="border:1px solid var(--border-default);border-radius:var(--radius-lg);padding:24px;display:flex;flex-direction:column;gap:14px"><span style="font:600 12px var(--font-mono);color:var(--green-600);letter-spacing:.06em">{c.s06_thanh_tuu.t15}</span>
<div style="display:flex;flex-direction:column;gap:2px;padding-bottom:12px;border-bottom:1px solid var(--border-default)"><strong>{c.s06_thanh_tuu.t16}</strong><span style="font-size:14px;color:var(--text-tertiary)">{c.s06_thanh_tuu.t17}</span></div>
<div style="display:flex;flex-direction:column;gap:2px;padding-bottom:12px;border-bottom:1px solid var(--border-default)"><strong>{c.s06_thanh_tuu.t18}</strong><span style="font-size:14px;color:var(--text-tertiary)">{c.s06_thanh_tuu.t19}</span></div>
<div style="display:flex;flex-direction:column;gap:2px"><strong>{c.s06_thanh_tuu.t20}</strong><span style="font-size:14px;color:var(--text-tertiary)">{c.s06_thanh_tuu.t21}</span></div></div>
<div style="border:1px solid var(--border-default);border-radius:var(--radius-lg);padding:24px;display:flex;flex-direction:column;gap:14px"><span style="font:600 12px var(--font-mono);color:var(--green-600);letter-spacing:.06em">{c.s06_thanh_tuu.t22}</span>
<div style="display:flex;flex-direction:column;gap:2px;padding-bottom:12px;border-bottom:1px solid var(--border-default)"><strong>{c.s06_thanh_tuu.t23}</strong><span style="font-size:14px;color:var(--text-tertiary)">{c.s06_thanh_tuu.t24}</span></div>
<div style="display:flex;flex-direction:column;gap:2px"><strong>{c.s06_thanh_tuu.t25}</strong><span style="font-size:14px;color:var(--text-tertiary)">{c.s06_thanh_tuu.t26}</span></div></div>
</div>
