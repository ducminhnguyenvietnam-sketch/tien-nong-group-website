---
import raw from '../content/pages/giai-phap-du-an.json';
import { withDefaults } from '../lib/content';
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import Checkbox from '../components/Checkbox.astro';
import ImageSlot from '../components/ImageSlot.astro';
import Input from '../components/Input.astro';
import Select from '../components/Select.astro';
import { url } from '../lib/routes';

const c = withDefaults(raw, 'src/content/pages/giai-phap-du-an.json');

---
<Layout title={c.seo.title || undefined} description={c.seo.description || undefined} active="Giải pháp">
<section style="background:var(--surface-card)">
<div style="max-width:1280px;margin:0 auto;padding:28px clamp(20px,4vw,56px) clamp(48px,6vw,80px);display:flex;flex-direction:column;gap:32px">
<span style="font-size:13px;color:var(--text-tertiary)"><a href={url('trang-chu')} style="color:var(--text-tertiary)">{c.s01_hero.t1}</a> / <a href={url('giai-phap')} style="color:var(--text-tertiary)">{c.s01_hero.t2}</a> {c.s01_hero.t3}</span>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,440px),1fr));gap:40px 64px;align-items:center">
<div style="display:flex;flex-direction:column;gap:20px">
<span style="font:var(--type-eyebrow);letter-spacing:.08em;color:var(--green-600)">{c.s01_hero.t4}</span>
<h1 style="margin:0;font:var(--type-h1);letter-spacing:-.015em;text-wrap:balance">{c.s01_hero.t5}</h1>
<p style="margin:0;font-size:var(--fs-lead);color:var(--text-secondary);text-wrap:pretty">{c.s01_hero.t6}</p>
<div style="display:flex;gap:12px;flex-wrap:wrap"><a href="#tu-van" style="background:var(--green-500);color:#fff;font-weight:700;padding:13px 22px;border-radius:var(--radius-md)">{c.s01_hero.t7}</a><a href="#quy-trinh" style="color:var(--green-700);font-weight:700;padding:13px 22px;border-radius:var(--radius-md);border:1px solid var(--border-strong)">{c.s01_hero.t8}</a></div>
</div>
<div style="position:relative;height:clamp(320px,36vw,480px)"><ImageSlot style="position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto;display:block" id="proj-hero" shape="rounded" radius="24" placeholder="Thảm cỏ sân golf / cảnh quan khu đô thị" image={c.s01_hero.img_proj_hero_1} cms="src/content/pages/giai-phap-du-an.json#s01_hero.img_proj_hero_1" /></div>
</div></div></section>

<section style="background:var(--surface-page)">
<div style="max-width:1280px;margin:0 auto;padding:clamp(64px,8vw,112px) clamp(20px,4vw,56px);display:flex;flex-direction:column;gap:40px">
<div style="display:flex;flex-direction:column;gap:14px;max-width:680px"><span style="font:var(--type-eyebrow);letter-spacing:.08em;color:var(--green-600)">{c.s02_nhom_khach_hang.t1}</span><h2 style="margin:0;font:var(--type-h2);letter-spacing:-.01em;text-wrap:balance">{c.s02_nhom_khach_hang.t2}</h2></div>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(clamp(calc((100% - 60px)/4),calc((2140px - 100%)*999),calc((100% - 20px)/2)),1fr));gap:20px">
<div style="display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.2fr);background:var(--surface-card);border:1px solid var(--border-default);border-radius:var(--radius-lg);overflow:hidden"><div style="position:relative;min-height:240px"><ImageSlot style="position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto;display:block" id="seg-1" shape="rect" placeholder="Sân golf" image={c.s02_nhom_khach_hang.img_seg_1_1} cms="src/content/pages/giai-phap-du-an.json#s02_nhom_khach_hang.img_seg_1_1" /></div><div style="padding:24px;display:flex;flex-direction:column;gap:10px"><strong style="font-size:20px">{c.s02_nhom_khach_hang.t3}</strong><span style="color:var(--text-secondary);font-size:15px">{c.s02_nhom_khach_hang.t4}</span><span style="font-size:14px;color:var(--text-tertiary)">{c.s02_nhom_khach_hang.t5}</span></div></div>
<div style="display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.2fr);background:var(--surface-card);border:1px solid var(--border-default);border-radius:var(--radius-lg);overflow:hidden"><div style="position:relative;min-height:240px"><ImageSlot style="position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto;display:block" id="seg-2" shape="rect" placeholder="Cảnh quan khu đô thị" image={c.s02_nhom_khach_hang.img_seg_2_1} cms="src/content/pages/giai-phap-du-an.json#s02_nhom_khach_hang.img_seg_2_1" /></div><div style="padding:24px;display:flex;flex-direction:column;gap:10px"><strong style="font-size:20px">{c.s02_nhom_khach_hang.t6}</strong><span style="color:var(--text-secondary);font-size:15px">{c.s02_nhom_khach_hang.t7}</span><span style="font-size:14px;color:var(--text-tertiary)">{c.s02_nhom_khach_hang.t8}</span></div></div>
<div style="display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.2fr);background:var(--surface-card);border:1px solid var(--border-default);border-radius:var(--radius-lg);overflow:hidden"><div style="position:relative;min-height:240px"><ImageSlot style="position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto;display:block" id="seg-3" shape="rect" placeholder="Cây xanh khu công nghiệp" image={c.s02_nhom_khach_hang.img_seg_3_1} cms="src/content/pages/giai-phap-du-an.json#s02_nhom_khach_hang.img_seg_3_1" /></div><div style="padding:24px;display:flex;flex-direction:column;gap:10px"><strong style="font-size:20px">{c.s02_nhom_khach_hang.t9}</strong><span style="color:var(--text-secondary);font-size:15px">{c.s02_nhom_khach_hang.t10}</span><span style="font-size:14px;color:var(--text-tertiary)">{c.s02_nhom_khach_hang.t11}</span></div></div>
<div style="display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.2fr);background:var(--surface-card);border:1px solid var(--border-default);border-radius:var(--radius-lg);overflow:hidden"><div style="position:relative;min-height:240px"><ImageSlot style="position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto;display:block" id="seg-4" shape="rect" placeholder="Nhà kính công nghệ cao" image={c.s02_nhom_khach_hang.img_seg_4_1} cms="src/content/pages/giai-phap-du-an.json#s02_nhom_khach_hang.img_seg_4_1" /></div><div style="padding:24px;display:flex;flex-direction:column;gap:10px"><strong style="font-size:20px">{c.s02_nhom_khach_hang.t12}</strong><span style="color:var(--text-secondary);font-size:15px">{c.s02_nhom_khach_hang.t13}</span><span style="font-size:14px;color:var(--text-tertiary)">{c.s02_nhom_khach_hang.t14}</span></div></div>
</div></div></section>

<section id="quy-trinh" style="background:var(--green-800);color:#fff;scroll-margin-top:120px">
<div style="max-width:1280px;margin:0 auto;padding:clamp(64px,8vw,112px) clamp(20px,4vw,56px);display:flex;flex-direction:column;gap:48px">
<div style="display:flex;flex-direction:column;gap:14px;max-width:700px"><span style="font:var(--type-eyebrow);letter-spacing:.08em;color:var(--green-200)">{c.s03_quy_trinh.t1}</span><h2 style="margin:0;font:var(--type-h2);letter-spacing:-.01em;text-wrap:balance">{c.s03_quy_trinh.t2}</h2></div>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(clamp(calc((100% - 64px)/5),calc((1000px - 100%)*999),100%),1fr));gap:16px">
<div style="background:var(--green-700);border-radius:var(--radius-lg);padding:24px;display:flex;flex-direction:column;gap:10px"><span style="font:var(--type-stat);color:var(--amber-400);overflow-wrap:normal;font-variant-numeric:tabular-nums">{c.s03_quy_trinh.t3}</span><strong style="font-size:18px">{c.s03_quy_trinh.t4}</strong><span style="color:var(--green-100);font-size:15px">{c.s03_quy_trinh.t5}</span></div>
<div style="background:var(--green-700);border-radius:var(--radius-lg);padding:24px;display:flex;flex-direction:column;gap:10px"><span style="font:var(--type-stat);color:var(--amber-400);overflow-wrap:normal;font-variant-numeric:tabular-nums">{c.s03_quy_trinh.t6}</span><strong style="font-size:18px">{c.s03_quy_trinh.t7}</strong><span style="color:var(--green-100);font-size:15px">{c.s03_quy_trinh.t8}</span></div>
<div style="background:var(--green-700);border-radius:var(--radius-lg);padding:24px;display:flex;flex-direction:column;gap:10px"><span style="font:var(--type-stat);color:var(--amber-400);overflow-wrap:normal;font-variant-numeric:tabular-nums">{c.s03_quy_trinh.t9}</span><strong style="font-size:18px">{c.s03_quy_trinh.t10}</strong><span style="color:var(--green-100);font-size:15px">{c.s03_quy_trinh.t11}</span></div>
<div style="background:var(--green-700);border-radius:var(--radius-lg);padding:24px;display:flex;flex-direction:column;gap:10px"><span style="font:var(--type-stat);color:var(--amber-400);overflow-wrap:normal;font-variant-numeric:tabular-nums">{c.s03_quy_trinh.t12}</span><strong style="font-size:18px">{c.s03_quy_trinh.t13}</strong><span style="color:var(--green-100);font-size:15px">{c.s03_quy_trinh.t14}</span></div>
<div style="background:var(--green-700);border-radius:var(--radius-lg);padding:24px;display:flex;flex-direction:column;gap:10px"><span style="font:var(--type-stat);color:var(--amber-400);overflow-wrap:normal;font-variant-numeric:tabular-nums">{c.s03_quy_trinh.t15}</span><strong style="font-size:18px">{c.s03_quy_trinh.t16}</strong><span style="color:var(--green-100);font-size:15px">{c.s03_quy_trinh.t17}</span></div>
</div></div></section>

<section style="background:var(--surface-card)">
<div style="max-width:1280px;margin:0 auto;padding:clamp(64px,8vw,112px) clamp(20px,4vw,56px);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:40px 72px;align-items:center">
<div style="display:flex;flex-direction:column;gap:16px">
<span style="font:var(--type-eyebrow);letter-spacing:.08em;color:var(--green-600)">{c.s04_nang_luc.t1}</span>
<h2 style="margin:0;font:var(--type-h2);letter-spacing:-.01em;text-wrap:balance">{c.s04_nang_luc.t2}</h2>
<p style="margin:0;color:var(--text-secondary);font-size:var(--fs-body);text-wrap:pretty">{c.s04_nang_luc.t3}</p>
</div>
<div style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px">
<div style="border-top:2px solid var(--green-500);padding-top:14px;display:flex;flex-direction:column;gap:4px"><strong style="font-size:18px">{c.s04_nang_luc.t4}</strong><span style="color:var(--text-secondary);font-size:15px">{c.s04_nang_luc.t5}</span></div>
<div style="border-top:2px solid var(--green-500);padding-top:14px;display:flex;flex-direction:column;gap:4px"><strong style="font-size:18px">{c.s04_nang_luc.t6}</strong><span style="color:var(--text-secondary);font-size:15px">{c.s04_nang_luc.t7}</span></div>
<div style="border-top:2px solid var(--green-500);padding-top:14px;display:flex;flex-direction:column;gap:4px"><strong style="font-size:18px">{c.s04_nang_luc.t8}</strong><span style="color:var(--text-secondary);font-size:15px">{c.s04_nang_luc.t9}</span></div>
<div style="border-top:2px solid var(--green-500);padding-top:14px;display:flex;flex-direction:column;gap:4px"><strong style="font-size:18px">{c.s04_nang_luc.t10}</strong><span style="color:var(--text-secondary);font-size:15px">{c.s04_nang_luc.t11}</span></div>
</div></div></section>

<section id="tu-van" style="background:var(--surface-page);scroll-margin-top:120px">
<div style="max-width:1280px;margin:0 auto;padding:clamp(64px,8vw,112px) clamp(20px,4vw,56px);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:40px 64px;align-items:start">
<div style="display:flex;flex-direction:column;gap:20px">
<span style="font:var(--type-eyebrow);letter-spacing:.08em;color:var(--green-600)">{c.s05_yeu_cau_tu_van.t1}</span>
<h2 style="margin:0;font:var(--type-h2);letter-spacing:-.01em;text-wrap:balance">{c.s05_yeu_cau_tu_van.t2}</h2>
<p style="margin:0;color:var(--text-secondary);font-size:var(--fs-body);text-wrap:pretty">{c.s05_yeu_cau_tu_van.t3}</p>
<div style="display:flex;flex-direction:column;gap:4px;padding-top:16px;border-top:1px solid var(--border-default)"><span style="font-size:14px;color:var(--text-tertiary)">{c.s05_yeu_cau_tu_van.t4}</span><strong style="font-size:18px">{c.s05_yeu_cau_tu_van.t5}</strong><span>{c.s05_yeu_cau_tu_van.t6}</span></div>
</div>
<div style="background:var(--surface-card);border:1px solid var(--border-default);border-radius:var(--radius-xl);padding:clamp(24px,3vw,36px);display:flex;flex-direction:column;gap:16px">
<div id="project-sent" hidden style="display:flex;flex-direction:column;gap:8px;padding:16px 0"><span style="font:700 13px var(--font-mono);color:var(--green-600)">{c.s05_yeu_cau_tu_van.t7}</span><strong style="font-size:22px">{c.s05_yeu_cau_tu_van.t8}</strong><span style="color:var(--text-secondary)">{c.s05_yeu_cau_tu_van.t9}</span><button type="button" data-form-again style="align-self:flex-start;background:none;border:0;padding:0;color:var(--green-700);font:600 15px var(--font-body);cursor:pointer">{c.s05_yeu_cau_tu_van.t10}</button></div>
<form data-lead-form data-sent="project-sent" style="display:flex;flex-direction:column;gap:16px">
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:14px">
<Input label={c.s05_yeu_cau_tu_van.f1} name="name" autocomplete="name" required placeholder={c.s05_yeu_cau_tu_van.f2} />
<Input label={c.s05_yeu_cau_tu_van.f3} name="company" autocomplete="organization" required placeholder={c.s05_yeu_cau_tu_van.f4} />
<Input label={c.s05_yeu_cau_tu_van.f5} name="phone" type="tel" autocomplete="tel" required placeholder={c.s05_yeu_cau_tu_van.f6} />
<Input label={c.s05_yeu_cau_tu_van.f7} name="email" type="email" autocomplete="email" placeholder={c.s05_yeu_cau_tu_van.f8} />
<Select label={c.s05_yeu_cau_tu_van.f9} name="type" options={c.project_types.map((v) => ({ value: v, label: v }))} />
<Input label={c.s05_yeu_cau_tu_van.f10} name="area" inputmode="decimal" placeholder={c.s05_yeu_cau_tu_van.f11} />
</div>
<Input label={c.s05_yeu_cau_tu_van.f12} name="location" placeholder={c.s05_yeu_cau_tu_van.f13} />
<Checkbox label={c.s05_yeu_cau_tu_van.f14} name="consent" data-consent required />
<Button size="lg" type="submit">{c.s05_yeu_cau_tu_van.t11}</Button>
</form>
</div></div></section>
</Layout>
