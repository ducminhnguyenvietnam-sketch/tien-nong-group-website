---
import raw from '../content/pages/lien-he.json';
import { withDefaults } from '../lib/content';
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import Checkbox from '../components/Checkbox.astro';
import ImageSlot from '../components/ImageSlot.astro';
import Input from '../components/Input.astro';
import Select from '../components/Select.astro';
import { url, link } from '../lib/routes';

const c = withDefaults(raw, 'src/content/pages/lien-he.json');

// Each office/plant card links to Google Maps: the CMS link if set, else a search for the address.
const f = c.s03_van_phong_nha_may;
const mapsFor = (address: string, custom?: string | null) =>
  custom?.trim() || `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(address.replace(/\u00a0/g, " "))}`;
const sites = [
  [f.t2, f.t3, f.t4, f.map1], [f.t5, f.t6, f.t7, f.map2], [f.t8, f.t9, f.t10, f.map3], [f.t11, f.t12, f.t13, f.map4],
].map(([name, address, phone, map]) => ({ name, address, phone, map: mapsFor(address ?? '', map) }));

---
<Layout title={c.seo.title || undefined} description={c.seo.description || undefined} active="">
<section style="background:var(--surface-card)">
<div style="max-width:1280px;margin:0 auto;padding:28px clamp(20px,4vw,56px) clamp(48px,6vw,80px);display:flex;flex-direction:column;gap:32px">
<span style="font-size:13px;color:var(--text-tertiary)"><a href={url('trang-chu')} style="color:var(--text-tertiary)">{c.s01_lien_he.t1}</a> {c.s01_lien_he.t2}</span>
<div style="display:flex;flex-direction:column;gap:14px;max-width:760px"><span style="font:var(--type-eyebrow);letter-spacing:.08em;color:var(--green-600)">{c.s01_lien_he.t3}</span><h1 style="margin:0;font:var(--type-h1);letter-spacing:-.015em;text-wrap:balance">{c.s01_lien_he.t4}</h1></div>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(clamp(calc((100% - 48px)/4),calc((1008px - 100%)*999),calc((100% - 16px)/2)),1fr));gap:16px">
<div style="background:var(--surface-page);border:1px solid var(--border-default);border-radius:var(--radius-lg);padding:22px;display:flex;flex-direction:column;gap:6px"><span style="font:var(--type-eyebrow);color:var(--green-600);letter-spacing:.06em">{c.s01_lien_he.t5}</span><strong style="font-size:20px">{c.s01_lien_he.t6}</strong><span style="color:var(--text-secondary);font-size:15px">{c.s01_lien_he.t7}</span></div>
<div style="background:var(--surface-page);border:1px solid var(--border-default);border-radius:var(--radius-lg);padding:22px;display:flex;flex-direction:column;gap:6px"><span style="font:var(--type-eyebrow);color:var(--green-600);letter-spacing:.06em">{c.s01_lien_he.t8}</span><strong style="font-size:20px">{c.s01_lien_he.t9}</strong><span style="color:var(--text-secondary);font-size:15px">{c.s01_lien_he.t10}</span></div>
<div style="background:var(--surface-page);border:1px solid var(--border-default);border-radius:var(--radius-lg);padding:22px;display:flex;flex-direction:column;gap:6px"><span style="font:var(--type-eyebrow);color:var(--green-600);letter-spacing:.06em">{c.s01_lien_he.t11}</span><strong style="font-size:20px">{c.s01_lien_he.t12}</strong><span style="color:var(--text-secondary);font-size:15px">{c.s01_lien_he.t13}</span></div>
<div style="background:var(--surface-page);border:1px solid var(--border-default);border-radius:var(--radius-lg);padding:22px;display:flex;flex-direction:column;gap:6px"><span style="font:var(--type-eyebrow);color:var(--green-600);letter-spacing:.06em">{c.s01_lien_he.t14}</span><strong style="font-size:20px">{c.s01_lien_he.t15}</strong><span style="color:var(--text-secondary);font-size:15px">{c.s01_lien_he.t16}</span></div>
</div></div></section>

<section id="dai-ly" style="background:var(--surface-page);scroll-margin-top:120px">
<div style="max-width:1280px;margin:0 auto;padding:clamp(64px,8vw,104px) clamp(20px,4vw,56px);display:flex;flex-direction:column;gap:28px">
<div style="display:flex;flex-direction:column;gap:14px;max-width:680px"><span style="font:var(--type-eyebrow);letter-spacing:.08em;color:var(--green-600)">{c.s02_tim_dai_ly.t1}</span><h2 style="margin:0;font:var(--type-h2);letter-spacing:-.01em;text-wrap:balance">{c.s02_tim_dai_ly.t2}</h2></div>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,380px),1fr));gap:24px;align-items:stretch">
<div style="display:flex;flex-direction:column;gap:16px">
<Select id="dealer-prov" label={c.s02_tim_dai_ly.f1} options={c.provinces.map((p, i) => ({ value: String(i), label: p.name }))} />
<span style="font-size:14px;color:var(--text-secondary)"><strong id="dealer-count" style="color:var(--text-primary)">{c.provinces[0]?.dealers.length ?? 0}</strong> {c.s02_tim_dai_ly.t3} <span id="dealer-prov-name">{c.provinces[0]?.name}</span></span>
<div style="display:flex;flex-direction:column;background:var(--surface-card);border:1px solid var(--border-default);border-radius:var(--radius-lg);overflow:hidden;max-height:420px;overflow-y:auto">
{c.provinces.flatMap((p, pi) => p.dealers.map((d) => (
<div data-prov={pi} hidden={pi !== 0} style="display:flex;flex-direction:column;gap:4px;padding:16px 20px;border-bottom:1px solid var(--border-default)"><div style="display:flex;justify-content:space-between;gap:12px;align-items:baseline"><strong>{d.name}</strong><span style="font:600 11px var(--font-mono);color:var(--green-700);background:var(--green-50);padding:2px 8px;border-radius:var(--radius-full)">{d.type}</span></div><span style="font-size:14px;color:var(--text-secondary)">{d.address}</span><a href={link(d.map)} style="font-size:14px;font-weight:600">{d.phone} · Chỉ đường</a></div>
)))}
</div>
<span style="font-size:13px;color:var(--text-tertiary)">{c.s02_tim_dai_ly.t4}</span>
</div>
<div style="position:relative;min-height:420px"><ImageSlot style="position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto;display:block" id="dealer-map" shape="rounded" radius="16" placeholder="Bản đồ đại lý (Google Maps nhúng)" image={c.s02_tim_dai_ly.img_dealer_map_1} cms="src/content/pages/lien-he.json#s02_tim_dai_ly.img_dealer_map_1" /></div>
</div>
<div style="display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap;padding:22px 24px;background:var(--green-800);color:#fff;border-radius:var(--radius-lg)"><div><strong style="font-size:19px;display:block">{c.s02_tim_dai_ly.t5}</strong><span style="color:var(--green-100)">{c.s02_tim_dai_ly.t6}</span></div><a href="#lien-he-form" style="background:#fff;color:var(--green-700);font-weight:700;padding:12px 20px;border-radius:var(--radius-md)">{c.s02_tim_dai_ly.t7}</a></div>
</div></section>

<section id="nha-may" style="background:var(--surface-card);scroll-margin-top:120px">
<div style="max-width:1280px;margin:0 auto;padding:clamp(56px,7vw,96px) clamp(20px,4vw,56px);display:flex;flex-direction:column;gap:28px">
<h2 style="margin:0;font:var(--type-h2)">{c.s03_van_phong_nha_may.t1}</h2>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(clamp(calc((100% - 48px)/4),calc((1088px - 100%)*999),calc((100% - 16px)/2)),1fr));gap:16px">
{sites.map((p, k) => (
<div style={`border-top:3px solid ${k === 0 ? 'var(--green-500)' : 'var(--border-strong)'};padding-top:16px;display:flex;flex-direction:column;gap:4px`}><strong style="font-size:18px">{p.name}</strong><span style="color:var(--text-secondary)">{p.address}</span><span>{p.phone}</span><a href={p.map} target="_blank" rel="noopener" style="margin-top:6px;font-weight:600;font-size:15px">{c.s03_van_phong_nha_may.map_label}</a></div>
))}
</div></div></section>

<section id="lien-he-form" style="background:var(--surface-page);scroll-margin-top:120px">
<div style="max-width:880px;margin:0 auto;padding:clamp(56px,7vw,96px) clamp(20px,4vw,56px);display:flex;flex-direction:column;gap:24px">
<div style="display:flex;flex-direction:column;gap:12px"><h2 style="margin:0;font:var(--type-h2)">{c.s04_gui_lien_he.t1}</h2><span style="color:var(--text-secondary)">{c.s04_gui_lien_he.t2}</span></div>
<div style="background:var(--surface-card);border:1px solid var(--border-default);border-radius:var(--radius-xl);padding:clamp(24px,3vw,36px);display:flex;flex-direction:column;gap:16px">
<div id="contact-sent" hidden style="display:flex;flex-direction:column;gap:8px;padding:16px 0"><span style="font:700 13px var(--font-mono);color:var(--green-600)">{c.s04_gui_lien_he.t3}</span><strong style="font-size:22px">{c.s04_gui_lien_he.t4}</strong><span style="color:var(--text-secondary)">{c.s04_gui_lien_he.t5} <span id="need-label">{c.needs[0]?.toLowerCase()}</span> {c.s04_gui_lien_he.t6}</span><button type="button" data-form-again style="align-self:flex-start;background:none;border:0;padding:0;color:var(--green-700);font:600 15px var(--font-body);cursor:pointer">{c.s04_gui_lien_he.t7}</button></div>
<form id="contact-form" data-lead-form data-sent="contact-sent" style="display:flex;flex-direction:column;gap:16px">
<Select id="contact-need" name="need" label={c.s04_gui_lien_he.f1} options={c.needs.map((v) => ({ value: v, label: v }))} />
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(clamp(calc((100% - 42px)/4),calc((922px - 100%)*999),calc((100% - 14px)/2)),1fr));gap:14px">
<Input label={c.s04_gui_lien_he.f2} name="name" autocomplete="name" required placeholder={c.s04_gui_lien_he.f3} />
<Input label={c.s04_gui_lien_he.f4} name="phone" type="tel" autocomplete="tel" required placeholder={c.s04_gui_lien_he.f5} />
<Input label={c.s04_gui_lien_he.f6} name="email" type="email" autocomplete="email" placeholder={c.s04_gui_lien_he.f7} />
<Input label={c.s04_gui_lien_he.f8} name="province" placeholder={c.s04_gui_lien_he.f9} />
</div>
<label style="display:flex;flex-direction:column;gap:6px"><span style="font-size:14px;font-weight:500">{c.s04_gui_lien_he.t8}</span><textarea name="message" rows="4" placeholder={c.s04_gui_lien_he.f10} style="padding:10px 14px;border-radius:var(--radius-md);border:1px solid var(--border-default);font:16px var(--font-body);resize:vertical;outline-color:var(--green-500)"></textarea></label>
<Checkbox label={c.s04_gui_lien_he.f11} name="consent" data-consent required />
<Button size="lg" type="submit">{c.s04_gui_lien_he.t9}</Button>
</form>
</div></div></section>
</Layout>

<script>
  const prov = document.getElementById('dealer-prov') as HTMLSelectElement;
  prov.addEventListener('change', () => {
    const rows = [...document.querySelectorAll<HTMLElement>('[data-prov]')];
    rows.forEach((r) => { r.hidden = r.dataset.prov !== prov.value; });
    document.getElementById('dealer-count')!.textContent = String(rows.filter((r) => !r.hidden).length);
    document.getElementById('dealer-prov-name')!.textContent = prov.selectedOptions[0].text;
  });

  // The "sent" panel names the department matching the chosen need.
  const need = document.getElementById('contact-need') as HTMLSelectElement;
  document.getElementById('contact-form')!.addEventListener('lead:sent', () => {
    document.getElementById('need-label')!.textContent = need.selectedOptions[0].text.toLowerCase();
  });
</script>
