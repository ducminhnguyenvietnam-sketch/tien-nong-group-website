---
import site from '../content/site.json';
import { asset, link, url } from '../lib/routes';

const { company: co, social, legal, footer: f } = site;
---
<footer style="font-family:var(--font-body);background:var(--gray-900);color:var(--gray-300);font-size:14px;line-height:1.6">
<div style="max-width:1280px;margin:0 auto;padding:64px clamp(20px,4vw,56px) 28px;display:flex;flex-direction:column;gap:40px">
<div style="display:flex;flex-wrap:wrap;gap:32px 40px">
<div style="flex:1.6 1 260px;min-width:0;display:flex;flex-direction:column;gap:14px;max-width:440px">
<span style="display:inline-flex;align-self:flex-start;background:#fff;border-radius:10px;padding:6px 12px"><img src={asset("assets/logo-full.png")} alt="Tiến Nông" style="height:44px;width:auto;display:block" /></span>
<strong style="color:#fff">{co.name}</strong>
<span style="line-height:1.8">{co.address}<br />{co.phone} · {co.email}<br />{co.tax_code_label} {co.tax_code}</span>
</div>
<div style="flex:1 1 150px;display:flex;flex-direction:column;gap:10px"><strong style="color:#fff">{f.col1_title}</strong><a href={url('ve-tien-nong')} style="color:var(--gray-300);text-decoration:none">{f.col1_about}</a><a href={url('khoa-hoc-cong-nghe')} style="color:var(--gray-300);text-decoration:none">{f.col1_science}</a><a href={url('phat-trien-ben-vung')} style="color:var(--gray-300);text-decoration:none">{f.col1_sustainability}</a><a href={url('tuyen-dung')} style="color:var(--gray-300);text-decoration:none">{f.col1_jobs}</a></div>
<div style="flex:1 1 150px;display:flex;flex-direction:column;gap:10px"><strong style="color:#fff">{f.col2_title}</strong><a href={url('san-pham')} style="color:var(--gray-300);text-decoration:none">{f.col2_products}</a><a href={url('giai-phap')} style="color:var(--gray-300);text-decoration:none">{f.col2_crop_solutions}</a><a href={url('giai-phap-du-an')} style="color:var(--gray-300);text-decoration:none">{f.col2_project_solutions}</a><a href={url('nong-dan')} style="color:var(--gray-300);text-decoration:none">{f.col2_farmers}</a></div>
<div style="flex:1 1 150px;display:flex;flex-direction:column;gap:10px"><strong style="color:#fff">{f.col3_title}</strong><a href={url('lien-he', 'dai-ly')} style="color:var(--gray-300);text-decoration:none">{f.col3_dealers}</a><a href={url('lien-he')} style="color:var(--gray-300);text-decoration:none">{f.col3_contact}</a><a href={url('tin-tuc')} style="color:var(--gray-300);text-decoration:none">{f.col3_news}</a></div>
</div>
<div style="display:flex;justify-content:space-between;gap:12px 24px;flex-wrap:wrap;padding-top:24px;border-top:1px solid var(--gray-700);font-size:13px;color:var(--gray-400)">
<span>{co.copyright}</span>
<div style="display:flex;gap:20px;flex-wrap:wrap"><a href={link(social.facebook)} style="color:var(--gray-400);text-decoration:none">Facebook</a><a href={link(social.youtube)} style="color:var(--gray-400);text-decoration:none">YouTube</a><a href={link(social.tiktok)} style="color:var(--gray-400);text-decoration:none">TikTok</a><span style="color:var(--gray-600)">|</span><a href={link(legal.privacy_url)} style="color:var(--gray-400);text-decoration:none">{legal.privacy_label}</a><a href={link(legal.terms_url)} style="color:var(--gray-400);text-decoration:none">{legal.terms_label}</a><span>{legal.ministry_badge}</span></div>
</div></div>
<a href={url('lien-he')} style="position:fixed;right:24px;bottom:24px;z-index:40;background:var(--green-500);color:#fff;font-weight:600;padding:12px 20px;border-radius:var(--radius-full);box-shadow:var(--shadow-md);text-decoration:none">{f.floating_button}</a>
</footer>
