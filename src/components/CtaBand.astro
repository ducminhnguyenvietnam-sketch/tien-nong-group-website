---
/**
 * Closing call-to-action band shared by the inner pages: dark brand green, white title, an optional
 * short line, a solid button and an outlined one. Title and line come from each page's CMS fields.
 */
import { isFilled } from '../lib/content';

interface Btn { label?: string; href: string; target?: string }
interface Props { title: string; text?: string; primary?: Btn; secondary?: Btn; id?: string }
const { title, text, primary, secondary, id } = Astro.props;
---
<section class="cta-band" id={id}>
<div class="cta-band__row">
<div class="cta-band__copy">
<h2>{title}</h2>
{isFilled(text) && <p>{text}</p>}
</div>
<div class="cta-band__actions">
{primary && isFilled(primary.label) && <a href={primary.href} target={primary.target} class="cta-band__btn cta-band__btn--solid">{primary.label}</a>}
{secondary && isFilled(secondary.label) && <a href={secondary.href} target={secondary.target} class="cta-band__btn">{secondary.label}</a>}
<slot />
</div>
</div>
</section>

<style>
  .cta-band { position: relative; overflow: hidden; background: var(--green-800); color: #fff; }
  .cta-band::before { content: ''; position: absolute; right: -120px; top: -160px; width: 420px; height: 420px; border-radius: 50%;
    background: radial-gradient(circle, rgba(245, 196, 78, .16) 0%, rgba(245, 196, 78, 0) 70%); pointer-events: none; }
  .cta-band__row { position: relative; max-width: 1280px; margin: 0 auto; padding: clamp(48px, 6vw, 72px) clamp(20px, 4vw, 56px);
    display: flex; justify-content: space-between; align-items: center; gap: 24px 48px; flex-wrap: wrap; }
  .cta-band__copy { display: flex; flex-direction: column; gap: 10px; max-width: 720px; }
  .cta-band h2 { margin: 0; font: var(--type-h2); color: #fff; text-wrap: balance; }
  .cta-band p { margin: 0; color: var(--green-100); font-size: var(--fs-body); line-height: 1.6; text-align: start; }
  .cta-band__actions { display: flex; gap: 12px; flex-wrap: wrap; }
  .cta-band__btn { display: inline-flex; align-items: center; justify-content: center; min-height: 48px; padding: 0 22px; border-radius: var(--radius-btn);
    border: 1px solid rgba(255, 255, 255, .7); color: #fff; font-weight: 600; text-decoration: none; white-space: nowrap;
    transition: background var(--motion-fast), border-color var(--motion-fast), color var(--motion-fast); }
  .cta-band__btn:hover { background: rgba(255, 255, 255, .1); color: #fff; text-decoration: none; }
  .cta-band__btn--solid { background: var(--brand-bright); border-color: var(--brand-bright); }
  .cta-band__btn--solid:hover { background: var(--green-600); border-color: var(--green-600); }
</style>
