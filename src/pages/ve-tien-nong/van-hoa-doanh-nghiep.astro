---
import raw from '../../content/pages/van-hoa-doanh-nghiep.json';
import { withDefaults } from '../../lib/content';
import Layout from '../../layouts/Layout.astro';
import ImageSlot from '../../components/ImageSlot.astro';
import { link, url, youtubeId } from '../../lib/routes';

const c = withDefaults(raw, 'src/content/pages/van-hoa-doanh-nghiep.json');
const F = 'src/content/pages/van-hoa-doanh-nghiep.json';
const slot = 'position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto;display:block';
const eyebrow = 'font:var(--type-eyebrow);letter-spacing:.08em;color:var(--green-700)';
const h2 = 'margin:0;font:var(--type-h2);letter-spacing:-.01em;text-wrap:balance';
const lead = 'margin:0;color:var(--text-secondary);font-size:var(--fs-lead);text-wrap:pretty';
---
<Layout title={c.seo.title || undefined} description={c.seo.description || undefined} active="Về Tiến Nông">
<section style="background:var(--surface-card)">
<div style="max-width:1280px;margin:0 auto;padding:28px clamp(20px,4vw,56px) clamp(48px,6vw,80px);display:flex;flex-direction:column;gap:32px">
<span style="font-size:13px;color:var(--text-tertiary)"><a href={url('trang-chu')} style="color:var(--text-tertiary)">{c.hero.breadcrumb_home}</a> / <a href={url('ve-tien-nong')} style="color:var(--text-tertiary)">{c.hero.breadcrumb_parent}</a> / {c.hero.breadcrumb_self}</span>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,440px),1fr));gap:40px 64px;align-items:center">
<div style="display:flex;flex-direction:column;gap:20px">
<span style={eyebrow}>{c.hero.eyebrow}</span>
<h1 style="margin:0;font:var(--type-h1);letter-spacing:-.015em;text-wrap:balance">{c.hero.title}</h1>
<p style="margin:0;font-size:var(--fs-lead);color:var(--text-secondary);text-wrap:pretty">{c.hero.intro}</p>
<div style="display:flex;gap:12px;flex-wrap:wrap"><a href="#tam-niem" style="background:var(--green-500);color:#fff;font-weight:700;padding:13px 22px;border-radius:var(--radius-md)">{c.hero.button_principles}</a><a href="#bai-hat" style="color:var(--green-700);font-weight:700;padding:13px 22px;border-radius:var(--radius-md);border:1px solid var(--border-strong)">{c.hero.button_media}</a></div>
</div>
<div style="display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);grid-template-rows:260px 200px;gap:14px">
<div style="position:relative;grid-row:span 2;min-width:0"><ImageSlot style={slot} id="vh-hero-1" shape="rounded" radius="16" placeholder={c.hero.image_1.alt} image={c.hero.image_1} cms={`${F}#hero.image_1`} /></div>
<div style="position:relative;min-width:0"><ImageSlot style={slot} id="vh-hero-2" shape="rounded" radius="16" placeholder={c.hero.image_2.alt} image={c.hero.image_2} cms={`${F}#hero.image_2`} /></div>
<div style="position:relative;min-width:0"><ImageSlot style={slot} id="vh-hero-3" shape="rounded" radius="16" placeholder={c.hero.image_3.alt} image={c.hero.image_3} cms={`${F}#hero.image_3`} /></div>
</div></div></div></section>

<section style="background:var(--green-800);color:#fff">
<div style="max-width:1280px;margin:0 auto;padding:48px clamp(20px,4vw,56px);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,280px),1fr));gap:28px 40px">
{c.mottos.map((m) => <div style="display:flex;flex-direction:column;gap:8px;padding-top:16px;border-top:2px solid var(--amber-400)"><span style="font:600 13px/1.45 var(--font-body);letter-spacing:.06em;text-transform:uppercase;color:var(--green-100)">{m.label}</span><strong style="font:var(--type-h3);text-wrap:balance">{m.text}</strong></div>)}
</div></section>

<section id="tam-niem" style="background:var(--surface-page);scroll-margin-top:120px">
<div style="max-width:1280px;margin:0 auto;padding:clamp(64px,8vw,112px) clamp(20px,4vw,56px);display:flex;flex-direction:column;gap:40px">
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:24px 64px;align-items:end">
<div style="display:flex;flex-direction:column;gap:14px"><span style={eyebrow}>{c.principles.eyebrow}</span><h2 style={h2}>{c.principles.title}</h2></div>
<p style={lead}>{c.principles.intro}</p>
</div>
<ol class="vh-principles" style="list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,210px),1fr));gap:16px">
{c.principles.items.map((p, i) => <li style="display:flex;flex-direction:column;gap:10px;padding:24px 22px;background:var(--surface-card);border:1px solid var(--border-default);border-top:4px solid var(--green-500);border-radius:var(--radius-lg)"><span style="font:var(--type-stat);color:var(--green-200);overflow-wrap:normal;font-variant-numeric:tabular-nums">{String(i + 1).padStart(2, '0')}</span><strong style="font-size:19px;line-height:1.35">{p.title}</strong><span style="color:var(--text-secondary);font-size:15px;text-wrap:pretty">{p.body}</span></li>)}
</ol>
</div></section>

<section style="background:var(--surface-card)">
<div style="max-width:1280px;margin:0 auto;padding:clamp(64px,8vw,112px) clamp(20px,4vw,56px);display:flex;flex-direction:column;gap:32px">
<div style="display:flex;flex-direction:column;gap:14px;max-width:760px"><span style={eyebrow}>{c.values.eyebrow}</span><h2 style={h2}>{c.values.title}</h2></div>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,190px),1fr));gap:16px 28px">
{c.values.items.map((v) => <div style="border-top:2px solid var(--green-500);padding-top:14px;display:flex;flex-direction:column;gap:4px"><strong style="font-size:18px">{v.title}</strong><span style="color:var(--text-secondary);font-size:15px">{v.body}</span></div>)}
</div></div></section>

<section style="background:var(--surface-page)">
<div style="max-width:1280px;margin:0 auto;padding:clamp(64px,8vw,112px) clamp(20px,4vw,56px);display:flex;flex-direction:column;gap:40px">
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:24px 64px;align-items:end">
<div style="display:flex;flex-direction:column;gap:14px"><span style={eyebrow}>{c.traditions.eyebrow}</span><h2 style={h2}>{c.traditions.title}</h2></div>
<p style={lead}>{c.traditions.intro}</p>
</div>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr));gap:20px">
{c.traditions.items.map((t, k) => <div style="background:var(--surface-card);border:1px solid var(--border-default);border-radius:var(--radius-lg);overflow:hidden;display:flex;flex-direction:column"><div style="position:relative;height:200px"><ImageSlot style={slot} id={`vh-tradition-${k}`} shape="rect" placeholder={t.image.alt} image={t.image} cms={`${F}#traditions.items.${k}.image`} /></div><div style="padding:22px;display:flex;flex-direction:column;gap:6px"><strong style="font-size:19px">{t.title}</strong><span style="color:var(--text-secondary)">{t.body}</span></div></div>)}
</div></div></section>

<section id="bai-hat" style="background:var(--green-800);color:#fff;scroll-margin-top:120px">
<div style="max-width:1280px;margin:0 auto;padding:clamp(64px,8vw,112px) clamp(20px,4vw,56px);display:flex;flex-direction:column;gap:40px">
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:24px 64px;align-items:end">
<div style="display:flex;flex-direction:column;gap:14px"><span style="font:var(--type-eyebrow);letter-spacing:.08em;color:var(--green-200)">{c.media.eyebrow}</span><h2 style={h2}>{c.media.title}</h2></div>
<p style="margin:0;color:var(--green-100);font-size:var(--fs-body);text-wrap:pretty">{c.media.intro}</p>
</div>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:28px">
{c.media.videos.map((v) => {
  const yt = youtubeId(v.youtube);
  return (
    <figure style="margin:0;display:flex;flex-direction:column;gap:12px">
      <div style="position:relative;aspect-ratio:16/9;border-radius:var(--radius-lg);overflow:hidden;background:var(--green-900)">
        {yt
          ? <iframe src={`https://www.youtube-nocookie.com/embed/${yt}`} title={v.title} loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen style="position:absolute;inset:0;width:100%;height:100%;border:0"></iframe>
          : v.file
            ? <video src={link(v.file)} controls preload="metadata" style="position:absolute;inset:0;width:100%;height:100%;background:#000"></video>
            : <div style="position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;padding:24px;text-align:center;color:var(--green-100);border:1.5px dashed rgba(255,255,255,.35);border-radius:inherit"><span style="font-size:40px;line-height:1" aria-hidden="true">▶</span><span style="font-size:14px;max-width:340px">{c.media.empty_note}</span></div>}
      </div>
      <figcaption style="display:flex;flex-direction:column;gap:2px"><strong style="font-size:19px">{v.title}</strong>{v.note && <span style="color:var(--green-100);font-size:14px">{v.note}</span>}</figcaption>
    </figure>
  );
})}
</div></div></section>

<section style="background:var(--surface-card)">
<div style="max-width:1280px;margin:0 auto;padding:clamp(64px,8vw,112px) clamp(20px,4vw,56px);display:flex;flex-direction:column;gap:40px">
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:24px 64px;align-items:end">
<div style="display:flex;flex-direction:column;gap:14px"><span style={eyebrow}>{c.poems.eyebrow}</span><h2 style={h2}>{c.poems.title}</h2></div>
<p style={lead}>{c.poems.intro}</p>
</div>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,340px),1fr));gap:20px">
{c.poems.items.map((p) => <figure style="margin:0;display:flex;flex-direction:column;gap:16px;padding:clamp(24px,3vw,36px);background:var(--surface-page);border-left:4px solid var(--amber-400);border-radius:var(--radius-lg)"><strong style="font:var(--type-num)">{p.title}</strong><blockquote style="margin:0;white-space:pre-line;font:500 17px/1.8 var(--font-display);color:var(--text-primary)">{p.text}</blockquote><figcaption style="display:flex;flex-direction:column;padding-top:12px;border-top:1px solid var(--border-default)"><strong>{p.author}</strong><span style="font-size:14px;color:var(--text-secondary)">{p.place}</span></figcaption></figure>)}
</div></div></section>

<section style="background:var(--surface-page)">
<div style="max-width:1280px;margin:0 auto;padding:clamp(64px,8vw,112px) clamp(20px,4vw,56px);display:flex;flex-direction:column;gap:32px">
<div style="display:flex;flex-direction:column;gap:14px"><span style={eyebrow}>{c.gallery.eyebrow}</span><h2 style={h2}>{c.gallery.title}</h2></div>
<div class="vh-gallery">
{c.gallery.photos.map((ph, k) => <div style="position:relative;min-height:200px"><ImageSlot style={slot} id={`vh-gallery-${k}`} shape="rounded" radius="12" placeholder={ph.alt} image={ph} cms={`${F}#gallery.photos.${k}`} /></div>)}
</div></div></section>

<section style="background:var(--surface-card);border-top:1px solid var(--border-default)">
<div style="max-width:1280px;margin:0 auto;padding:56px clamp(20px,4vw,56px);display:flex;justify-content:space-between;align-items:center;gap:24px;flex-wrap:wrap">
<h2 style="margin:0;font:var(--type-h3);text-wrap:balance;max-width:640px">{c.cta.title}</h2>
<div style="display:flex;gap:12px;flex-wrap:wrap"><a href={url('tuyen-dung', 'vi-tri')} style="background:var(--green-500);color:#fff;font-weight:700;padding:13px 22px;border-radius:var(--radius-md)">{c.cta.button_jobs}</a><a href={url('ve-tien-nong')} style="color:var(--green-700);font-weight:700;padding:13px 22px;border-radius:var(--radius-md);border:1px solid var(--border-strong)">{c.cta.button_about}</a></div>
</div></section>
</Layout>

<style>
  /* Mosaic: first photo large, the rest fill a 3-column grid (2 columns on tablets, 1 on phones). */
  .vh-gallery { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); grid-auto-rows: 220px; gap: 12px; }
  .vh-gallery > :first-child { grid-column: span 2; grid-row: span 2; }
  @media (max-width: 900px) { .vh-gallery { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-auto-rows: 180px; } }
  @media (max-width: 520px) { .vh-gallery { grid-template-columns: 1fr; } .vh-gallery > :first-child { grid-column: auto; grid-row: span 1; } }
</style>
