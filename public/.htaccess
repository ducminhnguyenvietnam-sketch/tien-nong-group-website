# tiennong.com on Mắt Bão hosting (Apache / LiteSpeed). Copied to the web folder with every deploy.
# (GitHub Pages ignores this file.)

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html
AddDefaultCharset utf-8

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Always https, always without "www".
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
  # Hidden files (.htaccess, the deploy state file …) are never served.
  RewriteRule (^|/)\. - [F]
  # The site is plain HTML: no server code may ever run from this folder, even if a file were slipped in.
  RewriteRule \.(php[0-9]?|phtml|phar|cgi|pl|py|sh|asp|aspx|jsp)$ - [F,NC]
</IfModule>

<IfModule mod_headers.c>
  # The browser may only load scripts, styles, fonts and images from this site; videos from YouTube;
  # forms send only here or to FormSubmit; the photo editor talks to GitHub. No other site may frame these pages.
  # Measurement and ads (only used once PUBLIC_GTM_ID is set): Google Tag Manager, GA4, Google Ads,
  # Meta (Facebook) pixel, TikTok pixel. Any other tag added in GTM is blocked until its host is listed here.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://*.google-analytics.com https://www.googleadservices.com https://googleads.g.doubleclick.net https://www.google.com https://connect.facebook.net https://analytics.tiktok.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://i.ytimg.com https://avatars.githubusercontent.com https://www.googletagmanager.com https://*.google-analytics.com https://*.g.doubleclick.net https://www.google.com https://www.google.com.vn https://www.facebook.com https://analytics.tiktok.com; font-src 'self' data:; frame-src https://www.youtube-nocookie.com https://www.youtube.com https://www.googletagmanager.com https://td.doubleclick.net; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com https://*.g.doubleclick.net https://www.google.com https://pagead2.googlesyndication.com https://www.facebook.com https://analytics.tiktok.com https://formsubmit.co https://api.github.com https://script.google.com https://script.googleusercontent.com; form-action 'self' https://formsubmit.co; frame-ancestors 'self'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
  Header always set Cross-Origin-Opener-Policy "same-origin"
  # An SVG opened on its own (e.g. /uploads/logo.svg) cannot run scripts.
  <FilesMatch "\.svg$">
    Header always set Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; img-src data:; sandbox"
  </FilesMatch>
  Header unset X-Powered-By

  # Files with a content hash in their name never change: cache for a year. Pages are re-checked each visit.
  <FilesMatch "\.(css|js|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(webp|avif|jpe?g|png|gif|svg|ico|pdf)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt|json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>
