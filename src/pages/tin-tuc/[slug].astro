---
import raw from '../../content/pages/tin-tuc.json';
import { isFilled, withDefaults } from '../../lib/content';
import siteRaw from '../../content/site.json';
import Layout from '../../layouts/Layout.astro';
import ImageSlot from '../../components/ImageSlot.astro';
import { render } from 'astro:content';
import { url, link } from '../../lib/routes';
import { CATEGORIES, CATEGORY_SLUGS, formatDate, getNews, isArticle, isPress, listUrl, newsUrl, readingTime, type NewsEntry } from '../../lib/news';
const site = withDefaults(siteRaw, 'src/content/site.json');

const c = withDefaults(raw, 'src/content/pages/tin-tuc.json');

export async function getStaticPaths() {
  // Press items that link to the newspaper's own page need no article page here.
  const all = (await getNews()).filter(isArticle);
  return all.map((entry) => ({ params: { slug: entry.id }, props: { entry, all } }));
}
interface Props { entry: NewsEntry; all: NewsEntry[] }
const { entry, all } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const t = c.article;
const cat = CATEGORIES[d.category];
const others = all.filter((e) => e.id !== entry.id && !isPress(e));
const related = [...others.filter((e) => e.data.category === d.category), ...others.filter((e) => e.data.category !== d.category)].slice(0, 4);
const pageUrl = new URL(newsUrl(entry), Astro.site ?? 'https://example.com').href;
// Many articles imported from the old site have a summary that is just the opening of the text (WordPress
// made it automatically), so it is shown above the article only when it says something the text does not.
const fold = (t: string) => t.normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/đ/gi, 'd').toLowerCase().replace(/[^a-z0-9]+/g, '');
const bodyStart = fold((entry.body ?? '').replace(/!\[[^\]]*\]\([^)]*\)|<[^>]+>|\]\([^)]*\)/g, ' ').slice(0, 1500));
const WEEKDAYS = ['Chủ nhật', 'Thứ hai', 'Thứ ba', 'Thứ tư', 'Thứ năm', 'Thứ sáu', 'Thứ bảy'];
const formatDateLong = (dt: Date) => `${WEEKDAYS[dt.getDay()]}, ${formatDate(dt)}`;
const showSummary = isFilled(d.summary) && !bodyStart.includes(fold(d.summary).slice(0, 60));
---
<Layout title={d.title} description={isFilled(d.summary) ? d.summary : undefined} active="Tin tức" background="var(--surface-card)">

<div class="art">
<aside class="art__share" aria-label="Chia sẻ">
<a href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(pageUrl)}`} target="_blank" rel="noopener" aria-label={t.share_facebook} title={t.share_facebook}><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M13.5 21v-7.5H16l.4-3h-2.9V8.6c0-.9.3-1.5 1.5-1.5h1.6V4.4c-.3 0-1.2-.1-2.3-.1-2.3 0-3.8 1.4-3.8 3.9v2.3H8v3h2.5V21h3z"/></svg></a>
<a href={link(site.social.zalo)} target="_blank" rel="noopener" aria-label={t.share_zalo} title={t.share_zalo} class="art__zalo">Zalo</a>
<button type="button" id="copy-link" data-copied={t.copied} aria-label={t.copy_link} title={t.copy_link}><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7"/><path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7"/></svg></button>
<span class="art__copied" role="status" aria-live="polite"></span>
</aside>
<article class="art__main">
<header class="art__head">
<nav class="art__crumbs" aria-label="Đường dẫn"><a href={url('trang-chu')}>{t.breadcrumb_home}</a> / <a href={url('tin-tuc')}>{t.breadcrumb_news}</a> / <a href={listUrl(d.category)} aria-current="page">{cat}</a></nav>
<span class="art__meta">{d.date && <time>{formatDateLong(d.date)}</time>}<span>{d.author}</span><span>{readingTime(entry)} {t.minutes_read}</span></span>
<h1>{d.title}</h1>
{showSummary && <p class="art__sapo">{d.summary}</p>}
</header>
<figure class="art__cover"><div class="art__cover-img"><ImageSlot style="position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto;display:block" id={`news-${entry.id}`} shape="rounded" radius="14" placeholder={d.cover.alt || 'Ảnh đại diện bài viết'} image={d.cover} cms={`${entry.filePath}#cover`} sizes="(max-width: 767px) 92vw, 780px" /></div>{d.cover_caption && <figcaption>{d.cover_caption}</figcaption>}</figure>
<div class="article-body">
<Content />
{d.album.length > 0 && <div style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px">{d.album.map((img, i) => <div style="position:relative;height:150px"><ImageSlot style="position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto;display:block" id={`news-${entry.id}-album-${i}`} shape="rounded" radius="10" placeholder={img.alt || 'Album'} image={img} cms={`${entry.filePath}#album.${i}`} /></div>)}</div>}
{d.album_link && <a href={link(d.album_link)} style="font-size:15px;font-weight:600">{t.album_more}</a>}
{d.tags.length > 0 && <div style="display:flex;gap:8px;flex-wrap:wrap;padding-top:20px;border-top:1px solid var(--border-default);font-size:14px"><span style="color:var(--text-tertiary)">{t.tags_label}</span>{d.tags.map((tag) => <a href={url('tin-tuc')} style="padding:4px 12px;border-radius:var(--radius-full);background:var(--surface-sunken);color:var(--text-primary)">{tag}</a>)}</div>}
</div>
</article>
<aside class="art__side">
<nav class="art__cats" aria-label={t.categories_title || 'Danh mục'}>
<h2>{t.categories_title || 'Danh mục'}</h2>
<ul>{Object.entries(CATEGORIES).filter(([k]) => k in CATEGORY_SLUGS).map(([k, label]) => <li><a href={listUrl(k)} aria-current={k === d.category ? 'page' : undefined}><span>{label}</span><span aria-hidden="true">›</span></a></li>)}</ul>
</nav>
</aside>
</div>

{related.length > 0 && <section style="background:var(--surface-page);border-top:1px solid var(--border-default)">
<div style="max-width:1280px;margin:0 auto;padding:clamp(48px,6vw,80px) clamp(20px,4vw,56px);display:flex;flex-direction:column;gap:28px">
<div style="display:flex;justify-content:space-between;align-items:flex-end;gap:16px;flex-wrap:wrap"><h2 style="margin:0;font:var(--type-h3)">{t.related_title}</h2><a href={url('tin-tuc')} style="font-weight:600">{t.related_all}</a></div>
<div class="art-rel">
{related.map((r) => <a href={newsUrl(r)} style="display:flex;flex-direction:column;gap:12px;color:var(--text-primary)"><div style="position:relative;aspect-ratio:16/10"><ImageSlot style="position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto;display:block" id={`news-${r.id}`} shape="rounded" radius="12" placeholder="Ảnh" image={r.data.cover} cms={`${r.filePath}#cover`} /></div><span style="display:flex;justify-content:space-between;gap:10px;font-size:13px;color:var(--text-tertiary)"><strong style="color:var(--green-600)">{CATEGORIES[r.data.category]}</strong>{r.data.date && <time style="flex:none">{formatDate(r.data.date)}</time>}</span><strong class="jx-justify" style="line-height:1.4">{r.data.title}</strong></a>)}
</div></div></section>}
</Layout>

<style>
  /* Article: share buttons on the left, the text in the middle, categories on the right (Figma). */
  .art { max-width: 1280px; margin: 0 auto; padding: 28px clamp(20px, 4vw, 56px) 64px; display: grid; grid-template-columns: 48px minmax(0, 780px) minmax(240px, 300px); justify-content: space-between; gap: 32px; align-items: start; }
  .art__share { position: sticky; top: 120px; margin-top: 96px; display: flex; flex-direction: column; gap: 10px; }
  .art__share a, .art__share button { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; border: 1.5px solid var(--green-200); background: var(--surface-card); color: var(--green-700); cursor: pointer; text-decoration: none; transition: background var(--motion-fast), color var(--motion-fast), border-color var(--motion-fast); }
  .art__share a:hover, .art__share button:hover { background: var(--brand-bright); border-color: var(--brand-bright); color: #fff; text-decoration: none; }
  .art__zalo { font: 700 11px/1 var(--font-display); }
  .art__copied { font-size: 12px; color: var(--green-700); text-align: center; min-height: 16px; }
  .art__main { min-width: 0; display: flex; flex-direction: column; gap: 24px; }
  .art__head { display: flex; flex-direction: column; gap: 12px; }
  .art__crumbs { font-size: 13px; color: var(--text-tertiary); }
  .art__crumbs a { color: var(--text-tertiary); }
  .art__crumbs [aria-current] { color: var(--green-600); }
  .art__meta { display: flex; flex-wrap: wrap; gap: 4px 18px; font-size: 14px; color: var(--text-secondary); }
  .art__meta > * + *::before { content: '·'; margin-right: 18px; color: var(--text-tertiary); }
  .art__head h1 { margin: 4px 0 0; font: 700 clamp(24px, 2.3vw, 32px)/1.3 var(--font-display); color: var(--green-700); letter-spacing: -.005em; text-wrap: balance; }
  .art__sapo { margin: 0; font-size: 18px; line-height: 1.6; font-weight: 500; color: var(--text-primary); }
  .art__cover { margin: 0; display: flex; flex-direction: column; gap: 10px; }
  .art__cover-img { position: relative; aspect-ratio: 16 / 10; }
  .art__cover figcaption { font-size: 14px; font-style: italic; color: var(--text-tertiary); text-align: center; text-align-last: center; }
  .article-body { display: flex; flex-direction: column; gap: 20px; font-size: 17px; line-height: 1.75; }
  .art__side { position: sticky; top: 120px; margin-top: 96px; }
  .art__cats { border: 1px solid var(--border-default); border-top: 4px solid var(--brand-bright); border-radius: var(--radius-lg); background: var(--surface-card); padding: 20px 22px 12px; box-shadow: 0 10px 28px rgba(0, 71, 35, .06); }
  .art__cats h2 { margin: 0 0 8px; font: 700 20px/1.3 var(--font-display); color: var(--green-800); }
  .art__cats ul { list-style: none; margin: 0; padding: 0; }
  .art__cats li + li { border-top: 1px solid var(--border-default); }
  .art__cats a { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 12px 0; color: var(--text-secondary); font-size: 15px; font-weight: 500; text-decoration: none; transition: color var(--motion-fast); }
  .art__cats a span:last-child { color: var(--text-tertiary); font-size: 18px; transition: transform var(--motion-fast); }
  .art__cats a:hover { color: var(--green-700); text-decoration: none; }
  .art__cats a:hover span:last-child { transform: translateX(3px); color: var(--green-600); }
  .art__cats a[aria-current] { color: var(--green-700); font-weight: 700; }
  .art__cats a[aria-current] span:first-child { box-shadow: inset 0 -2px 0 var(--brand-highlight); }
  .art-rel { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 24px; }
  @media (max-width: 1099.98px) {
    .art { grid-template-columns: minmax(0, 1fr); max-width: 820px; }
    .art__share { position: static; margin: 0; flex-direction: row; order: 2; }
    .art__side { position: static; margin: 0; order: 3; }
    .art-rel { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 599.98px) { .art-rel { grid-template-columns: minmax(0, 1fr); } }
  .article-body :global(p) { margin: 0; }
  .article-body :global(h2) { margin: 12px 0 0; font: 700 23px/1.35 var(--font-display); color: var(--green-700); }
  .article-body :global(h3) { margin: 8px 0 0; font: 700 19px/1.4 var(--font-display); color: var(--green-800); }
  .article-body :global(ul), .article-body :global(ol) { margin: 0; padding-left: 22px; }
  .article-body :global(img) { display: block; width: 100%; height: auto; border-radius: 12px; margin: 8px 0; background: var(--surface-sunken); }
  /* Photo caption: an italic line right under a photo (articles imported from the old site). */
  .article-body :global(p:has(> img) + p:has(> em:only-child)) { margin-top: -12px; font-size: 14px; line-height: 1.5; color: var(--text-tertiary); text-align: center; text-align-last: center; }
  .article-body :global(.video-embed) { position: relative; aspect-ratio: 16 / 9; border-radius: 12px; overflow: hidden; background: #000; }
  .article-body :global(.video-embed iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .article-body :global(table) { width: 100% !important; height: auto !important; border-collapse: collapse; font-size: 15px; line-height: 1.5; display: block; overflow-x: auto; }
  .article-body :global(th), .article-body :global(td) { width: auto !important; height: auto !important; padding: 8px 10px; border: 1px solid var(--border-default); text-align: left; vertical-align: top; }
  .article-body :global(th) { background: var(--surface-sunken); }
  .article-body :global(blockquote) { margin: 8px 0; padding: 8px 0 8px 24px; border-left: 4px solid var(--green-500); font: 600 22px/1.5 var(--font-display); color: var(--green-800); }
  .article-body :global(blockquote p) { text-align: left; }
  .article-body :global(blockquote p + p) { margin-top: 8px; font: 500 15px var(--font-body); color: var(--text-secondary); }
</style>
<script>
  const btn = document.getElementById('copy-link')!;
  const note = document.querySelector<HTMLElement>('.art__copied')!;
  btn.addEventListener('click', () => {
    navigator.clipboard?.writeText(location.href).catch(() => { /* clipboard unavailable */ });
    note.textContent = btn.dataset.copied!;
    setTimeout(() => { note.textContent = ''; }, 1800);
  });
</script>
