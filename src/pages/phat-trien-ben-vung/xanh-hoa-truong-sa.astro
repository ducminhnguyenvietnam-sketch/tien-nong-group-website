<script>
  // Journey arrows (phones): scroll one milestone at a time and keep "n / total" in step with the swipe.
  document.querySelectorAll<HTMLElement>('.ts-jnav').forEach((nav) => {
    const list = document.getElementById(nav.dataset.for || '');
    if (!list) return;
    const items = [...list.children] as HTMLElement[];
    const count = nav.querySelector('.ts-jnav__count b');
    const [prev, next] = [...nav.querySelectorAll<HTMLButtonElement>('button')];
    const at = () => { const x = list.scrollLeft + 4; let i = 0; items.forEach((it, k) => { if (it.offsetLeft - items[0].offsetLeft <= x) i = k; }); return i; };
    const sync = () => {
      const i = list.scrollLeft + list.clientWidth >= list.scrollWidth - 4 ? items.length - 1 : at();
      if (count) count.textContent = String(i + 1);
      prev.disabled = list.scrollLeft < 4; next.disabled = list.scrollLeft + list.clientWidth >= list.scrollWidth - 4;
    };
    const go = (d: number) => { const t = items[Math.max(0, Math.min(items.length - 1, at() + d))]; list.scrollTo({ left: t.offsetLeft - items[0].offsetLeft, behavior: 'smooth' }); };
    prev.addEventListener('click', () => go(-1)); next.addEventListener('click', () => go(1));
    list.addEventListener('scroll', () => requestAnimationFrame(sync), { passive: true });
    sync();
  });
</script>


<script>
  document.getElementById('wish-more')?.addEventListener('click', (e) => {
    document.getElementById('wish-wall')?.classList.add('is-open');
    (e.currentTarget as HTMLElement).hidden = true;
  });
</script>
