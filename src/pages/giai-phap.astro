  .gp-tile { position: relative; display: block; aspect-ratio: 16 / 10.5; border-radius: var(--radius-lg); overflow: hidden; color: #fff; text-decoration: none; isolation: isolate;
    background: linear-gradient(150deg, #1f7a43 0%, var(--green-800) 70%); }
  .gp-tile[data-empty-tile]::before { content: ''; position: absolute; right: -14%; bottom: -26%; width: 70%; aspect-ratio: 1; background: var(--leaf) center / contain no-repeat; opacity: .1; }
  .gp-tile__img { position: absolute; inset: 0; transition: transform .5s var(--ease-out); }
  .gp-tile::after { content: ''; position: absolute; inset: 0; background: linear-gradient(0deg, rgba(2, 53, 26, .78) 0%, rgba(2, 53, 26, .1) 55%, rgba(2, 53, 26, 0) 100%); pointer-events: none; }
  .gp-tile__name { position: absolute; left: 18px; bottom: 16px; z-index: 1; font: 700 18px/1.25 var(--font-display); }
  .gp-tile__go { position: absolute; right: 14px; bottom: 14px; z-index: 1; display: grid; place-items: center; width: 32px; height: 32px; border-radius: 50%; background: rgba(255, 255, 255, .18); font-size: 14px; transition: background var(--motion-fast), color var(--motion-fast); }
