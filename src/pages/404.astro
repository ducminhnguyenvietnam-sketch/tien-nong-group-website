---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import { url } from '../lib/routes';

const links: [string, Parameters<typeof url>[0]][] = [
  ['Sản phẩm', 'san-pham'], ['Giải pháp theo cây trồng', 'giai-phap'], ['Tin tức', 'tin-tuc'], ['Liên hệ', 'lien-he'],
];
---
<Layout title="Không tìm thấy trang" noindex>
<section style="background:var(--surface-card)">
<div style="max-width:1280px;margin:0 auto;padding:clamp(64px,10vw,140px) clamp(20px,4vw,56px);display:flex;flex-direction:column;gap:20px;max-width:760px">
<span style="font:var(--type-eyebrow);letter-spacing:.08em;color:var(--green-700)">LỖI 404</span>
<h1 style="margin:0;font:var(--type-h1);letter-spacing:-.015em">Trang bạn tìm không còn ở đây</h1>
<p style="margin:0;font-size:var(--fs-lead);color:var(--text-secondary)">Đường dẫn có thể đã thay đổi. Bà con và quý đối tác có thể quay về trang chủ hoặc đi thẳng tới các mục dưới đây.</p>
<div style="display:flex;gap:12px;flex-wrap:wrap"><a href={url('trang-chu')} style="text-decoration:none;display:inline-flex"><Button as="span" size="lg">Về trang chủ</Button></a></div>
<nav aria-label="Lối tắt" style="display:flex;gap:8px 24px;flex-wrap:wrap;padding-top:16px;border-top:1px solid var(--border-default);font-weight:600">
{links.map(([label, slug]) => <a href={url(slug)}>{label} →</a>)}
</nav>
</div></section>
</Layout>
