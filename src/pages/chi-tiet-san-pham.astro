---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import ImageSlot from '../components/ImageSlot.astro';
import { url } from '../lib/routes';

const VIEWS = [
  { label: 'Mặt trước', ph: 'Bao bì mặt trước' },
  { label: 'Mặt sau', ph: 'Bao bì mặt sau (thông tin kỹ thuật)' },
  { label: 'Hạt phân', ph: 'Cận cảnh hạt phân' },
  { label: 'Trên ruộng', ph: 'Sản phẩm trên ruộng lúa' },
];
---
<Layout title="NPK 12-3-10+2SiO₂hh Tiến Nông (Lúa 2)" active="Sản phẩm">
<section style="background:var(--surface-card)">
<div style="max-width:1280px;margin:0 auto;padding:24px clamp(20px,4vw,56px) clamp(48px,6vw,72px);display:flex;flex-direction:column;gap:28px">
<span style="font-size:13px;color:var(--text-tertiary)"><a href={url('trang-chu')} style="color:var(--text-tertiary)">Trang chủ</a> / <a href={url('san-pham')} style="color:var(--text-tertiary)">Sản phẩm</a> / Phân bón chuyên dụng</span>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,440px),1fr));gap:40px 64px;align-items:start">
<div data-picker style="display:flex;flex-direction:column;gap:12px">
<div style="height:clamp(360px,42vw,520px);background:var(--surface-sunken);border-radius:var(--radius-xl);padding:24px">
{VIEWS.map((v, k) => <div role="tabpanel" data-pick-panel={k} hidden={k !== 0} style="height:100%"><ImageSlot id={`pd-view-${k}`} shape="rounded" radius="12" fit="contain" placeholder={v.ph} /></div>)}
</div>
<div role="tablist" aria-label="Ảnh sản phẩm" style="display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px">
{VIEWS.map((v, k) => <button type="button" role="tab" class="pd-view" data-pick={k} aria-selected={k === 0 ? 'true' : 'false'} style="padding:10px 6px;border-radius:var(--radius-md);border:1px solid var(--border-default);background:var(--surface-card);font:600 13px var(--font-body);color:var(--text-secondary);cursor:pointer">{v.label}</button>)}
</div></div>
<div style="display:flex;flex-direction:column;gap:22px">
<div style="display:flex;flex-direction:column;gap:10px">
<span style="font:600 13px var(--font-mono);letter-spacing:.1em;color:var(--green-600)">PHÂN BÓN CHUYÊN DỤNG · CÂY LÚA</span>
<h1 style="margin:0;font:800 clamp(30px,3.6vw,44px)/1.15 var(--font-display);letter-spacing:-.01em;text-wrap:balance">NPK 12-3-10+2SiO₂hh Tiến Nông (Lúa 2)</h1>
<p style="margin:0;color:var(--text-secondary);font-size:17px;text-align:justify;text-wrap:pretty">Phân bón hỗn hợp NPK bổ sung Silic hữu hiệu, chuyên dùng bón thúc cho lúa giai đoạn đẻ nhánh và làm đòng.</p>
</div>
<div style="display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px">
<div style="background:var(--green-50);border-radius:var(--radius-md);padding:14px 10px;text-align:center"><div style="font:800 28px/1.1 var(--font-display);color:var(--green-800)">12%</div><div style="font-size:13px;color:var(--text-secondary)">Đạm (N)</div></div>
<div style="background:var(--green-50);border-radius:var(--radius-md);padding:14px 10px;text-align:center"><div style="font:800 28px/1.1 var(--font-display);color:var(--green-800)">3%</div><div style="font-size:13px;color:var(--text-secondary)">Lân (P₂O₅hh)</div></div>
<div style="background:var(--green-50);border-radius:var(--radius-md);padding:14px 10px;text-align:center"><div style="font:800 28px/1.1 var(--font-display);color:var(--green-800)">10%</div><div style="font-size:13px;color:var(--text-secondary)">Kali (K₂Ohh)</div></div>
<div style="background:var(--green-50);border-radius:var(--radius-md);padding:14px 10px;text-align:center"><div style="font:800 28px/1.1 var(--font-display);color:var(--green-800)">2%</div><div style="font-size:13px;color:var(--text-secondary)">Silic (SiO₂hh)</div></div>
</div>
<div style="display:flex;flex-direction:column;gap:8px;padding:16px 0;border-top:1px solid var(--border-default);border-bottom:1px solid var(--border-default);font-size:15px">
<div style="display:flex;justify-content:space-between;gap:16px"><span style="color:var(--text-secondary)">Mã số phân bón</span><strong>[mã số]</strong></div>
<div style="display:flex;justify-content:space-between;gap:16px"><span style="color:var(--text-secondary)">Quy cách</span><strong>[25 kg / 50 kg]</strong></div>
<div style="display:flex;justify-content:space-between;gap:16px"><span style="color:var(--text-secondary)">Phương thức sử dụng</span><strong>Bón rễ</strong></div>
<div style="display:flex;justify-content:space-between;gap:16px"><span style="color:var(--text-secondary)">Tiêu chuẩn</span><strong>ISO 9001:2015 · ISO 14001:2015</strong></div>
</div>
<div style="display:flex;gap:12px;flex-wrap:wrap">
<a href={url('lien-he', 'dai-ly')} style="text-decoration:none;display:inline-flex"><Button as="span" size="lg">Tìm đại lý gần nhất</Button></a>
<a href={url('lien-he', 'lien-he-form')} style="text-decoration:none;display:inline-flex"><Button as="span" size="lg" variant="secondary">Gọi kỹ sư tư vấn</Button></a>
</div>
<div style="display:flex;gap:20px;flex-wrap:wrap;font-size:15px;font-weight:600"><a href="#">Tải tài liệu kỹ thuật (PDF)</a><a href="#">Tải phiếu an toàn (SDS)</a></div>
</div></div></div></section>

<nav style="position:sticky;top:108px;z-index:20;background:var(--surface-page);border-top:1px solid var(--border-default);border-bottom:1px solid var(--border-default)">
<div style="max-width:1280px;margin:0 auto;padding:0 clamp(20px,4vw,56px);display:flex;gap:28px;overflow-x:auto;white-space:nowrap;font-size:14px;font-weight:600">
<a href="#thanh-phan" style="color:var(--text-secondary);padding:14px 0">Thành phần</a><a href="#cong-dung" style="color:var(--text-secondary);padding:14px 0">Công dụng</a><a href="#su-dung" style="color:var(--text-secondary);padding:14px 0">Hướng dẫn sử dụng</a><a href="#an-toan" style="color:var(--text-secondary);padding:14px 0">An toàn &amp; bảo quản</a><a href="#thong-tin" style="color:var(--text-secondary);padding:14px 0">Thông tin pháp lý</a>
</div></nav>

<div style="max-width:960px;margin:0 auto;padding:clamp(48px,6vw,80px) clamp(20px,4vw,56px);display:flex;flex-direction:column;gap:64px">

<section id="thanh-phan" style="scroll-margin-top:170px;display:flex;flex-direction:column;gap:20px">
<h2 style="margin:0;font:800 clamp(24px,2.6vw,32px)/1.2 var(--font-display)">Thành phần định lượng</h2>
<div style="background:var(--surface-card);border:1px solid var(--border-default);border-radius:var(--radius-lg);overflow:hidden;overflow-x:auto">
<div style="min-width:560px">
<div style="display:grid;grid-template-columns:minmax(0,2.2fr) 120px minmax(0,1.3fr);gap:16px;padding:12px 20px;background:var(--surface-sunken);font:600 12px var(--font-mono);letter-spacing:.06em;color:var(--text-secondary)"><span>CHỈ TIÊU</span><span>HÀM LƯỢNG</span><span>PHƯƠNG PHÁP THỬ</span></div>
<div style="display:grid;grid-template-columns:minmax(0,2.2fr) 120px minmax(0,1.3fr);gap:16px;padding:14px 20px;border-top:1px solid var(--border-default)"><span>Đạm tổng số (Nts)</span><strong>12%</strong><span style="color:var(--text-secondary)">TCVN 5815:2018</span></div>
<div style="display:grid;grid-template-columns:minmax(0,2.2fr) 120px minmax(0,1.3fr);gap:16px;padding:14px 20px;border-top:1px solid var(--border-default)"><span>Lân hữu hiệu (P₂O₅hh)</span><strong>3%</strong><span style="color:var(--text-secondary)">TCVN 5815:2018</span></div>
<div style="display:grid;grid-template-columns:minmax(0,2.2fr) 120px minmax(0,1.3fr);gap:16px;padding:14px 20px;border-top:1px solid var(--border-default)"><span>Kali hữu hiệu (K₂Ohh)</span><strong>10%</strong><span style="color:var(--text-secondary)">TCVN 8560:2018</span></div>
<div style="display:grid;grid-template-columns:minmax(0,2.2fr) 120px minmax(0,1.3fr);gap:16px;padding:14px 20px;border-top:1px solid var(--border-default)"><span>Silic hữu hiệu (SiO₂hh)</span><strong>2%</strong><span style="color:var(--text-secondary)">[phương pháp]</span></div>
<div style="display:grid;grid-template-columns:minmax(0,2.2fr) 120px minmax(0,1.3fr);gap:16px;padding:14px 20px;border-top:1px solid var(--border-default)"><span>Độ ẩm</span><strong>[%]</strong><span style="color:var(--text-secondary)">TCVN 5815:2018</span></div>
</div></div>
<span style="font-size:13px;color:var(--text-tertiary)">Kết quả kiểm định tại phòng thí nghiệm VILAS 1519 của Tiến Nông.</span>
</section>

<section id="cong-dung" style="scroll-margin-top:170px;display:flex;flex-direction:column;gap:20px">
<h2 style="margin:0;font:800 clamp(24px,2.6vw,32px)/1.2 var(--font-display)">Công dụng</h2>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(clamp(calc((100% - 48px)/4),calc((900px - 100%)*999),calc((100% - 16px)/2)),1fr));gap:16px">
<div style="background:var(--surface-card);border:1px solid var(--border-default);border-radius:var(--radius-lg);padding:20px;display:flex;flex-direction:column;gap:8px"><span style="font:700 13px var(--font-mono);color:var(--green-600)">ĐẺ NHÁNH</span><span>Lúa đẻ nhánh khỏe, đẻ tập trung</span></div>
<div style="background:var(--surface-card);border:1px solid var(--border-default);border-radius:var(--radius-lg);padding:20px;display:flex;flex-direction:column;gap:8px"><span style="font:700 13px var(--font-mono);color:var(--green-600)">LÀM ĐÒNG</span><span>Đòng to, dài; lúa trổ thoát</span></div>
<div style="background:var(--surface-card);border:1px solid var(--border-default);border-radius:var(--radius-lg);padding:20px;display:flex;flex-direction:column;gap:8px"><span style="font:700 13px var(--font-mono);color:var(--green-600)">NĂNG SUẤT</span><span>Bông to, nhiều hạt, hạt chắc mẩy</span></div>
<div style="background:var(--surface-card);border:1px solid var(--border-default);border-radius:var(--radius-lg);padding:20px;display:flex;flex-direction:column;gap:8px"><span style="font:700 13px var(--font-mono);color:var(--green-600)">CHỐNG CHỊU</span><span>Cứng cây, đứng lá, chống đổ ngã, hạn chế sâu bệnh</span></div>
</div></section>

<section id="su-dung" style="scroll-margin-top:170px;display:flex;flex-direction:column;gap:20px">
<h2 style="margin:0;font:800 clamp(24px,2.6vw,32px)/1.2 var(--font-display)">Hướng dẫn sử dụng</h2>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(clamp(calc((100% - 32px)/3),calc((632px - 100%)*999),100%),1fr));gap:0;border:1px solid var(--border-default);border-radius:var(--radius-lg);overflow:hidden;background:var(--surface-card)">
<div style="padding:20px;display:flex;flex-direction:column;gap:6px;background:var(--surface-sunken)"><span style="font:600 12px var(--font-mono);color:var(--text-tertiary);letter-spacing:.06em">BÓN LÓT</span><strong>Dùng NPK Lúa 1</strong><span style="font-size:14px;color:var(--text-secondary)">Không dùng sản phẩm này</span></div>
<div style="padding:20px;display:flex;flex-direction:column;gap:6px;border-left:3px solid var(--green-500)"><span style="font:600 12px var(--font-mono);color:var(--green-600);letter-spacing:.06em">THÚC ĐẺ NHÁNH</span><strong style="font-size:20px">300–350 kg/ha</strong><span style="font-size:14px;color:var(--text-secondary)">Bón khi lúa bắt đầu đẻ nhánh</span></div>
<div style="padding:20px;display:flex;flex-direction:column;gap:6px;border-left:3px solid var(--green-500)"><span style="font:600 12px var(--font-mono);color:var(--green-600);letter-spacing:.06em">THÚC ĐÒNG</span><strong style="font-size:20px">300–350 kg/ha</strong><span style="font-size:14px;color:var(--text-secondary)">Bón khi lúa phân hóa đòng</span></div>
</div>
<p style="margin:0;color:var(--text-secondary);text-align:justify;text-wrap:pretty"><strong style="color:var(--text-primary)">Cách bón:</strong> bón rải đều trên mặt ruộng khi ruộng còn ẩm hoặc có lớp nước nông, kết hợp làm cỏ, sục bùn. Liều lượng có thể điều chỉnh theo chân đất và giống lúa. Hãy liên hệ kỹ sư Tiến Nông để được hướng dẫn cụ thể.</p>
</section>

<section id="an-toan" style="scroll-margin-top:170px;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr));gap:20px">
<div style="background:var(--amber-100);border-radius:var(--radius-lg);padding:24px;display:flex;flex-direction:column;gap:10px"><h3 style="margin:0;font:700 20px var(--font-display)">Cảnh báo an toàn</h3><span>Không nguy hiểm khi tiếp xúc trực tiếp. Không độc hại cho người và gia súc. Rửa tay sạch sau khi sử dụng.</span></div>
<div style="background:var(--surface-card);border:1px solid var(--border-default);border-radius:var(--radius-lg);padding:24px;display:flex;flex-direction:column;gap:10px"><h3 style="margin:0;font:700 20px var(--font-display)">Bảo quản</h3><span>Bảo quản nơi khô ráo, thoáng mát, tránh ánh nắng trực tiếp. Buộc kín miệng bao sau khi sử dụng.</span></div>
</section>

<section id="thong-tin" style="scroll-margin-top:170px;display:flex;flex-direction:column;gap:20px">
<h2 style="margin:0;font:800 clamp(24px,2.6vw,32px)/1.2 var(--font-display)">Thông tin pháp lý</h2>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:0 32px;font-size:15px">
<div style="display:flex;justify-content:space-between;gap:16px;padding:12px 0;border-bottom:1px solid var(--border-default)"><span style="color:var(--text-secondary)">Mã số phân bón</span><strong>[mã số]</strong></div>
<div style="display:flex;justify-content:space-between;gap:16px;padding:12px 0;border-bottom:1px solid var(--border-default)"><span style="color:var(--text-secondary)">Loại phân bón</span><strong>Phân bón hỗn hợp NPK</strong></div>
<div style="display:flex;justify-content:space-between;gap:16px;padding:12px 0;border-bottom:1px solid var(--border-default)"><span style="color:var(--text-secondary)">Tiêu chuẩn cơ sở</span><strong>[số TCCS]</strong></div>
<div style="display:flex;justify-content:space-between;gap:16px;padding:12px 0;border-bottom:1px solid var(--border-default)"><span style="color:var(--text-secondary)">Hạn sử dụng</span><strong>36 tháng kể từ NSX</strong></div>
<div style="display:flex;justify-content:space-between;gap:16px;padding:12px 0;border-bottom:1px solid var(--border-default)"><span style="color:var(--text-secondary)">Ngày sản xuất</span><strong>In trên bao bì</strong></div>
<div style="display:flex;justify-content:space-between;gap:16px;padding:12px 0;border-bottom:1px solid var(--border-default)"><span style="color:var(--text-secondary)">Nơi sản xuất</span><strong>[Nhà máy]</strong></div>
</div></section>
</div>

<section style="background:var(--green-800);color:#fff">
<div style="max-width:1280px;margin:0 auto;padding:clamp(56px,7vw,88px) clamp(20px,4vw,56px);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,400px),1fr));gap:32px 64px;align-items:center">
<div style="position:relative;height:320px"><ImageSlot style="position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto;display:block" id="pd-model" shape="rounded" radius="16" placeholder="Ruộng lúa mô hình sử dụng NPK Lúa 2" /></div>
<div style="display:flex;flex-direction:column;gap:16px">
<span style="font:600 13px var(--font-mono);letter-spacing:.12em;color:var(--green-200)">MÔ HÌNH THỰC TẾ</span>
<h2 style="margin:0;font:800 clamp(26px,3vw,36px)/1.2 var(--font-display);text-wrap:balance">[Tên mô hình, địa phương, vụ]</h2>
<p style="margin:0;color:var(--green-100);text-align:justify">[Kết quả: năng suất đạt … tạ/ha, tăng …% so với ruộng đối chứng. Lời chia sẻ của hộ nông dân.]</p>
<a href={url('giai-phap')} style="color:#fff;font-weight:600">Xem mô hình →</a>
</div></div></section>

<section style="background:var(--surface-page)">
<div style="max-width:1280px;margin:0 auto;padding:clamp(56px,7vw,88px) clamp(20px,4vw,56px);display:flex;flex-direction:column;gap:28px">
<div style="display:flex;justify-content:space-between;align-items:flex-end;gap:16px;flex-wrap:wrap"><h2 style="margin:0;font:800 clamp(24px,2.6vw,32px)/1.2 var(--font-display)">Chương trình dinh dưỡng cho lúa</h2><a href={url('san-pham')} style="font-weight:600">Tất cả sản phẩm →</a></div>
<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:20px">
<a href={url('san-pham')} style="display:flex;flex-direction:column;background:var(--surface-card);border:1px solid var(--border-default);border-radius:var(--radius-lg);overflow:hidden;color:var(--text-primary)"><div style="position:relative;height:200px;background:var(--surface-sunken);padding:14px"><ImageSlot style="position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto;display:block" id="rel-1" shape="rounded" radius="10" fit="contain" placeholder="Bao bì" /></div><div style="padding:16px 18px;display:flex;flex-direction:column;gap:4px"><span style="font:600 12px var(--font-mono);color:var(--green-600)">BÓN LÓT</span><strong style="line-height:1.35">NPK 8-6-4+1,5SiO₂hh Tiến Nông (Lúa 1)</strong></div></a>
<a href={url('san-pham')} style="display:flex;flex-direction:column;background:var(--surface-card);border:1px solid var(--border-default);border-radius:var(--radius-lg);overflow:hidden;color:var(--text-primary)"><div style="position:relative;height:200px;background:var(--surface-sunken);padding:14px"><ImageSlot style="position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto;display:block" id="rel-2" shape="rounded" radius="10" fit="contain" placeholder="Bao bì" /></div><div style="padding:16px 18px;display:flex;flex-direction:column;gap:4px"><span style="font:600 12px var(--font-mono);color:var(--green-600)">ĐA DỤNG</span><strong style="line-height:1.35">NPK 15-15-15+1SiO₂hh Tiến Nông</strong></div></a>
<a href={url('san-pham')} style="display:flex;flex-direction:column;background:var(--surface-card);border:1px solid var(--border-default);border-radius:var(--radius-lg);overflow:hidden;color:var(--text-primary)"><div style="position:relative;height:200px;background:var(--surface-sunken);padding:14px"><ImageSlot style="position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto;display:block" id="rel-3" shape="rounded" radius="10" fit="contain" placeholder="Bao bì" /></div><div style="padding:16px 18px;display:flex;flex-direction:column;gap:4px"><span style="font:600 12px var(--font-mono);color:var(--green-600)">TRUNG VI LƯỢNG</span><strong style="line-height:1.35">Điều hòa pH đất 1 Tiến Nông</strong></div></a>
<a href={url('san-pham')} style="display:flex;flex-direction:column;background:var(--surface-card);border:1px solid var(--border-default);border-radius:var(--radius-lg);overflow:hidden;color:var(--text-primary)"><div style="position:relative;height:200px;background:var(--surface-sunken);padding:14px"><ImageSlot style="position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto;display:block" id="rel-4" shape="rounded" radius="10" fit="contain" placeholder="Bao bì" /></div><div style="padding:16px 18px;display:flex;flex-direction:column;gap:4px"><span style="font:600 12px var(--font-mono);color:var(--green-600)">ĐA DỤNG</span><strong style="line-height:1.35">Đạm vàng Tiến Nông bổ sung vi lượng</strong></div></a>
</div></div></section>
</Layout>

<style>
  .pd-view[aria-selected='true'] { border: 2px solid var(--green-500) !important; background: var(--green-50) !important; color: var(--green-800) !important; }
</style>
