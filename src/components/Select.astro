---
/** Design-system Select (TiNNNgDesignSystem.Select). */
interface Props {
  label?: string;
  options: { value: string; label: string }[];
  value?: string;
  name?: string;
  id?: string;
  disabled?: boolean;
  [key: string]: unknown;
}
const { label, options = [], value, name, id, disabled, ...rest } = Astro.props;
---
<label style="display:flex;flex-direction:column;gap:6px;font-family:var(--font-body);width:100%">
  {label && <span style="font-size:var(--text-sm);font-weight:var(--weight-medium);color:var(--text-primary)">{label}</span>}
  <select name={name} id={id} disabled={disabled} {...rest}
    style={`padding:10px 14px;border-radius:var(--radius-md);border:1px solid var(--border-default);font-size:var(--text-base);font-family:var(--font-body);color:var(--text-primary);background:${disabled ? 'var(--surface-sunken)' : 'var(--surface-card)'}`}>
    {options.map((o) => <option value={o.value} selected={o.value === value}>{o.label}</option>)}
  </select>
</label>
