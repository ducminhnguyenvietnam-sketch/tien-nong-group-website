---
import raw from '../content/pages/trang-chu.json';
import { withDefaults } from '../lib/content';
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import ImageSlot from '../components/ImageSlot.astro';
import Tabs from '../components/Tabs.astro';
import { link, url } from '../lib/routes';
import { CATEGORIES, getNews, getPress, isPress, newsLinkAttrs, newsUrl } from '../lib/news';
import newsRaw from '../content/pages/tin-tuc.json';

const c = withDefaults(raw, 'src/content/pages/trang-chu.json');

const latest = (await getNews()).filter((n) => !isPress(n)).slice(0, 3);
const press = await getPress(3);
const newsPage = withDefaults(newsRaw, 'src/content/pages/tin-tuc.json');

---
<Layout title={c.seo.title || undefined} description={c.seo.description || undefined} active="">
<section class="hero-slider" data-slider aria-roledescription="carousel" aria-label="Giới thiệu Tiến Nông" style="position:relative;height:min(78vh,720px);min-height:520px;background:var(--gray-800);overflow:hidden">
{c.hero_slides.map((s, k) => (
<div class:list={['hero-slide', { 'is-active': k === 0 }]} data-slide={k} data-empty-slide={k > 0 && !s.image?.src ? '' : undefined} role="group" aria-roledescription="slide" aria-label={`${k + 1} / ${c.hero_slides.length}`} aria-hidden={k === 0 ? 'false' : 'true'}>
<ImageSlot style="position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto;display:block" id={`hero-${k}`} shape="rect" placeholder={s.image.alt || 'Ảnh slide'} image={s.image} cms={`src/content/pages/trang-chu.json#hero_slides.${k}.image`} />
{s.show_text !== false && <>
<div class="hero-scrim" style="position:absolute;inset:0;pointer-events:none;background:linear-gradient(90deg,rgba(2,53,26,.8) 0%,rgba(2,53,26,.5) 45%,rgba(2,53,26,0) 78%)"></div>
<div class="hero-layer" style="position:absolute;inset:0;pointer-events:none;display:flex;align-items:center">
<div style="max-width:1280px;width:100%;margin:0 auto;padding:0 clamp(20px,4vw,56px)">
<div class="hero-copy" style="max-width:780px;display:flex;flex-direction:column;gap:22px;color:#fff">
{s.eyebrow && <span style="font:var(--type-eyebrow);letter-spacing:.08em;color:var(--green-100)">{s.eyebrow}</span>}
{k === 0
  ? <h1 style="margin:0;font:var(--type-display);letter-spacing:-.015em;text-wrap:balance">{s.title}</h1>
  : <h2 style="margin:0;font:var(--type-display);letter-spacing:-.015em;text-wrap:balance">{s.title}</h2>}
{s.text && <p style="margin:0;font-size:var(--fs-lead);line-height:1.55;color:var(--green-50);max-width:580px;text-wrap:pretty">{s.text}</p>}
<div style="display:flex;gap:12px;flex-wrap:wrap;pointer-events:auto">
{s.button1_label && <a href={link(s.button1_link)} style="text-decoration:none;display:inline-flex"><Button as="span" size="lg">{s.button1_label}</Button></a>}
{s.button2_label && <a href={link(s.button2_link)} style="text-decoration:none;display:inline-flex"><Button as="span" size="lg" variant="secondary">{s.button2_label}</Button></a>}
</div></div></div></div>
</>}
</div>
))}
{c.hero_slides.length > 1 && <>
<button type="button" class="hero-arrow" data-slide-step="-1" aria-label="Slide trước" style="left:clamp(8px,2vw,24px)">‹</button>
<button type="button" class="hero-arrow" data-slide-step="1" aria-label="Slide sau" style="right:clamp(8px,2vw,24px)">›</button>
<div class="hero-dots" role="tablist" aria-label="Chọn slide">
{c.hero_slides.map((_s, k) => <button type="button" role="tab" data-slide-to={k} aria-selected={k === 0 ? 'true' : 'false'} aria-label={`Slide ${k + 1}`}></button>)}
</div>
</>}
</section>

<section style="background:var(--surface-card);border-bottom:1px solid var(--border-default)">
<div style="max-width:1280px;margin:0 auto;padding:40px clamp(20px,4vw,56px) 44px;display:flex;flex-direction:column;gap:28px">
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(clamp(calc((100% - 72px)/4),calc((900px - 100%)*999),calc((100% - 24px)/2)),1fr));gap:24px">
<div style="display:flex;flex-direction:column;gap:2px"><span style="font:var(--type-stat);color:var(--green-700);overflow-wrap:normal;font-variant-numeric:tabular-nums">{c.s02_uy_tin.t1}</span><span style="font:600 13px/1.45 var(--font-body);letter-spacing:.06em;text-transform:uppercase;color:var(--text-secondary);margin-top:6px">{c.s02_uy_tin.t2}</span></div>
<div style="display:flex;flex-direction:column;gap:2px"><span style="font:var(--type-stat);color:var(--green-700);overflow-wrap:normal;font-variant-numeric:tabular-nums">{c.s02_uy_tin.t3}</span><span style="font:600 13px/1.45 var(--font-body);letter-spacing:.06em;text-transform:uppercase;color:var(--text-secondary);margin-top:6px">{c.s02_uy_tin.t4}</span></div>
<div style="display:flex;flex-direction:column;gap:2px"><span style="font:var(--type-stat);color:var(--green-700);overflow-wrap:normal;font-variant-numeric:tabular-nums">{c.s02_uy_tin.t5}</span><span style="font:600 13px/1.45 var(--font-body);letter-spacing:.06em;text-transform:uppercase;color:var(--text-secondary);margin-top:6px">{c.s02_uy_tin.t6}</span></div>
<div style="display:flex;flex-direction:column;gap:2px"><span style="font:var(--type-stat);color:var(--green-700);overflow-wrap:normal;font-variant-numeric:tabular-nums">{c.s02_uy_tin.t7}</span><span style="font:600 13px/1.45 var(--font-body);letter-spacing:.06em;text-transform:uppercase;color:var(--text-secondary);margin-top:6px">{c.s02_uy_tin.t8}</span></div>
</div>
<div class="awards" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(clamp(calc((100% - 84px)/4),calc((1084px - 100%)*999),calc((100% - 28px)/2)),1fr));gap:20px 28px;padding-top:24px;border-top:1px solid var(--border-default)">
<div style="display:flex;gap:12px;align-items:flex-start"><span style="flex:none;width:6px;align-self:stretch;min-height:44px;border-radius:3px;background:var(--amber-400)"></span><span style="display:flex;flex-direction:column;font:700 14px/1.45 var(--font-body);text-transform:uppercase;letter-spacing:.03em">{c.s02_uy_tin.t9}<span style="font-weight:600;color:var(--text-secondary)">{c.s02_uy_tin.t10}</span></span></div>
<div style="display:flex;gap:12px;align-items:flex-start"><span style="flex:none;width:6px;align-self:stretch;min-height:44px;border-radius:3px;background:var(--amber-400)"></span><span style="display:flex;flex-direction:column;font:700 14px/1.45 var(--font-body);text-transform:uppercase;letter-spacing:.03em">{c.s02_uy_tin.t11}<span style="font-weight:600;color:var(--text-secondary)">{c.s02_uy_tin.t12}</span></span></div>
<div style="display:flex;gap:12px;align-items:flex-start"><span style="flex:none;width:6px;align-self:stretch;min-height:44px;border-radius:3px;background:var(--amber-400)"></span><span style="display:flex;flex-direction:column;font:700 14px/1.45 var(--font-body);text-transform:uppercase;letter-spacing:.03em">{c.s02_uy_tin.t13}<span style="font-weight:600;color:var(--text-secondary)">{c.s02_uy_tin.t14}</span></span></div>
<div style="display:flex;gap:12px;align-items:flex-start"><span style="flex:none;width:6px;align-self:stretch;min-height:44px;border-radius:3px;background:var(--amber-400)"></span><span style="display:flex;flex-direction:column;font:700 14px/1.45 var(--font-body);text-transform:uppercase;letter-spacing:.03em">{c.s02_uy_tin.t15}<span style="font-weight:600;color:var(--text-secondary)">{c.s02_uy_tin.t16}</span></span></div>
</div>
<span style="font-size:13px;color:var(--text-tertiary)">{c.s02_uy_tin.t17} <a href={url('ve-tien-nong', 'thanh-tuu')}>{c.s02_uy_tin.t18}</a></span>
</div></section>

<section id="khoa-hoc" style="background:var(--green-800);color:#fff">
<div style="max-width:1280px;margin:0 auto;padding:clamp(64px,8vw,112px) clamp(20px,4vw,56px);display:flex;flex-direction:column;gap:48px">
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:40px 64px;align-items:end">
<div style="display:flex;flex-direction:column;gap:16px">
<span style="font:var(--type-eyebrow);letter-spacing:.08em;color:var(--green-200)">{c.s03_khoa_hoc_cong_nghe.t1}</span>
<h2 style="margin:0;font:var(--type-h1);letter-spacing:-.01em;text-wrap:balance; max-width:578px">{c.s03_khoa_hoc_cong_nghe.t2}</h2>
</div>
<p style="margin:0;font-size:var(--fs-lead);color:var(--green-100);text-wrap:pretty">{c.s03_khoa_hoc_cong_nghe.t3}</p>
</div>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,380px),1fr));gap:16px">
<div style="position:relative;height:420px"><ImageSlot style="position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto;display:block" id="rd-main" shape="rounded" radius="16" placeholder="Phòng thí nghiệm VILAS 1519 đang vận hành" image={c.s03_khoa_hoc_cong_nghe.img_rd_main_1} cms="src/content/pages/trang-chu.json#s03_khoa_hoc_cong_nghe.img_rd_main_1" /></div>
<div class="g-stack" style="display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:16px">
<div style="background:var(--green-700);border-radius:var(--radius-lg);padding:22px;display:flex;flex-direction:column;gap:8px"><span style="font:700 13px var(--font-mono);color:var(--green-200)">{c.s03_khoa_hoc_cong_nghe.t4}</span><strong style="font-size:18px;line-height:1.3">{c.s03_khoa_hoc_cong_nghe.t5}</strong><span style="color:var(--green-100);font-size:14px">{c.s03_khoa_hoc_cong_nghe.t6}</span></div>
<div style="background:var(--green-700);border-radius:var(--radius-lg);padding:22px;display:flex;flex-direction:column;gap:8px"><span style="font:700 13px var(--font-mono);color:var(--green-200)">{c.s03_khoa_hoc_cong_nghe.t7}</span><strong style="font-size:18px;line-height:1.3">{c.s03_khoa_hoc_cong_nghe.t8}</strong><span style="color:var(--green-100);font-size:14px">{c.s03_khoa_hoc_cong_nghe.t9}</span></div>
<div style="background:var(--green-700);border-radius:var(--radius-lg);padding:22px;display:flex;flex-direction:column;gap:8px"><span style="font:700 13px var(--font-mono);color:var(--green-200)">{c.s03_khoa_hoc_cong_nghe.t10}</span><strong style="font-size:18px;line-height:1.3">{c.s03_khoa_hoc_cong_nghe.t11}</strong><span style="color:var(--green-100);font-size:14px">{c.s03_khoa_hoc_cong_nghe.t12}</span></div>
<div style="background:var(--green-700);border-radius:var(--radius-lg);padding:22px;display:flex;flex-direction:column;gap:8px"><span style="font:700 13px var(--font-mono);color:var(--green-200)">{c.s03_khoa_hoc_cong_nghe.t13}</span><strong style="font-size:18px;line-height:1.3">{c.s03_khoa_hoc_cong_nghe.t14}</strong><span style="color:var(--green-100);font-size:14px">{c.s03_khoa_hoc_cong_nghe.t15}</span></div>
</div></div>
<div style="display:flex;justify-content:space-between;align-items:center;gap:20px;flex-wrap:wrap;padding-top:28px;border-top:1px solid var(--green-700)">
<div style="display:flex;gap:40px;flex-wrap:wrap">
<div style="display:flex;flex-direction:column"><span style="font:var(--type-stat);color:var(--amber-400);overflow-wrap:normal;font-variant-numeric:tabular-nums">{c.s03_khoa_hoc_cong_nghe.t16}</span><span style="font:600 13px/1.45 var(--font-body);letter-spacing:.06em;text-transform:uppercase;color:var(--green-100);margin-top:6px">{c.s03_khoa_hoc_cong_nghe.t17}</span></div>
<div style="display:flex;flex-direction:column"><span style="font:var(--type-stat);color:var(--amber-400);overflow-wrap:normal;font-variant-numeric:tabular-nums">{c.s03_khoa_hoc_cong_nghe.t18}</span><span style="font:600 13px/1.45 var(--font-body);letter-spacing:.06em;text-transform:uppercase;color:var(--green-100);margin-top:6px">{c.s03_khoa_hoc_cong_nghe.t19}</span></div>
<div style="display:flex;flex-direction:column"><span style="font:var(--type-stat);color:var(--amber-400);overflow-wrap:normal;font-variant-numeric:tabular-nums">{c.s03_khoa_hoc_cong_nghe.t20}</span><span style="font:600 13px/1.45 var(--font-body);letter-spacing:.06em;text-transform:uppercase;color:var(--green-100);margin-top:6px">{c.s03_khoa_hoc_cong_nghe.t21}</span></div>
</div>
<a href={url('khoa-hoc-cong-nghe')} style="color:#fff;font-weight:600;border:1px solid var(--green-400);border-radius:var(--radius-md);padding:12px 20px">{c.s03_khoa_hoc_cong_nghe.t22}</a>
</div></div></section>

<section id="doi-tuong" style="background:var(--surface-page)">
<div style="max-width:1280px;margin:0 auto;padding:clamp(64px,8vw,112px) clamp(20px,4vw,56px);display:flex;flex-direction:column;gap:40px">
<div style="display:flex;flex-direction:column;gap:14px;max-width:720px">
<span style="font:var(--type-eyebrow);letter-spacing:.08em;color:var(--green-600)">{c.s04_giai_phap_theo_doi_tuong.t1}</span>
<h2 style="margin:0;font:var(--type-h2);letter-spacing:-.01em;text-wrap:balance">{c.s04_giai_phap_theo_doi_tuong.t2}</h2>
</div>
<div class="aud-grid" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(clamp(calc((100% - 60px)/4),calc((1100px - 100%)*999),calc((100% - 20px)/2)),1fr));gap:20px">
<a href={url('giai-phap')} style="display:flex;flex-direction:column;background:var(--surface-card);border:1px solid var(--border-default);border-radius:var(--radius-lg);overflow:hidden;color:var(--text-primary)"><div style="position:relative;height:200px"><ImageSlot style="position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto;display:block" id="aud-farmer" shape="rect" placeholder="Nông dân trên ruộng" image={c.s04_giai_phap_theo_doi_tuong.img_aud_farmer_1} cms="src/content/pages/trang-chu.json#s04_giai_phap_theo_doi_tuong.img_aud_farmer_1" /></div><div style="padding:22px;display:flex;flex-direction:column;gap:8px;flex:1"><strong style="font-size:20px">{c.s04_giai_phap_theo_doi_tuong.t3}</strong><span style="color:var(--text-secondary);flex:1">{c.s04_giai_phap_theo_doi_tuong.t4}</span><span style="color:var(--green-600);font-weight:600">{c.s04_giai_phap_theo_doi_tuong.t5}</span></div></a>
<a href={url('lien-he', 'dai-ly')} style="display:flex;flex-direction:column;background:var(--surface-card);border:1px solid var(--border-default);border-radius:var(--radius-lg);overflow:hidden;color:var(--text-primary)"><div style="position:relative;height:200px"><ImageSlot style="position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto;display:block" id="aud-dealer" shape="rect" placeholder="Cửa hàng đại lý vật tư nông nghiệp" image={c.s04_giai_phap_theo_doi_tuong.img_aud_dealer_1} cms="src/content/pages/trang-chu.json#s04_giai_phap_theo_doi_tuong.img_aud_dealer_1" /></div><div style="padding:22px;display:flex;flex-direction:column;gap:8px;flex:1"><strong style="font-size:20px">{c.s04_giai_phap_theo_doi_tuong.t6}</strong><span style="color:var(--text-secondary);flex:1">{c.s04_giai_phap_theo_doi_tuong.t7} </span><span style="color:var(--green-600);font-weight:600">{c.s04_giai_phap_theo_doi_tuong.t8}</span></div></a>
<a href={url('giai-phap-du-an')} style="display:flex;flex-direction:column;background:var(--surface-card);border:1px solid var(--border-default);border-radius:var(--radius-lg);overflow:hidden;color:var(--text-primary)"><div style="position:relative;height:200px"><ImageSlot style="position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto;display:block" id="aud-project" shape="rect" placeholder="Sân golf / cảnh quan đô thị / nhà kính" image={c.s04_giai_phap_theo_doi_tuong.img_aud_project_1} cms="src/content/pages/trang-chu.json#s04_giai_phap_theo_doi_tuong.img_aud_project_1" /></div><div style="padding:22px;display:flex;flex-direction:column;gap:8px;flex:1"><strong style="font-size:20px">{c.s04_giai_phap_theo_doi_tuong.t9}</strong><span style="color:var(--text-secondary);flex:1">{c.s04_giai_phap_theo_doi_tuong.t10}</span><span style="color:var(--green-600);font-weight:600">{c.s04_giai_phap_theo_doi_tuong.t11}</span></div></a>
<a href={url('lien-he')} style="display:flex;flex-direction:column;background:var(--surface-card);border:1px solid var(--border-default);border-radius:var(--radius-lg);overflow:hidden;color:var(--text-primary)"><div style="position:relative;height:200px"><ImageSlot style="position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto;display:block" id="aud-export" shape="rect" placeholder="Container hàng xuất khẩu / kho" image={c.s04_giai_phap_theo_doi_tuong.img_aud_export_1} cms="src/content/pages/trang-chu.json#s04_giai_phap_theo_doi_tuong.img_aud_export_1" /></div><div style="padding:22px;display:flex;flex-direction:column;gap:8px;flex:1"><strong style="font-size:20px">{c.s04_giai_phap_theo_doi_tuong.t12}</strong><span style="color:var(--text-secondary);flex:1">{c.s04_giai_phap_theo_doi_tuong.t13}</span><span style="color:var(--green-600);font-weight:600">{c.s04_giai_phap_theo_doi_tuong.t14}</span></div></a>
</div>
<article class="org-card" style="display:grid;background:var(--surface-card);border:1px solid var(--border-default);border-radius:var(--radius-lg);overflow:hidden">
<div style="position:relative;min-height:260px"><ImageSlot style="position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto;display:block" id="aud-org" shape="rect" placeholder={c.s04_giai_phap_theo_doi_tuong.org_image.alt} image={c.s04_giai_phap_theo_doi_tuong.org_image} cms="src/content/pages/trang-chu.json#s04_giai_phap_theo_doi_tuong.org_image" /></div>
<div style="padding:clamp(22px,3vw,36px);display:flex;flex-direction:column;gap:12px">
<span style="font:var(--type-eyebrow);letter-spacing:.08em;color:var(--green-600)">{c.s04_giai_phap_theo_doi_tuong.org_eyebrow}</span>
<strong style="font:var(--type-h3)">{c.s04_giai_phap_theo_doi_tuong.org_title}</strong>
<p style="margin:0;color:var(--text-secondary);text-wrap:pretty">{c.s04_giai_phap_theo_doi_tuong.org_text}</p>
{c.s04_giai_phap_theo_doi_tuong.org_facts.length > 0 && <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px 20px;padding-top:14px;border-top:1px solid var(--border-default)">{c.s04_giai_phap_theo_doi_tuong.org_facts.map((f) => <div style="display:flex;flex-direction:column;gap:2px"><span style="font:var(--type-num);color:var(--green-700)">{f.value}</span><span style="font-size:13px;line-height:1.45;color:var(--text-secondary)">{f.label}</span></div>)}</div>}
<a href={link(c.s04_giai_phap_theo_doi_tuong.org_link)} style="align-self:flex-start;color:var(--green-600);font-weight:600">{c.s04_giai_phap_theo_doi_tuong.org_cta}</a>
</div>
</article>
</div></section>

<section id="san-pham" style="background:var(--surface-card)">
<div style="max-width:1280px;margin:0 auto;padding:clamp(64px,8vw,112px) clamp(20px,4vw,56px);display:flex;flex-direction:column;gap:32px">
<div style="display:flex;justify-content:space-between;align-items:flex-end;gap:24px;flex-wrap:wrap">
<div style="display:flex;flex-direction:column;gap:14px;max-width:640px">
<span style="font:var(--type-eyebrow);letter-spacing:.08em;color:var(--green-600)">{c.s05_san_pham.t1}</span>
<h2 style="margin:0;font:var(--type-h2);letter-spacing:-.01em;text-wrap:balance; max-width:787px">{c.s05_san_pham.t2}</h2>
</div>
<Tabs id="product-tabs" label="Xem sản phẩm" items={[{ value: 'line', label: c.product_tab_line }, { value: 'crop', label: c.product_tab_crop }]} value="line" />
</div>
