---
/**
 * Trở thành đối tác. Flow: hero → key figures → ways to partner → benefits → partner stories →
 * 5-step process → conditions → FAQ → pick a province to reach the sales director in charge (map).
 */
import raw from '../content/pages/tro-thanh-doi-tac.json';
import { isFilled, withDefaults } from '../lib/content';
import Head from '../components/story/Head.astro';
import FigureCard from '../components/FigureCard.astro';
import Faq from '../components/story/Faq.astro';
import Layout from '../layouts/Layout.astro';
import ImageSlot from '../components/ImageSlot.astro';
import PageHero from '../components/PageHero.astro';
import { url, asset, link } from '../lib/routes';
import { MAP_W, MAP_H, VN_PATH, PROVINCES, HOANG_SA, TRUONG_SA, project } from '../lib/vn-map';

const c = withDefaults(raw, 'src/content/pages/tro-thanh-doi-tac.json');
const partners = c.spotlight.partners.filter((p) => isFilled(p.name) && (isFilled(p.story) || isFilled(p.quote)));
const fill = 'position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto;display:block';
// In-page anchors stay as they are; site paths get the deploy base.
const href = (h: string) => (h.startsWith('#') ? h : link(h));
const F = 'src/content/pages/tro-thanh-doi-tac.json';
// Step icons: form, conversation, map pin, handshake/contract, storefront.
const ICONS = [
  '<path d="M7 3h7l4 4v14H7z"/><path d="M14 3v4h4"/><path d="M10 12h5M10 16h5"/>',
  '<path d="M4 5h11v8H8l-4 3z"/><path d="M15 9h5v8l-3-2h-6v-2"/>',
  '<path d="M12 21s-6-5.5-6-11a6 6 0 0 1 12 0c0 5.5-6 11-6 11z"/><circle cx="12" cy="10" r="2.2"/>',
  '<path d="M6 3h9l3 3v15H6z"/><path d="M9 14l2 2 4-4"/>',
  '<path d="M4 10h16l-1.5-5h-13z"/><path d="M5 10v10h14V10"/><path d="M10 20v-5h4v5"/>',
];

// Province → index of the sales director in charge. A province nobody was given falls back to the first director.
const owner: Record<string, number> = {};
c.managers.forEach((m, k) => (Array.isArray(m.provinces) ? m.provinces : []).forEach((p: string) => { if (!(p in owner)) owner[p] = k; }));
const ownerOf = (p: string) => owner[p] ?? 0;
const tel = (phone: string) => phone.replace(/[^\d+]/g, '');
const prettyPhone = (phone: string) => {
  const d = tel(phone);
  return /^0\d{9}$/.test(d) ? `${d.slice(0, 4)} ${d.slice(4, 7)} ${d.slice(7)}` : phone;
};
const pins = PROVINCES.map(([name, lat, lon]) => ({ name, xy: project(lat, lon), m: ownerOf(name) }));
const [hsx, hsy] = project(17.25, 111.3);
const [tsx, tsy] = project(11.75, 112.2);
---
<Layout align={c.can_le} title={c.seo.title || undefined} description={c.seo.description || undefined} active="">
<PageHero id="partner-hero" image={c.hero.image} cms={`${F}#hero.image`} placeholder="Ảnh đại lý Tiến Nông"
  crumbs={[{ label: c.hero.t1, href: url('trang-chu') }, { label: c.hero.t2.replace(/^\s*\/\s*/, '') }]}
  eyebrow={c.hero.eyebrow} title={c.hero.title} lead={c.hero.intro}>
<a href="#lien-he-khu-vuc" class="page-hero__btn page-hero__btn--solid">{c.hero.button1}</a><a href="#hinh-thuc" class="page-hero__btn">{c.hero.button2}</a>
</PageHero>

<FigureCard items={c.stats} overlap />

<section id="hinh-thuc" class="st-sec">
<div class="st-wrap">
<Head eyebrow={c.models.eyebrow} title={c.models.title} intro={c.models.intro} />
<div class="pt-models">
{c.models.items.map((m, k) => (
<div class="pt-model">
<span class="pt-model__n">{String(k + 1).padStart(2, '0')}</span>
<strong class="pt-model__title">{m.title}</strong>
<dl><div><dt>{c.models.who_label || 'Đối tượng'}</dt><dd class="jx-start">{m.who}</dd></div><div><dt>{c.models.get_label || 'Quyền lợi chính'}</dt><dd class="jx-start">{m.get}</dd></div></dl>
{isFilled(m.link) && <a class="pt-model__link" href={href(m.link)}>{m.link_label}</a>}
</div>
))}
</div>
</div></section>

<section id="quyen-loi" class="pt-tint" style="scroll-margin-top:120px">
<div style="max-width:var(--wrap, 1280px);margin:0 auto;padding:clamp(64px,8vw,112px) clamp(20px,4vw,56px);display:flex;flex-direction:column;gap:40px">
<div class="pt-head">
<div style="display:flex;flex-direction:column;gap:14px"><span style="font:var(--type-eyebrow);letter-spacing:.08em;color:var(--green-600)">{c.benefits.eyebrow}</span><h2 style="margin:0;font:var(--type-h2);letter-spacing:-.01em;text-wrap:balance">{c.benefits.title}</h2><p style="margin:0;color:var(--text-secondary);font-size:var(--fs-body);text-wrap:pretty">{c.benefits.intro}</p></div>
<div class="pt-photo" data-needs-photos={isFilled(c.benefits.image?.src) ? undefined : ''}><ImageSlot style="position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto;display:block" id="partner-benefits" shape="rounded" radius="16" placeholder="Ảnh minh hoạ quyền lợi" image={c.benefits.image} cms={`${F}#benefits.image`} sizes="(max-width: 767px) 92vw, 600px" /></div>
</div>
<div class="pt-benefits">
{c.benefits.items.map((b, k) => (
<div style="background:var(--surface-card);border:1px solid var(--border-default);border-radius:var(--radius-lg);padding:22px;display:flex;flex-direction:column;gap:8px">
<span style="width:44px;height:44px;border-radius:var(--radius-full);background:var(--green-50);color:var(--green-700);display:flex;align-items:center;justify-content:center;font:700 16px var(--font-display)">{String(k + 1).padStart(2, '0')}</span>
<strong style="font-size:18px;line-height:1.35">{b.title}</strong><span class="jx-start" style="color:var(--text-secondary);font-size:15px;line-height:1.6">{b.text}</span>
</div>
))}
</div></div></section>

{partners.length > 0 && <section id="cau-chuyen" class="st-sec st-sec--card">
<div class="st-wrap">
<Head eyebrow={c.spotlight.eyebrow} title={c.spotlight.title} intro={c.spotlight.intro} split />
<div class="pt-stories">
{partners.map((p, k) => (
<a class="pt-story" href={isFilled(p.link) ? link(p.link) : undefined}>
<div class="pt-story__img"><ImageSlot style={fill} id={`partner-${k}`} shape="rect" placeholder={p.image.alt} image={p.image} cms={`${F}#spotlight.partners.${k}.image`} sizes="(max-width: 899px) 92vw, 620px" /><span class="pt-story__kind">{p.kind}</span></div>
<span class="pt-story__label">{c.spotlight.card_label || 'CÂU CHUYỆN ĐỐI TÁC'}{isFilled(p.place) && <span> · {p.place}</span>}</span>
<strong class="pt-story__name">{p.name}</strong>
<p class="pt-story__line jx-start">{isFilled(p.line) ? p.line : p.story}</p>
{isFilled(p.link) && <span class="pt-story__more">Đọc câu chuyện <span aria-hidden="true">↗</span></span>}
</a>
))}
</div></div></section>}

<section id="quy-trinh" class="st-sec st-sec--dark pt-process">
<div class="st-wrap">
<Head eyebrow={c.process.eyebrow} title={c.process.title} />
<ol class="pt-steps">{c.process.steps.map((st, k) => <li>
<span class="pt-steps__ic" aria-hidden="true"><svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={ICONS[k % ICONS.length]} /><b>{k + 1}</b></span>
<strong>{st.title}</strong><span class="pt-steps__txt">{st.text}</span>
</li>)}</ol>
</div></section>

<section id="dieu-kien" style="background:var(--surface-card)">
<div style="max-width:var(--wrap, 1280px);margin:0 auto;padding:clamp(64px,8vw,112px) clamp(20px,4vw,56px);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:40px 72px;align-items:start">
<div style="display:flex;flex-direction:column;gap:16px">
<span style="font:var(--type-eyebrow);letter-spacing:.08em;color:var(--green-600)">{c.conditions.eyebrow}</span>
<h2 style="margin:0;font:var(--type-h2);letter-spacing:-.01em;text-wrap:balance">{c.conditions.title}</h2>
<p style="margin:0;color:var(--text-secondary);font-size:var(--fs-body);text-wrap:pretty">{c.conditions.intro}</p>
<div class="pt-photo pt-photo--sm" data-needs-photos={isFilled(c.conditions.image?.src) ? undefined : ''}><ImageSlot style="position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto;display:block" id="partner-conditions" shape="rounded" radius="16" placeholder="Ảnh minh hoạ điều kiện" image={c.conditions.image} cms={`${F}#conditions.image`} sizes="(max-width: 767px) 92vw, 560px" /></div>
</div>
<div style="display:flex;flex-direction:column;gap:24px">
<ol style="list-style:none;margin:0;padding:0;display:flex;flex-direction:column;border-top:1px solid var(--border-default)">
{c.conditions.items.map((it) => (
<li style="display:grid;grid-template-columns:32px minmax(0,1fr);gap:14px;padding:20px 0;border-bottom:1px solid var(--border-default)">
<span aria-hidden="true" style="width:28px;height:28px;border-radius:var(--radius-full);background:var(--green-500);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:800">✓</span>
<div style="display:flex;flex-direction:column;gap:4px"><strong style="font-size:18px">{it.title}</strong><span class="jx-start" style="color:var(--text-secondary)">{it.text}</span></div>
</li>
))}
</ol>
{isFilled(c.conditions.note) && <a href="#lien-he-khu-vuc" class="pt-cond-cta"><span>{c.conditions.note}</span><span class="pt-cond-cta__arrow" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M6 13l6 6 6-6"/></svg></span></a>}
</div></div></section>

<section id="hoi-dap" class="st-sec">
<div class="st-wrap">
<div class="pt-faq">
<Head eyebrow={c.faq.eyebrow} title={c.faq.title} />
<Faq id="pt-faq" items={c.faq.items} />
</div>
</div></section>

<section id="lien-he-khu-vuc" style="background:var(--green-900);color:#fff;scroll-margin-top:120px">
<div style="max-width:var(--wrap, 1280px);margin:0 auto;padding:clamp(64px,8vw,112px) clamp(20px,4vw,56px);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:40px 72px;align-items:center">
<div style="display:flex;flex-direction:column;gap:22px">
<span style="font:var(--type-eyebrow);letter-spacing:.08em;color:var(--green-200)">{c.region.eyebrow}</span>
<h2 style="margin:0;font:var(--type-h2);letter-spacing:-.01em;text-wrap:balance">{c.region.title}</h2>
<p style="margin:0;color:var(--green-100);font-size:var(--fs-body);text-wrap:pretty">{c.region.intro}</p>
<label style="display:flex;flex-direction:column;gap:8px"><span style="font-weight:600">{c.region.select_label}</span>
<select id="region-prov" style="padding:13px 14px;border-radius:var(--radius-md);border:0;font:600 16px var(--font-body);color:var(--text-primary);background:#fff;outline-color:var(--amber-400)">
<option value="">{c.region.select_placeholder}</option>
{[...PROVINCES].map(([n]) => n).sort((a, b) => a.localeCompare(b, 'vi')).map((n) => <option value={n} data-m={ownerOf(n)}>{n}</option>)}
</select></label>
<div id="region-empty" style="padding:18px 20px;border:1px dashed var(--green-600);border-radius:var(--radius-lg);color:var(--green-100)">{c.region.empty_text}</div>
{c.managers.map((m, k) => (
<div data-manager={k} hidden style="background:#fff;color:var(--text-primary);border-radius:var(--radius-lg);padding:22px 24px;display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:16px">
<div style="display:flex;flex-direction:column;gap:4px;min-width:0">
<span style="font:var(--type-eyebrow);letter-spacing:.08em;color:var(--green-600)">{c.region.result_label} <span data-prov-name></span></span>
<strong style="font:var(--type-num)">{m.name}</strong>
<span style="color:var(--text-secondary)">{[m.title, m.region].filter(Boolean).join(' · ')}</span>
<a href={`tel:${tel(m.phone)}`} style="font:700 18px var(--font-mono);color:var(--green-700)">{prettyPhone(m.phone)}</a>
</div>
<a href={`tel:${tel(m.phone)}`} style="display:inline-flex;align-items:center;gap:8px;background:var(--green-500);color:#fff;font-weight:700;padding:13px 22px;border-radius:var(--radius-md);white-space:nowrap"><span aria-hidden="true">☎</span> {c.region.call_label}</a>
</div>
))}
<span style="color:var(--green-100);font-size:15px">{c.region.form_text} <a href={`${url('lien-he')}?chu-de=${encodeURIComponent('Đăng ký làm đại lý')}#lien-he-form`} style="color:#fff;font-weight:700">{c.region.form_link}</a></span>
</div>
<figure style="margin:0;position:relative">
{c.region.map_image.src ? (
<div style="position:relative;height:min(80vh,640px)"><ImageSlot style="position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto;display:block" id="partner-map" shape="rounded" radius="16" fit="contain" placeholder={c.region.map_alt} image={c.region.map_image} cms={`${F}#region.map_image`} /></div>
) : (
<svg id="vn-map" viewBox={`-10 -10 ${MAP_W + 20} ${MAP_H + 20}`} role="img" aria-label={c.region.map_alt} style="display:block;width:100%;max-height:min(80vh,680px);overflow:visible">
<path d={VN_PATH} fill="#e9f5ec" stroke="#8fd3a6" stroke-width="1" stroke-linejoin="round" />
{HOANG_SA.map(([la, lo]) => { const [x, y] = project(la, lo); return <circle cx={x} cy={y} r="2" fill="#e9f5ec" />; })}
{TRUONG_SA.map(([la, lo]) => { const [x, y] = project(la, lo); return <circle cx={x} cy={y} r="2" fill="#e9f5ec" />; })}
<text x={hsx} y={hsy} fill="#bfe6cc" font-size="13" font-weight="600" font-family="var(--font-body)">QĐ. Hoàng Sa</text>
<text x={tsx} y={tsy} fill="#bfe6cc" font-size="13" font-weight="600" font-family="var(--font-body)">QĐ. Trường Sa</text>
{pins.map((p) => (
<g class="vn-pin" data-prov={p.name} data-m={p.m} transform={`translate(${p.xy[0].toFixed(1)} ${p.xy[1].toFixed(1)})`}>
<title>{p.name}</title>
<g class="vn-pin__body">
<circle r="9.5" fill="#fff" stroke="#03a64a" stroke-width="1.5" />
<image href={asset('assets/logo-mark.png')} x="-7.5" y="-7.5" width="15" height="15" />
</g>
<text class="vn-pin__label" x="14" y="5" font-size="14" font-weight="700" font-family="var(--font-body)" fill="#fff">{p.name}</text>
</g>
))}
</svg>
)}
</figure>
</div></section>
</Layout>

<style>
  .pt-head { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 28px 64px; align-items: center; }
  .pt-photo { position: relative; aspect-ratio: 16 / 9; border-radius: 16px; overflow: hidden; }
  .pt-photo--sm { margin-top: 8px; aspect-ratio: 3 / 2; }
  @media (max-width: 899.98px) { .pt-head { grid-template-columns: minmax(0, 1fr); } }

  /* Ways to partner: four cards, number, who it suits and what they get. */
  .pt-models { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 18px; }
  .pt-model { display: flex; flex-direction: column; gap: 12px; padding: 24px 22px; background: var(--surface-card); border: 1px solid var(--border-default); border-radius: var(--radius-lg); transition: box-shadow var(--motion-fast), border-color var(--motion-fast); }
  .pt-model:hover { border-color: var(--green-300); box-shadow: 0 14px 30px rgba(0, 71, 35, .08); }
  .pt-model__n { font: 700 32px/1 var(--font-display); color: var(--brand-bright); }
  .pt-model__title { font: 700 18px/1.35 var(--font-display); }
  .pt-model dl { margin: 0; display: flex; flex-direction: column; gap: 10px; }
  .pt-model dt { font: 600 11.5px/1.3 var(--font-display); letter-spacing: .08em; text-transform: uppercase; color: var(--amber-600); }
  .pt-model dd { margin: 3px 0 0; font-size: 15px; line-height: 1.55; color: var(--text-secondary); }
  .pt-model__link { margin-top: auto; padding-top: 6px; font-weight: 600; font-size: 15px; color: var(--brand-bright); }
  /* Partner stories: 2 × 2 large landscape photos, label, name, one line, link. */
  .pt-stories { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 40px 36px; }
  .pt-story { display: flex; flex-direction: column; gap: 10px; padding-bottom: 22px; border-bottom: 1px solid var(--border-default); color: var(--text-primary); text-decoration: none; }
  .pt-story:hover { text-decoration: none; color: var(--text-primary); }
  .pt-story__img { position: relative; aspect-ratio: 16 / 9; border-radius: 6px; overflow: hidden; margin-bottom: 8px; }
  .pt-story__img :global(.img-slot) { transition: transform .6s var(--ease-out); }
  .pt-story:hover .pt-story__img :global(.img-slot) { transform: scale(1.04); }
  .pt-story__kind { position: absolute; left: 14px; top: 14px; padding: 5px 10px; border-radius: 6px; background: rgba(2, 53, 26, .82); color: var(--brand-highlight); font: 700 11px/1.2 var(--font-display); letter-spacing: .08em; }
  .pt-story__label { font: 700 12px/1.3 var(--font-display); letter-spacing: .1em; color: var(--green-600); }
  .pt-story__label span { color: var(--text-tertiary); font-weight: 600; letter-spacing: .02em; }
  .pt-story__name { font: 700 clamp(21px, 1.8vw, 25px)/1.3 var(--font-display); color: var(--green-900); }
  .pt-story__line { margin: 0; color: var(--text-secondary); font-size: 15.5px; line-height: 1.6; }
  .pt-story__more { font-weight: 600; font-size: 14.5px; color: var(--brand-bright); }
  .pt-story:hover .pt-story__more { text-decoration: underline; }
  /* Five steps: icons on a connecting line. */
  .pt-steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 20px; position: relative; }
  /* The dashed line runs only in the gaps between the circles (it no longer crosses the icons). */
  .pt-steps li:not(:last-child)::after { content: ''; position: absolute; top: 35px; left: calc(50% + 46px); right: calc(-50% - 20px + 46px); height: 2px; background: repeating-linear-gradient(90deg, var(--green-300) 0 8px, transparent 8px 14px); }
  .pt-steps li { position: relative; display: flex; flex-direction: column; align-items: center; text-align: center; gap: 8px; }
  .pt-steps__ic { position: relative; display: grid; place-items: center; width: 72px; height: 72px; margin-bottom: 8px; border-radius: 50%; background: var(--surface-card); border: 2px solid var(--brand-bright); color: var(--green-700); box-shadow: 0 8px 20px rgba(0, 71, 35, .08); transition: background var(--motion-fast), color var(--motion-fast); }
  .pt-steps li:hover .pt-steps__ic { background: var(--brand-bright); color: #fff; }
  .pt-steps__ic b { position: absolute; right: -4px; top: -4px; display: grid; place-items: center; width: 26px; height: 26px; border-radius: 50%; background: var(--brand-highlight); color: var(--green-900); font: 700 13px/1 var(--font-display); }
  .pt-steps strong { font: 700 17px/1.35 var(--font-display); }
  .pt-steps li > span:last-child { font-size: 14.5px; line-height: 1.55; color: var(--text-secondary); max-width: 220px; }
  :global(main) .pt-steps__txt { text-align: center !important; text-align-last: center !important; }
  /* Six benefits: 3 + 3 on wide screens, 2 + 2 + 2 on tablets, one column on phones. */
  .pt-benefits { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
  @media (max-width: 1023.98px) { .pt-benefits { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 599.98px) { .pt-benefits { grid-template-columns: minmax(0, 1fr); } }
  /* "Chính sách cụ thể theo khu vực…": a button down to the regional contacts. */
  .pt-cond-cta { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 16px 18px 16px 22px; border-radius: var(--radius-md); background: var(--green-50); border: 1px solid var(--green-200);
    color: var(--green-800); font: 600 15.5px/1.5 var(--font-display); text-decoration: none; transition: background var(--motion-fast), border-color var(--motion-fast), color var(--motion-fast); }
  .pt-cond-cta:hover { background: var(--brand-bright); border-color: var(--brand-bright); color: #fff; text-decoration: none; }
  .pt-cond-cta__arrow { flex: none; display: grid; place-items: center; width: 36px; height: 36px; border-radius: 50%; background: var(--brand-bright); color: #fff; transition: background var(--motion-fast), color var(--motion-fast); }
  .pt-cond-cta:hover .pt-cond-cta__arrow { background: #fff; color: var(--brand-bright); }
  /* Alternating backgrounds: grey → soft green (benefits) → white (stories) → dark green (process) → white → grey. */
  .pt-tint { position: relative; background: linear-gradient(180deg, var(--green-50) 0%, #f3faf5 100%); }
  .pt-process { position: relative; overflow: hidden; }
  .pt-process::after { content: ''; position: absolute; right: -140px; top: -160px; width: 460px; height: 460px; border-radius: 50%; background: radial-gradient(circle, rgba(245, 196, 78, .14), rgba(245, 196, 78, 0) 70%); pointer-events: none; }
  .pt-process .pt-steps li:not(:last-child)::after { background: repeating-linear-gradient(90deg, rgba(245, 196, 78, .55) 0 8px, transparent 8px 14px); }
  .pt-process .pt-steps__ic { background: rgba(255, 255, 255, .08); border-color: var(--brand-highlight); color: #fff; box-shadow: none; }
  .pt-process .pt-steps li:hover .pt-steps__ic { background: var(--brand-highlight); color: var(--green-900); }
  .pt-process .pt-steps strong { color: #fff; }
  .pt-process .pt-steps li > span:last-child { color: var(--green-100); }
  .pt-faq { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); gap: 32px 72px; align-items: start; }
  @media (max-width: 1099.98px) { .pt-models { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 899.98px) {
    .pt-stories, .pt-faq { grid-template-columns: minmax(0, 1fr); }
    .pt-steps { grid-template-columns: minmax(0, 1fr); gap: 18px; }
    .pt-steps li::after { display: none; }
    :global(main) .pt-steps__txt { text-align: start !important; text-align-last: auto !important; }
    .pt-steps li { flex-direction: row; text-align: left; align-items: center; flex-wrap: wrap; column-gap: 16px; }
    .pt-steps__ic { width: 56px; height: 56px; margin: 0; }
    .pt-steps li > span:last-child { text-align: left; text-align-last: left; max-width: none; flex-basis: 100%; padding-left: 72px; margin-top: -8px; }
  }
  @media (max-width: 599.98px) { .pt-models { grid-template-columns: minmax(0, 1fr); } }
  .vn-pin { cursor: pointer; }
  .vn-pin__body { transition: transform .2s, opacity .2s; transform-box: fill-box; transform-origin: center; }
  .vn-pin__label { display: none; paint-order: stroke; stroke: rgba(2, 53, 26, .85); stroke-width: 4px; }
  #vn-map[data-m] .vn-pin:not(.is-region) .vn-pin__body { opacity: .4; }
  .vn-pin.is-active .vn-pin__body { transform: scale(1.7); }
  .vn-pin.is-active .vn-pin__label { display: block; }
  .vn-pin:hover .vn-pin__body, .vn-pin:focus .vn-pin__body { transform: scale(1.35); }
  @media (prefers-reduced-motion: reduce) { .vn-pin__body { transition: none; } }
</style>

<script>
  // Picking a province (in the list or on the map) shows the sales director in charge and highlights their region.
  const select = document.getElementById('region-prov') as HTMLSelectElement;
  const map = document.getElementById('vn-map');
  const pins = [...document.querySelectorAll<SVGGElement>('.vn-pin')];
  function show(prov: string) {
    const opt = [...select.options].find((o) => o.value === prov);
    const m = opt?.dataset.m ?? '';
    document.getElementById('region-empty')!.hidden = !!prov;
    document.querySelectorAll<HTMLElement>('[data-manager]').forEach((card) => {
      card.hidden = !prov || card.dataset.manager !== m;
      card.querySelectorAll('[data-prov-name]').forEach((el) => { el.textContent = prov ? `· ${prov.toUpperCase()}` : ''; });
    });
    if (map) {
      if (prov) map.dataset.m = m; else delete map.dataset.m;
      pins.forEach((p) => {
        p.classList.toggle('is-region', !!prov && p.dataset.m === m);
        p.classList.toggle('is-active', p.dataset.prov === prov);
        if (p.dataset.prov === prov) p.parentNode!.appendChild(p); // draw the chosen pin on top
      });
    }
  }
  select.addEventListener('change', () => show(select.value));
  pins.forEach((p) => p.addEventListener('click', () => { select.value = p.dataset.prov ?? ''; show(select.value); }));
  if (select.value) show(select.value);
</script>
