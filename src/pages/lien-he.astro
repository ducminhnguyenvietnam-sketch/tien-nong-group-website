---
/**
 * Liên hệ. Flow: hero → six contact points, one per need → check a genuine product (QR) and report
 * a problem → find a dealer: the sales director in charge of each province (data shared with
 * Trở thành đối tác) → head office & plants → request form (forwarded to the company mailbox) → social channels.
 */
import raw from '../content/pages/lien-he.json';
import partnerRaw from '../content/pages/tro-thanh-doi-tac.json';
import { isFilled, withDefaults } from '../lib/content';
import siteRaw from '../content/site.json';
import Layout from '../layouts/Layout.astro';
import FormFallback from '../components/FormFallback.astro';
import ImageSlot from '../components/ImageSlot.astro';
import Head from '../components/story/Head.astro';
import { asset, url, link } from '../lib/routes';
import { localeOf } from '../lib/i18n';
/** Language of this page (vi / en / zh): content is read in that language. */
const L = localeOf(Astro.url);

const c = withDefaults(raw, 'src/content/pages/lien-he.json', L);
const partner = withDefaults(partnerRaw, 'src/content/pages/tro-thanh-doi-tac.json', L);
const site = withDefaults(siteRaw, 'src/content/site.json', L);
const F = 'src/content/pages/lien-he.json';
const co = site.company as Record<string, string>;
const social = Object.entries(site.social as Record<string, string>).filter(([k, v]) => isFilled(v) && k in { facebook: 1, youtube: 1, tiktok: 1, linkedin: 1, zalo: 1 }).sort(([a], [b]) => ['facebook', 'youtube', 'tiktok', 'linkedin', 'zalo'].indexOf(a) - ['facebook', 'youtube', 'tiktok', 'linkedin', 'zalo'].indexOf(b));
// Social platforms in their own brand colours (logo + name + handle), in this order.
const NETWORKS: Record<string, { name: string; color: string; svg: string }> = {
  facebook: { name: 'Facebook', color: '#1877F2', svg: '<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="12" fill="#1877F2"/><path fill="#fff" d="M13.4 19.5v-6h2l.3-2.4h-2.3V9.6c0-.7.2-1.2 1.2-1.2h1.2V6.3c-.2 0-1-.1-1.8-.1-1.8 0-3 1.1-3 3.1v1.8H9v2.4h2v6h2.4z"/></svg>' },
  messenger: { name: 'Messenger', color: '#0A7CFF', svg: '<svg viewBox="0 0 24 24"><defs><linearGradient id="msg-g" x1="0" y1="1" x2="1" y2="0"><stop offset="0" stop-color="#0099FF"/><stop offset=".6" stop-color="#A033FF"/><stop offset="1" stop-color="#FF5C87"/></linearGradient></defs><circle cx="12" cy="12" r="12" fill="url(#msg-g)"/><path fill="#fff" d="M12 5.2c-3.9 0-6.9 2.8-6.9 6.6 0 2 .8 3.7 2.2 4.9v2.4l2.1-1.2c.8.2 1.6.4 2.6.4 3.9 0 6.9-2.8 6.9-6.5S15.9 5.2 12 5.2zm.7 8.8-1.8-1.9-3.4 1.9 3.8-4 1.8 1.9 3.4-1.9-3.8 4z"/></svg>' },
  youtube: { name: 'YouTube', color: '#FF0000', svg: '<svg viewBox="0 0 24 24"><rect x="1" y="4.5" width="22" height="15" rx="4.5" fill="#FF0000"/><path fill="#fff" d="M10 8.8v6.4l5.6-3.2z"/></svg>' },
  tiktok: { name: 'TikTok', color: '#000000', svg: '<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="12" fill="#000"/><path fill="#25F4EE" d="M10.1 10.6v-.7a4.4 4.4 0 0 0-.6 0 4 4 0 1 0 2.4 7.3 4 4 0 0 1-1.8-6.6z"/><path fill="#FE2C55" d="M10.2 17.8a1.9 1.9 0 0 0 1.9-1.8V6.2h1.8a3.4 3.4 0 0 1-.1-.7h-2.4V15a1.9 1.9 0 0 1-1.9 1.8 1.9 1.9 0 0 1-.9-.2 1.9 1.9 0 0 0 1.6 1.2zm7.2-8.4v-.7a3.3 3.3 0 0 1-1.8-.5 3.4 3.4 0 0 0 1.8 1.2z"/><path fill="#fff" d="M15.6 8.2a3.4 3.4 0 0 1-.8-2.2h-.7a3.4 3.4 0 0 0 1.5 2.2zm-5.4 4.1a1.9 1.9 0 0 0-.9 3.6 1.9 1.9 0 0 1 1.6-3 1.9 1.9 0 0 1 .6.1v-2.4a4 4 0 0 0-.6 0h-.1v1.8a1.9 1.9 0 0 0-.6-.1zm7.2-2.9v1.8a5.4 5.4 0 0 1-3.2-1v4.6a4.2 4.2 0 0 1-6.6 3.4 4.2 4.2 0 0 0 7.3-2.8V10.8a5.4 5.4 0 0 0 3.2 1V9.4a3.3 3.3 0 0 1-.7 0z"/></svg>' },
  linkedin: { name: 'LinkedIn', color: '#0A66C2', svg: '<svg viewBox="0 0 24 24"><rect width="24" height="24" rx="5" fill="#0A66C2"/><path fill="#fff" d="M7.3 9.6h2.3v7.5H7.3zm1.2-3.7a1.3 1.3 0 1 1 0 2.7 1.3 1.3 0 0 1 0-2.7zm2.6 3.7h2.2v1h.1c.3-.6 1.1-1.2 2.2-1.2 2.4 0 2.8 1.6 2.8 3.6v4.1h-2.3v-3.6c0-.9 0-2-1.2-2s-1.4.9-1.4 1.9v3.7h-2.4z"/></svg>' },
  zalo: { name: 'Zalo OA', color: '#0068FF', svg: '<svg viewBox="0 0 24 24"><rect width="24" height="24" rx="6" fill="#0068FF"/><path fill="#fff" d="M5.6 8.4h4.9v.9l-3.2 4.1h3.2v1.2H5.4v-.9l3.2-4.1H5.6zm6 2h1.1v4.2h-1.1v-.4a1.8 1.8 0 0 1-1.2.5 2.2 2.2 0 1 1 0-4.4 1.8 1.8 0 0 1 1.2.4zm-1.1 3.2a1.1 1.1 0 1 0 0-2.2 1.1 1.1 0 0 0 0 2.2zm2.7-5.2h1.2v6.2h-1.2zm4 2a2.2 2.2 0 1 1 0 4.4 2.2 2.2 0 0 1 0-4.4zm0 3.3a1.1 1.1 0 1 0 0-2.2 1.1 1.1 0 0 0 0 2.2z"/></svg>' },
};
const handle = (u: string) => { try { const seg = new URL(u).pathname.split('/').filter(Boolean).pop() ?? ''; return seg ? `@${seg.replace(/^@/, '')}` : new URL(u).hostname; } catch { return u; } };
const mailbox = (c.form.email || co.email || '').trim();
const topics = (c.form.topics ?? []).filter((t) => isFilled(t.label));
const fill = 'position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto;display:block';
// Contact values become tap-to-call / tap-to-mail links; a placeholder hotline falls back to the company number.
const value = (v: string) => (isFilled(v) ? v : v.trim() ? co.phone : '');
const contactHref = (v: string) => (v.includes('@') ? `mailto:${v.trim()}` : v.replace(/[^\d+]/g, '').length >= 8 ? `tel:${v.replace(/[^\d+]/g, '')}` : undefined);
// In-page anchors stay as they are; site paths get the deploy base.
const href = (h: string) => (h.startsWith('#') ? h : link(h));
const tel = (phone: string) => phone.replace(/[^\d+]/g, '');
// Icons for the six contact points: leaf (engineers), cart, handshake, briefcase, megaphone, people.
const ROUTE_ICONS = [
  '<path d="M5 19c0-8 5-13 14-14-1 9-6 14-14 14z"/><path d="M5 19l7-7"/>',
  '<circle cx="9" cy="20" r="1.4"/><circle cx="17" cy="20" r="1.4"/><path d="M3 4h2l2.4 11h11L21 7H6.2"/>',
  '<path d="M3 12l4-4 4 3 3-3 7 6"/><path d="M7 16l3 3M10 14l3 3M13 13l3 3"/>',
  '<rect x="3" y="7" width="18" height="13" rx="2"/><path d="M9 7V5h6v2M3 13h18"/>',
  '<path d="M4 10v4h3l7 4V6L7 10z"/><path d="M18 9a4 4 0 0 1 0 6"/>',
  '<circle cx="9" cy="8" r="3"/><path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6"/><path d="M16 4a3 3 0 0 1 0 6M21 20c0-2.6-1.6-4.8-4-5.6"/>',
];
const prettyPhone = (phone: string) => {
  const d = tel(phone);
  return /^0\d{9}$/.test(d) ? `${d.slice(0, 4)} ${d.slice(4, 7)} ${d.slice(7)}` : phone;
};
// Each office/plant card links to Google Maps: the CMS link if set, else a search for the address.
const mapsFor = (address: string, custom?: string | null) =>
  custom?.trim() || `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(address.replace(/ /g, ' '))}`;
---
<Layout align={c.can_le} title={c.seo.title || undefined} description={c.seo.description || undefined} active="">
<section class="lh-hero">
<div class="lh-hero__wrap">
<nav class="lh-hero__crumbs" aria-label="Đường dẫn"><a href={url('trang-chu')}>{c.hero.t1}</a> <span aria-hidden="true">/</span> <span aria-current="page">{c.hero.t2.replace(/^\s*\/\s*/, '')}</span></nav>
<span class="lh-hero__eyebrow">{c.hero.eyebrow}</span>
<h1>{c.hero.title}</h1>
<p>{[c.hero.lead, c.hero.hours].filter(isFilled).join(' ')}</p>
</div>
</section>
<section class="lh-routes" id="dau-moi" aria-label={c.routes.eyebrow}>
<div class="lh-routes__grid">
{c.routes.items.map((r, k) => {
  const v = value(r.value ?? '');
  return (
    <div class="lh-route">
      <span class="lh-route__ic" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={ROUTE_ICONS[k % ROUTE_ICONS.length]} /></span>
      <span class="lh-route__label">{r.label}</span>
      {isFilled(v) && <a class="lh-route__value" href={contactHref(v)}>{v}</a>}
      <span class="lh-route__note jx-start">{r.note}</span>
      {isFilled(r.link) && <a class="lh-route__link" href={href(r.link)}>{r.link_label}</a>}
    </div>
  );
})}
</div>
</section>

<section class="st-sec" id="chinh-hang">
<div class="st-wrap">
<div class="lh-genuine">
<div class="lh-genuine__main">
<Head eyebrow={c.genuine.eyebrow} title={c.genuine.title} intro={c.genuine.intro} />
<ol class="st-steps lh-genuine__steps">{c.genuine.steps.map((s) => <li><strong>{s.title}</strong><span>{s.text}</span></li>)}</ol>
</div>
<div class="lh-genuine__report">
<strong style="font:var(--type-h3)">{c.genuine.report_title}</strong>
<p class="jx-start" style="margin:0;color:var(--green-100);line-height:1.65">{c.genuine.report_text}</p>
<div class="st-actions">{isFilled(c.genuine.report_phone) && <a href={contactHref(c.genuine.report_phone)} class="st-btn" style="background:#fff;border-color:#fff;color:var(--green-700)">☎ {c.genuine.report_phone}</a>}<a href="#lien-he-form" data-topic="Phản ánh chất lượng sản phẩm" class="st-btn" style="border-color:rgba(255,255,255,.5);color:#fff">Gửi phản ánh</a></div>
</div>
</div>
</div></section>

<section class="st-sec lh-tint" id="dai-ly">
<div class="st-wrap">
<Head eyebrow={c.regions.eyebrow} title={c.regions.title} intro={c.regions.intro} split />
<div class="lh-dirs">
{partner.managers.map((m, k) => (
<article class="lh-dir">
<div class="lh-dir__img"><ImageSlot style={fill} id={`dir-${k}`} shape="rect" placeholder={m.image?.alt || m.area || m.region} image={m.image} cms={`src/content/pages/tro-thanh-doi-tac.json#managers.${k}.image`} sizes="(max-width: 899px) 92vw, 400px" /><span class="lh-dir__region">{m.region}</span></div>
<div class="lh-dir__body">
{isFilled(m.area) && <span class="lh-dir__area">{m.area}</span>}
<strong class="lh-dir__name">{m.name}</strong>
<span class="lh-dir__title">{m.title}</span>
<a class="lh-dir__call" href={`tel:${tel(m.phone)}`}><span aria-hidden="true">☎</span><span>{prettyPhone(m.phone)}</span><em>{c.regions.call_label}</em></a>
{Array.isArray(m.provinces) && m.provinces.length > 0 && <div class="lh-dir__prov"><span>{c.regions.provinces_label}</span><ul>{(m.provinces as string[]).map((pv) => <li>{pv}</li>)}</ul></div>}
</div>
</article>
))}
</div>
<a href={url('tro-thanh-doi-tac', 'lien-he-khu-vuc')} class="lh-more">{c.regions.map_label}</a>
</div></section>

<section id="nha-may" class="st-sec">
<div class="st-wrap">
<Head title={c.sites.title} />
<div class="g-stack" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(clamp(calc((100% - 48px)/4),calc((1088px - 100%)*999),calc((100% - 16px)/2)),1fr));gap:16px">
{c.sites.items.map((p, k) => (
<article class="site-card">
<div class:list={['site-card__img', { 'is-empty': !isFilled(p.image?.src) }]}><svg class="site-card__icon" viewBox="0 0 48 48" aria-hidden="true"><path d="M4 42V22l10 6v-6l10 6v-6l10 6V8h8v34z" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round"/><path d="M12 36h4M22 36h4M32 36h4" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg><ImageSlot style={fill} id={`site-${k + 1}`} shape="rect" placeholder={p.image?.alt || p.name} image={p.image} cms={`${F}#sites.items.${k}.image`} sizes="(max-width: 767px) 92vw, 320px" /></div>
<div class="site-card__body"><span class="site-card__tag">{p.tag}</span><strong>{p.name}</strong>{isFilled(p.role) && <span class="site-card__role">{p.role}</span>}<span class="site-card__addr">{p.address}</span><a href={`tel:${tel(p.phone)}`} class="site-card__phone">{p.phone}</a><a href={mapsFor(p.address, p.map)} target="_blank" rel="noopener" class="site-card__map">{c.sites.map_label}</a></div>
</article>
))}
</div>
{isFilled(c.sites.visit_text) && <p class="st-note" style="margin:0">{c.sites.visit_text}</p>}
</div></section>

<section id="lien-he-form" class="lh-form" style={`--leaf:url(${asset('assets/logo-la-chi.png')})`}>
<div class="lh-form__wrap">
<div class="lh-form__aside">
<span class="lh-form__eyebrow">{c.form.eyebrow}</span>
<h2>{c.form.title}</h2>
<p>{c.form.intro}</p>
<div class="lh-quick">
<strong>{c.form.quick_title}</strong>
<ul>
{isFilled(co.phone) && <li><span class="lh-quick__ic" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M21 16.4v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 1.1 3.6 2 2 0 0 1 3.1 1.5h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L7 9.4a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/></svg></span><span><small>Tổng đài</small><a href={`tel:${tel(co.phone)}`}>{co.phone}</a></span></li>}
{isFilled(mailbox) && <li><span class="lh-quick__ic" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3.5 6.5 8.5 6.5 8.5-6.5"/></svg></span><span><small>Email</small><a href={`mailto:${mailbox}`}>{mailbox}</a></span></li>}
{isFilled(co.address) && <li><span class="lh-quick__ic" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 21s-7-6.1-7-11.5A7 7 0 0 1 19 9.5C19 14.9 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg></span><span><small>Trụ sở</small><a href={mapsFor(co.address)} target="_blank" rel="noopener">{co.address}</a></span></li>}
{isFilled(c.form.hours) && <li><span class="lh-quick__ic" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></span><span><small>Giờ làm việc</small><span>{c.form.hours}</span></span></li>}
</ul>
</div>
</div>
<div class="lh-form__card">
<div id="contact-sent" hidden tabindex="-1" class="lh-sent"><span class="lh-sent__ic" aria-hidden="true">✓</span><span class="lh-sent__label">{c.form.sent_label}</span><strong>{c.form.sent_title}</strong><span>{c.form.sent_before} <b id="need-label">{topics[0]?.team}</b>. {c.form.sent_after}</span><button type="button" data-form-again>{c.form.again}</button></div>
<FormFallback />
<form id="contact-form" data-lead-form="lien-he" data-sent="contact-sent" data-mailto={(c.form.formsubmit_alias || '').trim() || mailbox} data-subject="Liên hệ từ website Tiến Nông" class="lh-f">
<fieldset class="lh-f__topics">
<legend>{c.form.topic_label}</legend>
<div class="lh-f__chips">
{topics.map((t, k) => <label class="lh-chip"><input type="radio" name="need" value={t.label} required checked={k === 0} data-team={t.team} data-hint={t.hint} /><span>{t.label}</span></label>)}
</div>
<p class="lh-f__route" aria-live="polite">{c.form.route_label}: <b id="route-team">{topics[0]?.team}</b></p>
</fieldset>
<div class="lh-f__grid">
<label class="lh-field"><span>{c.form.name_label}</span><input name="name" autocomplete="name" required placeholder={c.form.name_ph} /></label>
<label class="lh-field"><span>{c.form.phone_label}</span><input name="phone" type="tel" autocomplete="tel" required inputmode="tel" pattern="[0-9 +.()-]{8,}" placeholder={c.form.phone_ph} /></label>
<label class="lh-field"><span>{c.form.email_label}</span><input name="email" type="email" autocomplete="email" placeholder={c.form.email_ph} /></label>
<label class="lh-field"><span>{c.form.province_label}</span><input name="province" autocomplete="address-level1" placeholder={c.form.province_ph} /></label>
</div>
<label class="lh-field"><span>{c.form.message_label}</span><textarea id="contact-msg" name="message" rows="5" required minlength="10" maxlength="2000" placeholder={topics[0]?.hint || c.form.message_ph}></textarea><small class="lh-f__count"><span id="msg-count">0</span>/2000</small></label>
<div class="lh-f__foot">
<label class="lh-consent"><input type="checkbox" name="consent" data-consent required /><span>{c.form.consent}</span></label>
<button type="submit" class="lh-submit">{c.form.submit}<span aria-hidden="true">↗</span></button>
</div>
</form>
</div>
</div>
</section>

{social.length > 0 && <section id="theo-doi" class="lh-social" aria-label={c.social.title}>
<div class="lh-social__wrap">
<div class="lh-social__head"><h2>{c.social.title}</h2><p>{c.social.intro}</p></div>
<ul class="lh-social__list">
{social.map(([k, v]) => { const n = NETWORKS[k]; return n && <li><a href={link(v)} target="_blank" rel="noopener" class="lh-net" style={`--net:${n.color}`}>
<span class="lh-net__logo" aria-hidden="true" set:html={n.svg} />
<span class="lh-net__txt"><strong>{n.name}</strong><small>{handle(v)}</small></span>
<span class="lh-net__go" aria-hidden="true">↗</span>
</a></li>; })}
</ul>
</div>
</section>}
</Layout>

<style>
  /* Request form (last section): dark green with quick contacts on the left, a white form card on the right. */
  .lh-form { position: relative; overflow: hidden; color: #fff; background: radial-gradient(120% 140% at 0% 100%, #1d7a42 0%, var(--green-800) 45%, var(--green-900) 100%); scroll-margin-top: 80px; }
  .lh-form::before { content: ''; position: absolute; left: -10%; bottom: -30%; width: 46%; aspect-ratio: 1.4; background: var(--leaf) left bottom / contain no-repeat; opacity: .06; pointer-events: none; }
  .lh-form__wrap { position: relative; max-width: var(--wrap, 1280px); margin: 0 auto; padding: clamp(64px, 8vw, 104px) clamp(20px, 4vw, 56px); display: grid; grid-template-columns: minmax(0, .85fr) minmax(0, 1.25fr); gap: 40px clamp(36px, 5vw, 72px); align-items: start; }
  .lh-form__aside { display: flex; flex-direction: column; gap: 16px; position: sticky; top: 110px; }
  .lh-form__eyebrow { display: flex; align-items: center; gap: 14px; font: var(--type-eyebrow); letter-spacing: .1em; color: var(--brand-highlight); }
  .lh-form__eyebrow::before { content: ''; width: 36px; height: 2px; background: var(--brand-highlight); }
  .lh-form h2 { margin: 0; font: var(--type-h2); color: #fff; text-wrap: balance; }
  .lh-form__aside > p { margin: 0; color: var(--green-100); line-height: 1.65; text-align: start; }
  .lh-quick { margin-top: 10px; padding: 22px; border-radius: var(--radius-lg); background: rgba(255, 255, 255, .06); border: 1px solid rgba(255, 255, 255, .14); }
  .lh-quick > strong { display: block; margin-bottom: 12px; font: 700 13px/1.3 var(--font-display); letter-spacing: .1em; text-transform: uppercase; color: var(--brand-highlight); }
  .lh-quick ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 14px; }
  .lh-quick li { display: grid; grid-template-columns: 40px minmax(0, 1fr); gap: 12px; align-items: center; }
  .lh-quick__ic { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 12px; background: rgba(255, 255, 255, .1); }
  .lh-quick__ic svg { width: 19px; height: 19px; fill: none; stroke: #fff; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  .lh-quick li > span:last-child { display: flex; flex-direction: column; gap: 1px; min-width: 0; }
  .lh-quick small { font-size: 12.5px; color: var(--green-200); }
  .lh-quick a, .lh-quick li > span:last-child > span { color: #fff; font-weight: 600; font-size: 15.5px; text-decoration: none; overflow-wrap: anywhere; }
  .lh-quick a:hover { color: var(--brand-highlight); }
  .lh-form__card { background: var(--surface-card); color: var(--text-primary); border-radius: var(--radius-xl); padding: clamp(22px, 3vw, 36px); box-shadow: 0 30px 60px rgba(0, 0, 0, .25); }
  .lh-f { display: flex; flex-direction: column; gap: 18px; }
