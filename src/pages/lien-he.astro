<script>
  // Choosing a topic shows which team receives it and adapts the hint in the message box.
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const team = document.getElementById('route-team');
  const msg = document.getElementById('contact-msg') as HTMLTextAreaElement | null;
  const count = document.getElementById('msg-count');
  const sync = () => {
    const r = form?.querySelector<HTMLInputElement>('input[name="need"]:checked');
    if (!r) return;
    if (team) team.textContent = r.dataset.team || '';
    if (msg && r.dataset.hint) msg.placeholder = r.dataset.hint;
    const label = document.getElementById('need-label');
    if (label) label.textContent = r.dataset.team || r.value;
  };
  form?.addEventListener('change', sync);
  msg?.addEventListener('input', () => { if (count) count.textContent = String(msg.value.length); });
  // Links like /lien-he/?chu-de=Tuyển dụng#lien-he-form preselect a topic.
  const want = new URLSearchParams(location.search).get('chu-de');
  if (want) form?.querySelectorAll<HTMLInputElement>('input[name="need"]').forEach((r) => { if (r.value.toLowerCase() === want.toLowerCase()) r.checked = true; });
  sync();
  // Buttons elsewhere on the page ("Gửi phản ánh") jump to the form with their topic chosen.
  document.querySelectorAll<HTMLElement>('a[data-topic]').forEach((a) => a.addEventListener('click', () => {
    const r = [...(form?.querySelectorAll<HTMLInputElement>('input[name="need"]') ?? [])].find((x) => x.value === a.dataset.topic);
    if (r) { r.checked = true; sync(); }
  }));
</script>
