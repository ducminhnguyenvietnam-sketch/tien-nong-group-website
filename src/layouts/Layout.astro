---
import '@fontsource/alexandria/vietnamese-300.css';
import '@fontsource/alexandria/latin-300.css';
import '@fontsource/alexandria/vietnamese-400.css';
import '@fontsource/alexandria/latin-400.css';
import '@fontsource/alexandria/vietnamese-500.css';
import '@fontsource/alexandria/latin-500.css';
import '@fontsource/alexandria/vietnamese-600.css';
import '@fontsource/alexandria/latin-600.css';
import '@fontsource/alexandria/vietnamese-700.css';
import '@fontsource/alexandria/latin-700.css';
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import siteRaw from '../content/site.json';
import homeRaw from '../content/pages/trang-chu.json';
import { asset } from "../lib/routes";
import { LOCALE_META, alternates, localeOf, tr } from '../lib/i18n';

interface Props {
  title?: string;
  description?: string;
  /** Header nav label to highlight. */
  active?: string;
  /** Page wrapper background; the article page uses the card surface. */
  background?: string;
  /** Keep this page out of search engines (internal tools). */
  noindex?: boolean;
  /** Share image (a /uploads/… path); defaults to the home page hero photo. */
  image?: string;
  /** Open Graph type: "website" (default) or "article". */
  type?: 'website' | 'article';
  /** Extra JSON-LD objects for this page (an article, a product…). */
  schema?: Record<string, unknown>[];
  /** Text alignment chosen in the CMS ("Căn lề chữ"): one setting for the whole page and/or per section (by its id). */
  align?: { mac_dinh?: string; muc?: { muc?: string; kieu?: string }[] };
}
const DEFAULT_DESCRIPTION = 'Tiến Nông Group — hơn 30 năm khoa học phụng sự nhà nông. Doanh nghiệp Khoa học & Công nghệ đầu tiên trong lĩnh vực dinh dưỡng cây trồng tại Việt Nam.';
const {
  title,
  description,
  active = '',
  background = 'var(--surface-page)',
  noindex = false,
  type = 'website',
  schema = [],
  align,
} = Astro.props;
/* CMS text alignment → a few CSS rules. Running text is justified by default (v2.css); "left", "center"
   and "right" apply to every text element in the chosen area (headings included), "justify" to paragraphs. */
const ALIGNS = ['justify', 'left', 'center', 'right'];
const alignCss = (() => {
  const TEXT = ':is(p, li, dd, blockquote, figcaption, .jx-start, .jx-left, .jx-justify)';
  const ALL = ':is(p, li, dd, dt, blockquote, figcaption, h1, h2, h3, h4, h5, h6, strong, b, span, div, label, .jx-start, .jx-left, .jx-justify)';
  const rule = (scope: string, k: string) => k === 'justify'
    ? `${scope} ${TEXT}{text-align:justify!important;text-align-last:start!important}`
    : `${scope}, ${scope} ${ALL}{text-align:${k}!important;text-align-last:auto!important}`;
  const out: string[] = [];
  const page = align?.mac_dinh;
  if (page && page !== 'justify' && ALIGNS.includes(page)) out.push(`main ${TEXT}{text-align:${page}!important;text-align-last:auto!important}`);
  for (const m of align?.muc ?? []) {
    if (!m?.muc || !/^[a-z0-9-]+$/.test(m.muc) || !ALIGNS.includes(m.kieu || '')) continue;
    // English pages are set ragged-right (global.css): a section justified in the CMS stays left-aligned there.
    if (m.kieu === 'justify' && localeOf(Astro.url) === 'en') continue;
    out.push(rule(`main #${m.muc}`, m.kieu!));
  }
  return out.join('\n');
})();
/** Language of this page: /en/… English (UK), /zh/… Simplified Chinese, otherwise Vietnamese. */
const L = localeOf(Astro.url);
const meta = LOCALE_META[L];
/** hreflang links: the same page in each language (news articles exist only in Vietnamese). */
const alts = alternates(Astro.url).filter((a) => a.exists);
const desc = (description || tr(DEFAULT_DESCRIPTION, L)).replace(/\s+/g, ' ').trim().slice(0, 300);
// Home page: the brand comes first ("Tiến Nông Group · …"); other pages lead with their own subject.
const isHome = active === 'Trang chủ';
const fullTitle = title ? (isHome ? `Tiến Nông Group · ${title}` : `${title} · Tiến Nông Group`) : 'Tiến Nông Group';
/** Analytics / ads, set at build time (repo variables): one Google Tag Manager container carries GA4, Google Ads
 *  conversions, Meta / TikTok pixels… so marketing can add or change them without touching the code.
 *  GSC_VERIFY is the Google Search Console "HTML tag" code (not needed if the domain is verified by DNS). */
/** The GitHub Pages preview copy is kept out of Google, so it never competes with the real domain. */
const PREVIEW = import.meta.env.PUBLIC_PREVIEW === '1';
const GTM_ID = (import.meta.env.PUBLIC_GTM_ID ?? '').trim();
const GTM = /^GTM-[A-Z0-9]{4,12}$/.test(GTM_ID) && !noindex ? GTM_ID : '';
const GSC_VERIFY = (import.meta.env.PUBLIC_GSC_VERIFY ?? '').trim().replace(/[^\w-]/g, '');
const site = siteRaw as any;
const homeHero = (homeRaw as any).hero_slides?.find((s: any) => s?.image?.src)?.image?.src as string | undefined;
const shareImage = Astro.props.image || homeHero;
const origin = Astro.site ? Astro.site.origin : '';
const abs = (p?: string) => (p ? (/^https?:/.test(p) ? p : `${origin}${asset(p)}`) : undefined);
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const org = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: tr(site.company?.name || 'Công ty Cổ phần Công Nông nghiệp Tiến Nông', L),
  alternateName: 'Tiến Nông Group',
  url: origin ? `${origin}${asset('/')}` : undefined,
  logo: abs('/assets/logo-mark.png'),
  foundingDate: '1995-01-04',
  email: site.company?.email || undefined,
  telephone: site.company?.phone || undefined,
  address: site.company?.address ? { '@type': 'PostalAddress', streetAddress: site.company.address, addressCountry: 'VN' } : undefined,
  sameAs: Object.values(site.social || {}).filter((v) => typeof v === 'string' && /^https?:/.test(v) && !/\/\/m\.me\//.test(v)),
  legalName: 'Công ty Cổ phần Công Nông nghiệp Tiến Nông',
  taxID: '2800142141',
  slogan: tr('Khoa học phụng sự nhà nông', L),
  knowsAbout: ['Phân bón', 'Dinh dưỡng cây trồng', 'Phân bón NPK', 'Phân bón hữu cơ', 'Phân tích đất'],
  contactPoint: site.company?.phone ? [{ '@type': 'ContactPoint', telephone: site.company.phone, email: site.company?.email || undefined,
    contactType: 'customer service', areaServed: 'VN', availableLanguage: ['vi'] }] : undefined,
};
/** Home page: the site itself (name shown in Google results). */
const website = isHome ? [{ '@context': 'https://schema.org', '@type': 'WebSite', name: 'Tiến Nông Group', alternateName: 'Tiến Nông', url: org.url, inLanguage: meta.html }] : [];
---
<!doctype html>
<html lang={meta.html} data-hotline={(site.company?.hotline || site.company?.phone || undefined)}>
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{fullTitle}</title>
<meta name="description" content={desc} />
<meta name="theme-color" content="#00954f" />
{(noindex || PREVIEW) && <meta name="robots" content="noindex, nofollow" />}
{canonical && <link rel="canonical" href={canonical} />}
<meta property="og:site_name" content="Tiến Nông Group" />
<meta property="og:locale" content={meta.og} />
{alts.map((a) => a.locale !== L && <meta property="og:locale:alternate" content={LOCALE_META[a.locale].og} />)}
{Astro.site && !noindex && alts.length > 1 && alts.map((a) => <link rel="alternate" hreflang={LOCALE_META[a.locale].hreflang} href={new URL(a.href, Astro.site).href} />)}
{Astro.site && !noindex && alts.length > 1 && <link rel="alternate" hreflang="x-default" href={new URL(alts[0].href, Astro.site).href} />}
<meta property="og:type" content={type} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={desc} />
{canonical && <meta property="og:url" content={canonical} />}
{shareImage && <meta property="og:image" content={abs(shareImage)} />}
<meta name="twitter:card" content={shareImage ? 'summary_large_image' : 'summary'} />
<link rel="icon" type="image/svg+xml" href={asset("favicon.svg")} />
<script is:inline>
  // "js" lets CSS hide elements that are about to animate in; without JS nothing is hidden.
  document.documentElement.classList.add('js');
</script>
<script type="application/ld+json" set:html={JSON.stringify([org, ...website, ...schema])} />
{GSC_VERIFY && <meta name="google-site-verification" content={GSC_VERIFY} />}
{GTM && <script is:inline define:vars={{ GTM }}>
  window.dataLayer = window.dataLayer || [];
  (function (w, d, s, l, i) { w[l].push({ 'gtm.start': Date.now(), event: 'gtm.js' }); var f = d.getElementsByTagName(s)[0], j = d.createElement(s);
    j.async = true; j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i; f.parentNode.insertBefore(j, f); })(window, document, 'script', 'dataLayer', GTM);
</script>}
{alignCss && <style is:inline set:html={alignCss} />}
</head>
<body>
<a class="skip-link" href="#noi-dung">Bỏ qua đến nội dung</a>
<div style={`font-family:var(--font-body);color:var(--text-primary);background:${background};font-size:16px;line-height:1.6`}>
<SiteHeader active={active} />
<main id="noi-dung" tabindex="-1" style="outline:none">
<slot />
</main>
<SiteFooter />
</div>
<script src="../scripts/nowrap.js"></script>
<script src="../scripts/picker.ts"></script>
<script src="../scripts/chipfilter.ts"></script>
<script src="../scripts/accordion.ts"></script>
<script src="../scripts/reveal.ts"></script>
<script src="../scripts/subnav.ts"></script>
<script src="../scripts/forms.ts"></script>
<script src="../scripts/track.ts"></script>
<script src="../scripts/motion.ts"></script>
<script src="../scripts/justify.ts"></script>
<script src="../scripts/yt.ts"></script>
<script src="../scripts/scrolly.ts"></script>
<script>
  // On-site photo editor: ?sua-anh turns it on; it stays on (per browser) until "Thoát".
  let on = new URLSearchParams(location.search).has('sua-anh');
  try { on ||= localStorage.getItem('tn-edit-photos') === '1'; } catch { /* storage blocked */ }
  if (on) import('../scripts/photo-editor');
</script>
</body>
</html>
