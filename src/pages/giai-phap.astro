<style>
  .issue-flow { display: grid; grid-template-columns: minmax(0, 1fr) 28px minmax(0, 1fr) 28px minmax(0, 1.15fr); align-items: stretch; gap: 8px; }
  .issue-flow[hidden] { display: none; }
  .issue-step { background: var(--surface-card); border: 1px solid var(--border-default); border-radius: var(--radius-lg); overflow: hidden; display: flex; flex-direction: column; }
  .issue-step__label { display: flex; align-items: center; gap: 8px; font: 700 12px var(--font-mono); letter-spacing: .1em; color: var(--green-600); }
  .issue-step__label b { width: 24px; height: 24px; border-radius: 50%; background: var(--green-500); color: #fff; display: inline-flex; align-items: center; justify-content: center; font-size: 12px; }
  .issue-arrow { align-self: center; justify-self: center; font: 800 24px var(--font-body); color: var(--green-500); }
  .issue-cap { position: absolute; left: 8px; bottom: 8px; padding: 2px 8px; border-radius: var(--radius-full); background: rgba(2, 53, 26, .78); color: #fff; font-size: 12px; font-weight: 600; pointer-events: none; }
  @media (max-width: 980px) {
    .issue-flow { grid-template-columns: minmax(0, 1fr); }
    .issue-arrow { transform: rotate(90deg); }
  }
</style>

<script>
  // "Theo vấn đề": one chip per issue, showing its problem → why → solution panel.
  const issueTabs = [...document.querySelectorAll<HTMLButtonElement>('[data-issue-tab]')];
  issueTabs.forEach((tab) => tab.addEventListener('click', () => {
    issueTabs.forEach((t) => { const on = t === tab; t.setAttribute('aria-selected', String(on)); t.setAttribute('aria-pressed', String(on)); });
    document.querySelectorAll<HTMLElement>('[data-issue]').forEach((p) => { p.hidden = p.dataset.issue !== tab.dataset.issueTab; });
  }));

  // Crop + issue chips drive the preliminary recommendation.
  const pressed = (g: string) => Number(document.querySelector<HTMLElement>(`[data-chip="${g}"][aria-pressed="true"]`)?.dataset.k ?? 0);
  const sel: Record<string, number> = { crop: pressed('crop'), issue: pressed('issue') };
  const title = document.getElementById('rec-title')!;
  const label = (g: string) => document.querySelector<HTMLElement>(`[data-chip="${g}"][data-k="${sel[g]}"]`)!.textContent!.trim();
  document.querySelectorAll<HTMLButtonElement>('[data-chip]').forEach((chip) => chip.addEventListener('click', () => {
    const g = chip.dataset.chip!;
    sel[g] = Number(chip.dataset.k);
    document.querySelectorAll(`[data-chip="${g}"]`).forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
    title.textContent = `${label('crop')} · ${label('issue').toLowerCase()}`;
    document.querySelectorAll<HTMLElement>('[data-rec]').forEach((r) => { r.hidden = Number(r.dataset.rec) !== sel.issue; });
  }));
</script>
