---
/**
 * Photo framing tool (internal, not linked from the menu). Pick a photo slot, drop a
 * photo, drag/zoom it inside a frame with that slot's exact shape, then download a
 * cropped and compressed file to upload in Pages CMS. Everything runs in the browser.
 * Slot shapes come from src/data/photo-slots.json (measured from the built site).
 */
import Layout from '../../layouts/Layout.astro';
import Button from '../../components/Button.astro';
import slots from '../../data/photo-slots.json';

const groups = [...new Set(slots.map((s) => s.group))];
---
<Layout title="Căn ảnh vừa khung" noindex>
<section class="crop-tool" style="background:var(--surface-card)">
<div style="max-width:1080px;margin:0 auto;padding:28px clamp(16px,4vw,40px) 64px;display:flex;flex-direction:column;gap:24px">
<div style="display:flex;flex-direction:column;gap:10px">
<span style="font:600 13px var(--font-mono);letter-spacing:.12em;color:var(--green-600)">CÔNG CỤ NỘI BỘ</span>
<h1 style="margin:0;font:800 clamp(28px,4vw,44px)/1.15 var(--font-display)">Căn ảnh vừa khung</h1>
<p style="margin:0;color:var(--text-secondary);max-width:680px">Chọn vị trí ảnh, chọn ảnh, kéo và phóng to cho vừa ý rồi tải ảnh đã căn về máy. Sau đó tải tệp đó lên đúng ô trong trang quản trị và bấm Save — ảnh trên website sẽ hiện y như ở đây. Ảnh chỉ xử lý trên máy của bạn, không gửi đi đâu.</p>
</div>

<div class="step">
<label style="display:flex;flex-direction:column;gap:6px;font-weight:600">1. Vị trí ảnh
<select id="slot" class="field">
{groups.map((g) => <optgroup label={g}>{slots.filter((s) => s.group === g).map((s) => <option value={s.key}>{s.label}</option>)}</optgroup>)}
</select></label>
<div id="slot-info" style="font-size:14px;color:var(--text-secondary)"></div>
</div>

<div class="step">
<span style="font-weight:600">2. Chọn ảnh</span>
<label id="drop" class="drop"><input id="file" type="file" accept="image/*" style="position:absolute;opacity:0;width:1px;height:1px" />
<span>Bấm để chọn ảnh hoặc kéo thả ảnh vào đây</span></label>
</div>

<div id="editor" class="step" hidden>
<span style="font-weight:600">3. Kéo ảnh để chọn phần hiển thị, kéo thanh để phóng to</span>
<div id="stage-wrap" style="width:100%;max-width:820px">
<div id="stage" class="frame"><img id="img" alt="" draggable="false" /></div>
</div>
<div id="zoom-row" style="display:flex;align-items:center;gap:12px;max-width:820px">
<span style="font-size:14px;color:var(--text-secondary)">Phóng to</span>
<input id="zoom" type="range" min="100" max="400" value="100" style="flex:1;accent-color:var(--green-500)" />
<span id="zoom-val" style="font:600 14px var(--font-mono);min-width:48px">100%</span>
<button type="button" id="reset" class="link-btn">Vừa khung</button>
</div>
<div style="display:flex;flex-direction:column;gap:10px">
<span style="font-size:14px;font-weight:600">Xem trước ở các vị trí khác</span>
<div id="previews" style="display:flex;gap:16px;flex-wrap:wrap;align-items:flex-start"></div>
</div>
</div>

<div id="output" class="step" hidden>
<span style="font-weight:600">4. Tải ảnh đã căn và đưa lên trang quản trị</span>
<div style="display:flex;gap:12px;align-items:center;flex-wrap:wrap"><Button id="download" size="lg">Tải ảnh đã căn</Button><span id="out-info" style="font-size:14px;color:var(--text-secondary)"></span></div>
<ol style="margin:0;padding-left:20px;color:var(--text-secondary);display:flex;flex-direction:column;gap:6px">
<li>Mở <a href="https://app.pagescms.org" target="_blank" rel="noopener">trang quản trị</a> → <strong id="cms-path"></strong>.</li>
<li>Ở ô <strong>Ảnh</strong>, tải lên tệp vừa lưu. Giữ <strong>Ở giữa</strong> và <strong>Không phóng (100%)</strong> — ảnh đã được căn sẵn.</li>
<li>Bấm <strong>Save</strong>. Khoảng 2 phút sau ảnh hiện trên website.</li>
</ol>
</div>
</div>
</section>
</Layout>

<script is:inline type="application/json" id="slot-data" set:html={JSON.stringify(slots)}></script>

<style is:global>
  /* Global (scoped by .crop-tool) because the preview frames are created by the script. */
  .crop-tool .step { display: flex; flex-direction: column; gap: 12px; padding-top: 20px; border-top: 1px solid var(--border-default); }
  .crop-tool .field { padding: 10px 14px; border-radius: var(--radius-md); border: 1px solid var(--border-default); font: 16px var(--font-body); background: var(--surface-card); color: var(--text-primary); max-width: 100%; }
  .crop-tool .drop { position: relative; display: flex; align-items: center; justify-content: center; min-height: 120px; padding: 20px; text-align: center; border: 1.5px dashed var(--border-strong); border-radius: var(--radius-lg); background: var(--surface-page); color: var(--text-secondary); cursor: pointer; }
  .crop-tool .drop.over { border-color: var(--green-500); background: var(--green-50); }
  .crop-tool .frame { position: relative; overflow: hidden; background: var(--surface-sunken); touch-action: none; user-select: none; cursor: grab; }
  .crop-tool .frame.contain { cursor: default; }
  .crop-tool .frame img { position: absolute; left: 0; top: 0; max-width: none; transform-origin: 0 0; pointer-events: none; }
  .crop-tool .preview { display: flex; flex-direction: column; gap: 6px; font-size: 13px; color: var(--text-secondary); }
  .crop-tool .link-btn { background: none; border: 0; padding: 0; color: var(--green-700); font: 600 15px var(--font-body); cursor: pointer; }
</style>

<script>
  type Frame = { name: string; w: number; h: number; radius: string };
  type Slot = { key: string; group: string; label: string; cms: string[]; fit: string; frames: Frame[] };
  const slots: Slot[] = JSON.parse(document.getElementById('slot-data')!.textContent!);
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const select = $<HTMLSelectElement>('slot');
  const stage = $('stage');
  const img = $<HTMLImageElement>('img');
  const zoom = $<HTMLInputElement>('zoom');
  const previews = $('previews');

  let slot: Slot = slots[0];
  let source: HTMLImageElement | null = null;
  let fileName = 'anh';
  // Crop state in stage pixels: image scale and top-left offset.
  let fw = 0, fh = 0, base = 1, z = 1, x = 0, y = 0;

  const pre = new URLSearchParams(location.search).get('o');
  if (pre && slots.some((s) => s.key === pre)) select.value = pre;

  function chooseSlot() {
    slot = slots.find((s) => s.key === select.value) ?? slots[0];
    const [d, m] = slot.frames;
    $('slot-info').textContent = `Khung ${d.name.toLowerCase()}: ${d.w}×${d.h} px` + (m ? ` · ${m.name.toLowerCase()}: ${m.w}×${m.h} px` : '')
      + (slot.fit === 'contain' ? ' · Ảnh được hiển thị trọn vẹn, không bị cắt.' : '');
    $('cms-path').textContent = ['Các trang', ...slot.cms].filter((p, i) => !(i === 0 && slot.group.startsWith('Tin tức'))).join(' › ');
    layout();
  }

  // keep = true (window resize): keep the current crop, just rescale it to the new frame size.
  function layout(keep = false) {
    const d = slot.frames[0];
    const oldFw = fw;
    fw = Math.min($('stage-wrap').clientWidth, 820);
    fh = Math.round(fw * d.h / d.w);
    Object.assign(stage.style, { width: `${fw}px`, height: `${fh}px`, borderRadius: d.radius });
    stage.classList.toggle('contain', slot.fit === 'contain');
    $('zoom-row').style.display = slot.fit === 'contain' ? 'none' : 'flex';
    if (!source) return;
    base = slot.fit === 'contain' ? Math.min(fw / source.naturalWidth, fh / source.naturalHeight) : Math.max(fw / source.naturalWidth, fh / source.naturalHeight);
    if (keep && oldFw) {
      x *= fw / oldFw; y *= fw / oldFw;
    } else {
      z = 1; zoom.value = '100';
      center();
      buildPreviews();
    }
    render();
  }

  function center() {
    const s = base * z;
    x = (fw - source!.naturalWidth * s) / 2;
    y = (fh - source!.naturalHeight * s) / 2;
  }

  function clamp() {
    if (slot.fit === 'contain') return center();
    const s = base * z, w = source!.naturalWidth * s, h = source!.naturalHeight * s;
    x = Math.min(0, Math.max(fw - w, x));
    y = Math.min(0, Math.max(fh - h, y));
  }

  // Each preview shows the cropped result the way the site shows it (cover, centered).
  function buildPreviews() {
    previews.replaceChildren();
    slot.frames.slice(1).forEach((f) => {
      const scale = Math.min(1, 300 / f.w, 260 / f.h);
      const box = document.createElement('div'); box.className = 'preview';
      const fr = document.createElement('div'); fr.className = 'frame contain';
      Object.assign(fr.style, { width: `${Math.round(f.w * scale)}px`, height: `${Math.round(f.h * scale)}px`, borderRadius: f.radius });
      const im = document.createElement('img'); im.src = img.src; im.alt = '';
      fr.append(im);
      const cap = document.createElement('span'); cap.textContent = `${f.name} · ${f.w}×${f.h}`;
      box.append(fr, cap); previews.append(box);
    });
  }

  function render() {
    if (!source) return;
    clamp();
    const s = base * z;
    img.style.transform = `translate(${x}px, ${y}px) scale(${s})`;
    $('zoom-val').textContent = `${Math.round(z * 100)}%`;
    previews.querySelectorAll<HTMLElement>('.frame').forEach((fr) => {
      const pw = fr.clientWidth, ph = fr.clientHeight;
      if (slot.fit === 'contain') {
        const k = Math.min(pw / source!.naturalWidth, ph / source!.naturalHeight);
        fr.querySelector('img')!.style.transform = `translate(${(pw - source!.naturalWidth * k) / 2}px, ${(ph - source!.naturalHeight * k) / 2}px) scale(${k})`;
        return;
      }
      const p = Math.max(pw / fw, ph / fh); // cover the preview with the cropped frame
      const ox = (pw - fw * p) / 2, oy = (ph - fh * p) / 2;
      fr.querySelector('img')!.style.transform = `translate(${ox + x * p}px, ${oy + y * p}px) scale(${s * p})`;
    });
    const out = outputSize();
    $('out-info').textContent = `Ảnh xuất ra: ${out.w}×${out.h} px`;
  }

  function outputSize() {
    const d = slot.frames[0];
    if (slot.fit === 'contain') {
      const k = Math.min(1, (2 * d.w) / source!.naturalWidth, (2 * d.h) / source!.naturalHeight);
      return { w: Math.round(source!.naturalWidth * k), h: Math.round(source!.naturalHeight * k) };
    }
    const s = base * z, srcW = fw / s; // source pixels inside the frame
    const w = Math.round(Math.min(srcW, 2 * d.w, 2400));
    return { w, h: Math.round(w * fh / fw) };
  }

  function load(file: File) {
    if (!file.type.startsWith('image/')) return;
    fileName = file.name.replace(/\.[^.]+$/, '');
    const url = URL.createObjectURL(file);
    const im = new Image();
    im.onload = () => {
      source = im; img.src = url;
      $('editor').hidden = false; $('output').hidden = false;
      layout();
    };
    im.src = url;
  }

  $<HTMLInputElement>('file').addEventListener('change', (e) => { const f = (e.target as HTMLInputElement).files?.[0]; if (f) load(f); });
  const drop = $('drop');
  drop.addEventListener('dragover', (e) => { e.preventDefault(); drop.classList.add('over'); });
  drop.addEventListener('dragleave', () => drop.classList.remove('over'));
  drop.addEventListener('drop', (e) => { e.preventDefault(); drop.classList.remove('over'); const f = e.dataTransfer?.files[0]; if (f) load(f); });

  select.addEventListener('change', () => chooseSlot());
  let lastWidth = $('stage-wrap').clientWidth;
  window.addEventListener('resize', () => {
    const w = $('stage-wrap').clientWidth;
    if (w !== lastWidth) { lastWidth = w; layout(true); }
  });

  // Zoom keeps the point at the frame's centre fixed.
  zoom.addEventListener('input', () => {
    const nz = Number(zoom.value) / 100, s0 = base * z, s1 = base * nz;
    x = fw / 2 - (fw / 2 - x) * s1 / s0;
    y = fh / 2 - (fh / 2 - y) * s1 / s0;
    z = nz; render();
  });
  $('reset').addEventListener('click', () => { z = 1; zoom.value = '100'; center(); render(); });

  let drag: { px: number; py: number; x: number; y: number } | null = null;
  stage.addEventListener('pointerdown', (e) => {
    if (!source || slot.fit === 'contain') return;
    e.preventDefault();
    stage.setPointerCapture(e.pointerId); stage.style.cursor = 'grabbing';
    drag = { px: e.clientX, py: e.clientY, x, y };
  });
  stage.addEventListener('pointermove', (e) => {
    if (!drag) return;
    x = drag.x + e.clientX - drag.px; y = drag.y + e.clientY - drag.py; render();
  });
  const end = () => { drag = null; stage.style.cursor = ''; };
  stage.addEventListener('pointerup', end);
  stage.addEventListener('pointercancel', end);
  stage.addEventListener('wheel', (e) => {
    if (!source || slot.fit === 'contain') return;
    e.preventDefault();
    zoom.value = String(Math.min(400, Math.max(100, Number(zoom.value) - Math.sign(e.deltaY) * 5)));
    zoom.dispatchEvent(new Event('input'));
  }, { passive: false });

  $('download').addEventListener('click', () => {
    if (!source) return;
    const out = outputSize();
    const canvas = document.createElement('canvas');
    canvas.width = out.w; canvas.height = out.h;
    const ctx = canvas.getContext('2d')!;
    ctx.imageSmoothingQuality = 'high';
    const png = slot.fit === 'contain';
    if (png) ctx.drawImage(source, 0, 0, out.w, out.h);
    else {
      const s = base * z;
      ctx.drawImage(source, -x / s, -y / s, fw / s, fh / s, 0, 0, out.w, out.h);
    }
    canvas.toBlob((blob) => {
      if (!blob) return;
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = `${slot.key}-${fileName}.${png ? 'png' : 'jpg'}`.toLowerCase().replace(/[^a-z0-9.-]+/g, '-');
      a.click();
      $('out-info').textContent = `Đã tạo ${out.w}×${out.h} px · ${Math.round(blob.size / 1024)} KB`;
    }, png ? 'image/png' : 'image/jpeg', 0.85);
  });

  chooseSlot();
</script>
