---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import ImageSlot from '../components/ImageSlot.astro';
import { url } from '../lib/routes';

const MILESTONES = [
  { year: '1995', title: 'Thành lập tại Thanh Hóa', body: 'Ngày 04/01/1995, Tiến Nông ra đời với khát vọng mang đến cho nhà nông những sản phẩm dinh dưỡng cây trồng chất lượng, giá trị thực.', ph: 'Ảnh tư liệu: biển hiệu xí nghiệp năm 1995' },
  { year: '2002', title: 'Giải thưởng Chất lượng Việt Nam', body: 'Hệ thống quản lý chất lượng và sản phẩm của Tiến Nông được ghi nhận ở cấp quốc gia.', ph: 'Ảnh lễ nhận giải 2002' },
  { year: '2011', title: 'Thương hiệu nổi tiếng ASEAN', body: 'Thương hiệu Tiến Nông được ghi nhận trong khu vực, mở đường cho các thị trường xuất khẩu.', ph: 'Ảnh lễ nhận giải 2011' },
  { year: '2012', title: 'Doanh nghiệp Khoa học & Công nghệ đầu tiên của ngành', body: '[Bổ sung: năm được công nhận, số giấy chứng nhận và ý nghĩa của danh hiệu.]', ph: 'Ảnh giấy chứng nhận DN KH&CN' },
  { year: '2022', title: 'Bằng khen của Thủ tướng Chính phủ', body: 'Ghi nhận những đóng góp của Tiến Nông cho sự phát triển của nông nghiệp và cộng đồng.', ph: 'Ảnh Bằng khen Thủ tướng' },
  { year: '2026', title: '3 nhà máy, 650.000 tấn/năm, 10+ quốc gia', body: 'Tiến Nông phục vụ hơn 200.000 hộ nông dân, hướng tới mục tiêu 1 triệu hộ nông dân Việt Nam.', ph: 'Ảnh flycam nhà máy hiện nay' },
];
---
<Layout title="Về Tiến Nông" active="Về Tiến Nông">
<section style="background:var(--surface-card)">
<div style="max-width:1280px;margin:0 auto;padding:28px clamp(20px,4vw,56px) 0;display:flex;flex-direction:column;gap:clamp(28px,4vw,48px)">
<span style="font-size:13px;color:var(--text-tertiary)"><a href={url('trang-chu')} style="color:var(--text-tertiary)">Trang chủ</a> / Về&nbsp;Tiến&nbsp;Nông</span>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,440px),1fr));gap:24px 64px;align-items:end">
<div style="display:flex;flex-direction:column;gap:16px">
<span style="font:600 13px var(--font-mono);letter-spacing:.12em;color:var(--green-600)">VỀ&nbsp;TIẾN&nbsp;NÔNG</span>
<h1 style="margin: 0; font: 800 clamp(38px,5vw,64px)/1.08 var(--font-display); letter-spacing: -.015em; max-width:794px;text-wrap:balance">Hơn 30 năm đồng hành cùng nông nghiệp Việt Nam</h1><p style="margin: 0; font-size: 18px; color: var(--text-secondary); text-align: justify; text-wrap: pretty; width: min(739px, 100%); min-height: 90px">Thành lập ngày 04/01/1995 tại Thanh Hóa, CTCP Công Nông nghiệp Tiến Nông nghiên cứu, sản xuất và phân phối các giải pháp dinh dưỡng cây trồng cho nhà nông trên khắp cả nước và hơn 10 thị trường quốc&nbsp;tế.</p>
</div>

</div>
<div style="position:relative;height:clamp(280px,40vw,560px)"><ImageSlot style="position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto;display:block" id="about-hero" shape="rounded" radius="24" placeholder="Ảnh tập thể cán bộ, nhân viên trước trụ sở Tiến Nông" /></div>
</div>
<div style="max-width:1280px;margin:0 auto;padding:40px clamp(20px,4vw,56px) 48px;display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:24px">
<div style="display:flex;flex-direction:column;gap:2px"><span style="font:800 36px/1.1 var(--font-display);color:var(--green-700)">1995</span><span style="font:600 13px/1.45 var(--font-body);letter-spacing:.06em;text-transform:uppercase;color:var(--text-secondary);margin-top:6px">năm&nbsp;thành&nbsp;lập</span></div>
<div style="display:flex;flex-direction:column;gap:2px"><span style="font:800 36px/1.1 var(--font-display);color:var(--green-700)">650.000</span><span style="font:600 13px/1.45 var(--font-body);letter-spacing:.06em;text-transform:uppercase;color:var(--text-secondary);margin-top:6px">tấn/năm · 3&nbsp;nhà&nbsp;máy</span></div>
<div style="display:flex;flex-direction:column;gap:2px"><span style="font:800 36px/1.1 var(--font-display);color:var(--green-700)">200+</span><span style="font:600 13px/1.45 var(--font-body);letter-spacing:.06em;text-transform:uppercase;color:var(--text-secondary);margin-top:6px">nhà&nbsp;phân&nbsp;phối</span></div>
<div style="display:flex;flex-direction:column;gap:2px"><span style="font:800 36px/1.1 var(--font-display);color:var(--green-700)">10.000</span><span style="font:600 13px/1.45 var(--font-body);letter-spacing:.06em;text-transform:uppercase;color:var(--text-secondary);margin-top:6px">điểm&nbsp;bán</span></div>
<div style="display:flex;flex-direction:column;gap:2px"><span style="font:800 36px/1.1 var(--font-display);color:var(--green-700)">200.000+</span><span style="font:600 13px/1.45 var(--font-body);letter-spacing:.06em;text-transform:uppercase;color:var(--text-secondary);margin-top:6px">hộ&nbsp;nông&nbsp;dân tin&nbsp;dùng</span></div>
<div style="display:flex;flex-direction:column;gap:2px"><span style="font:800 36px/1.1 var(--font-display);color:var(--green-700)">10+</span><span style="font:600 13px/1.45 var(--font-body);letter-spacing:.06em;text-transform:uppercase;color:var(--text-secondary);margin-top:6px">quốc&nbsp;gia xuất&nbsp;khẩu</span></div>
</div>
</section>

<nav style="position:sticky;top:108px;z-index:20;background:var(--surface-page);border-top:1px solid var(--border-default);border-bottom:1px solid var(--border-default)">
<div style="max-width:1280px;margin:0 auto;padding:0 clamp(20px,4vw,56px);display:flex;gap:28px;overflow-x:auto;white-space:nowrap;font-size:14px;font-weight:600">
<a href="#thu-ngo" style="color:var(--text-secondary);padding:14px 0">Thư ngỏ</a><a href="#su-menh" style="color:var(--text-secondary);padding:14px 0">Sứ&nbsp;mệnh &amp;&nbsp;giá&nbsp;trị</a><a href="#lich-su" style="color:var(--text-secondary);padding:14px 0">Lịch sử</a><a href="#lanh-dao" style="color:var(--text-secondary);padding:14px 0">Lãnh&nbsp;đạo</a><a href="#thanh-tuu" style="color:var(--text-secondary);padding:14px 0">Thành&nbsp;tựu</a><a href="#nang-luc" style="color:var(--text-secondary);padding:14px 0">Năng&nbsp;lực</a><a href="#he-sinh-thai" style="color:var(--text-secondary);padding:14px 0">Hệ sinh&nbsp;thái</a>
</div></nav>

<section id="thu-ngo" style="scroll-margin-top:160px">
<div style="max-width:1280px;margin:0 auto;padding:clamp(64px,8vw,112px) clamp(20px,4vw,56px);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,360px),1fr));gap:48px 80px;align-items:center">
<div style="display:flex;flex-direction:column;gap:16px;max-width:420px">
<div style="position:relative;aspect-ratio:4/5"><ImageSlot style="position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto;display:block" id="ceo-portrait" shape="rounded" radius="20" placeholder="Chân dung Tổng Giám đốc Nguyễn Hồng Phong" /></div>
</div>
<div style="display:flex;flex-direction:column;gap:24px">
<span style="font:600 13px var(--font-mono);letter-spacing:.12em;color:var(--green-600)">THƯ NGỎ CỦA TỔNG&nbsp;GIÁM&nbsp;ĐỐC</span>
<p style="margin: 0; font: 600 clamp(24px,2.6vw,34px)/1.4 var(--font-display); text-wrap: pretty; text-align: justify">“Mùa vụ không chỉ là những gì chúng tôi trồng trọt, mà là những cuộc đời chúng tôi cùng vun đắp và tương lai chúng tôi cùng kiến tạo.”</p>
<p style="margin:0;color:var(--text-secondary);font-size:17px;text-align:justify;text-wrap:pretty">Hơn ba thập kỷ qua, Tiến Nông kiên định với một lựa chọn: lấy khoa học làm nền tảng và lấy lợi ích của nhà nông làm thước đo cho mọi quyết định. Chúng tôi tin rằng khi người nông dân được canh tác hiệu quả hơn, mỗi vụ mùa sẽ góp phần vào sự thịnh vượng chung của đất&nbsp;nước.</p>
<div style="display:flex;flex-direction:column;padding-top:16px;border-top:1px solid var(--border-default)"><strong style="font-size:17px">Nguyễn Hồng&nbsp;Phong</strong><span style="color:var(--text-secondary)">Tổng&nbsp;Giám&nbsp;đốc</span></div>
</div></div></section>

<section id="su-menh" style="scroll-margin-top:160px;background:var(--green-800);color:#fff">
<div style="max-width:1280px;margin:0 auto;padding:clamp(64px,8vw,112px) clamp(20px,4vw,56px);display:flex;flex-direction:column;gap:56px">
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(clamp(calc((100% - 64px)/3),calc((964px - 100%)*999),100%),1fr));gap:32px">
<div style="display:flex;flex-direction:column;gap:12px"><span style="font:600 13px var(--font-mono);letter-spacing:.12em;color:var(--green-200)">SỨ&nbsp;MỆNH</span><span style="font:700 clamp(24px,2.4vw,30px)/1.3 var(--font-display);text-wrap:balance">Phụng&nbsp;sự để nông&nbsp;dân giàu&nbsp;có, Việt&nbsp;Nam thịnh&nbsp;vượng</span></div>
<div style="display:flex;flex-direction:column;gap:12px"><span style="font:600 13px var(--font-mono);letter-spacing:.12em;color:var(--green-200)">TẦM&nbsp;NHÌN</span><span style="font:700 clamp(24px,2.4vw,30px)/1.3 var(--font-display);text-wrap:balance">Doanh&nbsp;nghiệp sáng&nbsp;tạo dẫn&nbsp;đầu trong lĩnh&nbsp;vực dinh&nbsp;dưỡng cây&nbsp;trồng tại&nbsp;Việt&nbsp;Nam</span></div>
<div style="display:flex;flex-direction:column;gap:12px"><span style="font:600 13px var(--font-mono);letter-spacing:.12em;color:var(--green-200)">MỤC&nbsp;TIÊU</span><span style="font:700 clamp(24px,2.4vw,30px)/1.3 var(--font-display);text-wrap:balance">Phục&nbsp;vụ 1&nbsp;triệu hộ&nbsp;nông&nbsp;dân Việt&nbsp;Nam</span></div>
</div>
<div style="display:flex;flex-direction:column;gap:24px;padding-top:40px;border-top:1px solid var(--green-700)">
<span style="font:600 13px var(--font-mono);letter-spacing:.12em;color:var(--green-200)">GIÁ&nbsp;TRỊ CỐT&nbsp;LÕI</span>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(clamp(calc((100% - 48px)/4),calc((1008px - 100%)*999),calc((100% - 16px)/2)),1fr));gap:16px">
<div style="background:var(--green-700);border-radius:var(--radius-lg);padding:24px;display:flex;flex-direction:column;gap:10px"><span style="font:700 14px var(--font-mono);color:var(--amber-400)">01</span><strong style="font-size:20px">Đam&nbsp;mê chân&nbsp;chính</strong><span style="color:var(--green-100);font-size:15px;text-align:justify">Tận tâm với nông nghiệp và khoa học, bền bỉ theo đuổi những giá trị thực cho nhà&nbsp;nông.</span></div>
<div style="background:var(--green-700);border-radius:var(--radius-lg);padding:24px;display:flex;flex-direction:column;gap:10px"><span style="font:700 14px var(--font-mono);color:var(--amber-400)">02</span><strong style="font-size:20px">Khát&nbsp;vọng cháy&nbsp;bỏng</strong><span style="color:var(--green-100);font-size:15px">Không ngừng vươn lên, cống hiến trọn vẹn trong lĩnh vực mình đã&nbsp;chọn.</span></div>
<div style="background:var(--green-700);border-radius:var(--radius-lg);padding:24px;display:flex;flex-direction:column;gap:10px"><span style="font:700 14px var(--font-mono);color:var(--amber-400)">03</span><strong style="font-size:20px">Sáng&nbsp;tạo không&nbsp;ngừng</strong><span style="color:var(--green-100);font-size:15px;text-align:justify">Đổi mới để giữ vị thế dẫn đầu về dinh dưỡng cây trồng tại Việt Nam và vươn ra thế&nbsp;giới.</span></div>
<div style="background:var(--green-700);border-radius:var(--radius-lg);padding:24px;display:flex;flex-direction:column;gap:10px"><span style="font:700 14px var(--font-mono);color:var(--amber-400)">04</span><strong style="font-size:20px">Sẻ&nbsp;chia lợi&nbsp;ích</strong><span style="color:var(--green-100);font-size:15px">Lợi ích của nhà nông luôn được đặt lên trên hết trong mọi quyết&nbsp;định.</span></div>
</div></div></div></section>

<section id="lich-su" style="scroll-margin-top:160px;background:var(--surface-card)">
<div data-picker style="max-width:1280px;margin:0 auto;padding:clamp(64px,8vw,112px) clamp(20px,4vw,56px);display:flex;flex-direction:column;gap:40px">
<div style="display:flex;justify-content:space-between;align-items:flex-end;gap:24px;flex-wrap:wrap">
<div style="display:flex;flex-direction:column;gap:14px;max-width:640px">
<span style="font:600 13px var(--font-mono);letter-spacing:.12em;color:var(--green-600)">LỊCH SỬ&nbsp;PHÁT&nbsp;TRIỂN</span>
<h2 style="margin:0;font:800 clamp(30px,3.4vw,44px)/1.15 var(--font-display);letter-spacing:-.01em;text-wrap:balance">Những dấu&nbsp;mốc trên hành&nbsp;trình hơn ba&nbsp;thập&nbsp;kỷ</h2>
</div>
<div style="display:flex;gap:8px"><button type="button" data-pick-step="-1" aria-label="Mốc trước" style="width:44px;height:44px;border-radius:var(--radius-full);border:1px solid var(--border-strong);background:var(--surface-card);font-size:18px;cursor:pointer">←</button><button type="button" data-pick-step="1" aria-label="Mốc sau" style="width:44px;height:44px;border-radius:var(--radius-full);border:1px solid var(--border-strong);background:var(--surface-card);font-size:18px;cursor:pointer">→</button></div>
</div>
<div role="tablist" aria-label="Các mốc lịch sử" style="display:flex;gap:0;overflow-x:auto;border-bottom:1px solid var(--border-default)">
{MILESTONES.map((m, k) => <button type="button" role="tab" class="ms-year" data-pick={k} aria-selected={k === 0 ? 'true' : 'false'} style="flex:1 0 110px;padding:14px 8px;background:none;border:0;border-bottom:3px solid transparent;font:700 22px var(--font-display);color:var(--text-tertiary);cursor:pointer">{m.year}</button>)}
</div>
{MILESTONES.map((m, k) => (
<div role="tabpanel" data-pick-panel={k} hidden={k !== 0} style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,400px),1fr));gap:32px 56px;align-items:center">
<div style="position:relative;height:360px"><ImageSlot style="position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto;display:block" id={`ms-${k}`} shape="rounded" radius="16" placeholder={m.ph} /></div>
<div style="display:flex;flex-direction:column;gap:14px">
<span style="font:800 64px/1 var(--font-display);color:var(--green-200)">{m.year}</span>
<h3 style="margin: 0; font: 700 26px/1.3 var(--font-display); text-wrap: balance; max-width:382px">{m.title}</h3>
<p style="margin:0;color:var(--text-secondary);font-size:17px;text-align:justify;text-wrap:pretty">{m.body}</p>
</div></div>
))}
</div></section>

<section id="lanh-dao" style="scroll-margin-top:160px">
<div style="max-width:1280px;margin:0 auto;padding:clamp(64px,8vw,112px) clamp(20px,4vw,56px);display:flex;flex-direction:column;gap:40px">
<div style="display:flex;flex-direction:column;gap:14px;max-width:640px">
<span style="font:600 13px var(--font-mono);letter-spacing:.12em;color:var(--green-600)">BAN&nbsp;LÃNH&nbsp;ĐẠO</span>
<h2 style="margin:0;font:800 clamp(30px,3.4vw,44px)/1.15 var(--font-display);letter-spacing:-.01em">Đội&nbsp;ngũ lãnh&nbsp;đạo</h2>
</div>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(clamp(calc((100% - 96px)/5),calc((1000px - 100%)*999),calc((100% - 48px)/3)),1fr));gap:24px">
<div style="display:flex;flex-direction:column;gap:12px"><div style="position:relative;aspect-ratio:4/5"><ImageSlot style="position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto;display:block" id="lead-1" shape="rounded" radius="16" placeholder="Chân dung (nền đồng nhất)" /></div><div><strong style="display:block;font-size:17px">Nguyễn Hồng&nbsp;Phong</strong><span style="color:var(--text-secondary);font-size:15px">Tổng&nbsp;Giám&nbsp;đốc</span></div></div>
<div style="display:flex;flex-direction:column;gap:12px"><div style="position:relative;aspect-ratio:4/5"><ImageSlot style="position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto;display:block" id="lead-2" shape="rounded" radius="16" placeholder="Chân dung (nền đồng nhất)" /></div><div><strong style="display:block;font-size:17px">[Họ và&nbsp;tên]</strong><span style="color:var(--text-secondary);font-size:15px">[Chức danh]</span></div></div>
<div style="display:flex;flex-direction:column;gap:12px"><div style="position:relative;aspect-ratio:4/5"><ImageSlot style="position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto;display:block" id="lead-3" shape="rounded" radius="16" placeholder="Chân dung (nền đồng nhất)" /></div><div><strong style="display:block;font-size:17px">[Họ và&nbsp;tên]</strong><span style="color:var(--text-secondary);font-size:15px">[Chức danh]</span></div></div>
<div style="display:flex;flex-direction:column;gap:12px"><div style="position:relative;aspect-ratio:4/5"><ImageSlot style="position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto;display:block" id="lead-4" shape="rounded" radius="16" placeholder="Chân dung (nền đồng nhất)" /></div><div><strong style="display:block;font-size:17px">[Họ và&nbsp;tên]</strong><span style="color:var(--text-secondary);font-size:15px">[Chức danh]</span></div></div>
<div style="display:flex;flex-direction:column;gap:12px"><div style="position:relative;aspect-ratio:4/5"><ImageSlot style="position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto;display:block" id="lead-5" shape="rounded" radius="16" placeholder="Chân dung (nền đồng nhất)" /></div><div><strong style="display:block;font-size:17px">[Họ và&nbsp;tên]</strong><span style="color:var(--text-secondary);font-size:15px">[Chức danh]</span></div></div>
</div></div></section>

<section id="thanh-tuu" style="scroll-margin-top:160px;background:var(--surface-card)">
<div style="max-width:1280px;margin:0 auto;padding:clamp(64px,8vw,112px) clamp(20px,4vw,56px);display:flex;flex-direction:column;gap:40px">
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:24px 64px;align-items:end">
<div style="display:flex;flex-direction:column;gap:14px">
<span style="font:600 13px var(--font-mono);letter-spacing:.12em;color:var(--green-600)">THÀNH&nbsp;TỰU &amp;&nbsp;GHI&nbsp;NHẬN</span>
<h2 style="margin:0;font:800 clamp(30px,3.4vw,44px)/1.15 var(--font-display);letter-spacing:-.01em;text-wrap:balance">Những ghi&nbsp;nhận xứng&nbsp;đáng cho hơn ba thập&nbsp;kỷ cống&nbsp;hiến</h2>
</div>
<p style="margin:0;color:var(--text-secondary);font-size:17px;text-align:justify;text-wrap:pretty">Những danh hiệu dưới đây là sự ghi nhận cho hơn ba thập kỷ kiên trì với chất lượng, khoa học và trách nhiệm với nhà&nbsp;nông.</p>
</div>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(clamp(calc((100% - 40px)/3),calc((960px - 100%)*999),100%),1fr));gap:20px">
<div style="grid-column:1/-1;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr));gap:20px">
<div style="background:var(--green-50);border-radius:var(--radius-lg);padding:28px;display:grid;grid-template-columns:96px minmax(0,1fr);gap:20px;align-items:center"><div style="position:relative;height:120px"><ImageSlot style="position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto;display:block" id="award-hc" shape="rounded" radius="12" fit="contain" placeholder="Ảnh Huân chương" /></div><div style="display:flex;flex-direction:column;gap:4px"><span style="font:600 12px var(--font-mono);color:var(--green-700);letter-spacing:.06em">NHÀ&nbsp;NƯỚC ·&nbsp;[NĂM]</span><strong style="font-size:21px;line-height:1.3">Huân&nbsp;chương Lao&nbsp;động hạng&nbsp;Ba</strong><span style="color:var(--text-secondary);font-size:14px">Chủ tịch nước trao&nbsp;tặng</span></div></div>
