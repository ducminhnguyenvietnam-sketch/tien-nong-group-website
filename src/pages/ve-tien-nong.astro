---
import raw from '../content/pages/ve-tien-nong.json';
import siteRaw from '../content/site.json';
import { isFilled, stripPlaceholders, withDefaults } from '../lib/content';
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import ImageSlot from '../components/ImageSlot.astro';
import PageHero from '../components/PageHero.astro';
import { asset, link, url } from '../lib/routes';

const c = withDefaults(raw, 'src/content/pages/ve-tien-nong.json');
const site = withDefaults(siteRaw, 'src/content/site.json');
const F = 'src/content/pages/ve-tien-nong.json';
const fill = 'position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto;display:block';

const stats = [[c.s01_hero.t6, c.s01_hero.t7], [c.s01_hero.t8, c.s01_hero.t9], [c.s01_hero.t10, c.s01_hero.t11],
  [c.s01_hero.t12, c.s01_hero.t13], [c.s01_hero.t14, c.s01_hero.t15], [c.s01_hero.t16, c.s01_hero.t17]].filter(([v]) => isFilled(v));
const t = c.s02_thu_ngo;
const m = c.s03_su_menh_gia_tri;
const awards = [...c.s06_thanh_tuu.featured_awards.map((w, k) => ({ ...w, big: true, path: `s06_thanh_tuu.featured_awards.${k}.image` })),
  ...c.s06_thanh_tuu.awards.map((w, k) => ({ ...w, big: false, path: `s06_thanh_tuu.awards.${k}.image` }))].filter((w) => isFilled(w.title));
const caps = c.s07_nang_luc.capabilities.filter((x) => isFilled(x.title));
const partners = c.s08_he_sinh_thai.partners.map((p, k) => ({ ...p, k })).filter((p) => isFilled(p.name))
  .sort((a, b) => Number(!!b.featured) - Number(!!a.featured));
---
<Layout title={c.seo.title || undefined} description={c.seo.description || undefined} active="Về Tiến Nông">
<PageHero id="about-hero" image={c.s01_hero.img_about_hero_1} cms={`${F}#s01_hero.img_about_hero_1`} placeholder="Ảnh tập thể cán bộ, nhân viên trước trụ sở Tiến Nông"
  crumbs={[{ label: c.s01_hero.t1, href: url('trang-chu') }, { label: c.s01_hero.t2.replace(/^\s*\/\s*/, '') }]}
  eyebrow={c.s01_hero.t3} title={c.s01_hero.t4} lead={c.s01_hero.t5} />

{stats.length > 0 && <section class="about-stats">
<div class="about-stats__row">
{stats.map(([v, l]) => <div class="about-stat"><span class="about-stat__value" style="font:var(--type-stat)">{v}</span><span class="about-stat__label">{l}</span></div>)}
</div></section>}

<section id="thu-ngo" class="ceo">
<div class="ceo__bg" aria-hidden="true"></div>
<div class="ceo__wrap">
<div class="ceo__photo"><ImageSlot style={fill} id="ceo-portrait" shape="rounded" radius="24" placeholder="Chân dung Tổng Giám đốc Nguyễn Hồng Phong" image={t.img_ceo_portrait_1} cms={`${F}#s02_thu_ngo.img_ceo_portrait_1`} sizes="(max-width: 767px) 80vw, 420px" /></div>
<div class="ceo__text">
<h2 class="ceo__heading"><span>{t.heading_small || t.t1}</span>{t.heading}</h2>
<div class="ceo__letter">
<span class="ceo__quote ceo__quote--open" aria-hidden="true">“</span>
{isFilled(t.t2) && <p class="ceo__lead">{t.t2.replace(/^[“"]\s*|\s*[”"]$/g, '')}</p>}
<p class="ceo__body">{t.t3}</p>
</div>
<div class="ceo__sign"><span>{t.t5} {site.company.name}</span><strong>{t.t4}</strong></div>
<span class="ceo__quote ceo__quote--close" aria-hidden="true">”</span>
</div>
<div class="ceo__band">
<div class="ceo__badge"><span class="ceo__logo"><img src={asset('assets/logo-header.png')} alt="Tiến Nông" width="147" height="120" /></span><span class="ceo__slogan">{t.slogan}</span></div>
</div>
</div>
</section>

<section id="su-menh" class="mission">
<div class="mission__photo"><ImageSlot style={fill} id="mission-bg" shape="rect" placeholder="Ảnh nền sứ mệnh" image={m.background} cms={`${F}#s03_su_menh_gia_tri.background`} sizes="100vw" /></div>
<div class="mission__scrim" aria-hidden="true"></div>
<div class="mission__inner">
<div class="mission__cols">
<div><span class="mission__eyebrow">{m.t1}</span><span class="mission__statement">{m.t2}</span></div>
<div><span class="mission__eyebrow">{m.t3}</span><span class="mission__statement">{m.t4}</span></div>
<div><span class="mission__eyebrow">{m.t5}</span><span class="mission__statement">{m.t6}</span></div>
</div>
<div class="mission__values">
<span class="mission__eyebrow">{m.t7}</span>
<div class="values-grid">
<div style="background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.16);backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);border-radius:var(--radius-lg);padding:24px;display:flex;flex-direction:column;gap:10px"><span style="font:700 14px var(--font-mono);color:var(--amber-400)">{c.s03_su_menh_gia_tri.t8}</span><strong style="font-size:20px">{c.s03_su_menh_gia_tri.t9}</strong><span style="color:var(--green-100);font-size:15px">{c.s03_su_menh_gia_tri.t10}</span></div>
<div style="background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.16);backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);border-radius:var(--radius-lg);padding:24px;display:flex;flex-direction:column;gap:10px"><span style="font:700 14px var(--font-mono);color:var(--amber-400)">{c.s03_su_menh_gia_tri.t11}</span><strong style="font-size:20px">{c.s03_su_menh_gia_tri.t12}</strong><span style="color:var(--green-100);font-size:15px">{c.s03_su_menh_gia_tri.t13}</span></div>
<div style="background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.16);backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);border-radius:var(--radius-lg);padding:24px;display:flex;flex-direction:column;gap:10px"><span style="font:700 14px var(--font-mono);color:var(--amber-400)">{c.s03_su_menh_gia_tri.t14}</span><strong style="font-size:20px">{c.s03_su_menh_gia_tri.t15}</strong><span style="color:var(--green-100);font-size:15px">{c.s03_su_menh_gia_tri.t16}</span></div>
<div style="background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.16);backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);border-radius:var(--radius-lg);padding:24px;display:flex;flex-direction:column;gap:10px"><span style="font:700 14px var(--font-mono);color:var(--amber-400)">{c.s03_su_menh_gia_tri.t17}</span><strong style="font-size:20px">{c.s03_su_menh_gia_tri.t18}</strong><span style="color:var(--green-100);font-size:15px">{c.s03_su_menh_gia_tri.t19}</span></div>
{c.s03_su_menh_gia_tri.t21 && <div style="background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.16);backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);border-radius:var(--radius-lg);padding:24px;display:flex;flex-direction:column;gap:10px"><span style="font:700 14px var(--font-mono);color:var(--amber-400)">{c.s03_su_menh_gia_tri.t20}</span><strong style="font-size:20px">{c.s03_su_menh_gia_tri.t21}</strong><span style="color:var(--green-100);font-size:15px">{c.s03_su_menh_gia_tri.t22}</span></div>}
</div>
</div></div></section>

<section id="lich-su" class="hist">
<div class="hist__inner" data-picker data-pick-autoplay="5000">
<div class="hist__head">
<div class="hist__title"><span class="eyebrow-tag">{c.s04_lich_su.t1}</span><h2>{c.s04_lich_su.t2}</h2></div>
<div class="hist__arrows"><button type="button" data-pick-step="-1" aria-label="Mốc trước">←</button><button type="button" data-pick-step="1" aria-label="Mốc sau">→</button></div>
</div>
<div class="hist__stage">
{c.milestones.map((ms, k) => (
<div role="tabpanel" class="hist__panel" data-pick-panel={k} hidden={k !== 0} aria-label={ms.year}>
<div class="hist__photo"><ImageSlot style={fill} id={`ms-${k}`} shape="rounded" radius="20" placeholder={ms.image.alt} image={ms.image} cms={`${F}#milestones.${k}.image`} sizes="(max-width: 767px) 92vw, 600px" /></div>
<div class="hist__text">
<span class="hist__year" aria-hidden="true">{ms.year}</span>
<h3>{ms.title}</h3>
<p>{ms.body}</p>
</div>
</div>
))}
</div>
<div class="hist__rail" role="tablist" aria-label="Các mốc lịch sử">
{c.milestones.map((ms, k) => <button type="button" role="tab" class="hist__stop" data-pick={k} aria-selected={k === 0 ? 'true' : 'false'}><span class="hist__dot" aria-hidden="true"></span><span class="hist__label">{ms.year}</span></button>)}
</div>
</div></section>

<section id="lanh-dao" style="scroll-margin-top:160px">
<div style="max-width:1280px;margin:0 auto;padding:clamp(64px,8vw,112px) clamp(20px,4vw,56px);display:flex;flex-direction:column;gap:40px">
<div style="display:flex;flex-direction:column;gap:14px;max-width:640px">
<span style="font:var(--type-eyebrow);letter-spacing:.08em;color:var(--green-600)">{c.s05_lanh_dao.t1}</span>
<h2 style="margin:0;font:var(--type-h2);letter-spacing:-.01em">{c.s05_lanh_dao.t2}</h2>
</div>
<div class="board-grid">
<div style="display:flex;flex-direction:column;gap:12px"><div style="position:relative;aspect-ratio:4/5"><ImageSlot style="position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto;display:block" id="lead-1" shape="rounded" radius="16" placeholder="Chân dung (nền đồng nhất)" image={c.s05_lanh_dao.img_lead_1_1} cms="src/content/pages/ve-tien-nong.json#s05_lanh_dao.img_lead_1_1" /></div><div><strong style="display:block;font-size:17px">{c.s05_lanh_dao.t3}</strong><span style="color:var(--text-secondary);font-size:15px">{c.s05_lanh_dao.t4}</span></div></div>
<div style="display:flex;flex-direction:column;gap:12px"><div style="position:relative;aspect-ratio:4/5"><ImageSlot style="position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto;display:block" id="lead-2" shape="rounded" radius="16" placeholder="Chân dung (nền đồng nhất)" image={c.s05_lanh_dao.img_lead_2_1} cms="src/content/pages/ve-tien-nong.json#s05_lanh_dao.img_lead_2_1" /></div><div><strong style="display:block;font-size:17px">{c.s05_lanh_dao.t5}</strong><span style="color:var(--text-secondary);font-size:15px">{c.s05_lanh_dao.t6}</span></div></div>
<div style="display:flex;flex-direction:column;gap:12px"><div style="position:relative;aspect-ratio:4/5"><ImageSlot style="position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto;display:block" id="lead-3" shape="rounded" radius="16" placeholder="Chân dung (nền đồng nhất)" image={c.s05_lanh_dao.img_lead_3_1} cms="src/content/pages/ve-tien-nong.json#s05_lanh_dao.img_lead_3_1" /></div><div><strong style="display:block;font-size:17px">{c.s05_lanh_dao.t7}</strong><span style="color:var(--text-secondary);font-size:15px">{c.s05_lanh_dao.t8}</span></div></div>
<div style="display:flex;flex-direction:column;gap:12px"><div style="position:relative;aspect-ratio:4/5"><ImageSlot style="position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto;display:block" id="lead-4" shape="rounded" radius="16" placeholder="Chân dung (nền đồng nhất)" image={c.s05_lanh_dao.img_lead_4_1} cms="src/content/pages/ve-tien-nong.json#s05_lanh_dao.img_lead_4_1" /></div><div><strong style="display:block;font-size:17px">{c.s05_lanh_dao.t9}</strong><span style="color:var(--text-secondary);font-size:15px">{c.s05_lanh_dao.t10}</span></div></div>
<div style="display:flex;flex-direction:column;gap:12px"><div style="position:relative;aspect-ratio:4/5"><ImageSlot style="position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto;display:block" id="lead-5" shape="rounded" radius="16" placeholder="Chân dung (nền đồng nhất)" image={c.s05_lanh_dao.img_lead_5_1} cms="src/content/pages/ve-tien-nong.json#s05_lanh_dao.img_lead_5_1" /></div><div><strong style="display:block;font-size:17px">{c.s05_lanh_dao.t11}</strong><span style="color:var(--text-secondary);font-size:15px">{c.s05_lanh_dao.t12}</span></div></div>
</div>
{c.s05_lanh_dao.executives.some((p) => isFilled(p.name)) && <div style="display:flex;flex-direction:column;gap:20px;padding-top:40px;border-top:1px solid var(--border-default)">
<div style="display:flex;flex-direction:column;gap:10px"><span style="font:var(--type-eyebrow);letter-spacing:.08em;color:var(--green-600)">{c.s05_lanh_dao.t13}</span><h3 style="margin:0;font:var(--type-h3)">{c.s05_lanh_dao.t14}</h3></div>
<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,260px),1fr));gap:12px">
{c.s05_lanh_dao.executives.filter((p) => isFilled(p.name)).map((p) => <div style="display:flex;flex-direction:column;gap:4px;padding:16px 18px;border:1px solid var(--border-default);border-radius:var(--radius-md);background:var(--surface-card)"><strong style="font-size:16px">{p.name}</strong><span style="color:var(--text-secondary);font-size:14px;line-height:1.45">{p.title}</span></div>)}
</div></div>}
</div></section>


<section id="thanh-tuu" class="fame">
<div class="fame__inner">
<div class="fame__head">
<span class="eyebrow-tag">{c.s06_thanh_tuu.t1}</span>
<h2>{c.s06_thanh_tuu.t2}</h2>
{isFilled(c.s06_thanh_tuu.t3) && <p>{c.s06_thanh_tuu.t3}</p>}
</div>
<ul class="fame__wall">
{awards.map((w, k) => (
<li class:list={['fame__item', { 'fame__item--big': w.big }]}>
<div class="fame__img"><ImageSlot style={fill} id={`fame-${k}`} shape="rect" fit="contain" placeholder="Ảnh giải thưởng" image={w.image} cms={`${F}#${w.path}`} sizes={w.big ? '(max-width: 767px) 80vw, 420px' : '(max-width: 767px) 45vw, 240px'} /></div>
{isFilled(stripPlaceholders(w.label)) && <span class="fame__label">{stripPlaceholders(w.label)}</span>}
<strong class="fame__title">{w.title}</strong>
{isFilled(w.detail) && <span class="fame__detail">{w.detail}</span>}
</li>
))}
</ul>
{isFilled(c.s06_thanh_tuu.profile_pdf) && <div class="fame__cta"><a href={link(c.s06_thanh_tuu.profile_pdf)} target="_blank" rel="noopener" style="text-decoration:none;display:inline-flex"><Button as="span" variant="secondary">{c.s06_thanh_tuu.t29}</Button></a></div>}
</div></section>

{caps.length > 0 && <section id="nang-luc" class="cap">
<div class="cap__inner" data-picker>
<div class="cap__head">
<div><span class="eyebrow-tag">{c.s07_nang_luc.t1}</span><h2>{c.s07_nang_luc.t2}</h2></div>
{caps.length > 1 && <div class="cap__tabs" role="tablist" aria-label="Năng lực">
{caps.map((x, k) => <button type="button" role="tab" data-pick={k} aria-selected={k === 0 ? 'true' : 'false'}>{x.tab || x.title}</button>)}
</div>}
</div>
{caps.map((x, k) => (
<div role="tabpanel" class="cap__panel" data-pick-panel={k} hidden={k !== 0} aria-label={x.title}>
<div class="cap__mosaic" data-count={Math.min(4, x.photos.length)}>
{x.photos.slice(0, 4).map((ph, i) => <div class="cap__tile"><ImageSlot style={fill} id={`cap-${k}-${i}`} shape="rounded" radius="16" placeholder={ph.alt || 'Ảnh năng lực'} image={ph} cms={`${F}#s07_nang_luc.capabilities.${c.s07_nang_luc.capabilities.indexOf(x)}.photos.${i}`} sizes={i === 0 ? '(max-width: 767px) 92vw, 460px' : '(max-width: 767px) 45vw, 280px'} /></div>)}
</div>
<div class="cap__body">
<h3 class="cap__title">{x.title}</h3>
{isFilled(x.subtitle) && <p class="cap__subtitle">{x.subtitle}</p>}
{isFilled(x.text) && <p class="cap__text">{x.text}</p>}
{x.stats.length > 0 && <div class="cap__stats">
{x.stats.filter((s) => isFilled(s.value)).map((s) => <div class="cap__stat"><span class="cap__stat-value">{s.value}</span><span class="cap__stat-label">{s.label}</span>{isFilled(s.sub) && <span class="cap__stat-sub">{s.sub}</span>}</div>)}
</div>}
{x.chips.length > 0 && <div class="cap__chips-wrap">
{isFilled(x.chips_title) && <span class="cap__chips-title">{x.chips_title}</span>}
<ul class="cap__chips">{x.chips.filter(isFilled).map((ch) => <li>{ch}</li>)}</ul>
</div>}
{isFilled(x.note) && <p class="cap__text">{x.note}</p>}
{isFilled(x.link) && <a class="cap__more" href={link(x.link)}>{x.link_label || 'Xem thêm'} →</a>}
</div>
</div>
))}
</div></section>}

{partners.length > 0 && <section id="doi-tac" class="partners">
<div class="partners__inner">
<div class="partners__head"><span class="eyebrow-tag">{c.s08_he_sinh_thai.t1}</span><h2>{c.s08_he_sinh_thai.t2}</h2></div>
<ul class="partners__cloud">
{partners.map((p) => {
  const hasLogo = isFilled(p.logo?.src);
  const inner = <>
    <span class="partner__logo" data-needs-photos={hasLogo ? undefined : ''}><ImageSlot style={fill} id={`partner-${p.k}`} shape="rect" fit="contain" placeholder={`Logo ${p.name}`} image={p.logo} cms={`${F}#s08_he_sinh_thai.partners.${p.k}.logo`} sizes="240px" /></span>
    {!hasLogo && <span class="partner__name">{p.name}</span>}
  </>;
  return <li class:list={['partner', { 'partner--big': p.featured }]} title={p.name}>
    {isFilled(p.link) ? <a href={link(p.link)} target="_blank" rel="noopener" aria-label={p.name}>{inner}</a> : <div>{inner}</div>}
  </li>;
})}
</ul>
</div></section>}

<section style="background:var(--green-500);color:#fff">
<div style="max-width:1280px;margin:0 auto;padding:56px clamp(20px,4vw,56px);display:flex;justify-content:space-between;align-items:center;gap:24px;flex-wrap:wrap">
<h2 style="margin:0;font:var(--type-h2);max-width:640px;text-wrap:balance">{c.s09_phan_9.t1}</h2>
<div style="display:flex;gap:12px;flex-wrap:wrap"><a href={url('lien-he', 'lien-he-form')} style="background:#fff;color:var(--green-700);font-weight:700;padding:13px 22px;border-radius:var(--radius-md)">{c.s09_phan_9.t2}</a><a href={url('tuyen-dung', 'vi-tri')} style="color:#fff;font-weight:700;padding:13px 22px;border-radius:var(--radius-md);border:1px solid rgba(255,255,255,.7)">{c.s09_phan_9.t3}</a></div>
</div></section>
</Layout>

<style>
  /* Shared section frame on this page */
  .ceo__wrap, .mission__inner, .hist__inner, .fame__inner, .cap__inner, .partners__inner, .about-stats__row {
    max-width: 1280px; margin: 0 auto; padding-inline: clamp(20px, 4vw, 56px); }
  .eyebrow-tag { display: block; font: var(--type-eyebrow); letter-spacing: .08em; text-transform: uppercase; color: var(--green-700); }
  section h2 { margin: 10px 0 0; font: var(--type-h2); letter-spacing: -.01em; text-wrap: balance; }

  /* Stats under the hero */
  .about-stats { background: var(--surface-card); border-bottom: 1px solid var(--border-default); }
  .about-stats__row { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 24px; padding-block: 40px 44px; }
  .about-stat { display: flex; flex-direction: column; gap: 6px; }
  .about-stat__value { font-size: clamp(28px, 2.3vw, 34px) !important; color: var(--green-700); white-space: nowrap; font-variant-numeric: tabular-nums; }
  .about-stat__label { font: 600 13px/1.45 var(--font-body); letter-spacing: .06em; text-transform: uppercase; color: var(--text-secondary); }
  @media (max-width: 1099.98px) { .about-stats__row { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 599.98px) { .about-stats__row { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px 16px; padding-block: 32px; } }

  /* CEO letter — brand panel with a curved foot, portrait overlapping a dark band (reference: "Lời chào từ Tổng Giám đốc") */
  .ceo { position: relative; padding: clamp(56px, 7vw, 96px) 0 clamp(56px, 7vw, 96px); background: var(--surface-page); overflow: hidden; scroll-margin-top: 120px; }
  .ceo__bg { position: absolute; left: -10%; right: -10%; top: 0; height: 78%; background: var(--green-600);
    border-radius: 0 0 50% 50% / 0 0 22% 22%; }
  .ceo__wrap { position: relative; display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); grid-template-rows: auto auto; column-gap: clamp(32px, 4vw, 64px); }
  .ceo__photo { grid-row: 1 / span 2; grid-column: 1; position: relative; z-index: 2; align-self: end; aspect-ratio: 4 / 5; width: 100%; max-width: 440px; justify-self: center;
    margin-bottom: 0; filter: drop-shadow(0 18px 30px rgba(2, 53, 26, .28)); }
  .ceo__text { position: relative; grid-column: 2; color: #fff; display: flex; flex-direction: column; gap: 20px; padding-bottom: clamp(32px, 4vw, 48px); }
  .ceo__heading { margin: 0; font: var(--type-h1); color: #fff; letter-spacing: -.015em; }
