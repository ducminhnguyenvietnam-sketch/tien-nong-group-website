---
/**
 * Văn hóa doanh nghiệp. Flow: hero → key figures → the slogan → origin + the five "tốt cho" questions
 * → five tâm niệm → five core values (photo + caption from a real news story) → traditions → training
 * (news cards) → the Tiến Nông song → poems → gallery → invitation to join.
 */
import raw from '../../content/pages/van-hoa-doanh-nghiep.json';
import { isFilled, stripPlaceholders, withDefaults } from '../../lib/content';
import Layout from '../../layouts/Layout.astro';
import ImageSlot from '../../components/ImageSlot.astro';
import PageHero from '../../components/PageHero.astro';
import FigureCard from '../../components/FigureCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import Head from '../../components/story/Head.astro';
import siteRaw from '../../content/site.json';
import { link, url, youtubeId } from '../../lib/routes';
import { newsByLink } from '../../lib/news';

const c = withDefaults(raw, 'src/content/pages/van-hoa-doanh-nghiep.json');
const site = withDefaults(siteRaw, 'src/content/site.json');
const F = 'src/content/pages/van-hoa-doanh-nghiep.json';
const fill = 'position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto;display:block';

const principles = c.principles.items.filter((p) => isFilled(p.title));
const poems = c.poems.items.filter((p) => isFilled(p.text));
const measures = (c.origin.measures as string[]).filter(isFilled);
const hasGallery = c.gallery.photos.some((ph) => isFilled(ph.src));

// Slogan band: the "KHẨU HIỆU" line large, the other two lines beneath it.
const mottos = c.mottos.filter((m) => isFilled(m.text));
const slogan = mottos.find((m) => /khẩu hiệu/i.test(m.label)) ?? mottos.at(-1);
const otherMottos = mottos.filter((m) => m !== slogan);
const sloganParts = String(slogan?.text || '').split(/\s+[–-]\s+/);

/** Photo for a card: its own CMS photo, otherwise the cover of the news story it links to. */
const photoFor = async (img: any, href: string) => {
  if (isFilled(img?.src)) return { image: img, own: true };
  const n = await newsByLink(href);
  return { image: n?.data.cover, own: false };
};
const values = await Promise.all(c.values.items.map(async (v, k) => ({ ...v, k, ...(await photoFor(v.image, v.link)) })));
const shownValues = values.filter((v) => isFilled(v.title));
const traditions = c.traditions.items.map((t, k) => ({ ...t, k })).filter((t) => isFilled(t.title));
const learning = await Promise.all(c.learning.items.map(async (l, k) => ({ ...l, k, ...(await photoFor(l.image, l.link)) })));
const shownLearning = learning.filter((l) => isFilled(l.title));

const videos = c.media.videos.filter((v) => isFilled(v.youtube) || isFilled(v.file));
const [mainVideo, ...moreVideos] = videos;
const titleParts = (() => {
  const t = String(c.media.title || ''), h = String(c.media.highlight || '').trim();
  const i = h ? t.indexOf(h) : -1;
  return i < 0 ? [t, '', ''] : [t.slice(0, i), h, t.slice(i + h.length)];
})();
const two = (n: number) => String(n + 1).padStart(2, '0');
const tnVideo = youtubeId(c.principles.youtube);
const stories = c.family.stories.map((st, k) => ({ ...st, k })).filter((st) => isFilled(st.names));
---
<Layout title={c.seo.title || undefined} description={c.seo.description || undefined} active="Về Tiến Nông">
<PageHero id="vh-hero" image={c.hero.background} cms={`${F}#hero.background`} placeholder={c.hero.background?.alt || 'Tập thể cán bộ, nhân viên Tiến Nông'}
  crumbs={[{ label: c.hero.breadcrumb_home, href: url('trang-chu') }, { label: c.hero.breadcrumb_parent, href: url('ve-tien-nong') }, { label: c.hero.breadcrumb_self }]}
  eyebrow={c.hero.eyebrow} title={c.hero.title} lead={c.hero.intro} leadWidth={775}>
{principles.length > 0 && <a href="#tam-niem" class="page-hero__btn page-hero__btn--solid">{c.hero.button_principles}</a>}{mainVideo && <a href="#bai-hat" class="page-hero__btn">{c.hero.button_media}</a>}
</PageHero>

<FigureCard overlap items={c.stats} />

{slogan && <section class="vh-slogan">
<div class="vh-slogan__wrap">
<span class="vh-slogan__label">{slogan.label}</span>
<p class="vh-slogan__text">{sloganParts.length > 1 ? <><span>{sloganParts[0]}</span><span class="vh-slogan__dash"> – </span><span class="vh-slogan__gold">{sloganParts.slice(1).join(' – ')}</span></> : slogan.text}</p>
{otherMottos.length > 0 && <dl class="vh-slogan__more">{otherMottos.map((m) => <div><dt>{m.label}</dt><dd>{m.text}</dd></div>)}</dl>}
</div></section>}

<section id="khoi-nguon" class="st-sec">
<div class="st-wrap">
<div class="vh-origin">
<Head eyebrow={c.origin.eyebrow} title={c.origin.title} intro={c.origin.text} />
<div class="vh-origin__photo st-hide-empty"><ImageSlot style={fill} id="vh-origin" shape="rounded" radius="20" placeholder={c.origin.image.alt || 'Ảnh khởi nguồn'} image={c.origin.image} cms={`${F}#origin.image`} sizes="(max-width: 899px) 92vw, 520px" /></div>
</div>
{measures.length > 0 && <div class="vh-measure">
<div class="vh-measure__head"><strong>{c.origin.measure_title}</strong><span>{c.origin.measure_intro}</span></div>
<ul class="vh-measure__list" style={`--n:${measures.length}`}>{measures.map((m) => <li>{m}</li>)}</ul>
</div>}
</div></section>

{principles.length > 0 && <section id="tam-niem" class="st-sec st-sec--dark">
<div class="st-wrap">
<Head eyebrow={c.principles.eyebrow} title={c.principles.title} intro={c.principles.intro} split />
<div class="vh-tn">
{tnVideo
  ? <button type="button" class="yt vh-tn__media" data-yt={tnVideo} aria-label={`Phát video ${c.principles.title}`}>
      <img src={`https://i.ytimg.com/vi/${tnVideo}/hqdefault.jpg`} alt="" loading="lazy" width="480" height="360" />
      <span class="yt__play" aria-hidden="true"></span>
    </button>
  : <div class="vh-tn__media st-hide-empty"><ImageSlot style={fill} id="vh-tam-niem" shape="rounded" radius="20" placeholder="Bức Tâm niệm" image={c.principles.image} cms={`${F}#principles.image`} sizes="(max-width: 899px) 92vw, 560px" /></div>}
<ol class="vh-tn__list" data-seq>
{principles.map((p, i) => <li><span class="vh-tn__num">{i + 1}</span><strong>{p.title}</strong></li>)}
</ol>
</div>
</div></section>}

{shownValues.length > 0 && <section id="gia-tri" class="st-sec scrolly" data-scrolly>
<div class="scrolly__pin"><div class="st-wrap">
<Head eyebrow={c.values.eyebrow} title={c.values.title} intro={c.values.intro} split />
<div class="vh-values" data-picker>
<div class="vh-values__list" role="tablist" aria-label={c.values.title}>
{shownValues.map((v, i) => <button type="button" role="tab" data-pick={i} aria-selected={i === 0 ? 'true' : 'false'}>
<span class="vh-values__num">{two(i)}</span>
<span class="vh-values__txt"><strong>{v.title}</strong><span>{v.body}</span></span>
</button>)}
</div>
<div class="vh-values__stage">
{shownValues.map((v, i) => <figure role="tabpanel" data-pick-panel={i} hidden={i !== 0} class="vh-values__panel">
<div class="vh-values__img"><ImageSlot style={fill} id={`vh-value-${v.k}`} shape="rect" placeholder={v.title} image={v.image} cms={v.own ? `${F}#values.items.${v.k}.image` : undefined} sizes="(max-width: 899px) 92vw, 640px" /></div>
{isFilled(v.proof) && <figcaption><span>{v.proof}</span>{isFilled(v.link) && <a href={link(v.link)}>Đọc bài →</a>}</figcaption>}
</figure>)}
</div>
</div>
</div></div></section>}

{traditions.length > 0 && <section id="nghi-thuc" class="st-sec st-sec--dark scrolly" data-scrolly>
<div class="scrolly__pin"><div class="st-wrap">
<Head eyebrow={c.traditions.eyebrow} title={c.traditions.title} intro={c.traditions.intro} split />
<div class="vh-trad" data-picker>
<div class="vh-trad__list">
{traditions.map((t, i) => <div class="vh-trad__item">
<button type="button" data-pick={i} aria-selected={i === 0 ? 'true' : 'false'} aria-controls={`vh-trad-${i}`}><span>{t.title}</span><span class="vh-trad__sign" aria-hidden="true"></span></button>
<div id={`vh-trad-${i}`} class="vh-trad__body" data-pick-panel={i} hidden={i !== 0}><p>{stripPlaceholders(t.body)}</p></div>
</div>)}
</div>
<div class="vh-trad__stage">
{traditions.map((t, i) => <div class="vh-trad__img" data-pick-panel={i} hidden={i !== 0}><ImageSlot style={fill} id={`vh-tradition-${t.k}`} shape="rounded" radius="20" placeholder={t.image.alt || t.title} image={t.image} cms={`${F}#traditions.items.${t.k}.image`} sizes="(max-width: 899px) 92vw, 600px" /></div>)}
</div>
</div>
</div></div></section>}

{stories.length > 0 && <section id="gia-dinh" class="st-sec st-sec--card">
<div class="st-wrap">
<div class="vh-fam__head">
<Head eyebrow={c.family.eyebrow} title={c.family.title} intro={c.family.intro} split />
</div>
<div class="vh-fam">
{stories.map((st) => <article class="vh-fam__card">
<div class="vh-fam__img"><ImageSlot style={fill} id={`vh-family-${st.k}`} shape="rect" placeholder={st.names} image={st.image} cms={`${F}#family.stories.${st.k}.image`} sizes="(max-width: 899px) 92vw, 600px" /></div>
<div class="vh-fam__body">
{isFilled(st.tag) && <span class="vh-fam__tag">{st.tag}</span>}
<h3>{st.names}</h3>
<p class="jx-justify">{st.text}</p>
</div>
</article>)}
</div>
{isFilled(c.family.link) && <a href={link(c.family.link)} class="vh-link vh-fam__more">{c.family.link_label || 'Đọc câu chuyện'} →</a>}
</div></section>}

{shownLearning.length > 0 && <section id="hoc-tap" class="st-sec">
<div class="st-wrap">
<div class="st-split">
<div class="vh-learn__copy">
<Head eyebrow={c.learning.eyebrow} title={c.learning.title} intro={c.learning.intro} />
{isFilled(c.learning.motto) && <blockquote class="vh-learn__motto"><p>{c.learning.motto}</p></blockquote>}
</div>
<div class="st-split__media st-hide-empty" style="--ratio:3/2"><ImageSlot style={fill} id="vh-learning" shape="rounded" radius="20" placeholder={c.learning.image.alt || 'Ảnh đào tạo'} image={c.learning.image} cms={`${F}#learning.image`} sizes="(max-width: 899px) 92vw, 600px" /></div>
</div>
<div class="vh-learn__grid">
{shownLearning.map((l) => <a href={link(l.link)} class="vh-learn__card">
<span class="vh-learn__img"><ImageSlot style={fill} id={`vh-learn-${l.k}`} shape="rect" placeholder={l.title} image={l.image} cms={l.own ? `${F}#learning.items.${l.k}.image` : undefined} sizes="(max-width: 767px) 92vw, 400px" /></span>
<span class="vh-learn__body">
{isFilled(l.label) && <span class="vh-learn__label">{l.label}</span>}
<strong>{l.title}</strong>
<span class="vh-learn__text">{l.text}</span>
</span>
</a>)}
</div>
</div></section>}

{mainVideo && <section id="bai-hat" class="st-sec st-sec--dark">
<div class="st-wrap">
<div class="vh-song__head">
<div class="st-head"><span class="vh-song__eyebrow">{c.media.eyebrow}</span><h2 class="st-h2 vh-song__title">{titleParts[0]}{titleParts[1] && <span class="vh-gold">{titleParts[1]}</span>}{titleParts[2]}</h2>{isFilled(c.media.intro) && <p class="st-lead">{c.media.intro}</p>}</div>
{isFilled(site.social.youtube) && <a href={link(site.social.youtube)} target="_blank" rel="noopener" class="vh-song__channel-link">Xem kênh YouTube <span aria-hidden="true">↗</span></a>}
</div>
<div class:list={['vh-song', { 'vh-song--solo': moreVideos.length === 0 }]}>
{(() => { const id = youtubeId(mainVideo.youtube); return id
  ? <button type="button" class="yt vh-song__main" data-yt={id} aria-label={`Phát video ${mainVideo.title || ''}`}>
      <img src={`https://i.ytimg.com/vi/${id}/maxresdefault.jpg`} alt="" loading="lazy" width="1280" height="720" />
      <span class="vh-song__shade" aria-hidden="true"></span>
      {isFilled(mainVideo.duration) && <span class="vh-song__dur">{mainVideo.duration}</span>}
      <span class="yt__play yt__play--big" aria-hidden="true"></span>
      <span class="vh-song__cap">{isFilled(mainVideo.label) && <span>{mainVideo.label}</span>}{isFilled(mainVideo.title) && <strong>{mainVideo.title}</strong>}</span>
    </button>
  : <div class="vh-song__main"><video src={link(mainVideo.file)} controls preload="metadata"></video></div>; })()}
{moreVideos.length > 0 && <ul class="vh-song__list">
{moreVideos.slice(0, 3).map((v) => { const id = youtubeId(v.youtube); return (
  <li><a href={isFilled(v.youtube) ? link(v.youtube) : link(v.file)} target="_blank" rel="noopener" class="vh-song__item">
    <span class="vh-song__thumb">{id && <img src={`https://i.ytimg.com/vi/${id}/mqdefault.jpg`} alt="" loading="lazy" width="320" height="180" />}<span class="yt__play" aria-hidden="true"></span>{isFilled(v.duration) && <span class="vh-song__dur vh-song__dur--sm">{v.duration}</span>}</span>
    <span class="vh-song__meta">{isFilled(v.label) && <span>{v.label}</span>}<strong>{v.title}</strong></span>
  </a></li>); })}
{moreVideos.length < 3 && isFilled(site.social.youtube) && <li><a href={link(site.social.youtube)} target="_blank" rel="noopener" class="vh-song__item vh-song__item--channel">
  <span class="vh-song__thumb vh-song__thumb--channel"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="1" y="4.5" width="22" height="15" rx="4.5" fill="#FF0000"/><path fill="#fff" d="m10 8.8 5.6 3.2-5.6 3.2z"/></svg></span>
  <span class="vh-song__meta"><span>KÊNH YOUTUBE</span><strong>Xem thêm video của Tiến Nông</strong></span>
</a></li>}
</ul>}
</div>
</div></section>}

{poems.length > 0 && <section class="st-sec st-sec--card">
<div class="st-wrap">
<Head eyebrow={c.poems.eyebrow} title={c.poems.title} intro={c.poems.intro} split />
<div class="st-grid" style="--min:340px">
{poems.map((p) => <figure style="margin:0;display:flex;flex-direction:column;gap:16px;padding:clamp(24px,3vw,36px);background:var(--surface-page);border-left:4px solid var(--amber-400);border-radius:var(--radius-lg)"><strong style="font:var(--type-num)">{p.title}</strong><blockquote style="margin:0;white-space:pre-line;font:500 17px/1.8 var(--font-display);color:var(--text-primary)">{p.text}</blockquote><figcaption style="display:flex;flex-direction:column;padding-top:12px;border-top:1px solid var(--border-default)"><strong>{p.author}</strong><span style="font-size:14px;color:var(--text-secondary)">{p.place}</span></figcaption></figure>)}
</div></div></section>}

<section class="st-sec" data-needs-photos={hasGallery ? undefined : ''}>
<div class="st-wrap">
<Head eyebrow={c.gallery.eyebrow} title={c.gallery.title} />
<div class="vh-gallery">
{c.gallery.photos.map((ph, k) => <div style="position:relative;min-height:200px"><ImageSlot style={fill} id={`vh-gallery-${k}`} shape="rounded" radius="16" placeholder={ph.alt} image={ph} cms={`${F}#gallery.photos.${k}`} /></div>)}
</div></div></section>

<CtaBand title={c.cta.title} text={c.cta.text} primary={{ label: c.cta.button_jobs, href: url('tuyen-dung', 'vi-tri') }} secondary={{ label: c.cta.button_about, href: url('ve-tien-nong') }} />
</Layout>

<style>
  /* Slogan band: one large line, two supporting lines (different from the figures card above). */
  .vh-slogan { position: relative; overflow: hidden; background: radial-gradient(120% 140% at 50% 0%, var(--green-700) 0%, var(--green-800) 55%, var(--green-900) 100%); color: #fff; margin-top: clamp(40px, 5vw, 64px); }
  .vh-slogan__wrap { max-width: var(--wrap, 1280px); margin: 0 auto; padding: clamp(56px, 7vw, 88px) clamp(20px, 4vw, 56px); display: flex; flex-direction: column; align-items: center; text-align: center; gap: 18px; }
  .vh-slogan__label { font: 600 13px/1.4 var(--font-body); letter-spacing: .14em; text-transform: uppercase; color: var(--brand-highlight); }
  .vh-slogan__text { margin: 0; font: 600 clamp(28px, 3.6vw, 48px)/1.2 var(--font-display); letter-spacing: -.01em; text-align: center; text-align-last: center; text-wrap: balance; }
  .vh-slogan__dash { color: rgba(245, 196, 78, .75); }
  .vh-slogan__gold { color: var(--brand-highlight); }
  .vh-slogan__more { margin: 14px 0 0; display: grid; grid-template-columns: repeat(2, minmax(0, auto)); justify-content: center; gap: 16px 0; }
  .vh-slogan__more > div { display: flex; flex-direction: column; gap: 6px; padding: 4px clamp(20px, 3vw, 40px); }
  .vh-slogan__more > div + div { border-left: 1px solid rgba(245, 196, 78, .45); }
  .vh-slogan__more dt { font: 600 12px/1.4 var(--font-body); letter-spacing: .1em; text-transform: uppercase; color: var(--green-100); }
  .vh-slogan__more dd { margin: 0; font: 500 clamp(16px, 1.4vw, 19px)/1.45 var(--font-display); color: #fff; text-align: center; text-align-last: center; }

  /* Origin: text beside a shorter photo, then the five questions across the full width. */
  .vh-origin { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: 32px clamp(32px, 5vw, 64px); align-items: start; }
  .vh-origin :global(.st-head) { max-width: none; }
  .vh-origin__photo { position: relative; aspect-ratio: 4 / 3; }
  .vh-measure { display: flex; flex-direction: column; gap: 18px; padding: clamp(22px, 3vw, 32px); border-radius: var(--radius-xl); background: var(--surface-card); border: 1px solid var(--border-default); }
  .vh-measure__head { display: flex; align-items: baseline; justify-content: space-between; gap: 8px 32px; flex-wrap: wrap; }
  .vh-measure__head strong { font: 600 clamp(22px, 2vw, 26px)/1.3 var(--font-display); color: var(--text-primary); }
  .vh-measure__head span { color: var(--text-secondary); font-size: 16px; text-align: start; }
  .vh-measure__list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(var(--n), minmax(0, 1fr)); gap: 12px; }
  .vh-measure__list li { display: flex; align-items: center; justify-content: center; min-height: 68px; padding: 12px 10px; border-radius: var(--radius-lg);
    background: var(--m-bg, var(--green-800)); color: var(--m-fg, #fff); font: 600 clamp(15px, 1.3vw, 18px)/1.3 var(--font-display); text-align: center; white-space: nowrap; }

  /* The five questions get darker from left to right (lightest "tốt cho mình", darkest "tốt cho tương lai"). */
  .vh-measure__list li:nth-child(1) { --m-bg: #d6f2e1; --m-fg: var(--green-900); }
  .vh-measure__list li:nth-child(2) { --m-bg: #8fd3ab; --m-fg: var(--green-900); }
  .vh-measure__list li:nth-child(3) { --m-bg: #2eae69; }
  .vh-measure__list li:nth-child(4) { --m-bg: #00793f; }
  .vh-measure__list li:nth-child(5) { --m-bg: #02351a; }

  /* Five tâm niệm (Figma): the song video on the left, the five lines on the right with round numbers. */
  .vh-tn { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 32px clamp(40px, 6vw, 88px); align-items: center; }
  .vh-tn__media { position: relative; aspect-ratio: 16 / 9; }
  .vh-tn__list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 18px; }
  .vh-tn__list li { display: grid; grid-template-columns: 44px minmax(0, 1fr); gap: 18px; align-items: center; }
  .vh-tn__num { width: 44px; height: 44px; border-radius: 50%; display: flex; align-items: center; justify-content: center; border: 1px solid rgba(245, 196, 78, .65); color: var(--brand-highlight); font: 600 18px/1 var(--font-display); }
  .vh-tn__list strong { font: 600 clamp(19px, 1.75vw, 24px)/1.35 var(--font-display); color: #fff; text-align: start; }


  /* Family: two couples, photo + short story. */
  .vh-fam { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
  .vh-fam__card { display: flex; flex-direction: column; background: var(--surface-page); border: 1px solid var(--border-default); border-radius: var(--radius-xl); overflow: hidden; }
  .vh-fam__img { position: relative; aspect-ratio: 16 / 9; }
  .vh-fam__body { display: flex; flex-direction: column; gap: 10px; padding: clamp(20px, 2.4vw, 30px); }
  .vh-fam__tag { font: 600 12px/1.4 var(--font-body); letter-spacing: .08em; text-transform: uppercase; color: var(--brand-bright); }
  .vh-fam__body h3 { margin: 0; font: 600 clamp(18px, 1.5vw, 21px)/1.35 var(--font-display); color: var(--green-800); text-wrap: balance; }
  .vh-fam__body p { margin: 0; font-size: 15.5px; line-height: 1.65; color: var(--text-secondary); }
  .vh-fam__more { align-self: flex-start; }

  /* Core values: pick a value on the left, its photo and caption show on the right. */
  .vh-values { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr); gap: 24px clamp(28px, 4vw, 56px); align-items: start; }
  .vh-values__list { display: flex; flex-direction: column; gap: 8px; }
  .vh-values__list button { display: grid; grid-template-columns: 40px minmax(0, 1fr); gap: 14px; align-items: start; width: 100%; padding: 16px 18px; text-align: left; cursor: pointer;
    border: 1px solid var(--border-default); border-radius: var(--radius-lg); background: var(--surface-card); color: var(--text-primary); font: inherit;
    transition: background var(--motion-base), border-color var(--motion-base), box-shadow var(--motion-base); }
  .vh-values__list button:hover { border-color: var(--green-200); }
  .vh-values__list button[aria-selected='true'] { background: var(--green-800); border-color: var(--green-800); color: #fff; box-shadow: var(--shadow-md); }
  .vh-values__num { font: 600 15px/1.6 var(--font-display); color: var(--brand-bright); }
