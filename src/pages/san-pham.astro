---
import raw from '../content/pages/san-pham.json';
import { isFilled, withDefaults } from '../lib/content';
import Layout from '../layouts/Layout.astro';
import ImageSlot from '../components/ImageSlot.astro';
import Select from '../components/Select.astro';
import Tabs from '../components/Tabs.astro';
import { url, link } from '../lib/routes';
import { getProducts, productUrl } from '../lib/products';

const c = withDefaults(raw, 'src/content/pages/san-pham.json');

const products = await getProducts();
const lines = c.lines;
const lineLabel = (key: string) => (lines.find((l) => l.key === key)?.label ?? '').replace('Phân bón ', '');
const hasPoster = isFilled(c.poster.image?.src);
const hasPosterText = isFilled(c.poster.title);
---
<Layout title={c.seo.title || undefined} description={c.seo.description || undefined} active="Sản phẩm">
{/* Launch banner, full width: the communications team swaps the image (and optional words) for each product launch. */}
<section class="pd-banner" aria-label={c.poster.image.alt} data-needs-photos={hasPoster ? undefined : ''}>
{(() => {
  const inner = <>
    <div class="pd-banner__img"><ImageSlot style="position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto;display:block" id="product-poster" sizes="100vw" priority shape="rect" placeholder={c.poster.image.alt} image={c.poster.image} cms="src/content/pages/san-pham.json#poster.image" /></div>
    {hasPosterText && <><div class="pd-banner__scrim" aria-hidden="true"></div><div class="pd-banner__copy">{isFilled(c.poster.eyebrow) && <span class="pd-banner__eyebrow">{c.poster.eyebrow}</span>}<strong class="pd-banner__title">{c.poster.title}</strong>{isFilled(c.poster.text) && <span class="pd-banner__text">{c.poster.text}</span>}{isFilled(c.poster.button) && <span class="pd-banner__btn">{c.poster.button}</span>}</div></>}
  </>;
  return c.poster.link ? <a href={link(c.poster.link)} class="pd-banner__link">{inner}</a> : <div class="pd-banner__link">{inner}</div>;
})()}
</section>
<section style="background:var(--surface-card)">
<div style="max-width:1280px;margin:0 auto;padding:28px clamp(20px,4vw,56px) 40px;display:flex;flex-direction:column;gap:28px">
<span style="font-size:13px;color:var(--text-tertiary)"><a href={url('trang-chu')} style="color:var(--text-tertiary)">{c.s01_tieu_de.t1}</a> {c.s01_tieu_de.t2}</span>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:20px 64px;align-items:end">
<div style="display:flex;flex-direction:column;gap:14px">
<span style="font:var(--type-eyebrow);letter-spacing:.08em;color:var(--green-600)">{c.s01_tieu_de.t3}</span>
<h1 style="margin:0;font:var(--type-h1);letter-spacing:-.015em;text-wrap:balance">{c.s01_tieu_de.t4}</h1>
</div>
<div style="display:flex;flex-direction:column;gap:14px">
<p style="margin:0;color:var(--text-secondary);font-size:var(--fs-body);text-wrap:pretty">{c.s01_tieu_de.t5}</p>
<div style="display:flex;gap:16px;flex-wrap:wrap">{isFilled(c.s01_tieu_de.link1) && <a href={link(c.s01_tieu_de.link1)} target="_blank" rel="noopener" style="font-weight:600">{c.s01_tieu_de.t6}</a>}<a href={url('lien-he')} style="font-weight:600">{c.s01_tieu_de.t7}</a></div>
</div></div>
<div style="overflow-x:auto"><Tabs id="line-tabs" label="Dòng sản phẩm" items={[{ value: 'all', label: c.lines_all_label }, ...lines.map((l) => ({ value: l.key, label: l.label }))]} value="all" /></div>
</div></section>

<section style="background:var(--surface-page)">
<div style="max-width:1280px;margin:0 auto;padding:32px clamp(20px,4vw,56px) clamp(64px,8vw,104px);display:flex;flex-direction:column;gap:28px">
<div style="display:flex;flex-wrap:wrap;gap:16px;align-items:flex-end">
<label style="display:flex;flex-direction:column;gap:6px;flex:2 1 320px;min-width:0"><span style="font-size:14px;font-weight:500">{c.s02_danh_sach.t1}</span><input id="prod-q" type="search" placeholder={c.s02_danh_sach.f1} style="padding:10px 14px;border-radius:var(--radius-md);border:1px solid var(--border-default);font:16px var(--font-body);background:var(--surface-card);color:var(--text-primary);outline-color:var(--green-500)" /></label>
<div style="flex:1 1 200px;min-width:0"><Select id="prod-crop" label={c.s02_danh_sach.f2} options={[{ value: 'all', label: c.crops_all_label }, ...c.crops.map((v) => ({ value: v, label: v }))]} value="all" /></div>
<div style="flex:1 1 200px;min-width:0"><Select id="prod-sort" label={c.s02_danh_sach.f3} options={[{ value: 'pop', label: c.sort_popular_label }, { value: 'name', label: c.sort_name_label }]} value="pop" /></div>
</div>
<div style="display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;font-size:15px;color:var(--text-secondary)"><span><strong id="prod-count" style="color:var(--text-primary)">{products.length}</strong> {c.s02_danh_sach.t2}</span><button type="button" id="prod-reset" hidden style="background:none;border:0;color:var(--green-700);font:600 15px var(--font-body);cursor:pointer">{c.s02_danh_sach.t3}</button></div>
<div id="prod-grid" class="prod-grid" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(270px,1fr));gap:20px">
{products.map((e, i) => { const p = e.data; return (
<a data-line={p.line} data-crops={p.crops.join('|')} data-name={p.name.toLowerCase()} data-pop={i} href={productUrl(e)} class="prod-card hover-lift">
<div class="prod-card__img"><ImageSlot style="position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto;display:block" id={`prod-${e.id}`} shape="rect" fit="contain" placeholder={p.front.alt || p.name} image={p.front} cms={`${e.filePath}#front`} sizes="(max-width: 599px) 45vw, 260px" /></div>
<div class="prod-card__body">
<span class="prod-card__line">{lineLabel(p.line)}</span>
<strong class="prod-card__name">{p.name.replace(/\+/g, '+\u200B')}</strong>
{p.npk.length > 0 && <div class="prod-card__npk">{p.npk.filter(({ value: v }) => isFilled(v)).slice(0, 4).map(({ value: v, unit: k }) => <span data-npk><b>{v}</b><small>{k}</small></span>)}</div>}
{p.crops.length > 0 && <span class="prod-card__crops">{'Phù hợp: ' + p.crops.slice(0, 4).join(', ') + (p.crops.length > 4 ? '…' : '')}</span>}
</div></a>
); })}
</div>
<div id="prod-empty" hidden style="padding:48px;text-align:center;background:var(--surface-card);border:1px dashed var(--border-strong);border-radius:var(--radius-lg);color:var(--text-secondary)">{c.s02_danh_sach.t4} <a href={url('lien-he')}>{c.s02_danh_sach.t5}</a> {c.s02_danh_sach.t6}</div>
</div></section>

<section style="background:var(--green-800);color:#fff">
<div style="max-width:1280px;margin:0 auto;padding:56px clamp(20px,4vw,56px);display:flex;justify-content:space-between;align-items:center;gap:24px;flex-wrap:wrap">
<div style="display:flex;flex-direction:column;gap:8px;max-width:640px"><h2 style="margin:0;font:var(--type-h3);text-wrap:balance">{c.s03_tu_van.t1}</h2><span style="color:var(--green-100)">{c.s03_tu_van.t2}</span></div>
<div style="display:flex;gap:12px;flex-wrap:wrap"><a href={url('giai-phap')} style="background:#fff;color:var(--green-700);font-weight:700;padding:13px 22px;border-radius:var(--radius-md)">{c.s03_tu_van.t3}</a><a href={url('lien-he')} style="color:#fff;font-weight:700;padding:13px 22px;border-radius:var(--radius-md);border:1px solid rgba(255,255,255,.7)">{c.s03_tu_van.t4}</a></div>
</div></section>
</Layout>

<script>
  const grid = document.getElementById('prod-grid')!;
  const cards = [...grid.children] as HTMLElement[];
  const q = document.getElementById('prod-q') as HTMLInputElement;
  const crop = document.getElementById('prod-crop') as HTMLSelectElement;
  const sort = document.getElementById('prod-sort') as HTMLSelectElement;
  const tabs = document.getElementById('line-tabs')!;
  const count = document.getElementById('prod-count')!;
  const reset = document.getElementById('prod-reset')!;
  const empty = document.getElementById('prod-empty')!;
  let line = 'all';

  function render() {
    const qq = q.value.trim().toLowerCase();
    const c = crop.value;
    const visible = cards.filter((el) => {
      const ok = (line === 'all' || el.dataset.line === line)
        && (c === 'all' || el.dataset.crops!.split('|').includes(c))
        && (!qq || el.dataset.name!.includes(qq));
      el.hidden = !ok;
      return ok;
    });
    const byName = (a: HTMLElement, b: HTMLElement) => a.dataset.name!.localeCompare(b.dataset.name!, 'vi');
    const byPop = (a: HTMLElement, b: HTMLElement) => Number(a.dataset.pop) - Number(b.dataset.pop);
    [...cards].sort(sort.value === 'name' ? byName : byPop).forEach((el) => grid.appendChild(el));
    count.textContent = String(visible.length);
    empty.hidden = visible.length > 0;
    reset.hidden = !(line !== 'all' || c !== 'all' || qq);
  }
  function setLine(v: string) {
    line = v;
    tabs.querySelectorAll('[role="tab"]').forEach((t) => t.setAttribute('aria-selected', String((t as HTMLElement).dataset.value === v)));
  }
  tabs.addEventListener('tabs:change', (e) => { setLine((e as CustomEvent<string>).detail); render(); });
  q.addEventListener('input', render);
  crop.addEventListener('change', render);
  sort.addEventListener('change', render);
  reset.addEventListener('click', () => { setLine('all'); crop.value = 'all'; q.value = ''; render(); });
  render();
</script>
<style>
  .pd-banner { position: relative; background: var(--green-900); }
  .pd-banner__link { position: relative; display: block; height: clamp(300px, 40vw, 600px); color: #fff; text-decoration: none; overflow: hidden; }
  .pd-banner__link:hover { color: #fff; text-decoration: none; }
  .pd-banner__img { position: absolute; inset: 0; }
  .pd-banner__scrim { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(2, 53, 26, .85) 0%, rgba(2, 53, 26, .45) 45%, rgba(2, 53, 26, 0) 80%); }
  .pd-banner__copy { position: relative; max-width: 1280px; height: 100%; margin: 0 auto; padding: clamp(32px, 5vw, 72px) clamp(20px, 4vw, 56px); display: flex; flex-direction: column; justify-content: center; align-items: flex-start; gap: 12px; }
  .pd-banner__eyebrow { font: var(--type-eyebrow); letter-spacing: .08em; color: var(--green-100); }
  .pd-banner__title { font: var(--type-h1); max-width: 14em; text-wrap: balance; }
  .pd-banner__text { max-width: 32em; color: var(--green-50); font-size: var(--fs-lead); text-align: start; }
  .pd-banner__btn { margin-top: 6px; display: inline-flex; align-items: center; min-height: 48px; padding: 0 22px; border-radius: var(--radius-md); background: #fff; color: var(--green-700); font-weight: 700; }
  /* Product cards: the bag stands on the card itself — no grey backdrop, no inner frame. */
  .prod-card { display: flex; flex-direction: column; background: var(--surface-card); border: 1px solid var(--border-default); border-radius: var(--radius-lg); overflow: hidden; color: var(--text-primary); text-decoration: none; transition: box-shadow .15s, border-color .15s; }
  .prod-card:hover { text-decoration: none; border-color: var(--green-300); }
  .prod-card__img { position: relative; height: 250px; margin: 16px 16px 0; }
  .prod-card__img :global(.img-slot__frame) { background: transparent !important; }
  .prod-card__body { padding: 16px 20px 20px; display: flex; flex-direction: column; gap: 10px; flex: 1; }
  .prod-card__line { font: var(--type-eyebrow); color: var(--green-600); letter-spacing: .06em; text-transform: uppercase; }
  .prod-card__name { font-size: 17px; line-height: 1.35; flex: 1; }
  .prod-card__npk { display: flex; gap: 6px; flex-wrap: wrap; }
  .prod-card__npk span { display: flex; flex-direction: column; align-items: center; min-width: 52px; padding: 4px 8px; border-radius: var(--radius-sm); background: var(--green-50); }
  .prod-card__npk b { font: 700 15px var(--font-display); color: var(--green-800); }
  .prod-card__npk small { font-size: 11px; color: var(--text-secondary); }
  .prod-card__crops { font-size: 13px; color: var(--text-tertiary); }
  /* Phones: two compact product cards per row. */
  @media (max-width: 599.98px) {
    .prod-grid { grid-template-columns: repeat(2, minmax(0, 1fr)) !important; gap: 12px !important; }
    .prod-card__img { height: 160px; margin: 10px 10px 0; }
    .prod-card__body { padding: 12px; gap: 8px; }
    .prod-card__name { font-size: 15px; }
    .prod-card__npk span { min-width: 40px; padding: 3px 5px; }
  }
</style>
