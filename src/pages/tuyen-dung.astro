---
/**
 * Con người & Tuyển dụng. Flow: hero → key figures → why Tiến Nông → training → a real career path →
 * pay & recognition → the five departments → open positions with full job descriptions → closing band.
 */
import raw from '../content/pages/tuyen-dung.json';
import { isFilled, withDefaults } from '../lib/content';
import Layout from '../layouts/Layout.astro';
import ImageSlot from '../components/ImageSlot.astro';
import Icon from '../components/Icon.astro';
import Select from '../components/Select.astro';
import Head from '../components/story/Head.astro';
import Stats from '../components/story/Stats.astro';
import CtaBand from '../components/CtaBand.astro';
import { url, link } from '../lib/routes';
import { newsByLink } from '../lib/news';
import siteRaw from '../content/site.json';
import { localeOf } from '../lib/i18n';
/** Language of this page (vi / en / zh): content is read in that language. */
const L = localeOf(Astro.url);

const c = withDefaults(raw, 'src/content/pages/tuyen-dung.json', L);
const site = withDefaults(siteRaw, 'src/content/site.json', L);
const F = 'src/content/pages/tuyen-dung.json';
const fill = 'position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto;display:block';
const jobsEmail = isFilled(c.contact.email) ? c.contact.email : site.company.email;
const jobs = c.jobs.items.filter((j) => isFilled(j.title));
const applyHref = (j: { title: string; link?: string | null }) =>
  isFilled(j.link) ? link(j.link) : `mailto:${jobsEmail}?subject=${encodeURIComponent('Ứng tuyển: ' + j.title)}`;
const opt = (arr: string[], all: string) => [{ value: 'all', label: all }, ...[...new Set(arr)].map((v) => ({ value: v, label: v }))];
const list = (v: unknown) => (Array.isArray(v) ? (v as string[]).filter(isFilled) : []);
const tel = (v: string) => `tel:${v.replace(/[^\d+]/g, '')}`;
// Training: each item shows its own photo, or the cover of the article it links to.
const training = await Promise.all(c.training.items.map(async (t) => {
  if (isFilled(t.image?.src)) return { ...t, img: t.image };
  const n = await newsByLink(t.link);
  return { ...t, img: n?.data.cover?.src ? { ...n.data.cover, alt: n.data.cover.alt || t.title } : t.image };
}));
/** Career story: "Giám đốc Phòng Kinh doanh 1 · Gắn bó từ 2006" → the post (on the photo) and the years with the company (under the quote). */
const [roleMain, ...roleRest] = String(c.growth.role || '').split(/\s*·\s*/);
const roleSince = roleRest.join(' · ').replace(/^Gắn bó từ/i, 'Gắn bó cùng Tiến Nông từ');
const quote = String(c.growth.quote || '').replace(/^[“"]\s*|\s*[”"]$/g, '');
---
<Layout align={c.can_le} title={c.seo.title || undefined} description={c.seo.description || undefined} active="">
<section style="background:var(--surface-card)">
<div style="max-width:var(--wrap, 1280px);margin:0 auto;padding:28px clamp(20px,4vw,56px) clamp(48px,6vw,80px);display:flex;flex-direction:column;gap:32px">
<span style="font-size:13px;color:var(--text-tertiary)"><a href={url('trang-chu')} style="color:var(--text-tertiary)">{c.hero.t1}</a> {c.hero.t2}</span>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,440px),1fr));gap:40px 64px;align-items:center">
<div style="display:flex;flex-direction:column;gap:20px">
<span class="st-eyebrow">{c.hero.eyebrow}</span>
<h1 style="margin:0;font:var(--type-h1);letter-spacing:-.015em;text-wrap:balance">{c.hero.title}</h1>
<p style="margin:0;font-size:var(--fs-lead);color:var(--text-secondary);text-wrap:pretty">{c.hero.intro}</p>
<div class="st-actions"><a href="#vi-tri" class="st-btn st-btn--solid">{c.hero.button1} →</a><a href="#vi-sao" class="st-btn">{c.hero.button2}</a></div>
</div>
<div style="display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);grid-template-rows:260px 200px;gap:14px">
<div style="position:relative;grid-row:span 2;min-width:0"><ImageSlot style={fill} id="hr-hero-1" shape="rounded" radius="16" placeholder="Chân dung người lao động thâm niên" image={c.hero.img1} cms={`${F}#hero.img1`} /></div>
<div style="position:relative;min-width:0"><ImageSlot style={fill} id="hr-hero-2" shape="rounded" radius="16" placeholder="Tập thể trong chuyến du lịch" image={c.hero.img2} cms={`${F}#hero.img2`} /></div>
<div style="position:relative;min-width:0"><ImageSlot style={fill} id="hr-hero-3" shape="rounded" radius="16" placeholder="Kỹ sư trẻ tại phòng lab" image={c.hero.img3} cms={`${F}#hero.img3`} /></div>
</div></div></div></section>

<section class="st-sec st-sec--dark"><div class="st-wrap st-wrap--s"><Stats items={c.stats} /></div></section>

<section id="vi-sao" class="st-sec">
<div class="st-wrap">
<Head eyebrow={c.reasons.eyebrow} title={c.reasons.title} />
<div class="st-grid" style="--min:280px">
{c.reasons.items.map((r, k) => <div class="st-card st-card--top td-reason"><div class="st-card__body"><div class="td-reason__top"><span class="td-ico"><Icon name={r.icon || ['sprout', 'graduation', 'home'][k % 3]} size={28} /></span><span class="st-card__num">{String(k + 1).padStart(2, '0')}</span></div><strong class="st-card__title">{r.title}</strong><span class="st-card__text jx-justify" data-unglued>{r.text}</span></div></div>)}
</div>
<a href={url('ve-tien-nong/van-hoa-doanh-nghiep')} style="align-self:flex-start;font-weight:600">{c.reasons.link_label}</a>
</div></section>

<section id="dao-tao" class="st-sec st-sec--card">
<div class="st-wrap">
<Head eyebrow={c.training.eyebrow} title={c.training.title} />
<div class="td-train">
{training.map((t, k) => <a class="td-train__card" href={isFilled(t.link) ? link(t.link) : undefined}>
<div class="td-train__img"><ImageSlot style={fill} id={`train-${k}`} shape="rounded" radius="14" placeholder={t.title} image={t.img} cms={`${F}#training.items.${k}.image`} sizes="(max-width: 767px) 92vw, 300px" /></div>
<strong>{t.title}</strong><span class="jx-start">{t.text}</span>{isFilled(t.link) && <span class="td-train__more">Đọc tin →</span>}
</a>)}
</div>
</div></section>

<section id="lo-trinh" class="st-sec td-career">
<div class="st-wrap">
<div class="td-career__top">
<div class="td-career__photo"><ImageSlot style={fill} id="hr-story" shape="rounded" radius="24" placeholder="Chân dung người lao động gắn bó 20+ năm tại nơi làm việc" image={c.growth.image} cms={`${F}#growth.image`} sizes="(max-width: 899px) 92vw, 600px" />
{isFilled(c.growth.person) && <div class="td-career__cap"><strong>{c.growth.person}</strong>{isFilled(roleMain) && <span>{roleMain}</span>}</div>}</div>
<div class="td-career__copy">
<Head eyebrow={c.growth.eyebrow} title={c.growth.title} />
<blockquote class="td-career__quote"><span class="td-career__qm" aria-hidden="true">“</span><p class="jx-start">{quote}</p><footer><strong>{c.growth.person}</strong>{isFilled(roleSince) && <span>{roleSince}</span>}</footer></blockquote>
</div>
</div>
<ol class="td-career__tl" style={`--n:${c.growth.timeline.length}`}>
{c.growth.timeline.map((t, i) => <li class:list={{ 'is-now': i === c.growth.timeline.length - 1 }}><span class="td-career__when">{t.when}</span><span class="td-career__dot" aria-hidden="true"></span><strong>{t.title}</strong><span class="td-career__text jx-start">{t.text}</span></li>)}
</ol>
</div></section>

<section id="dai-ngo" class="st-sec st-sec--card">
<div class="st-wrap">
<Head eyebrow={c.benefits.eyebrow} title={c.benefits.title} intro={c.benefits.intro} split />
<div class="st-grid" style="--min:280px">
{c.benefits.cards.map((b, k) => <div class="st-card"><div class="st-card__img"><ImageSlot style={fill} id={`ben-${k + 1}`} shape="rect" placeholder={b.image.alt || b.title} image={b.image} cms={`${F}#benefits.cards.${k}.image`} sizes="(max-width: 767px) 92vw, 400px" /></div><div class="st-card__body"><strong class="st-card__title">{b.title}</strong><span class="st-card__text">{b.text}</span></div></div>)}
</div>
<div class="st-ruled">{c.benefits.items.map((b) => <div><strong>{b.title}</strong><span>{b.text}</span></div>)}</div>
</div></section>

<section id="khoi-nghe" class="st-sec">
<div class="st-wrap">
<Head eyebrow={c.paths.eyebrow} title={c.paths.title} intro={c.paths.intro} split />
<ul class="td-paths">
{c.paths.items.map((p, k) => <li><span class="td-paths__n">{String(k + 1).padStart(2, '0')}</span><strong>{p.title}</strong><span class="td-paths__text jx-start">{p.text}</span><span class="td-paths__where">{p.where}</span></li>)}
</ul>
</div></section>

<section id="vi-tri" class="st-sec td-jobs-sec">
<div class="st-wrap st-wrap--narrow">
<div style="display:flex;justify-content:space-between;align-items:flex-end;gap:20px;flex-wrap:wrap">
<Head eyebrow={c.jobs.eyebrow} title={c.jobs.title} intro={c.jobs.intro} />
<span style="color:var(--text-secondary)"><strong id="job-count" style="color:var(--text-primary)">{jobs.length}</strong> {c.jobs.count_label}</span>
</div>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:14px">
<Select id="job-dept" label={c.jobs.dept_label} options={opt(jobs.map((j) => j.dept), c.jobs.all_depts)} value="all" />
<Select id="job-loc" label={c.jobs.loc_label} options={opt(jobs.map((j) => j.loc), c.jobs.all_locations)} value="all" />
</div>
<div class="td-jobs">
{jobs.map((j, k) => (
<details class="td-job" data-dept={j.dept} data-loc={j.loc}>
<summary>
<div style="display:flex;flex-direction:column;gap:4px;min-width:0"><strong style="font-size:19px">{j.title}</strong><span style="font-size:14px;color:var(--text-secondary)">{[j.dept, j.loc, isFilled(j.count) ? `Số lượng: ${j.count}` : '', isFilled(j.due) ? `Hạn nộp ${j.due}` : ''].filter(Boolean).join(' · ')}</span></div>
<span class="td-job__sign" aria-hidden="true">+</span>
</summary>
<div class="td-job__body">
{isFilled(j.summary) && <p style="margin:0;font-size:var(--fs-body);line-height:1.65">{j.summary}</p>}
<div class="td-job__cols">
{list(j.duties).length > 0 && <div><strong>{c.jobs.duties_label}</strong><ul>{list(j.duties).map((x) => <li>{x}</li>)}</ul></div>}
{list(j.requirements).length > 0 && <div><strong>{c.jobs.requirements_label}</strong><ul>{list(j.requirements).map((x) => <li>{x}</li>)}</ul></div>}
</div>
{isFilled(c.jobs.common_benefits) && <p style="margin:0;color:var(--text-secondary);font-size:15px"><strong style="color:var(--text-primary)">{c.jobs.benefits_label}: </strong>{c.jobs.common_benefits}</p>}
<a href={applyHref(j)} class="st-btn st-btn--solid" style="align-self:flex-start">{c.jobs.apply_label} →</a>
</div>
</details>
))}
<div id="job-empty" hidden style="padding:32px 24px;color:var(--text-secondary)">{c.jobs.empty_text} <strong>{jobsEmail}</strong> {c.jobs.empty_after}</div>
</div>
</div></section>

<CtaBand title={c.cta.title} text={c.cta.text} primary={{ label: c.cta.apply, href: `mailto:${jobsEmail}?subject=${encodeURIComponent('Ứng tuyển vào Tiến Nông')}` }} secondary={isFilled(c.contact.phone) ? { label: `☎ ${c.contact.phone}`, href: tel(c.contact.phone) } : undefined} />
</Layout>

<style>
  /* Softer page colours: sections alternate a light leaf green and a warm rice-paper cream instead of white and grey. */
  #vi-sao { background: linear-gradient(180deg, #f1f8ef 0%, #f7fbf4 100%); }
  #dao-tao { background: #fbf8f0; }
  #dai-ngo { background: #f3f8f0; }
  #dai-ngo :is(.st-card, article) { background: #fff; }
  #khoi-nghe { background: #fbf8f0; }
  .td-jobs-sec { background: linear-gradient(180deg, #f3f8f0 0%, #fbfdf9 100%); }
  .td-reason { border-color: var(--green-100) !important; }
  .td-reason__top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px; }
  .td-reason .st-card__num { color: var(--green-200); }
  .td-ico { display: inline-grid; place-items: center; width: 56px; height: 56px; border-radius: 18px; background: linear-gradient(145deg, var(--green-50), #fdf6e3); color: var(--green-700); border: 1px solid var(--green-100); }
  .td-reason:hover .td-ico { background: var(--green-700); color: #fff; }

  .td-jobs-sec { background: var(--surface-card); }
  .td-jobs { display: flex; flex-direction: column; background: var(--surface-card); box-shadow: 0 10px 30px rgba(0, 71, 35, .05); border: 1px solid var(--border-default); border-radius: var(--radius-lg); overflow: hidden; }
  .td-job { border-bottom: 1px solid var(--border-default); }
  .td-job:last-of-type { border-bottom: 0; }
  .td-job summary { list-style: none; cursor: pointer; display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 16px; align-items: center; padding: 20px 24px; }
  .td-job summary::-webkit-details-marker { display: none; }
  .td-job summary:hover { background: var(--green-50); }
  .td-job__sign { font: 400 26px var(--font-body); color: var(--green-600); }
  .td-job[open] .td-job__sign { transform: rotate(45deg); }
  .td-job__body { padding: 0 24px 26px; display: flex; flex-direction: column; gap: 18px; }
  .td-job__cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); gap: 18px 32px; }
  .td-job__cols ul { margin: 8px 0 0; padding-left: 1.2em; color: var(--text-secondary); line-height: 1.65; display: flex; flex-direction: column; gap: 6px; }
  /* Career story (reference layout): photo with name on the left, title + quote on the right, the
     path as a horizontal timeline underneath — sized to fit one laptop screen. */
  .td-career .st-wrap { display: flex; flex-direction: column; gap: clamp(32px, 4vh, 48px); }
  .td-career__top { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); gap: clamp(32px, 6vw, 96px); align-items: center; }
  .td-career__photo { position: relative; height: clamp(320px, calc(100vh - 440px), 500px); border-radius: 24px; overflow: hidden; }
  .td-career__cap { position: absolute; left: 0; right: 0; bottom: 0; z-index: 1; padding: 72px 28px 24px; display: flex; flex-direction: column; gap: 4px; pointer-events: none;
    background: linear-gradient(0deg, rgba(2, 53, 26, .85) 0%, rgba(2, 53, 26, .45) 60%, rgba(2, 53, 26, 0) 100%); color: #fff; }
  .td-career__cap strong { font: 700 clamp(20px, 1.8vw, 26px)/1.25 var(--font-display); }
  .td-career__cap span { font-size: 14px; color: rgba(255, 255, 255, .85); }
  .td-career__copy { display: flex; flex-direction: column; gap: clamp(20px, 3vh, 32px); }
  .td-career__quote { position: relative; margin: 0; padding: 4px 0 4px 28px; border-left: 2px solid var(--brand-highlight); display: flex; flex-direction: column; gap: 18px; }
  .td-career__qm { font: 800 64px/.6 var(--font-display); color: var(--brand-bright); height: 30px; }
  .td-career__quote p { margin: 0; font: 400 clamp(16px, 1.35vw, 19px)/1.75 var(--font-body); color: var(--text-primary); }
  .td-career__quote footer { display: flex; flex-direction: column; gap: 4px; }
  .td-career__quote footer strong { font: 700 16px/1.3 var(--font-display); }
  .td-career__quote footer span { font-size: 14px; color: var(--text-tertiary); }
  .td-career__tl { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(var(--n, 4), minmax(0, 1fr)); gap: 0 clamp(20px, 2.5vw, 36px); }
  .td-career__tl li { display: grid; grid-template-rows: auto auto auto 1fr; gap: 8px; }
  .td-career__when { font: 700 clamp(22px, 2vw, 28px)/1.2 var(--font-display); color: var(--green-800); }
  .td-career__dot { position: relative; height: 14px; margin: 4px 0 8px; }
  .td-career__dot::before { content: ''; position: absolute; left: 0; top: 2px; width: 10px; height: 10px; border-radius: 50%; background: var(--brand-bright); box-shadow: 0 0 0 3px var(--green-100); }
  .td-career__dot::after { content: ''; position: absolute; left: 22px; right: 0; top: 6px; height: 2px; background: var(--border-default); }
  .td-career__tl li.is-now .td-career__dot::before { background: var(--brand-highlight); box-shadow: 0 0 0 3px rgba(245, 196, 78, .25); }
  .td-career__tl strong { font: 700 16px/1.4 var(--font-display); color: var(--text-primary); }
  .td-career__text { font-size: 14px; line-height: 1.6; color: var(--text-secondary); }
  @media (max-width: 899.98px) {
    .td-career__top { grid-template-columns: minmax(0, 1fr); }
    .td-career__photo { height: auto; aspect-ratio: 4 / 3.4; }
    .td-career__tl { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px 20px; }
  }
  @media (max-width: 479.98px) { .td-career__tl { grid-template-columns: minmax(0, 1fr); } }
  /* Departments: one row each — number, name, short text, where. */
  .td-paths { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--border-default); }
  .td-paths li { display: grid; grid-template-columns: 48px minmax(0, 240px) minmax(0, 1fr) auto; gap: 8px 24px; align-items: center; padding: 18px 4px; border-bottom: 1px solid var(--border-default); transition: background var(--motion-fast); }
  .td-paths li:hover { background: var(--green-50); }
  .td-paths__n { font: 700 22px/1 var(--font-display); color: var(--brand-bright); }
  .td-paths strong { font: 700 18px/1.35 var(--font-display); }
  .td-paths__text { color: var(--text-secondary); line-height: 1.55; }
  .td-paths__where { justify-self: end; padding: 6px 12px; border-radius: 999px; background: var(--surface-page); border: 1px solid var(--border-default); font-size: 13px; font-weight: 600; color: var(--green-700); white-space: nowrap; }
  /* Training: news photos with the title and one line. */
  .td-train { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 22px; }
  .td-train__card { display: flex; flex-direction: column; gap: 8px; color: var(--text-primary); text-decoration: none; }
  .td-train__card:hover { text-decoration: none; color: var(--text-primary); }
  .td-train__card:hover strong { color: var(--green-700); }
  .td-train__img { position: relative; aspect-ratio: 16 / 10; margin-bottom: 6px; }
  .td-train__card strong { font: 700 17px/1.35 var(--font-display); transition: color var(--motion-fast); }
  .td-train__card > span:not(.td-train__more) { color: var(--text-secondary); font-size: 15px; line-height: 1.55; }
  .td-train__more { font-size: 14px; font-weight: 600; color: var(--brand-bright); }
  @media (max-width: 1099.98px) { .td-train { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 767.98px) {
    .td-paths li { grid-template-columns: 36px minmax(0, 1fr); }
    .td-paths__text, .td-paths__where { grid-column: 2; justify-self: start; }
    .td-train { grid-template-columns: minmax(0, 1fr); }
  }
</style>

<script>
  const dept = document.getElementById('job-dept') as HTMLSelectElement;
  const loc = document.getElementById('job-loc') as HTMLSelectElement;
  function render() {
    const rows = [...document.querySelectorAll<HTMLElement>('[data-dept]')];
    let n = 0;
    rows.forEach((r) => {
      r.hidden = !((dept.value === 'all' || r.dataset.dept === dept.value) && (loc.value === 'all' || r.dataset.loc === loc.value));
      if (!r.hidden) n++;
    });
    document.getElementById('job-count')!.textContent = String(n);
    document.getElementById('job-empty')!.hidden = n > 0;
  }
  dept.addEventListener('change', render);
  loc.addEventListener('change', render);
</script>
