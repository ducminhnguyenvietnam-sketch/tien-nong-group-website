---
import raw from '../content/pages/ve-tien-nong.json';
import siteRaw from '../content/site.json';
import { isFilled, stripPlaceholders, withDefaults } from '../lib/content';
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import ImageSlot from '../components/ImageSlot.astro';
import PageHero from '../components/PageHero.astro';
import FigureCard from '../components/FigureCard.astro';
import CtaBand from '../components/CtaBand.astro';
import { asset, link, url } from '../lib/routes';

// Board titles: "Chủ tịch HĐQT · Người sáng lập" shows each title on its own line.
const roles = (t: string) => String(t ?? '').split(/\s*·\s*/).filter(Boolean);
const c = withDefaults(raw, 'src/content/pages/ve-tien-nong.json');
const site = withDefaults(siteRaw, 'src/content/site.json');
const F = 'src/content/pages/ve-tien-nong.json';
const fill = 'position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto;display:block';

const stats = [[c.s01_hero.t6, c.s01_hero.t7], [c.s01_hero.t8, c.s01_hero.t9], [c.s01_hero.t10, c.s01_hero.t11],
  [c.s01_hero.t12, c.s01_hero.t13], [c.s01_hero.t14, c.s01_hero.t15], [c.s01_hero.t16, c.s01_hero.t17]].filter(([v]) => isFilled(v));
const t = c.s02_thu_ngo;
const m = c.s03_su_menh_gia_tri;
/** "Phụng sự nhà nông – Kiến tạo tương lai": the part after the dash is set in the accent yellow. */
const slogan = String(t.slogan || '').split(/\s+[–-]\s+/);
/** Mission, vision, goal and the five core values, each with a light line icon (no photos). */
const ICON = {'target': '<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1.2"/></svg>', 'eye': '<svg viewBox="0 0 24 24"><path d="M2 12s3.6-6.5 10-6.5S22 12 22 12s-3.6 6.5-10 6.5S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg>', 'flag': '<svg viewBox="0 0 24 24"><path d="M5 21V4M5 4h11l-2 4 2 4H5"/></svg>', 'heart': '<svg viewBox="0 0 24 24"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/></svg>', 'flame': '<svg viewBox="0 0 24 24"><path d="M12 21c-3.9 0-6.5-2.6-6.5-6 0-3.6 2.8-5.4 3.5-9 2.4 1.4 3.6 3.4 3.8 5.3.8-.7 1.3-1.8 1.4-3 2.2 1.7 4.3 4.1 4.3 6.7 0 3.4-2.6 6-6.5 6z"/></svg>', 'bulb': '<svg viewBox="0 0 24 24"><path d="M9 18h6M10 21h4M12 3a6 6 0 0 0-3.5 10.9c.6.5 1 1.2 1 2V16h5v-.1c0-.8.4-1.5 1-2A6 6 0 0 0 12 3z"/></svg>', 'hands': '<svg viewBox="0 0 24 24"><path d="M3 12l4-4 4 3 3-2 7 5-4 4-3-2-3 2-4-3-4 1z"/><path d="M11 11l3 3"/></svg>', 'leaf': '<svg viewBox="0 0 24 24"><path d="M5 19c0-8 5-13 14-14 0 9-5 14-13 14z"/><path d="M5 19l8-8"/></svg>'};
const statements = [[m.t1, m.t2, ICON.target], [m.t3, m.t4, ICON.eye], [m.t5, m.t6, ICON.flag]]
  .filter(([, t]) => isFilled(t)).map(([label, text, icon]) => ({ label, text, icon }));
const coreValues = [[m.t8, m.t9, m.t10, ICON.heart], [m.t11, m.t12, m.t13, ICON.flame], [m.t14, m.t15, m.t16, ICON.bulb],
  [m.t17, m.t18, m.t19, ICON.hands], [m.t20, m.t21, m.t22, ICON.leaf]].filter(([, t]) => isFilled(t))
  .map(([num, title, text, icon]) => ({ num, title, text, icon }));

const awards = [...c.s06_thanh_tuu.featured_awards.map((w, k) => ({ ...w, big: true, path: `s06_thanh_tuu.featured_awards.${k}.image` })),
  ...c.s06_thanh_tuu.awards.map((w, k) => ({ ...w, big: false, path: `s06_thanh_tuu.awards.${k}.image` }))].filter((w) => isFilled(w.title)).map((w, k) => ({ ...w, k }));
/** The two highest honours stay on top; the other awards are shown 8 to a page (1, 2, 3 …). */
const bigAwards = awards.filter((w) => w.big);
const PER_PAGE = 8;
const rest = awards.filter((w) => !w.big);
const awardPages = Array.from({ length: Math.ceil(rest.length / PER_PAGE) }, (_, p) => rest.slice(p * PER_PAGE, (p + 1) * PER_PAGE));
/** Milestones of the same year share one stop on the timeline; their stories play one after the other. */
const years = [...new Set(c.milestones.map((ms) => String(ms.year).trim()))];
const yearOf = (ms: { year: string }) => years.indexOf(String(ms.year).trim());
const countIn = (ms: { year: string }) => c.milestones.filter((x) => yearOf(x) === yearOf(ms));
const caps = c.s07_nang_luc.capabilities.filter((x) => isFilled(x.title));
const partners = c.s08_he_sinh_thai.partners.map((p, k) => ({ ...p, k })).filter((p) => isFilled(p.name))
  .sort((a, b) => Number(!!b.featured) - Number(!!a.featured));
---
<Layout align={c.can_le} title={c.seo.title || undefined} description={c.seo.description || undefined} active="Về Tiến Nông">
<PageHero id="about-hero" image={c.s01_hero.img_about_hero_1} cms={`${F}#s01_hero.img_about_hero_1`} placeholder="Ảnh tập thể cán bộ, nhân viên trước trụ sở Tiến Nông"
  crumbs={[{ label: c.s01_hero.t1, href: url('trang-chu') }, { label: c.s01_hero.t2.replace(/^\s*\/\s*/, '') }]}
  eyebrow={c.s01_hero.t3} title={c.s01_hero.t4} lead={c.s01_hero.t5} />

<FigureCard overlap items={stats.map(([value, label]) => ({ value, label }))} />

<section id="thu-ngo" class="ceo">
<img class="ceo__watermark" src={asset('assets/logo-la-chi.png')} alt="" aria-hidden="true" width="485" height="271" loading="lazy" />
<div class="ceo__wrap">
<div class="ceo__photo"><ImageSlot style={fill} id="ceo-portrait" shape="rect" fit="contain" placeholder="Chân dung Tổng Giám đốc Nguyễn Hồng Phong" image={t.img_ceo_portrait_1} cms={`${F}#s02_thu_ngo.img_ceo_portrait_1`} sizes="(max-width: 767px) 70vw, 420px" /></div>
<div class="ceo__text">
<span class="ceo__qmark" aria-hidden="true">“</span>
<h2 class="ceo__heading"><span>{t.heading_small || t.t1}</span>{t.heading}</h2>
{isFilled(t.t2) && <p class="ceo__lead">{t.t2.replace(/^[“"]\s*|\s*[”"]$/g, '')}</p>}
<p class="ceo__body jx-justify">{t.t3}</p>
<div class="ceo__sign"><span>{t.t5} {site.company.name}</span><strong>{t.t4}</strong></div>
</div>
</div>
<div class="ceo__band">
<div class="ceo__badge"><img class="ceo__mark" src={asset('assets/logo-mark-vang.png')} alt="Tiến Nông" width="277" height="200" /><span class="ceo__rule" aria-hidden="true"></span><p class="ceo__slogan">{slogan.length > 1 ? <><span>{slogan[0]}</span><span class="ceo__dash"> – </span><span class="ceo__gold">{slogan.slice(1).join(' – ')}</span></> : t.slogan}</p></div>
</div>
</section>

<section id="su-menh" class:list={['mission', { 'mission--photo': isFilled(m.background?.src) }]}>
<div class="mission__bg" data-needs-photos={isFilled(m.background?.src) ? undefined : ''}><ImageSlot style={fill} id="mission-bg" shape="rect" placeholder="Ảnh nền mục Sứ mệnh – Giá trị cốt lõi (ảnh ngang khổ lớn)" image={m.background} cms={`${F}#s03_su_menh_gia_tri.background`} sizes="100vw" /></div>
<div class="mission__inner">
<ul class="mission__cols">
{statements.map((st) => <li class="mission__col">
<span class="mission__icon" aria-hidden="true" set:html={st.icon}></span>
<span class="mission__eyebrow">{st.label}</span>
<p class="mission__statement">{st.text}</p>
</li>)}
</ul>
<div class="mission__values">
<span class="mission__eyebrow mission__eyebrow--center">{m.t7}</span>
<ul class="core">
{coreValues.map((v) => <li class="core__item">
<span class="core__icon" aria-hidden="true" set:html={v.icon}></span>
<strong class="core__title">{v.title}</strong>
<p class="core__text">{v.text}</p>
</li>)}
</ul>
</div></div></section>

<section id="lich-su" class="hist">
<div class="hist__inner" data-picker data-pick-autoplay="5000">
<div class="hist__head">
<div class="hist__title"><span class="eyebrow-tag">{c.s04_lich_su.t1}</span><h2>{c.s04_lich_su.t2}</h2></div>
<div class="hist__arrows"><button type="button" data-pick-step="-1" aria-label="Mốc trước"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"/></svg></button><button type="button" data-pick-step="1" aria-label="Mốc sau"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></button></div>
</div>
<div class="hist__stage">
{c.milestones.map((ms, k) => (
<div role="tabpanel" class="hist__panel" data-pick-panel={yearOf(ms)} hidden={k !== 0} aria-label={ms.year}>
<div class="hist__photo"><ImageSlot style={fill} id={`ms-${k}`} shape="rounded" radius="20" placeholder={ms.image.alt} image={ms.image} cms={`${F}#milestones.${k}.image`} sizes="(max-width: 767px) 92vw, 600px" /></div>
<div class="hist__text">
<span class="hist__year" aria-hidden="true">{ms.year}{countIn(ms).length > 1 && <span class="hist__part">{countIn(ms).indexOf(ms) + 1}/{countIn(ms).length}</span>}</span>
<h3>{ms.title}</h3>
<p>{ms.body}</p>
</div>
</div>
))}
</div>
<div class="hist__rail" role="tablist" aria-label="Các mốc lịch sử">
{years.map((y, k) => <button type="button" role="tab" class="hist__stop" data-pick={k} aria-selected={k === 0 ? 'true' : 'false'}><span class="hist__dot" aria-hidden="true"></span><span class="hist__label">{y}</span></button>)}
</div>
</div></section>

<section id="lanh-dao" style="scroll-margin-top:160px">
<div style="max-width:var(--wrap, 1280px);margin:0 auto;padding:clamp(64px,8vw,112px) clamp(20px,4vw,56px);display:flex;flex-direction:column;gap:40px">
<div style="display:flex;flex-direction:column;gap:14px;max-width:640px">
<span style="font:var(--type-eyebrow);letter-spacing:.08em;color:var(--green-600)">{c.s05_lanh_dao.t1}</span>
<h2 style="margin:0;font:var(--type-h2);letter-spacing:-.01em">{c.s05_lanh_dao.t2}</h2>
</div>
<div class="board-grid">
<div style="display:flex;flex-direction:column;gap:12px"><div style="position:relative;aspect-ratio:4/5"><ImageSlot style="position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto;display:block" id="lead-1" shape="rounded" radius="16" placeholder="Chân dung (nền đồng nhất)" image={c.s05_lanh_dao.img_lead_1_1} cms="src/content/pages/ve-tien-nong.json#s05_lanh_dao.img_lead_1_1" /></div><div><strong style="display:block;font-size:17px">{c.s05_lanh_dao.t3}</strong><span style="display:block;color:var(--text-secondary);font-size:15px;line-height:1.5">{roles(c.s05_lanh_dao.t4).map((r, i) => <>{i > 0 && <br />}{r}</>)}</span></div></div>
<div style="display:flex;flex-direction:column;gap:12px"><div style="position:relative;aspect-ratio:4/5"><ImageSlot style="position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto;display:block" id="lead-2" shape="rounded" radius="16" placeholder="Chân dung (nền đồng nhất)" image={c.s05_lanh_dao.img_lead_2_1} cms="src/content/pages/ve-tien-nong.json#s05_lanh_dao.img_lead_2_1" /></div><div><strong style="display:block;font-size:17px">{c.s05_lanh_dao.t5}</strong><span style="display:block;color:var(--text-secondary);font-size:15px;line-height:1.5">{roles(c.s05_lanh_dao.t6).map((r, i) => <>{i > 0 && <br />}{r}</>)}</span></div></div>
<div style="display:flex;flex-direction:column;gap:12px"><div style="position:relative;aspect-ratio:4/5"><ImageSlot style="position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto;display:block" id="lead-3" shape="rounded" radius="16" placeholder="Chân dung (nền đồng nhất)" image={c.s05_lanh_dao.img_lead_3_1} cms="src/content/pages/ve-tien-nong.json#s05_lanh_dao.img_lead_3_1" /></div><div><strong style="display:block;font-size:17px">{c.s05_lanh_dao.t7}</strong><span style="display:block;color:var(--text-secondary);font-size:15px;line-height:1.5">{roles(c.s05_lanh_dao.t8).map((r, i) => <>{i > 0 && <br />}{r}</>)}</span></div></div>
<div style="display:flex;flex-direction:column;gap:12px"><div style="position:relative;aspect-ratio:4/5"><ImageSlot style="position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto;display:block" id="lead-4" shape="rounded" radius="16" placeholder="Chân dung (nền đồng nhất)" image={c.s05_lanh_dao.img_lead_4_1} cms="src/content/pages/ve-tien-nong.json#s05_lanh_dao.img_lead_4_1" /></div><div><strong style="display:block;font-size:17px">{c.s05_lanh_dao.t9}</strong><span style="display:block;color:var(--text-secondary);font-size:15px;line-height:1.5">{roles(c.s05_lanh_dao.t10).map((r, i) => <>{i > 0 && <br />}{r}</>)}</span></div></div>
<div style="display:flex;flex-direction:column;gap:12px"><div style="position:relative;aspect-ratio:4/5"><ImageSlot style="position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto;display:block" id="lead-5" shape="rounded" radius="16" placeholder="Chân dung (nền đồng nhất)" image={c.s05_lanh_dao.img_lead_5_1} cms="src/content/pages/ve-tien-nong.json#s05_lanh_dao.img_lead_5_1" /></div><div><strong style="display:block;font-size:17px">{c.s05_lanh_dao.t11}</strong><span style="display:block;color:var(--text-secondary);font-size:15px;line-height:1.5">{roles(c.s05_lanh_dao.t12).map((r, i) => <>{i > 0 && <br />}{r}</>)}</span></div></div>
</div>
{c.s05_lanh_dao.executives.some((p) => isFilled(p.name)) && <div style="display:flex;flex-direction:column;gap:20px;padding-top:40px;border-top:1px solid var(--border-default)">
<div style="display:flex;flex-direction:column;gap:10px"><span style="font:var(--type-eyebrow);letter-spacing:.08em;color:var(--green-600)">{c.s05_lanh_dao.t13}</span><h3 style="margin:0;font:var(--type-h3)">{c.s05_lanh_dao.t14}</h3></div>
<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,260px),1fr));gap:12px">
{c.s05_lanh_dao.executives.filter((p) => isFilled(p.name)).map((p) => <div style="display:flex;flex-direction:column;gap:4px;padding:16px 18px;border:1px solid var(--border-default);border-radius:var(--radius-md);background:var(--surface-card)"><strong style="font-size:16px">{p.name}</strong><span style="color:var(--text-secondary);font-size:14px;line-height:1.45">{p.title}</span></div>)}
</div></div>}
</div></section>


<section id="thanh-tuu" class="fame">
<div class="fame__inner">
<div class="fame__head">
<span class="eyebrow-tag">{c.s06_thanh_tuu.t1}</span>
<h2>{c.s06_thanh_tuu.t2}</h2>
{isFilled(c.s06_thanh_tuu.t3) && <p>{c.s06_thanh_tuu.t3}</p>}
</div>
{bigAwards.length > 0 && <ul class="fame__wall">
{bigAwards.map((w, k) => (
<li class:list={['fame__item', { 'fame__item--big': w.big }]}>
<div class="fame__img"><ImageSlot style={fill} id={`fame-${w.k}`} shape="rect" fit="contain" placeholder="Ảnh giải thưởng" image={w.image} cms={`${F}#${w.path}`} sizes={w.big ? '(max-width: 767px) 80vw, 420px' : '(max-width: 767px) 45vw, 240px'} /></div>
{isFilled(stripPlaceholders(w.label)) && <span class="fame__label">{stripPlaceholders(w.label)}</span>}
<strong class="fame__title">{w.title}</strong>
{isFilled(w.detail) && <span class="fame__detail">{w.detail}</span>}
</li>
))}
</ul>}
{awardPages.length > 0 && <div class="fame__more" data-picker>
{awardPages.map((pg, p) => <ul class="fame__wall" data-pick-panel={p} hidden={p !== 0} aria-label={`Trang ${p + 1}`}>
{pg.map((w) => (
<li class:list={['fame__item', { 'fame__item--big': w.big }]}>
<div class="fame__img"><ImageSlot style={fill} id={`fame-${w.k}`} shape="rect" fit="contain" placeholder="Ảnh giải thưởng" image={w.image} cms={`${F}#${w.path}`} sizes={w.big ? '(max-width: 767px) 80vw, 420px' : '(max-width: 767px) 45vw, 240px'} /></div>
{isFilled(stripPlaceholders(w.label)) && <span class="fame__label">{stripPlaceholders(w.label)}</span>}
<strong class="fame__title">{w.title}</strong>
{isFilled(w.detail) && <span class="fame__detail">{w.detail}</span>}
</li>
))}
</ul>)}
{awardPages.length > 1 && <nav class="fame__pages" aria-label="Các trang giải thưởng">
<button type="button" class="fame__step" data-pick-step="-1" aria-label="Trang trước"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg></button>
{awardPages.map((_, p) => <button type="button" data-pick={p} aria-selected={p === 0 ? 'true' : 'false'} aria-label={`Trang ${p + 1}`}>{p + 1}</button>)}
<button type="button" class="fame__step" data-pick-step="1" aria-label="Trang sau"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></button>
</nav>}
</div>}
{isFilled(c.s06_thanh_tuu.profile_pdf) && <div class="fame__cta"><a href={link(c.s06_thanh_tuu.profile_pdf)} target="_blank" rel="noopener" style="text-decoration:none;display:inline-flex"><Button as="span" variant="secondary">{c.s06_thanh_tuu.t29}</Button></a></div>}
</div></section>

{caps.length > 0 && <section id="nang-luc" class="cap">
<div class="cap__inner" data-picker>
<div class="cap__head">
<div><span class="eyebrow-tag">{c.s07_nang_luc.t1}</span><h2>{(() => { const [a, ...b] = String(c.s07_nang_luc.t2).split(/,\s+/); return b.length ? <>{a},<br />{b.join(', ')}</> : a; })()}</h2></div>
{caps.length > 1 && <div class="cap__tabs" role="tablist" aria-label="Năng lực">
{caps.map((x, k) => <button type="button" role="tab" data-pick={k} aria-selected={k === 0 ? 'true' : 'false'}>{x.tab || x.title}</button>)}
</div>}
</div>
{caps.map((x, k) => (
<div role="tabpanel" class="cap__panel" data-pick-panel={k} hidden={k !== 0} aria-label={x.title}>
<div class="cap__mosaic" data-count={Math.min(4, x.photos.length)}>
{x.photos.slice(0, 4).map((ph, i) => <div class="cap__tile"><ImageSlot style={fill} id={`cap-${k}-${i}`} shape="rounded" radius="16" placeholder={ph.alt || 'Ảnh năng lực'} image={ph} cms={`${F}#s07_nang_luc.capabilities.${c.s07_nang_luc.capabilities.indexOf(x)}.photos.${i}`} sizes={i === 0 ? '(max-width: 767px) 92vw, 460px' : '(max-width: 767px) 45vw, 280px'} /></div>)}
</div>
<div class="cap__body">
<h3 class="cap__title">{x.title}</h3>
{isFilled(x.subtitle) && <p class="cap__subtitle">{x.subtitle}</p>}
{isFilled(x.text) && <p class="cap__text jx-justify">{x.text}</p>}
{x.stats.length > 0 && <div class="cap__stats">
{x.stats.filter((s) => isFilled(s.value)).map((s) => <div class="cap__stat"><span class="cap__stat-value">{s.value}</span><span class="cap__stat-label">{s.label}{isFilled(s.sub) && ` ${s.sub}`}</span></div>)}
</div>}
{x.chips.length > 0 && <div class="cap__chips-wrap">
{isFilled(x.chips_title) && <span class="cap__chips-title">{x.chips_title}</span>}
<ul class="cap__chips">{x.chips.filter(isFilled).map((ch) => <li>{ch}</li>)}</ul>
</div>}
{isFilled(x.note) && <p class="cap__text jx-justify">{x.note}</p>}
{isFilled(x.link) && <a class="cap__more" href={link(x.link)}>{x.link_label || 'Xem thêm'} →</a>}
</div>
</div>
))}
</div></section>}

{partners.length > 0 && <section id="doi-tac" class="partners">
<div class="partners__inner">
<div class="partners__head"><span class="eyebrow-tag">{c.s08_he_sinh_thai.t1}</span><h2>{c.s08_he_sinh_thai.t2}</h2></div>
<ul class="partners__cloud">
{partners.map((p) => {
  const hasLogo = isFilled(p.logo?.src);
  const inner = <>
    <span class="partner__logo" data-needs-photos={hasLogo ? undefined : ''}><ImageSlot style={fill} id={`partner-${p.k}`} shape="rect" fit="contain" placeholder={`Logo ${p.name}`} image={p.logo} cms={`${F}#s08_he_sinh_thai.partners.${p.k}.logo`} sizes="240px" /></span>
    {!hasLogo && <span class="partner__name">{p.name}</span>}
  </>;
  return <li class:list={['partner', { 'partner--big': p.featured }]} title={p.name}>
    {isFilled(p.link) ? <a href={link(p.link)} target="_blank" rel="noopener" aria-label={p.name}>{inner}</a> : <div>{inner}</div>}
  </li>;
})}
</ul>
</div></section>}

