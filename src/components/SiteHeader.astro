---
import siteRaw from '../content/site.json';
import { withDefaults } from '../lib/content';
import { NAV, asset, link, url } from '../lib/routes';
import { LOCALE_META, ZH_EXCLUDED, alternates, localeOf, type Locale } from '../lib/i18n';
/** Language of this page (vi / en / zh): content is read in that language. */
const L = localeOf(Astro.url);

const site = withDefaults(siteRaw, 'src/content/site.json', L);

interface Props { active?: string }
const { active = '' } = Astro.props;
const h = site.header;
const navLabels: Record<string, string> = h.nav;
const subLabels: Record<string, string> = h.subnav ?? {};
const here = Astro.url.pathname;
// `active` names the nav item by its built-in label; the shown label comes from the CMS.
// News exist only in Vietnamese, so the English and Chinese menus leave them out.
const items = NAV.filter(([, slug]) => L === 'vi' || slug !== 'tin-tuc').map(([key, slug, children = []]) => ({
  label: navLabels[slug.replace(/-/g, '_')] || key, href: url(slug), active: key === active,
  children: children.filter(([, cslug]) => L !== 'zh' || !ZH_EXCLUDED.test(cslug)).map(([ckey, cslug, labelKey]) => ({ label: subLabels[labelKey] || ckey, href: url(cslug), current: here === url(cslug) })),
}));
// Languages: the same page in Tiếng Việt / English / 中文 (src/lib/i18n.ts). A page with no translation
// (news articles) links to the home page of that language.
const LABEL: Record<Locale, string> = { vi: h.lang_vi || 'Tiếng Việt', en: h.lang_en || 'English', zh: h.lang_zh || '中文' };
const langs = alternates(Astro.url).map((a) => ({ ...a, label: LABEL[a.locale], code: LOCALE_META[a.locale].hreflang, current: a.locale === L }));
const co = site.company as Record<string, string>;
const callNumber = (co.hotline || co.phone || '').replace(/[^\d+]/g, '');
const menuLabel = (h.menu_open || 'Menu').replace(/^[☰\s]+/, '');
const closeLabel = (h.menu_close || 'Đóng').replace(/^[✕×\s]+/, '');
---
<header class="site-header" data-site-header>
<div class="hdr-top">
<div class="hdr-container hdr-top__row">
<a href={url('tuyen-dung')}>{h.top_jobs}</a><a href={url('lien-he')}>{h.top_contact}</a>
<span class="hdr-top__sep" aria-hidden="true"></span>
<span class="hdr-lang">
<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9.5"/><path d="M2.5 12h19M12 2.5c2.6 2.8 3.9 6 3.9 9.5s-1.3 6.7-3.9 9.5c-2.6-2.8-3.9-6-3.9-9.5s1.3-6.7 3.9-9.5z"/></svg>
{langs.map((l) => l.current ? <strong aria-current="true" lang={l.code}>{l.label}</strong> : <a href={l.href} hreflang={l.code} lang={l.code}>{l.label}</a>)}
</span>
</div></div>
<div class="hdr-container hdr-main">
<a href={url('trang-chu')} class="hdr-logo"><img src={asset("assets/logo-header.png")} alt="Tiến Nông — trang chủ" width="147" height="120" /></a>
<div class="hdr-wide">
<nav aria-label="Chính" class="hdr-nav">
{items.map((item) => {
  if (!item.children.length) return <a href={item.href} aria-current={item.active ? 'page' : undefined} class:list={['hdr-link', { 'is-active': item.active }]}>{item.label}</a>;
  return (
    <div class="nav-dd">
      <a href={item.href} aria-current={item.active ? 'page' : undefined} aria-haspopup="true" class:list={['hdr-link', { 'is-active': item.active }]}>{item.label}</a>
      <div class="nav-dd__menu">
        {item.children.map((c) => <a href={c.href} aria-current={c.current ? 'page' : undefined}>{c.label}</a>)}
      </div>
    </div>
  );
})}
</nav>
<a href={url('tro-thanh-doi-tac')} class="hdr-cta">{h.cta}</a>
</div>
<div class="hdr-narrow">
<a href={url('tro-thanh-doi-tac')} class="hdr-cta hdr-cta--tablet">{h.cta}</a>
<button type="button" class="hdr-toggle" data-menu-toggle aria-expanded="false" aria-controls="hdr-panel" data-open={closeLabel} data-closed={menuLabel}>
<span class="hdr-toggle__icon" aria-hidden="true"><i></i><i></i><i></i></span><span data-menu-label>{menuLabel}</span>
</button>
</div>
</div>
<nav id="hdr-panel" class="hdr-panel" aria-label="Chính" hidden>
<div class="hdr-panel__inner">
{items.map((item) => (
  <div class="hdr-panel__group">
    <a href={item.href} aria-current={item.active ? 'page' : undefined} class:list={['hdr-panel__link', { 'is-active': item.active }]}>{item.label}</a>
    {item.children.map((c) => <a href={c.href} aria-current={c.current ? 'page' : undefined} class:list={['hdr-panel__sub', { 'is-active': c.current }]}>{c.label}</a>)}
  </div>
))}
<div class="hdr-panel__meta">
<a href={url('tuyen-dung')}>{h.top_jobs}</a><a href={url('lien-he')}>{h.top_contact}</a>
</div>
<div class="hdr-panel__langs">
{langs.map((l) => l.current ? <strong aria-current="true" lang={l.code}>{l.label}</strong> : <a href={l.href} hreflang={l.code} lang={l.code}>{l.label}</a>)}
</div>
<div class="hdr-panel__actions">
{callNumber && <a href={`tel:${callNumber}`} class="hdr-panel__call">Gọi kỹ sư tư vấn</a>}
<a href={url('tro-thanh-doi-tac')} class="hdr-panel__partner">{h.cta}</a>
</div>
</div></nav>
</header>

<style>
  .site-header { position: sticky; top: 0; z-index: 30; display: block; font-family: var(--font-body); background: var(--surface-card);
    border-bottom: 1px solid var(--border-default); transition: box-shadow var(--motion-base) var(--ease-out); }
  .site-header.is-scrolled { box-shadow: 0 6px 20px rgba(28, 32, 28, .08); }
  .hdr-container { max-width: 1440px; margin: 0 auto; padding-inline: clamp(20px, 3vw, 40px); }

  /* Top bar (Figma colours): shown on wide screens, folds away once the page is scrolled (web behaviour). */
  .hdr-top { background: var(--brand-bright); color: #fff; font-size: 13px; font-weight: 500; overflow: hidden; max-height: 40px;
    transition: max-height var(--motion-base) var(--ease-out); }
  .hdr-top__row { display: flex; justify-content: flex-end; align-items: center; gap: 22px; padding-block: 7px; }
  .hdr-top a { color: rgba(255, 255, 255, .88); text-decoration: none; transition: color var(--motion-fast); }
  .hdr-top a:hover { color: #fff; text-decoration: underline; text-underline-offset: 3px; }
  .hdr-top__sep { width: 1px; height: 16px; background: rgba(255, 255, 255, .45); }
  .hdr-lang { display: flex; align-items: center; gap: 14px; }
  .hdr-lang svg { margin-right: -6px; opacity: .9; }
  .hdr-lang strong { color: #fff; font-weight: 600; }
  .site-header.is-scrolled .hdr-top { max-height: 0; }

  .hdr-main { display: flex; align-items: center; justify-content: space-between; gap: 24px; padding-block: 10px;
    transition: padding var(--motion-base) var(--ease-out); }
  .hdr-logo { flex: none; display: block; }
  .hdr-logo img { height: 52px; width: auto; display: block; transition: height var(--motion-base) var(--ease-out); }
  .site-header.is-scrolled .hdr-main { padding-block: 8px; }
  .site-header.is-scrolled .hdr-logo img { height: 44px; }

  /* Main menu: capitals, no arrows. Hover = green text (Figma) + underline (web). */
  .hdr-nav { flex: 1 1 auto; min-width: 0; display: flex; justify-content: center; align-items: center; gap: clamp(12px, 1.25vw, 22px);
    white-space: nowrap; font-size: 13px; font-weight: 500; letter-spacing: .01em; text-transform: uppercase; }
  .hdr-link { color: var(--text-primary); text-decoration: none; padding: 8px 0; border-bottom: 2px solid transparent;
    transition: color var(--motion-fast), border-color var(--motion-fast); }
  .hdr-link:hover { color: var(--brand-bright); text-decoration: none; border-bottom-color: var(--brand-bright); }
  .hdr-link.is-active { color: var(--brand-bright); border-bottom-color: var(--brand-bright); }
  .hdr-cta { flex: none; display: inline-flex; align-items: center; min-height: 40px; padding: 0 18px; border-radius: var(--radius-btn);
    background: var(--brand-bright); color: #fff; font-size: 13px; font-weight: 600; letter-spacing: .01em; text-transform: uppercase;
    white-space: nowrap; text-decoration: none; transition: background var(--motion-fast); }
  .hdr-cta:hover { background: var(--green-600); color: #fff; text-decoration: none; }

  .hdr-narrow { align-items: center; gap: 12px; }
  .hdr-toggle { display: inline-flex; align-items: center; gap: 10px; min-height: 44px; padding: 8px 14px; border-radius: var(--radius-md);
    border: 1px solid var(--border-strong); background: var(--surface-card); font: 600 15px var(--font-body); color: var(--text-primary); cursor: pointer; white-space: nowrap; }
  .hdr-toggle__icon { position: relative; width: 18px; height: 12px; display: inline-block; }
  .hdr-toggle__icon i { position: absolute; left: 0; width: 18px; height: 2px; border-radius: 2px; background: currentColor;
    transition: transform var(--motion-base) var(--ease-out), opacity var(--motion-fast); }
  .hdr-toggle__icon i:nth-child(1) { top: 0; } .hdr-toggle__icon i:nth-child(2) { top: 5px; } .hdr-toggle__icon i:nth-child(3) { top: 10px; }
  .hdr-toggle[aria-expanded='true'] .hdr-toggle__icon i:nth-child(1) { transform: translateY(5px) rotate(45deg); }
  .hdr-toggle[aria-expanded='true'] .hdr-toggle__icon i:nth-child(2) { opacity: 0; }
  .hdr-toggle[aria-expanded='true'] .hdr-toggle__icon i:nth-child(3) { transform: translateY(-5px) rotate(-45deg); }

  /* Full-height menu panel under the header bar (tablet and phone). */
  .hdr-panel { position: fixed; left: 0; right: 0; top: var(--hdr-h, 72px); height: calc(100dvh - var(--hdr-h, 72px)); overflow-y: auto;
    overscroll-behavior: contain; background: var(--surface-card); border-top: 1px solid var(--border-default); }
  .hdr-panel:not([hidden]) { animation: hdr-in var(--motion-base) var(--ease-out); }
  @keyframes hdr-in { from { opacity: 0; transform: translateY(-8px); } to { opacity: 1; transform: none; } }
  .hdr-panel__inner { max-width: 760px; margin: 0 auto; padding: 8px clamp(20px, 4vw, 56px) 32px; display: flex; flex-direction: column; }
  .hdr-panel__group { display: flex; flex-direction: column; border-bottom: 1px solid var(--border-default); padding-block: 4px; }
  .hdr-panel__link { display: flex; align-items: center; min-height: 52px; color: var(--text-primary); font-weight: 500; font-size: 16px; text-transform: uppercase; text-decoration: none; }
  .hdr-panel__link.is-active { color: var(--brand-bright); font-weight: 600; }
  .hdr-panel__sub { display: flex; align-items: center; min-height: 44px; margin: 0 0 6px 4px; padding-left: 16px; border-left: 2px solid var(--border-default);
    color: var(--text-secondary); font-weight: 500; text-decoration: none; }
  .hdr-panel__sub.is-active { border-left-color: var(--brand-bright); color: var(--green-700); }
  .hdr-panel__meta, .hdr-panel__langs { display: flex; gap: 8px 24px; flex-wrap: wrap; align-items: center; padding: 16px 0 0; font-weight: 500; }
  .hdr-panel__meta a, .hdr-panel__langs a { color: var(--text-secondary); min-height: 44px; display: inline-flex; align-items: center; }
  .hdr-panel__langs strong { color: var(--green-700); }
  .hdr-panel__actions { display: grid; gap: 12px; padding-top: 16px; }
  .hdr-panel__actions a { display: flex; align-items: center; justify-content: center; min-height: 52px; border-radius: var(--radius-btn); font-weight: 600; text-decoration: none; }
  .hdr-panel__call { background: var(--brand-bright); color: #fff !important; }
  .hdr-panel__partner { border: 1px solid var(--border-strong); color: var(--text-primary) !important; }
  :global(html.menu-open) { overflow: hidden; }

  /* Laptops (1280–1399px): a slightly tighter menu so all eight items and the button fit on one line. */
  @media (max-width: 1399.98px) {
    .hdr-main { gap: 16px; }
    .hdr-nav { font-size: 12.5px; gap: 12px; }
    .hdr-cta { font-size: 12.5px; padding: 0 14px; }
    .hdr-logo img { height: 46px; }
  }
  @media (max-width: 1279.98px) {
    .hdr-top { display: none; }
    .hdr-main { padding-block: 10px; }
    .hdr-logo img, .site-header.is-scrolled .hdr-logo img { height: 44px; }
  }
  @media (max-width: 767.98px) {
    .hdr-cta--tablet { display: none; }
    .hdr-logo img, .site-header.is-scrolled .hdr-logo img { height: 40px; }
    .hdr-main, .site-header.is-scrolled .hdr-main { padding-block: 8px; }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const panel = document.getElementById('hdr-panel');
  const label = toggle?.querySelector<HTMLElement>('[data-menu-label]');

  // Compact header after the first 80px of scrolling.
  if (header) {
    const setH = () => document.documentElement.style.setProperty('--hdr-h', `${header.getBoundingClientRect().height}px`);
    let ticking = false;
    const onScroll = () => {
      if (ticking) return; ticking = true;
      requestAnimationFrame(() => { header.classList.toggle('is-scrolled', scrollY > 80); setH(); ticking = false; });
    };
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', setH);
    onScroll(); setH();
  }

  if (toggle && panel) {
    const setOpen = (open: boolean) => {
      panel.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
      if (label) label.textContent = (open ? toggle.dataset.open : toggle.dataset.closed) ?? '';
      document.documentElement.classList.toggle('menu-open', open);
      if (open) panel.querySelector<HTMLElement>('a')?.focus({ preventScroll: true });
    };
    toggle.addEventListener('click', () => setOpen(panel.hidden));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.hidden) { setOpen(false); toggle.focus(); }
    });
    // Keep keyboard focus inside the open menu.
    panel.addEventListener('keydown', (e) => {
      if (e.key !== 'Tab') return;
      const links = [...panel.querySelectorAll<HTMLElement>('a')];
      const first = links[0], last = links.at(-1);
      if (e.shiftKey && document.activeElement === first) { e.preventDefault(); toggle.focus(); }
      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); toggle.focus(); }
    });
    matchMedia('(min-width: 1280px)').addEventListener('change', (m) => { if (m.matches) setOpen(false); });
  }
</script>
