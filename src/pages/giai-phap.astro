---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import ImageSlot from '../components/ImageSlot.astro';
import Input from '../components/Input.astro';
import { url } from '../lib/routes';

const PROBLEMS = [
  { title: 'Đất chua, bạc màu, suy giảm độ phì', cause: 'Canh tác liên tục, bón nhiều phân hóa học thiếu cân đối và ít bổ sung hữu cơ khiến đất mất cấu trúc, pH giảm.', fix: 'Điều hòa pH đất, bổ sung phân hữu cơ và vi sinh để phục hồi cấu trúc và hệ sinh vật đất.' },
  { title: 'Thiếu hụt hoặc mất cân đối dinh dưỡng', cause: 'Bón theo thói quen, không theo nhu cầu của cây ở từng giai đoạn sinh trưởng.', fix: 'Sử dụng phân bón chuyên dụng theo cây trồng và giai đoạn, kết hợp phân tích đất định kỳ.' },
  { title: 'Cây vàng lá, sinh trưởng kém, năng suất không ổn định', cause: 'Thường do thiếu trung – vi lượng (Ca, Mg, S, Zn, B…) hoặc rễ hoạt động kém.', fix: 'Bổ sung trung – vi lượng, cải thiện môi trường rễ và điều chỉnh chương trình bón.' },
  { title: 'Hiệu quả sử dụng phân bón chưa cao', cause: 'Phân bón bị rửa trôi, bay hơi hoặc bị đất giữ chặt, cây không hấp thu được.', fix: 'Chọn sản phẩm có công nghệ nâng cao hiệu suất sử dụng và bón đúng thời điểm, đúng cách.' },
];
const CROPS = ['Lúa', 'Ngô', 'Rau màu', 'Cây ăn quả', 'Cà phê', 'Chè', 'Mía'];
const ISSUES = ['Đất chua, bạc màu', 'Thiếu dinh dưỡng', 'Vàng lá, kém phát triển', 'Muốn tăng năng suất'];
const FIX = [
  ['Phân tích pH và hữu cơ trong đất', 'Bón vôi hoặc sản phẩm điều hòa pH đất trước vụ', 'Bổ sung phân hữu cơ – Humic kết hợp NPK chuyên dụng'],
  ['Xác định giai đoạn sinh trưởng hiện tại', 'Dùng NPK chuyên dụng theo đúng giai đoạn', 'Bổ sung trung – vi lượng khi cây có biểu hiện thiếu'],
  ['Kiểm tra rễ và độ ẩm đất', 'Bổ sung phân trung – vi lượng', 'Điều chỉnh lượng đạm, tăng kali cho giai đoạn nuôi hạt, nuôi quả'],
  ['Phân tích đất làm căn cứ', 'Áp dụng chương trình bón cân đối của Tiến Nông', 'Theo dõi và điều chỉnh cùng kỹ sư trong suốt vụ'],
];
---
<Layout title="Giải pháp theo cây trồng" active="Giải pháp">
<section style="position:relative;min-height:min(70vh,600px);background:var(--green-900);display:flex">
<div style="position:absolute;inset:0"><ImageSlot style="position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto;display:block" id="sol-hero" shape="rect" placeholder="Cận cảnh bông lúa chín trên cánh đồng" /></div>
<div style="position:absolute;inset:0;pointer-events:none;background:linear-gradient(90deg,rgba(2,53,26,.8) 0%,rgba(2,53,26,.45) 50%,rgba(2,53,26,0) 80%)"></div>
<div style="position:relative;max-width:1280px;width:100%;margin:0 auto;padding:28px clamp(20px,4vw,56px) clamp(56px,7vw,96px);display:flex;flex-direction:column;justify-content:space-between;gap:48px;pointer-events:none;color:#fff">
<span style="font-size:13px;color:var(--green-100)">Trang chủ / Giải pháp / Theo cây trồng</span>
<div style="max-width:760px;display:flex;flex-direction:column;gap:20px">
<span style="font:600 13px var(--font-mono);letter-spacing:.12em;color:var(--green-100)">GIẢI PHÁP DINH DƯỠNG</span>
<h1 style="margin:0;font:800 clamp(34px,4.8vw,60px)/1.08 var(--font-display);letter-spacing:-.015em;text-wrap:balance">Đất khỏe. Cây khỏe. Nông nghiệp hiệu quả hơn.</h1>
<p style="margin:0;font-size:19px;line-height:1.55;color:var(--green-50);text-align:justify;text-wrap:pretty">Mỗi loại cây, mỗi chân đất có nhu cầu dinh dưỡng riêng. Tiến Nông xây dựng chương trình bón phân dựa trên phân tích đất và đặc điểm sinh trưởng của từng cây trồng.</p>
<div style="display:flex;gap:12px;flex-wrap:wrap;pointer-events:auto"><a href="#tim-giai-phap" style="background:var(--green-500);color:#fff;font-weight:700;padding:13px 22px;border-radius:var(--radius-md)">Tìm giải pháp cho cây trồng →</a><a href={url('giai-phap-du-an')} style="background:#fff;color:var(--green-700);font-weight:700;padding:13px 22px;border-radius:var(--radius-md)">Giải pháp cho dự án</a></div>
</div></div></section>

<section style="background:var(--surface-card)">
<div style="max-width:1280px;margin:0 auto;padding:clamp(64px,8vw,112px) clamp(20px,4vw,56px);display:flex;flex-direction:column;gap:40px">
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:24px 64px;align-items:end">
<div style="display:flex;flex-direction:column;gap:14px"><span style="font:600 13px var(--font-mono);letter-spacing:.12em;color:var(--green-600)">01 · THEO CÂY TRỒNG</span><h2 style="margin:0;font:800 clamp(30px,3.4vw,44px)/1.15 var(--font-display);letter-spacing:-.01em;text-wrap:balance">Mỗi nhóm cây trồng, một chương trình dinh dưỡng riêng</h2></div>
<p style="margin:0;color:var(--text-secondary);font-size:17px;text-align:justify;text-wrap:pretty">Chương trình được thiết kế theo từng giai đoạn sinh trưởng, từ bón lót đến nuôi quả, giúp cây phát triển cân đối và tối ưu chi phí đầu tư.</p>
</div>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,340px),1fr));gap:20px">
<a href="#tim-giai-phap" style="position:relative;height:300px;border-radius:var(--radius-lg);overflow:hidden;display:block;color:#fff"><ImageSlot style="position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto;display:block" id="cg-1" shape="rect" placeholder="Lúa, ngô" /><div style="position:absolute;inset:auto 0 0 0;padding:22px;background:linear-gradient(0deg,rgba(2,53,26,.85),rgba(2,53,26,0));pointer-events:none;display:flex;flex-direction:column;gap:4px"><strong style="font-size:21px">Cây lương thực</strong><span style="font-size:14px;color:var(--green-50)">Lúa · Ngô · Khoai · Sắn</span></div></a>
<a href="#tim-giai-phap" style="position:relative;height:300px;border-radius:var(--radius-lg);overflow:hidden;display:block;color:#fff"><ImageSlot style="position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto;display:block" id="cg-2" shape="rect" placeholder="Rau màu" /><div style="position:absolute;inset:auto 0 0 0;padding:22px;background:linear-gradient(0deg,rgba(2,53,26,.85),rgba(2,53,26,0));pointer-events:none;display:flex;flex-direction:column;gap:4px"><strong style="font-size:21px">Rau màu &amp; cây thực phẩm</strong><span style="font-size:14px;color:var(--green-50)">Rau ăn lá · Rau ăn quả · Củ</span></div></a>
<a href="#tim-giai-phap" style="position:relative;height:300px;border-radius:var(--radius-lg);overflow:hidden;display:block;color:#fff"><ImageSlot style="position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto;display:block" id="cg-3" shape="rect" placeholder="Cây ăn quả" /><div style="position:absolute;inset:auto 0 0 0;padding:22px;background:linear-gradient(0deg,rgba(2,53,26,.85),rgba(2,53,26,0));pointer-events:none;display:flex;flex-direction:column;gap:4px"><strong style="font-size:21px">Cây ăn quả</strong><span style="font-size:14px;color:var(--green-50)">Cam · Bưởi · Sầu riêng · Thanh long</span></div></a>
<a href="#tim-giai-phap" style="position:relative;height:300px;border-radius:var(--radius-lg);overflow:hidden;display:block;color:#fff"><ImageSlot style="position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto;display:block" id="cg-4" shape="rect" placeholder="Cà phê, chè" /><div style="position:absolute;inset:auto 0 0 0;padding:22px;background:linear-gradient(0deg,rgba(2,53,26,.85),rgba(2,53,26,0));pointer-events:none;display:flex;flex-direction:column;gap:4px"><strong style="font-size:21px">Cây công nghiệp</strong><span style="font-size:14px;color:var(--green-50)">Cà phê · Chè · Hồ tiêu · Mía</span></div></a>
<a href="#tim-giai-phap" style="position:relative;height:300px;border-radius:var(--radius-lg);overflow:hidden;display:block;color:#fff"><ImageSlot style="position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto;display:block" id="cg-5" shape="rect" placeholder="Hoa, cây cảnh" /><div style="position:absolute;inset:auto 0 0 0;padding:22px;background:linear-gradient(0deg,rgba(2,53,26,.85),rgba(2,53,26,0));pointer-events:none;display:flex;flex-direction:column;gap:4px"><strong style="font-size:21px">Hoa, cây cảnh &amp; cảnh quan</strong><span style="font-size:14px;color:var(--green-50)">Hoa · Cây cảnh · Thảm cỏ</span></div></a>
<a href="#tim-giai-phap" style="position:relative;height:300px;border-radius:var(--radius-lg);overflow:hidden;display:block;color:#fff"><ImageSlot style="position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto;display:block" id="cg-6" shape="rect" placeholder="Cây dược liệu" /><div style="position:absolute;inset:auto 0 0 0;padding:22px;background:linear-gradient(0deg,rgba(2,53,26,.85),rgba(2,53,26,0));pointer-events:none;display:flex;flex-direction:column;gap:4px"><strong style="font-size:21px">Cây dược liệu</strong><span style="font-size:14px;color:var(--green-50)">Sâm · Đinh lăng · Nghệ</span></div></a>
</div></div></section>

<section style="background:var(--surface-page)">
<div style="max-width:1280px;margin:0 auto;padding:clamp(64px,8vw,112px) clamp(20px,4vw,56px);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:40px 72px;align-items:start">
<div style="display:flex;flex-direction:column;gap:16px;position:sticky;top:140px">
<span style="font:600 13px var(--font-mono);letter-spacing:.12em;color:var(--green-600)">02 · THEO VẤN ĐỀ</span>
<h2 style="margin:0;font:800 clamp(30px,3.4vw,44px)/1.15 var(--font-display);letter-spacing:-.01em;text-wrap:balance">Nhận diện đúng vấn đề để chọn đúng giải pháp</h2>
<p style="margin:0;color:var(--text-secondary);font-size:17px;text-align:justify;text-wrap:pretty">Phần lớn tình trạng cây sinh trưởng kém bắt nguồn từ đất. Chọn vấn đề đang gặp phải để xem hướng xử lý phù hợp.</p>
</div>
<div data-accordion style="display:flex;flex-direction:column;border-top:1px solid var(--border-default)">
{PROBLEMS.map((p, k) => (
<div style="border-bottom:1px solid var(--border-default)">
<button type="button" data-acc aria-expanded={k === 0 ? 'true' : 'false'} aria-controls={`pb-${k}`} style="width:100%;display:flex;gap:16px;align-items:baseline;text-align:left;padding:22px 0;border:0;background:none;cursor:pointer;font:700 19px/1.35 var(--font-body);color:var(--text-primary)"><span style="font:600 14px var(--font-mono);color:var(--green-600)">{String(k + 1).padStart(2, '0')}</span><span style="flex:1">{p.title}</span><span data-acc-sign style="font:400 22px var(--font-body);color:var(--green-600)">{k === 0 ? '−' : '+'}</span></button>
<div id={`pb-${k}`} hidden={k !== 0} style="padding:0 0 24px 38px;display:flex;flex-direction:column;gap:12px"><span style="color:var(--text-secondary)">{p.cause}</span><div style="background:var(--green-50);border-radius:var(--radius-md);padding:14px 16px"><strong style="color:var(--green-800)">Hướng xử lý: </strong>{p.fix}</div></div>
</div>
))}
</div></div></section>

<section style="background:var(--green-800);color:#fff">
<div style="max-width:1280px;margin:0 auto;padding:clamp(64px,8vw,112px) clamp(20px,4vw,56px);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:48px 72px;align-items:center">
<div style="position:relative;height:480px"><ImageSlot style="position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto;display:block" id="soil" shape="rounded" radius="20" placeholder="Bàn tay cầm nắm đất có cây con" /></div>
<div style="display:flex;flex-direction:column;gap:24px">
<span style="font:600 13px var(--font-mono);letter-spacing:.12em;color:var(--green-200)">03 · SỨC KHỎE ĐẤT</span>
<h2 style="margin:0;font:800 clamp(30px,3.4vw,44px)/1.15 var(--font-display);letter-spacing:-.01em;text-wrap:balance">Đất là nền tảng của sản xuất nông nghiệp</h2>
<div style="display:flex;flex-direction:column;gap:0;border-top:1px solid var(--green-600)">
<div style="display:grid;grid-template-columns:48px minmax(0,1fr);gap:12px;padding:16px 0;border-bottom:1px solid var(--green-700)"><span style="font:800 22px var(--font-display);color:var(--amber-400)">01</span><div><strong>Đánh giá đất</strong><div style="color:var(--green-100);font-size:15px">Lấy mẫu và phân tích tại phòng thí nghiệm VILAS 1519</div></div></div>
<div style="display:grid;grid-template-columns:48px minmax(0,1fr);gap:12px;padding:16px 0;border-bottom:1px solid var(--green-700)"><span style="font:800 22px var(--font-display);color:var(--amber-400)">02</span><div><strong>Xác định nhu cầu cây trồng</strong><div style="color:var(--green-100);font-size:15px">Theo giống, giai đoạn và mục tiêu năng suất</div></div></div>
<div style="display:grid;grid-template-columns:48px minmax(0,1fr);gap:12px;padding:16px 0;border-bottom:1px solid var(--green-700)"><span style="font:800 22px var(--font-display);color:var(--amber-400)">03</span><div><strong>Xây dựng chương trình bón phân</strong><div style="color:var(--green-100);font-size:15px">Cân đối đa – trung – vi lượng và hữu cơ</div></div></div>
<div style="display:grid;grid-template-columns:48px minmax(0,1fr);gap:12px;padding:16px 0;border-bottom:1px solid var(--green-700)"><span style="font:800 22px var(--font-display);color:var(--amber-400)">04</span><div><strong>Theo dõi &amp; điều chỉnh</strong><div style="color:var(--green-100);font-size:15px">Kỹ sư đồng hành trong suốt vụ mùa</div></div></div>
</div></div></div></section>

<section id="tim-giai-phap" style="background:var(--surface-card);scroll-margin-top:120px">
<div style="max-width:1280px;margin:0 auto;padding:clamp(64px,8vw,112px) clamp(20px,4vw,56px);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:40px 64px;align-items:start">
<div style="display:flex;flex-direction:column;gap:24px">
<div style="display:flex;flex-direction:column;gap:14px"><span style="font:600 13px var(--font-mono);letter-spacing:.12em;color:var(--green-600)">04 · TÌM GIẢI PHÁP</span><h2 style="margin:0;font:800 clamp(30px,3.4vw,44px)/1.15 var(--font-display);letter-spacing:-.01em;text-wrap:balance">Tìm giải pháp phù hợp cho từng cây trồng</h2></div>
<div style="display:flex;flex-direction:column;gap:10px"><span style="font-weight:600">1. Cây trồng</span><div style="display:flex;gap:8px;flex-wrap:wrap">{CROPS.map((c, k) => <button type="button" class="chip" data-chip="crop" data-k={k} aria-pressed={k === 0 ? 'true' : 'false'} style="padding:8px 16px;border-radius:var(--radius-full);border:1px solid var(--border-strong);background:var(--surface-card);color:var(--text-primary);font:600 15px var(--font-body);cursor:pointer">{c}</button>)}</div></div>
<div style="display:flex;flex-direction:column;gap:10px"><span style="font-weight:600">2. Vấn đề đang gặp</span><div style="display:flex;gap:8px;flex-wrap:wrap">{ISSUES.map((c, k) => <button type="button" class="chip" data-chip="issue" data-k={k} aria-pressed={k === 3 ? 'true' : 'false'} style="padding:8px 16px;border-radius:var(--radius-full);border:1px solid var(--border-strong);background:var(--surface-card);color:var(--text-primary);font:600 15px var(--font-body);cursor:pointer">{c}</button>)}</div></div>
</div>
<div style="background:var(--surface-page);border:1px solid var(--border-default);border-radius:var(--radius-xl);padding:clamp(24px,3vw,36px);display:flex;flex-direction:column;gap:18px">
<span style="font:600 12px var(--font-mono);letter-spacing:.08em;color:var(--text-tertiary)">ĐỀ XUẤT SƠ BỘ</span>
<h3 id="rec-title" style="margin:0;font:700 24px/1.3 var(--font-display)">{CROPS[0] + ' · ' + ISSUES[3].toLowerCase()}</h3>
{FIX.map((steps, i) => <div data-rec={i} hidden={i !== 3} style="display:flex;flex-direction:column;gap:10px">{steps.map((t, k) => <div style="display:grid;grid-template-columns:28px minmax(0,1fr);gap:10px;align-items:baseline"><span style="font:700 14px var(--font-mono);color:var(--green-600)">{String(k + 1).padStart(2, '0')}</span><span>{t}</span></div>)}</div>)}
<span style="font-size:14px;color:var(--text-tertiary)">Đây là định hướng chung. Kỹ sư Tiến Nông sẽ tư vấn liều lượng cụ thể theo chân đất và giống cây trồng thực tế.</span>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:12px;padding-top:16px;border-top:1px solid var(--border-default)">
<Input label="Số điện thoại" placeholder="09xx xxx xxx" />
<Input label="Tỉnh / thành phố" placeholder="VD: Thanh Hóa" />
</div>
<a href={url('lien-he', 'lien-he-form')} style="text-decoration:none;display:inline-flex"><Button as="span" size="lg">Nhận tư vấn từ kỹ sư</Button></a>
</div></div></section>

<section style="background:var(--surface-page)">
<div style="max-width:1280px;margin:0 auto;padding:clamp(64px,8vw,112px) clamp(20px,4vw,56px);display:flex;flex-direction:column;gap:36px">
<div style="display:flex;justify-content:space-between;align-items:flex-end;gap:20px;flex-wrap:wrap"><div style="display:flex;flex-direction:column;gap:14px;max-width:640px"><span style="font:600 13px var(--font-mono);letter-spacing:.12em;color:var(--green-600)">05 · MÔ HÌNH THỰC TẾ</span><h2 style="margin:0;font:800 clamp(30px,3.4vw,44px)/1.15 var(--font-display);letter-spacing:-.01em;text-wrap:balance">Giải pháp được kiểm chứng trên đồng ruộng</h2></div><a href={url('nong-dan')} style="font-weight:600">Tất cả mô hình →</a></div>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(clamp(calc((100% - 48px)/3),calc((1068px - 100%)*999),100%),1fr));gap:24px">
<div style="background:var(--surface-card);border:1px solid var(--border-default);border-radius:var(--radius-lg);overflow:hidden"><div style="position:relative;height:240px"><ImageSlot style="position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto;display:block" id="model-1" shape="rect" placeholder="Mô hình lúa" /></div><div style="padding:22px;display:flex;flex-direction:column;gap:10px"><span style="font:600 12px var(--font-mono);color:var(--green-600)">LÚA · THANH HÓA</span><strong style="font-size:19px;line-height:1.35">[Tên mô hình]</strong><div style="display:flex;gap:28px;padding-top:10px;border-top:1px solid var(--border-default)"><div><div style="font:800 26px var(--font-display);color:var(--amber-600)">+[x]%</div><span style="font:600 12px/1.4 var(--font-body);letter-spacing:.06em;text-transform:uppercase;color:var(--text-secondary)">năng suất</span></div><div><div style="font:800 26px var(--font-display);color:var(--amber-600)">[x] ha</div><span style="font:600 12px/1.4 var(--font-body);letter-spacing:.06em;text-transform:uppercase;color:var(--text-secondary)">diện tích</span></div></div></div></div>
