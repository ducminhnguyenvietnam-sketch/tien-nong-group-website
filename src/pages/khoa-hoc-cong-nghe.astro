---
import raw from '../content/pages/khoa-hoc-cong-nghe.json';
import { isFilled, withDefaults } from '../lib/content';
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import ImageSlot from '../components/ImageSlot.astro';
import CtaBand from '../components/CtaBand.astro';
import { url } from '../lib/routes';

const c = withDefaults(raw, 'src/content/pages/khoa-hoc-cong-nghe.json');
const lab = c.s03_trung_tam_r_d as Record<string, any>;
const labs = [1, 2, 3, 4].map((n) => ({ n, img: lab[`img_lab_${n}_1`], name: lab[`t${2 + n * 2}`], text: lab[`t${3 + n * 2}`] }));
const domains = c.domains.filter((d) => isFilled(d.name) && isFilled(d.body) && !d.topics.some((t) => !isFilled(t)));

---
<Layout title={c.seo.title || undefined} description={c.seo.description || undefined} active="Khoa học & Công nghệ">
<section style="position:relative;min-height:min(72vh,640px);background:var(--green-900);display:flex">
<div style="position:absolute;inset:0"><ImageSlot style="position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto;display:block" id="khcn-hero" shape="rect" placeholder="Nhà khoa học thao tác trong phòng thí nghiệm VILAS 1519" image={c.s01_hero.img_khcn_hero_1} cms="src/content/pages/khoa-hoc-cong-nghe.json#s01_hero.img_khcn_hero_1" /></div>
<div style="position:absolute;inset:0;pointer-events:none;background:linear-gradient(90deg,rgba(2,53,26,.82) 0%,rgba(2,53,26,.5) 50%,rgba(2,53,26,0) 80%)"></div>
<div style="position:relative;max-width:var(--wrap, 1280px);width:100%;margin:0 auto;padding:28px clamp(20px,4vw,56px) clamp(56px,7vw,96px);display:flex;flex-direction:column;justify-content:space-between;gap:48px;pointer-events:none;color:#fff">
<span style="font-size:13px;color:var(--green-100)">{c.s01_hero.t1}</span>
<div class="hero-copy" style="max-width:760px;display:flex;flex-direction:column;gap:20px">
<span style="font:var(--type-eyebrow);letter-spacing:.08em;color:var(--green-100)">{c.s01_hero.t2}</span>
<h1 style="margin:0;font:var(--type-h1);letter-spacing:-.015em;text-wrap:balance">{c.s01_hero.t3}</h1>
<p style="margin:0;font-size:var(--fs-lead);line-height:1.55;color:var(--green-50);text-wrap:pretty">{c.s01_hero.t4}</p>
<div class="kh-hbtns"><a href="#nang-luc" class="kh-hbtn kh-hbtn--solid">{c.s01_hero.t5}<span aria-hidden="true">↗</span></a><a href="#quy-trinh" class="kh-hbtn">{c.s01_hero.t6}<span aria-hidden="true">↗</span></a></div>
</div></div></section>

<section style="background:var(--surface-card);border-bottom:1px solid var(--border-default)">
<div style="max-width:var(--wrap, 1280px);margin:0 auto;padding:clamp(48px,6vw,80px) clamp(20px,4vw,56px);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,440px),1fr));gap:40px 72px;align-items:center">
<div style="display:flex;gap:20px;align-items:flex-start">
<span style="flex:none;width:8px;align-self:stretch;border-radius:4px;background:var(--amber-400)"></span>
<div style="display:flex;flex-direction:column;gap:10px">
<h2 style="margin:0;font:var(--type-h2);text-wrap:balance">{c.s02_dinh_vi.t1}</h2>
<span style="color:var(--text-tertiary);font-size:14px">{c.s02_dinh_vi.t2}</span>
</div></div>
<div style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:28px 32px">
<div style="display:flex;flex-direction:column;padding-top:14px;border-top:2px solid var(--green-500)"><span style="font:var(--type-stat);color:var(--amber-600);overflow-wrap:normal;font-variant-numeric:tabular-nums">{c.s02_dinh_vi.t3}</span><span style="font:600 13px/1.45 var(--font-body);letter-spacing:.06em;text-transform:uppercase;color:var(--text-secondary);margin-top:6px">{c.s02_dinh_vi.t4}</span></div>
<div style="display:flex;flex-direction:column;padding-top:14px;border-top:2px solid var(--green-500)"><span style="font:var(--type-stat);color:var(--amber-600);overflow-wrap:normal;font-variant-numeric:tabular-nums">{c.s02_dinh_vi.t5}</span><span style="font:600 13px/1.45 var(--font-body);letter-spacing:.06em;text-transform:uppercase;color:var(--text-secondary);margin-top:6px">{c.s02_dinh_vi.t6}</span></div>
<div style="display:flex;flex-direction:column;padding-top:14px;border-top:2px solid var(--green-500)"><span style="font:var(--type-stat);color:var(--amber-600);overflow-wrap:normal;font-variant-numeric:tabular-nums">{c.s02_dinh_vi.t7}</span><span style="font:600 13px/1.45 var(--font-body);letter-spacing:.06em;text-transform:uppercase;color:var(--text-secondary);margin-top:6px">{c.s02_dinh_vi.t8}</span></div>
<div style="display:flex;flex-direction:column;padding-top:14px;border-top:2px solid var(--green-500)"><span style="font:var(--type-stat);color:var(--amber-600);overflow-wrap:normal;font-variant-numeric:tabular-nums">{c.s02_dinh_vi.t9}</span><span style="font:600 13px/1.45 var(--font-body);letter-spacing:.06em;text-transform:uppercase;color:var(--text-secondary);margin-top:6px">{c.s02_dinh_vi.t10}</span></div>
</div></div></section>

<section id="nang-luc" style="background:var(--surface-page);scroll-margin-top:90px">
<div style="max-width:var(--wrap, 1280px);margin:0 auto;padding:clamp(40px,4vw,56px) clamp(20px,4vw,56px);display:flex;flex-direction:column;gap:24px">
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:20px 64px;align-items:end">
<div style="display:flex;flex-direction:column;gap:14px">
<span style="font:var(--type-eyebrow);letter-spacing:.08em;color:var(--green-600)">{c.s03_trung_tam_r_d.t1}</span>
<h2 style="margin:0;font:var(--type-h2);letter-spacing:-.01em;text-wrap:balance">{c.s03_trung_tam_r_d.t2}</h2>
</div>
<p class="jx-justify" style="margin:0;color:var(--text-secondary);font-size:var(--fs-body);line-height:1.6">{c.s03_trung_tam_r_d.t3}</p>
</div>
<div class="kh-labs">
{labs.map(({ n, img, name, text }) => (
<article class="kh-lab">
<div class="kh-lab__img"><ImageSlot style="position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto;display:block" id={`lab-${n}`} shape="rect" placeholder={img?.alt} image={img} cms={`src/content/pages/khoa-hoc-cong-nghe.json#s03_trung_tam_r_d.img_lab_${n}_1`} sizes="(max-width: 767px) 92vw, 600px" /></div>
<div class="kh-lab__text"><span class="kh-lab__n">{String(n).padStart(2, '0')}</span><h3>{name}</h3><p>{text}</p></div>
</article>
))}
</div></div></section>

<section style="background:var(--surface-card)">
<div style="max-width:var(--wrap, 1280px);margin:0 auto;padding:clamp(64px,8vw,112px) clamp(20px,4vw,56px);display:flex;flex-direction:column;gap:32px">
<div style="display:flex;flex-direction:column;gap:14px;max-width:680px">
<span style="font:var(--type-eyebrow);letter-spacing:.08em;color:var(--green-600)">{c.s04_linh_vuc_nghien_cuu.t1}</span>
<h2 style="margin:0;font:var(--type-h2);letter-spacing:-.01em;text-wrap:balance">{c.s04_linh_vuc_nghien_cuu.t2}</h2>
</div>
<div data-picker style="display:flex;flex-wrap:wrap;gap:32px 48px;align-items:flex-start">
<div role="tablist" aria-orientation="vertical" aria-label="Lĩnh vực nghiên cứu" style="flex:1 1 260px;max-width:340px;display:flex;flex-direction:column;border-top:1px solid var(--border-default)">
{domains.map((d, k) => <button type="button" role="tab" class="dom-tab" data-pick={k} aria-selected={k === 0 ? 'true' : 'false'} style="display:flex;gap:14px;align-items:baseline;text-align:left;padding:18px 0 18px 16px;border:0;border-bottom:1px solid var(--border-default);border-left:3px solid transparent;background:none;font:600 17px var(--font-body);color:var(--text-secondary);cursor:pointer"><span style="font:600 13px var(--font-mono);color:var(--text-tertiary)">{String(k + 1).padStart(2, '0')}</span>{d.name}</button>)}
</div>
{domains.map((d, k) => (
<div role="tabpanel" data-pick-panel={k} hidden={k !== 0} style="flex:999 1 520px;min-width:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr));gap:28px 40px">
<div style="position:relative;height:380px"><ImageSlot style="position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto;display:block" id={`dom-${k}`} shape="rounded" radius="16" placeholder={d.image.alt} image={d.image} cms={`src/content/pages/khoa-hoc-cong-nghe.json#domains.${k}.image`} /></div>
<div style="display:flex;flex-direction:column;gap:16px">
<h3 style="margin:0;font:var(--type-num)">{d.name}</h3>
<p style="margin:0;color:var(--text-secondary);font-size:var(--fs-body);text-wrap:pretty">{d.body}</p>
<div style="display:flex;flex-direction:column;gap:10px;padding-top:12px;border-top:1px solid var(--border-default)">
<span style="font:var(--type-eyebrow);color:var(--text-tertiary);letter-spacing:.06em">{c.domains_topics_label}</span>
{d.topics.map((f) => <div style="display:flex;gap:10px;align-items:baseline"><span style="flex:none;width:6px;height:6px;border-radius:50%;background:var(--green-500);transform:translateY(-2px)"></span><span>{f}</span></div>)}
</div></div></div>
))}
</div></div></section>

<section id="quy-trinh" style="background:var(--green-800);color:#fff;scroll-margin-top:90px">
<div style="max-width:var(--wrap, 1280px);margin:0 auto;padding:clamp(64px,8vw,112px) clamp(20px,4vw,56px);display:flex;flex-direction:column;gap:48px">
<div style="display:flex;flex-direction:column;gap:14px;max-width:700px">
<span style="font:var(--type-eyebrow);letter-spacing:.08em;color:var(--green-200)">{c.s05_quy_trinh.t1}</span>
<h2 style="margin:0;font:var(--type-h2);letter-spacing:-.01em;text-wrap:balance">{c.s05_quy_trinh.t2}</h2>
</div>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(clamp(calc((100% - 0px)/5),calc((1000px - 100%)*999),100%),1fr));gap:0;border-top:1px solid var(--green-600)">
<div style="padding:24px 20px 8px 0;display:flex;flex-direction:column;gap:10px"><span style="font:var(--type-stat);color:var(--amber-400);overflow-wrap:normal;font-variant-numeric:tabular-nums">{c.s05_quy_trinh.t3}</span><strong style="font-size:18px;line-height:1.35">{c.s05_quy_trinh.t4}</strong><span style="color:var(--green-100);font-size:15px">{c.s05_quy_trinh.t5}</span></div>
<div style="padding:24px 20px 8px 0;display:flex;flex-direction:column;gap:10px"><span style="font:var(--type-stat);color:var(--amber-400);overflow-wrap:normal;font-variant-numeric:tabular-nums">{c.s05_quy_trinh.t6}</span><strong style="font-size:18px;line-height:1.35">{c.s05_quy_trinh.t7}</strong><span style="color:var(--green-100);font-size:15px">{c.s05_quy_trinh.t8}</span></div>
<div style="padding:24px 20px 8px 0;display:flex;flex-direction:column;gap:10px"><span style="font:var(--type-stat);color:var(--amber-400);overflow-wrap:normal;font-variant-numeric:tabular-nums">{c.s05_quy_trinh.t9}</span><strong style="font-size:18px;line-height:1.35">{c.s05_quy_trinh.t10}</strong><span style="color:var(--green-100);font-size:15px">{c.s05_quy_trinh.t11}</span></div>
<div style="padding:24px 20px 8px 0;display:flex;flex-direction:column;gap:10px"><span style="font:var(--type-stat);color:var(--amber-400);overflow-wrap:normal;font-variant-numeric:tabular-nums">{c.s05_quy_trinh.t12}</span><strong style="font-size:18px;line-height:1.35">{c.s05_quy_trinh.t13}</strong><span style="color:var(--green-100);font-size:15px">{c.s05_quy_trinh.t14}</span></div>
<div style="padding:24px 0 8px 0;display:flex;flex-direction:column;gap:10px"><span style="font:var(--type-stat);color:var(--amber-400);overflow-wrap:normal;font-variant-numeric:tabular-nums">{c.s05_quy_trinh.t15}</span><strong style="font-size:18px;line-height:1.35">{c.s05_quy_trinh.t16}</strong><span style="color:var(--green-100);font-size:15px">{c.s05_quy_trinh.t17}</span></div>
</div></div></section>

<section style="background:var(--surface-page)">
<div style="max-width:var(--wrap, 1280px);margin:0 auto;padding:clamp(64px,8vw,112px) clamp(20px,4vw,56px);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:48px 72px;align-items:center">
<div style="position:relative;height:460px"><ImageSlot style="position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto;display:block" id="vilas" shape="rounded" radius="20" placeholder="Thiết bị phân tích hiện đại trong phòng thí nghiệm" image={c.s06_vilas_1519.img_vilas_1} cms="src/content/pages/khoa-hoc-cong-nghe.json#s06_vilas_1519.img_vilas_1" /></div>
<div style="display:flex;flex-direction:column;gap:20px">
<span style="font:var(--type-eyebrow);letter-spacing:.08em;color:var(--green-600)">{c.s06_vilas_1519.t1}</span>
<h2 style="margin:0;font:var(--type-h2);letter-spacing:-.01em;text-wrap:balance">{c.s06_vilas_1519.t2}</h2>
<p style="margin:0;color:var(--text-secondary);font-size:var(--fs-body);text-wrap:pretty">{c.s06_vilas_1519.t3}</p>
<div style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px">
<div style="background:var(--surface-card);border:1px solid var(--border-default);border-radius:var(--radius-md);padding:16px"><strong style="display:block">{c.s06_vilas_1519.t4}</strong><span style="font-size:14px;color:var(--text-secondary)">{c.s06_vilas_1519.t5}</span></div>
<div style="background:var(--surface-card);border:1px solid var(--border-default);border-radius:var(--radius-md);padding:16px"><strong style="display:block">{c.s06_vilas_1519.t6}</strong><span style="font-size:14px;color:var(--text-secondary)">{c.s06_vilas_1519.t7}</span></div>
<div style="background:var(--surface-card);border:1px solid var(--border-default);border-radius:var(--radius-md);padding:16px"><strong style="display:block">{c.s06_vilas_1519.t8}</strong><span style="font-size:14px;color:var(--text-secondary)">{c.s06_vilas_1519.t9}</span></div>
{isFilled(c.s06_vilas_1519.t11) && <div style="background:var(--surface-card);border:1px solid var(--border-default);border-radius:var(--radius-md);padding:16px"><strong style="display:block">{c.s06_vilas_1519.t10}</strong><span style="font-size:14px;color:var(--text-secondary)">{c.s06_vilas_1519.t11}</span></div>}
</div>
<div style="display:flex;gap:12px;flex-wrap:wrap"><a href={url('lien-he', 'lien-he-form')} style="text-decoration:none;display:inline-flex"><Button as="span" >{c.s06_vilas_1519.t12} ↗</Button></a></div>
</div></div></section>

<section style="background:var(--surface-card)">
<div style="max-width:var(--wrap, 1280px);margin:0 auto;padding:clamp(64px,8vw,112px) clamp(20px,4vw,56px);display:flex;flex-direction:column;gap:40px">
<div style="display:flex;justify-content:space-between;align-items:flex-end;gap:24px;flex-wrap:wrap">
<div style="display:flex;flex-direction:column;gap:14px;max-width:680px">
<span style="font:var(--type-eyebrow);letter-spacing:.08em;color:var(--green-600)">{c.s07_thanh_qua.t1}</span>
<h2 style="margin:0;font:var(--type-h2);letter-spacing:-.01em">{c.s07_thanh_qua.t2}</h2>
</div>
<a href={url('san-pham')} style="font-weight:600">{c.s07_thanh_qua.t3}</a>
</div>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(clamp(calc((100% - 48px)/3),calc((948px - 100%)*999),100%),1fr));gap:24px">
<div style="display:flex;flex-direction:column;gap:14px"><div style="position:relative;height:240px"><ImageSlot style="position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto;display:block" id="res-1" shape="rounded" radius="16" placeholder="Bao bì NPK bổ sung Silic" image={c.s07_thanh_qua.img_res_1_1} cms="src/content/pages/khoa-hoc-cong-nghe.json#s07_thanh_qua.img_res_1_1" /></div><span style="font:var(--type-eyebrow);color:var(--green-600);letter-spacing:.06em">{c.s07_thanh_qua.t4}</span><strong style="font-size:19px;line-height:1.35">{c.s07_thanh_qua.t5}</strong><span style="color:var(--text-secondary);font-size:15px">{c.s07_thanh_qua.t6}</span></div>
<div style="display:flex;flex-direction:column;gap:14px"><div style="position:relative;height:240px"><ImageSlot style="position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto;display:block" id="res-2" shape="rounded" radius="16" placeholder="Mô hình NPK – hữu cơ – vi sinh" image={c.s07_thanh_qua.img_res_2_1} cms="src/content/pages/khoa-hoc-cong-nghe.json#s07_thanh_qua.img_res_2_1" /></div><span style="font:var(--type-eyebrow);color:var(--green-600);letter-spacing:.06em">{c.s07_thanh_qua.t7}</span><strong style="font-size:19px;line-height:1.35">{c.s07_thanh_qua.t8}</strong><span style="color:var(--text-secondary);font-size:15px">{c.s07_thanh_qua.t9}</span></div>
<div style="display:flex;flex-direction:column;gap:14px"><div style="position:relative;height:240px"><ImageSlot style="position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto;display:block" id="res-3" shape="rounded" radius="16" placeholder="Phân bón hữu cơ, phân bón lỏng" image={c.s07_thanh_qua.img_res_3_1} cms="src/content/pages/khoa-hoc-cong-nghe.json#s07_thanh_qua.img_res_3_1" /></div><span style="font:var(--type-eyebrow);color:var(--green-600);letter-spacing:.06em">{c.s07_thanh_qua.t10}</span><strong style="font-size:19px;line-height:1.35">{c.s07_thanh_qua.t11}</strong><span style="color:var(--text-secondary);font-size:15px">{c.s07_thanh_qua.t12}</span></div>
</div></div></section>

<section class="kh-partners">
<div class="kh-partners__wrap">
<div class="kh-partners__head">
<div style="display:flex;flex-direction:column;gap:14px"><span style="font:var(--type-eyebrow);letter-spacing:.08em;color:var(--green-600)">{c.s08_doi_tac_nghien_cuu.t1}</span>
<h2 style="margin:0;font:var(--type-h2);letter-spacing:-.01em;text-wrap:balance">{c.s08_doi_tac_nghien_cuu.t2}</h2></div>
<div style="display:flex;flex-direction:column;gap:16px;align-items:flex-start"><p class="jx-justify" style="margin:0;color:var(--text-secondary);line-height:1.6">{c.s08_doi_tac_nghien_cuu.t3}</p>
<a href={url('lien-he', 'lien-he-form')} class="kh-link">{c.s08_doi_tac_nghien_cuu.t4} <span aria-hidden="true">→</span></a></div>
</div>
<ul class="kh-logos">
{c.s08_doi_tac_nghien_cuu.partners.filter((pt) => isFilled(pt.name)).map((pt, k) => <li><div class="kh-logos__img"><ImageSlot style="position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto;display:block" id={`part-${k + 1}`} shape="rect" fit="contain" placeholder="Logo" image={pt.logo} cms={`src/content/pages/khoa-hoc-cong-nghe.json#s08_doi_tac_nghien_cuu.partners.${k}.logo`} sizes="200px" /></div><span>{pt.name}</span></li>)}
</ul>
</div></section>

<CtaBand title={c.s09_cta.t1} text={c.s09_cta.t2} primary={{ label: c.s09_cta.t3, href: url('lien-he', 'lien-he-form') }} secondary={{ label: c.s09_cta.t4, href: url('giai-phap') }} />
</Layout>

<style>
  .kh-hbtns { display: flex; gap: 12px; flex-wrap: wrap; pointer-events: auto; margin-top: 4px; }
  .kh-hbtn { display: inline-flex; align-items: center; gap: 14px; min-height: 48px; padding: 0 22px; border-radius: var(--radius-btn); background: #fff; color: var(--green-700); font-weight: 700; text-decoration: none; }
  .kh-hbtn:hover { background: var(--green-50); color: var(--green-800); text-decoration: none; }
  .kh-hbtn--solid { background: var(--brand-bright); color: #fff; }
  .kh-hbtn--solid:hover { background: var(--green-500); color: #fff; }
  .kh-hbtn span { font-size: 14px; }
  /* Four labs: 2 × 2 large photos, number, name and the full description over a green fade. */
  .kh-labs { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
  .kh-lab { position: relative; height: clamp(250px, 20vw, 285px); border-radius: var(--radius-lg); overflow: hidden; color: #fff; isolation: isolate; background: var(--green-800); }
  .kh-lab__img { position: absolute; inset: 0; transition: transform .6s var(--ease-out); }
  .kh-lab:hover .kh-lab__img { transform: scale(1.04); }
  .kh-lab::after { content: ''; position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(0deg, rgba(2, 53, 26, .94) 0%, rgba(2, 53, 26, .78) 32%, rgba(2, 53, 26, .2) 62%, rgba(2, 53, 26, 0) 80%); }
  .kh-lab__text { position: absolute; left: 0; right: 0; bottom: 0; z-index: 1; padding: 22px 26px; display: flex; flex-direction: column; gap: 6px; pointer-events: none; }
